(module
  (@use "walz:core" (type $list))
  (type $S (struct (field $sum (mut i32))))
  (import "walz:host/event-loop@0.1.0" "sleep" (func $sleep (param $ms i32)))
  (func $sum (export "sum") (param $xs (@inst $list i32)) (result i32)
    (@effect reads writes allocates host suspends)
    (@let $s (@$S::{:sum 0})
      (block (result i32)
        (@for-each $value $xs
          (@struct.update $S $s ($sum $old
            (block (result i32) (call $sleep $value) (+ $old $value)))))
        (@let {:sum $answer} $s $answer))))
  (func $null (export "null-update") (@effect reads writes host suspends)
    (@struct.update $S (ref.null $S) ($sum $old
      (block (result i32) (call $sleep 1) $old)))))
