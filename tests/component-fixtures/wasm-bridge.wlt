(module
  (memory $data 1)
  (func $main (export "main") (result i32) (%effect reads writes)
    (%let $pointer (type i32) 16
      (block (result i32)
        (memory.fill $data (i32.const 0) (i32.const 0) (i32.const 64))
        (i32.store $data $pointer (i32.const 42))
        (memory.copy $data $data (i32.const 32) $pointer (i32.const 4))
        (i32.load $data (i32.const 32)))))
  (func $simd (export "simd") (result i32) (%effect reads writes)
    (block (result i32)
      (v128.store $data (i32.const 0) (v128.const i32x4 10 20 30 40))
      (i32x4.extract_lane 2 (v128.load $data (i32.const 0)))))
  (func $trap (export "trap") (param $at i32) (result i32) (%effect reads)
    (i32.load $data $at)))
