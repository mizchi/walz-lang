(module
  (type $Event (@variant
    (v0 i32) (v1 i32) (v2 i32) (v3 i32)
    (v4 i32) (v5 i32) (v6 i32) (v7 i32)))
  (type $Counter (struct (field $count (mut i32))))

  ;; Reverse arm order must still dispatch by declaration tag.
  (func $read (param $event (ref $Event)) (result i32) (@effect pure)
    (@match $event
      (case v7 ($n) (+ $n 7))
      (case v6 ($n) (+ $n 6))
      (case v5 ($n) (+ $n 5))
      (case v4 ($n) (+ $n 4))
      (case v3 ($n) (+ $n 3))
      (case v2 ($n) (+ $n 2))
      (case v1 ($n) (+ $n 1))
      (case v0 ($n) $n)))

  (func $run (export "run") (param $op i32) (param $n i32) (result i32) (@effect allocates)
    (@let $event (type (ref $Event))
      (if (result (ref $Event)) (i32.eq $op 0)
        (then (@variant.new $Event v0 $n))
        (else (if (result (ref $Event)) (i32.eq $op 1)
          (then (@variant.new $Event v1 $n))
          (else (if (result (ref $Event)) (i32.eq $op 2)
            (then (@variant.new $Event v2 $n))
            (else (if (result (ref $Event)) (i32.eq $op 3)
              (then (@variant.new $Event v3 $n))
              (else (if (result (ref $Event)) (i32.eq $op 4)
                (then (@variant.new $Event v4 $n))
                (else (if (result (ref $Event)) (i32.eq $op 5)
                  (then (@variant.new $Event v5 $n))
                  (else (if (result (ref $Event)) (i32.eq $op 6)
                    (then (@variant.new $Event v6 $n))
                    (else (@variant.new $Event v7 $n)))))))))))))))
      (call $read $event)))

  (func $next (param $counter (ref $Counter)) (result (ref $Event))
    (block (result (ref $Event))
      (struct.set $Counter $count $counter (+ (struct.get $Counter $count $counter) 1))
      (@variant.new $Event v7 34)))

  ;; The match subject has a visible effect and must run exactly once.
  (func $main (export "main") (result i32) (@effect reads writes allocates)
    (@let $counter (struct.new $Counter 0)
      (+ (@match (call $next $counter)
           (case v0 ($n) $n)
           (case v1 ($n) (+ $n 1))
           (case v2 ($n) (+ $n 2))
           (case v3 ($n) (+ $n 3))
           (case v4 ($n) (+ $n 4))
           (case v5 ($n) (+ $n 5))
           (case v6 ($n) (+ $n 6))
           (case v7 ($n) (+ $n 7)))
         (struct.get $Counter $count $counter)))))
