(module
  (%use "wlt:core" (type $list) (type $future) (type $stream) (type $option) (type $tuple))
  (func $ints (export "ints") (param $xs (%inst $list i32)) (result (%inst $list i32)) (%effect pure) (local.get $xs))
  (func $longs (export "longs") (param $xs (%inst $list i64)) (result (%inst $list i64)) (%effect pure) (local.get $xs))
  (func $floats (export "floats") (param $xs (%inst $list f32)) (result (%inst $list f32)) (%effect pure) (local.get $xs))
  (func $doubles (export "doubles") (param $xs (%inst $list f64)) (result (%inst $list f64)) (%effect pure) (local.get $xs))
  (func $nested (export "nested") (param $xs (%inst $list (%inst $list i32))) (result (%inst $list (%inst $list i32))) (%effect pure) (local.get $xs))
  (func $later (export "later") (param $xs (%inst $future (%inst $list i32))) (result (%inst $list i32)) (%effect suspends)
    (%future.await (%inst $list i32) (%move $xs)))
  (func $first (export "first") (param $xs (%inst $stream (%inst $list f64))) (result (%inst $option (%inst $list f64))) (%effect suspends)
    (%let ($rest $item) (%stream.next (%inst $list f64) (%move $xs))
      (block (result (%inst $option (%inst $list f64)))
        (%stream.close (%inst $list f64) (%move $rest))
        (local.get $item)))))
