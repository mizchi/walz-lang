(module
  (%import "wlt:std"
    (type $option)
    (type $pair)
    (type $result)
    (type $text))
  (%import "../../stdlib/json-value.wlt"
    (type $json-value.Value)
    (func $json-value.parse) (func $json-value.stringify)
    (func $json-value.get) (func $json-value.at))
  (%import "../../stdlib/json-value.wlt" (func $json-value.null) (func $json-value.array)
    (func $json-value.prepend) (func $json-value.string) (func $json-value.number)
    (func $json-value.object) (func $json-value.set))
  (%import "../../stdlib/json.wlt" (func $json.new) (func $json.number)
    (func $json.null) (func $json.value) (func $json.finish))
  (func $constructed (export "constructed") (result (%inst $result $text i32)) (%effects reads writes allocates)
    (%result.let ($number) (call $json-value.number (%text.lit "1.25e2"))
      (%result.let ($array) (call $json-value.prepend (call $json-value.array) (call $json-value.null))
        (%result.let ($array) (call $json-value.prepend (local.get $array) (call $json-value.string (%text.lit "日本語")))
          (%result.let ($object) (call $json-value.set (call $json-value.object) (%text.lit "values") (local.get $array))
            (%result.let ($object) (call $json-value.set (local.get $object) (%text.lit "n") (local.get $number))
              (%result.ok $text i32 (call $json-value.stringify (local.get $object)))))))))
  (func $builder (export "builder") (result (%inst $result $text i32)) (%effects reads writes allocates)
    (%let $object (call $json.new)
      (block (result (%inst $result $text i32))
        (drop (call $json.number (local.get $object) (%text.lit "bad") (%text.lit "01")))
        (call $json.null (local.get $object) (%text.lit "nothing"))
        (%result.let () (call $json.number (local.get $object) (%text.lit "n") (%text.lit "1.25e2"))
          (%result.let ($value) (call $json-value.parse (%text.lit "[null,true]"))
            (block (result (%inst $result $text i32))
              (call $json.value (local.get $object) (%text.lit "values") (local.get $value))
              (%result.ok $text i32 (call $json.finish (local.get $object)))))))))
  (func $normalize (export "normalize") (param $source $text)
    (result (%inst $result $text i32)) (%effects reads writes allocates)
    (%match (%inst $result (ref $json-value.Value) i32) (result (%inst $result $text i32))
      (call $json-value.parse (local.get $source))
      (case ok ($value) (%result.ok $text i32 (call $json-value.stringify (local.get $value))))
      (case err ($offset) (%result.err $text i32 (local.get $offset)))))
  ;; Observe the old value after creating another value sharing its list tail.
  (func $prepend-snapshot (export "prepend-snapshot") (param $source $text)
    (result (%inst $result (%inst $pair $text $text) i32)) (%effects reads writes allocates)
    (%result.do
      ($original (call $json-value.parse (local.get $source)))
      ($updated (call $json-value.prepend (local.get $original) (call $json-value.null)))
      (%result.ok (%pair.new
        (call $json-value.stringify (local.get $original))
        (call $json-value.stringify (local.get $updated))))))
  (func $set-snapshot (export "set-snapshot") (param $source $text)
    (result (%inst $result (%inst $pair $text $text) i32)) (%effects reads writes allocates)
    (%result.do
      ($original (call $json-value.parse (local.get $source)))
      ($updated (call $json-value.set (local.get $original) (%text.lit "x") (call $json-value.null)))
      (%result.ok (%pair.new
        (call $json-value.stringify (local.get $original))
        (call $json-value.stringify (local.get $updated))))))
  (func $get (export "get") (param $source $text) (param $key $text)
    (result (%inst $option $text)) (%effects reads writes allocates)
    (%match (%inst $result (ref $json-value.Value) i32) (result (%inst $option $text))
      (call $json-value.parse (local.get $source))
      (case err ($offset) (%option.none $text))
      (case ok ($value)
        (%match (%inst $option (ref $json-value.Value)) (result (%inst $option $text))
          (call $json-value.get (local.get $value) (local.get $key))
          (case none () (%option.none $text))
          (case some ($item) (%option.some $text (call $json-value.stringify (local.get $item)))))))))
