(module
  (@use "walz:core" (type $bytes) (type $list) (type $result))
  (@use "../../walz/frontend/tree.walz"
    (type $source-file)
    (type $project-error)
    (type $rendered))
  (@use "../../walz/frontend/frontend.walz" (func $frontend.expand))
  (func $expand
    (export "expand")
    (param $files $list<(ref $source-file)>)
    (result $result<$bytes, (ref $project-error)>)
    (@effect reads writes allocates)
    (@match (call $frontend.expand $files)
      (@case err ($e) (@result.err $e))
      (@case ok ($r) (@result.ok (struct.get $rendered $bytes $r))))
  )
  (@use "../../walz/frontend/modules.walz" (func $modules.link) (func $linked.tree))
  (@use "../../walz/frontend/tree.walz" (func $tree.render))
  (func $link
    (export "link")
    (param $files $list<(ref $source-file)>)
    (result $result<$bytes, (ref $project-error)>)
    (@effect reads writes allocates)
    (@match (call $modules.link $files)
      (@case err ($e) (@result.err $e))
      (@case ok ($linked)
        (@match (call $tree.render (call $linked.tree $linked))
          (@case err ($e) (@result.err $e))
          (@case ok ($r) (@result.ok (struct.get $rendered $bytes $r))))
      ))))
