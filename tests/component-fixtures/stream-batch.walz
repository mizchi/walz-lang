(module
  (@use "walz:core" (type $stream) (type $list) (type $tuple) (type $string) (type $unit))
  (func $local (export "local") (result i32) (@effect suspends)
    (@let $s (@stream.cons i32 20 (@stream.cons i32 22 (@stream.cons i32 100 (@stream.empty i32))))
      (@match (@stream.read-batch i32 2 (@move $s))
        (case pair ($tail $items)
          (block (result i32) (@stream.close i32 (@move $tail))
            (+ (@list.get i32 $items 0) (@list.get i32 $items 1)))))))
  (func $read (export "read") (param $s (@inst $stream i32)) (param $max i32)
    (result (@inst $tuple (@inst $stream i32) (@inst $list i32))) (@effect suspends)
    (@stream.read-batch i32 $max (@move $s)))
  (func $read-text (export "read-text") (param $s (@inst $stream $string)) (param $max i32)
    (result (@inst $tuple (@inst $stream $string) (@inst $list $string))) (@effect suspends)
    (@stream.read-batch $string $max (@move $s)))
  (func $read-unit (export "read-unit") (param $s (@inst $stream $unit)) (param $max i32)
    (result (@inst $tuple (@inst $stream $unit) (@inst $list $unit))) (@effect suspends)
    (@stream.read-batch $unit $max (@move $s)))
)
