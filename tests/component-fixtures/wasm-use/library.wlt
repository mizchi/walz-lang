(module
  (%use "wlt:core" (type $string) (type $bytes) (type $option) (type $result) (type $future))
  (memory $state 1)
  (type $Point (struct (field $x i32) (field $y i32)))
  (%abi.type $Point (record "x" "y"))
  (type $Count (%newtype i32))
  (%abi.type $Count (u32))
  (func $add (export "math-add") (param $a i32) (param $b i32) (result i32) (%effect pure) (+ $a $b))
  (func $next (export "math-next") (result i32) (%effect reads writes)
    (block (result i32)
      (i32.store $state 0 (+ (i32.load $state 0) 1))
      (i32.load $state 0)))
  (func $echo (export "math-echo") (param $value $string) (result $string) (%effect pure) $value)
  (func $bytes (export "math-bytes") (param $value $bytes) (result $bytes) (%effect pure) $value)
  (func $mirror (export "math-mirror") (param $value (ref $Point)) (result (ref $Point)) (%effect pure) $value)
  (func $count (export "math-count") (param $value $Count) (result $Count) (%effect pure) $value)
  (func $maybe (export "math-maybe") (param $value (%inst $option i32)) (result (%inst $option i32)) (%effect pure) $value)
  (func $checked (export "math-checked") (param $value (%inst $result i64 $string)) (result (%inst $result i64 $string)) (%effect pure) $value)
  (func $later (export "math-later") (param $value i64) (result (%inst $future i64)) (%effect allocates)
    (%future.ready i64 $value))
  (func $double (export "math-double") (param $value i64) (result i64) (%effect pure) (* $value 2))
  (func $consume (export "math-consume") (param $value (%inst $future i64)) (result i64) (%effect suspends)
    (%future.await i64 (%move $value))))
