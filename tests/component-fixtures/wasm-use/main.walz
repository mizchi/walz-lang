(component
  (@use "./library.wasm" (component $Library))
  (instance $library (instantiate $Library))
  (instance $other (instantiate $Library))
  (alias export $library "test:binary/math" (instance $math))
  (alias export $other "test:binary/math" (instance $other-math))
  (export "test:binary/math" (instance $math))
  (alias export $other-math "next" (func $other-next))
  (export "other-next" (func $other-next))
  (@lib
    (@use "walz:core" (type $string) (type $bytes) (type $option) (type $result) (type $future))
    (@use "./facade.walz" (func $forward))
    (@type.alias $Point (@component.type "math" (type "point")))
    (@type.alias $Count (@component.type "math" (param "count" 0)))
    (import "math" "add" (func $add (param $a i32) (param $b i32) (result i32)))
    (import "math" "echo" (func $echo (param $value $string) (result $string)))
    (import "math" "bytes" (func $bytes (param $value $bytes) (result $bytes)))
    (import "math" "mirror" (func $mirror (param $value $Point) (result $Point)))
    (import "math" "count" (func $count (param $value $Count) (result $Count)))
    (import "math" "maybe" (func $maybe (param $value $option<i32>) (result $option<i32>)))
    (import "math" "checked" (func $checked (param $value $result<i64, $string>) (result $result<i64, $string>)))
    (import "math" "double" (func $double (param $value i64) (result i64)))
    (import "math" "consume" (func $consume (param $value $future<i64>) (result i64)))
    (import "math" "later" (func $later (param $value i64) (result $future<i64>)))
    (func $main (result i32) (@effect host) (call $add (call $forward) (call $forward)))
    (func $text (param $value $string) (result $string) (@effect host) (call $echo $value))
    (func $data (param $value $bytes) (result $bytes) (@effect host) (call $bytes $value))
    (func $point (param $value $Point) (result $Point) (@effect host) (call $mirror $value))
    (func $unsigned (param $value $Count) (result $Count) (@effect host) (call $count $value))
    (func $optional (param $value (@inst $option i32)) (result (@inst $option i32)) (@effect host) (call $maybe $value))
    (func $result (param $value (@inst $result i64 $string)) (result (@inst $result i64 $string)) (@effect host) (call $checked $value))
    (func $local-future (result (@inst $future i64)) (@effect allocates)
      (@future.ready i64 42))
    (func $double-run (param $value i64) (result i64) (@effect host suspends) (call $double $value))
    (func $consume-run (param $value $future<i64>) (result i64) (@effect host suspends) (call $consume (@move $value)))
    (func $later-run (param $value i64) (result $future<i64>) (@effect host) (call $later $value))
  )
  (@connect "math" (instance $math))
  (@expose "main" $main)
  (@expose "text" $text)
  (@expose "data" $data)
  (@expose "point" $point)
  (@expose "unsigned" $unsigned)
  (@expose "optional" $optional)
  (@expose "result" $result)
  (@expose "local-future" $local-future)
  (@expose "double" $double-run)
  (@expose "consume" $consume-run)
  (@expose "later" $later-run)
)
