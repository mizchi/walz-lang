(module
  (@use "walz:core" (type $string) (type $list) (type $result)
    (func $json.parse)
    (func $json.stringify) (func $json.from-string) (func $string.concat)
    (func $string-builder.new) (func $string-builder.text) (func $string-builder.finish))
  (func $quote (export "quote") (param $s $string) (result $string)
    (@effect reads writes allocates)
    (call $json.stringify (call $json.from-string $s)))
  (func $normalize (export "normalize") (param $s $string)
    (result (@inst $result $string i32)) (@effect reads writes allocates)
    (@result.do ($value (call $json.parse $s))
      (@result.ok (call $json.stringify $value))))
  (func $concat (export "concat") (param $a $string) (param $b $string) (result $string)
    (@effect reads writes allocates)
    (call $string.concat $a $b))
  (func $chunks (export "chunks") (param $values (@inst $list $string)) (result $string)
    (@effect reads writes allocates)
    (@let $out (call $string-builder.new)
      (block (result $string)
        (@for $append (bind $i i32 0) (while (< $i (@list.len $string $values))) (step (+ $i 1))
          (call $string-builder.text $out (@list.get $string $values $i)))
        (call $string-builder.finish $out)))))
