(component
  (component $Provider
    (core module $State
      (global $closed (mut i32) (i32.const 0))
      (func (export "destroy") (param i32)
        (global.set $closed (i32.add (global.get $closed) (i32.const 1))))
      (func (export "count") (result i32) (global.get $closed)))
    (core instance $state (instantiate $State))
    (type $File (resource (rep i32) (dtor (core func $state "destroy"))))
    (core func $new (canon resource.new $File))
    (core module $Ops
      (import "" "new" (func $new (param i32) (result i32)))
      (func (export "make") (result i32) (call $new (i32.const 42)))
      ;; A borrow lowered into its defining component is the representation.
      (func (export "read") (param i32) (result i32) (local.get 0)))
    (core instance $ops (instantiate $Ops (with "" (instance
      (export "new" (func $new))))))
    (func $make (result (own $File)) (canon lift (core func $ops "make")))
    (func $read (param "f" (borrow $File)) (result s32) (canon lift (core func $ops "read")))
    (func $count (result s32) (canon lift (core func $state "count")))
    (instance $api (export "file" (type $File))
      (export "make" (func $make)) (export "read" (func $read)) (export "count" (func $count)))
    (export "api" (instance $api)))
  (instance $provider (instantiate $Provider))
  (alias export $provider "api" (instance $files))
  (alias export $files "count" (func $count))
  (@lib
    (@use "walz:core" (type $borrow))
    (type $File (@resource "test:resources/host/file" $drop))
    (import "test:resources/host" "make" (func $new (result (@resource $File))))
    (import "test:resources/host" "read" (func $read (param $f $borrow<$File>) (result i32)))
    (import "test:resources/host" "[resource-drop]file" (func $drop (param $f i32)))
    (func $run (result i32) (@effect host reads writes allocates)
      (@using $f (call $new) (call $read $f))))
  (@bind "test:resources/host" (instance $files))
  (@expose "run" $run)
  (export "closed-count" (func $count)))
