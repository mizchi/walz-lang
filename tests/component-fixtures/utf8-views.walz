(module
  (@use "walz:core" (type $bytes) (type $string) (type $option)
    (func $bytes.is-utf8)
    (func $bytes-view.new) (func $bytes-view.slice) (func $bytes-view.is-utf8)
    (func $bytes-view.to-string)
    (func $string-view.from-bytes-view) (func $string-view.byte-len)
    (func $string-view.slice) (func $string-view.to-string))
  (type $Counter (array (mut i32)))
  (func $valid (export "valid") (param $b $bytes) (result i32) (@effect pure)
    (call $bytes.is-utf8 $b))
  (func $valid-range (export "valid-range") (param $b $bytes) (param $p i32) (param $n i32)
    (result i32) (@effect pure) (@bytes.is-utf8 $b $p $n))
  (func $valid-view (export "valid-view") (param $b $bytes) (param $p i32) (param $n i32)
    (result i32) (@effect allocates)
    (call $bytes-view.is-utf8 (call $bytes-view.slice (call $bytes-view.new $b) $p $n)))
  (func $length (export "length") (param $b $bytes) (param $p i32) (param $n i32)
    (result (@inst $option i32)) (@effect allocates)
    (@match (call $string-view.from-bytes-view
      (call $bytes-view.slice (call $bytes-view.new $b) $p $n))
      (@case none () (@option.none))
      (@case some ($v) (@option.some (call $string-view.byte-len $v)))))
  (func $decode (export "decode") (param $b $bytes) (param $p i32) (param $n i32)
    (result (@inst $option $string)) (@effect pure)
    (@string.from-bytes $b $p $n))
  (func $materialize (export "materialize") (param $b $bytes) (param $p i32) (param $n i32)
    (result (@inst $option $string)) (@effect allocates)
    (call $bytes-view.to-string (call $bytes-view.slice (call $bytes-view.new $b) $p $n)))
  (func $string (export "text") (param $b $bytes) (param $p i32) (param $n i32)
    (param $start i32) (param $length i32) (result (@inst $option $string)) (@effect allocates)
    (@match (call $string-view.from-bytes-view
      (call $bytes-view.slice (call $bytes-view.new $b) $p $n))
      (@case none () (@option.none))
      (@case some ($v) (@option.some
        (call $string-view.to-string (call $string-view.slice $v $start $length))))))
  (func $mark (param $counter (ref $Counter)) (param $digit i32) (param $value i32)
    (result i32) (@effect reads writes)
    (block (result i32)
      (array.set $Counter $counter 0 (+ (* (array.get $Counter $counter 0) 10) $digit)) $value))
  (func $order (export "order") (result i32) (@effect reads writes allocates)
    (@let $counter (array.new $Counter 0 1)
      (block (result i32)
        (drop (@bytes.is-utf8
          (block (result $bytes) (drop (call $mark $counter 1 0)) (@bytes.new 65))
          (call $mark $counter 2 0) (call $mark $counter 3 1)))
        (drop (@string.from-bytes
          (block (result $bytes) (drop (call $mark $counter 4 0)) (@bytes.new 65))
          (call $mark $counter 5 0) (call $mark $counter 6 1)))
        (array.get $Counter $counter 0)))))
