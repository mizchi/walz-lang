(module
  (@use "walz:core"
    (type $future)
    (type $option)
    (type $tuple)
    (type $result)
    (type $stream)
    (type $unit))
  (func $value (export "value") (param $x (@inst $option (@inst $result i64 f64)))
    (result (@inst $option (@inst $result i64 f64))) (@effect pure) (local.get $x))
  (func $wide (export "wide")
    (param $a0 i32) (param $a1 i32) (param $a2 i32) (param $a3 i32)
    (param $a4 i32) (param $a5 i32) (param $a6 i32) (param $a7 i32)
    (param $a8 i32) (param $a9 i32) (param $a10 i32) (param $a11 i32)
    (param $a12 i32) (param $a13 i32) (param $a14 i32) (param $a15 i32) (param $a16 i32)
    (result (@inst $tuple i32 f64)) (@effect pure)
    (@tuple.new i32 f64 (i32.add (local.get $a0) (local.get $a16)) (f64.const -1.25)))
  (func $option-stream (export "option-stream") (result (@inst $stream (@inst $option i64))) (@effect pure)
    (@stream.cons (@inst $option i64) (@option.none i64)
      (@stream.cons (@inst $option i64) (@option.some i64 (i64.const 42)) (@stream.empty (@inst $option i64)))))
  (func $units (export "units") (param $x (@inst $tuple $unit (@inst $option $unit)))
    (result (@inst $tuple $unit (@inst $option $unit))) (@effect pure) (local.get $x))
  (func $future (export "future") (result (@inst $future i64)) (@effect pure)
    (@future.ready i64 (i64.const 42)))
  (func $stream (export "stream") (result (@inst $stream i64)) (@effect pure)
    (@stream.cons i64 (i64.const 40) (@stream.cons i64 (i64.const 2) (@stream.empty i64))))
  (func $await (export "await") (param $f (@inst $future i64)) (result i64) (@effect suspends)
    (@future.await i64 (@move $f)))
  (func $prepend (export "prepend") (param $s (@inst $stream i64)) (result (@inst $stream i64)) (@effect pure)
    (@stream.cons i64 (i64.const 40) (@move $s)))
  (func $first (export "first") (param $s (@inst $stream i64)) (result (@inst $option i64)) (@effect suspends)
    (@match (@inst $tuple (@inst $stream i64) (@inst $option i64)) (result (@inst $option i64)) (@stream.next i64 (@move $s))
      (case pair ($next $item)
        (block (result (@inst $option i64)) (@stream.close i64 (@move $next)) (local.get $item)))))
  (func $close-stream (export "close-stream") (param $s (@inst $stream i64)) (@effect pure)
    (@stream.close i64 (@move $s)))
  (func $unit-future (export "unit-future") (result (@inst $future $unit)) (@effect pure) (@future.ready $unit))
  (func $await-unit (export "await-unit") (param $f (@inst $future $unit)) (@effect suspends)
    (@future.await $unit (@move $f)))
  (func $next-unit (export "next-unit") (param $s (@inst $stream $unit)) (result (@inst $option $unit)) (@effect suspends)
    (@match (@inst $tuple (@inst $stream $unit) (@inst $option $unit)) (result (@inst $option $unit)) (@stream.next $unit (@move $s))
      (case pair ($next $item)
        (block (result (@inst $option $unit)) (@stream.close $unit (@move $next)) (local.get $item)))))
  (func $unit-stream (export "unit-stream") (result (@inst $stream $unit)) (@effect pure)
    (@stream.cons $unit (@stream.empty $unit))))
