(module
  (type $Numbers (array (mut i64)))
  (func $identity (export "identity") (param $xs (%list i64)) (result (%list i64)) (%effects pure)
    (local.get $xs))
  (func $texts (export "texts") (param $xs (%list %text)) (result (%list %text)) (%effects pure) (local.get $xs))
  (func $nested (export "nested") (param $xs (%list (%option (%result (%pair i64 %text) %bytes))))
    (result (%list (%option (%result (%pair i64 %text) %bytes)))) (%effects pure) (local.get $xs))
  (func $units (export "units") (param $xs (%list %unit)) (result (%list %unit)) (%effects pure) (local.get $xs))
  (func $new-units (export "new-units") (result (%list %unit)) (%effects pure) (%list.new %unit (nop) (nop)))
  (func $unit-get (export "unit-get") (param $xs (%list %unit)) (param $i i32) (%effects pure) (%list.get %unit (local.get $xs) (local.get $i)))
  (func $floats (export "floats") (param $xs (%list f32)) (result (%list f32)) (%effects pure) (local.get $xs))
  (func $doubles (export "doubles") (param $xs (%list f64)) (result (%list f64)) (%effects pure) (local.get $xs))
  (func $matrix (export "matrix") (param $xs (%list (%list i32))) (result (%list (%list i32))) (%effects pure) (local.get $xs))
  (func $literal (export "literal") (result (%list i64)) (%effects pure)
    (%list.new i64 (i64.const 40) (i64.const 2)))
  (func $empty (export "empty") (result (%list %text)) (%effects pure) (%list.new %text))
  (func $length (export "length") (param $xs (%list i64)) (result i32) (%effects pure)
    (%list.len i64 (local.get $xs)))
  (func $get (export "get") (param $xs (%list i64)) (param $i i32) (result i64) (%effects pure)
    (%list.get i64 (local.get $xs) (local.get $i)))
  (func $slice (export "slice") (param $xs (%list i64)) (param $start i32) (param $length i32)
    (result (%list i64)) (%effects pure) (%list.slice i64 (local.get $xs) (local.get $start) (local.get $length)))
  (func $snapshot (export "snapshot") (result (%list i64)) (%effects reads writes allocates)
    (%let $source (array.new_fixed $Numbers 2 (i64.const 40) (i64.const 2))
      (%let $copy (%list.from-array i64 $Numbers (local.get $source))
        (block (result (%list i64)) (array.set $Numbers (local.get $source) (i32.const 0) (i64.const 99)) (local.get $copy)))))
  (func $await (export "await") (param $f (%future (%list %text))) (result (%list %text)) (%effects suspends)
    (%future.await (%list %text) (%move $f)))
  (func $first (export "first") (param $s (%stream (%list %text))) (result (%option (%list %text))) (%effects suspends)
    (%match (%pair (%stream (%list %text)) (%option (%list %text))) (result (%option (%list %text)))
      (%stream.next (%list %text) (%move $s))
      (case pair ($next $item)
        (block (result (%option (%list %text))) (%stream.close (%list %text) (%move $next)) (local.get $item)))))
  (func $trap-owned (export "trap-owned") (param $s (%stream (%list %text))) (result i32) (%effects pure)
    (block (result i32)
      (drop (i32.div_s (i32.const 1) (i32.const 0)))
      (%stream.close (%list %text) (%move $s)) (i32.const 0))))
