(module
  (@use "walz:core" (type $option) (type $future) (type $unit) (type $string))
  (import "walz:host/event-loop@0.1.0" "sleep" (func $sleep (param $n i32)))
  (import "walz:host/event-loop@0.1.0" "after" (func $after (param $n i32) (result (@inst $future $unit))))
  (@closure $Work (@capture $n i32) (result i32) (@effect host suspends)
    (block (result i32) (call $sleep $n) (i32.const 21)))
  (@closure $Captured (@capture $f (@inst $future $unit)) (result i32) (@effect host suspends)
    (block (result i32) (@future.await $unit (@move $f)) (i32.const 99)))
  (func $run (export "run") (result i32) (@effect host reads writes allocates suspends)
    (@let $sibling (@task.spawn i32 $Work (@closure.new $Work 10))
      (@let $cancelled (@task.spawn i32 $Captured (@closure.new $Captured (call $after 60000)))
        (@let $answer (@task.join-timeout i32 5 (@move $cancelled))
          (+ (@match (@inst $option i32) (result i32) $answer (case none () (i32.const 21)) (case some ($v) $v))
             (@task.join i32 (@move $sibling)))))))
  (func $cancel (export "cancel") (result i32) (@effect host reads writes allocates suspends)
    (@let $t (@task.spawn i32 $Work (@closure.new $Work 60000))
      (block (result i32) (@task.cancel i32 (@move $t)) (i32.const 42))))
  (func $ready (export "ready") (result (@inst $option i32)) (@effect host reads writes allocates suspends)
    (@let $t (@task.spawn i32 $Work (@closure.new $Work 0)) (@task.join-timeout i32 1000 (@move $t))))
  (@closure $Nested (result i32) (@effect host reads writes allocates suspends)
    (@task.scope (result i32)
      (@let $t (@task.spawn i32 $Work (@closure.new $Work 60000)) (@task.join i32 (@move $t)))))
  (func $nested (export "nested") (result (@inst $option i32)) (@effect host reads writes allocates suspends)
    (@let $t (@task.spawn i32 $Nested (@closure.new $Nested)) (@task.join-timeout i32 5 (@move $t))))
  (func $running (export "running") (result (@inst $option i32)) (@effect host reads writes allocates suspends)
    (@let $t (@task.spawn i32 $Work (@closure.new $Work 60000)) (@task.join-timeout i32 5 (@move $t))))

  (@closure $Text (@capture $f (@inst $future $string)) (@capture $n i32) (result $string) (@effect host suspends)
    (block (result $string)
      (call $sleep $n)
      (@let $v (@future.await $string (@move $f))
        (block (result $string) (call $sleep 40) $v))))
  (func $text (export "text") (param $a (@inst $future $string)) (param $b (@inst $future $string)) (result $string) (@effect host reads writes allocates suspends)
    (@let $first (@task.spawn $string $Text (@closure.new $Text (@move $a) 1))
      (@let $second (@task.spawn $string $Text (@closure.new $Text (@move $b) 2))
        (block (result $string)
          (drop (@task.join-timeout $string 25 (@move $first)))
          (@task.join $string (@move $second))))))

  (@closure $Escaped (result i32) (@effect host reads writes allocates suspends)
    (block (result i32)
      (@let $f (block $out (result (@inst $future $unit))
        (@task.scope (result (@inst $future $unit)) (br $out (call $after 60000))))
        (block (call $sleep 60000) (@future.await $unit (@move $f))))
      (i32.const 99)))
  (func $escaped (export "escaped") (@effect host reads writes allocates suspends)
    (@let $t (@task.spawn i32 $Escaped (@closure.new $Escaped))
      (block (drop (@task.join-timeout i32 5 (@move $t))) (call $sleep 3))))

)
