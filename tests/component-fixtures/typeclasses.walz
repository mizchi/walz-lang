(module
  (@use "walz:core" (type $tuple) (type $future))

  (func $add (@type.params $T) (@where (Add $T))
    (param $a $T) (param $b $T) (result $T)
    (@effect pure)
    (+ $a $b))

  (func $less (@type.params $T) (@where (Ord $T))
    (param $a $T) (param $b $T) (result i32)
    (@effect pure)
    (< $a $b))

  (func $add32 (export "add32") (param $a i32) (param $b i32) (result i32)
    (@effect pure)
    (call (@inst $add i32) $a $b))
  (func $add64 (export "add64") (param $a i64) (param $b i64) (result i64)
    (@effect pure)
    (call (@inst $add i64) $a $b))
  (func $float32 (export "float32") (param $a f32) (param $b f32) (result f32)
    (@effect pure)
    (call (@inst $add f32) $a $b))
  (func $float64 (export "float64") (param $a f64) (param $b f64) (result f64)
    (@effect pure)
    (call (@inst $add f64) $a $b))
  (func $less32 (export "less32") (param $a i32) (param $b i32) (result i32)
    (@effect pure)
    (call (@inst $less i32) $a $b))
  (func $less64 (export "less64") (param $a i64) (param $b i64) (result i32)
    (@effect pure)
    (call (@inst $less i64) $a $b))
  (func $eq64 (export "eq64") (param $a i64) (param $b i64) (result i32)
    (@effect pure)
    (= $a $b))
  (func $ne32 (export "ne32") (param $a i32) (param $b i32) (result i32)
    (@effect pure)
    (!= $a $b))
  (func $literals (export "literals") (result i32)
    (@effect pure)
    (+ 1 3))
  (func $inferred (export "inferred") (param $x i64) (result i64)
    (@effect pure)
    (@let $y (+ 1 $x) (+ $y 1)))

  (func $arithmetic (@type.params $T) (@where (Sub $T) (Mul $T) (Div $T))
    (param $x $T) (param $offset $T) (param $factor $T) (param $denominator $T)
    (result $T) (@effect pure)
    (/ (* (- $x $offset) $factor) $denominator))
  (func $arithmetic32 (export "arithmetic32")
    (param $x i32) (param $offset i32) (param $factor i32) (param $denominator i32)
    (result i32) (@effect pure)
    (call (@inst $arithmetic i32) $x $offset $factor $denominator))
  (func $arithmetic64 (export "arithmetic64")
    (param $x i64) (param $offset i64) (param $factor i64) (param $denominator i64)
    (result i64) (@effect pure)
    (call (@inst $arithmetic i64) $x $offset $factor $denominator))
  (func $arithmetic_f32 (export "arithmetic-f32")
    (param $x f32) (param $offset f32) (param $factor f32) (param $denominator f32)
    (result f32) (@effect pure)
    (call (@inst $arithmetic f32) $x $offset $factor $denominator))
  (func $arithmetic_f64 (export "arithmetic-f64")
    (param $x f64) (param $offset f64) (param $factor f64) (param $denominator f64)
    (result f64) (@effect pure)
    (call (@inst $arithmetic f64) $x $offset $factor $denominator))
  (func $pair (export "pair") (param $x i64) (result (@inst $tuple i64 i32))
    (@effect pure)
    (@tuple.new (+ $x 1) (< $x 0)))
  (func $await (export "await-add") (param $f (@inst $future i64)) (result i64)
    (@effect suspends)
    (+ (@future.await i64 (@move $f)) 2))

  (type $Trace (struct (field $log (mut i32))))
  (func $mark (param $t (ref $Trace)) (param $n i32) (param $value i32) (result i32)
    (@effect reads writes)
    (block (result i32)
      (struct.set $Trace $log $t (+ (i32.mul (struct.get $Trace $log $t) 10) $n))
      $value))

  (func $both (@type.params $T) (@where (Logical $T))
    (param $a $T) (param $b $T) (result $T) (@effect pure)
    (&& $a $b))
  (func $both32 (export "both32") (param $a i32) (param $b i32) (result i32)
    (@effect pure)
    (call (@inst $both i32) $a $b))
  (func $bits (@type.params $T) (@where (Bitwise $T))
    (param $a $T) (param $b $T) (result $T) (@effect pure)
    (^ (| $a $b) (& $a $b)))
  (func $bits32 (export "bits32") (param $a i32) (param $b i32) (result i32)
    (@effect pure) (call (@inst $bits i32) $a $b))
  (func $bits64 (export "bits64") (param $a i64) (param $b i64) (result i64)
    (@effect pure) (call (@inst $bits i64) $a $b))
  (func $ushift (@type.params $T) (@where (Shift $T))
    (param $a $T) (param $n $T) (result $T) (@effect pure) (>>> $a $n))
  (func $ushift32 (export "ushift32") (param $a i32) (param $n i32) (result i32)
    (@effect pure) (call (@inst $ushift i32) $a $n))
  (func $ushift64 (export "ushift64") (param $a i64) (param $n i64) (result i64)
    (@effect pure) (call (@inst $ushift i64) $a $n))
  (func $ashift32 (export "ashift32") (param $a i32) (param $n i32) (result i32)
    (@effect pure) (>> $a $n))
  (func $ashift64 (export "ashift64") (param $a i64) (param $n i64) (result i64)
    (@effect pure) (>> $a $n))
  (func $shl32 (export "shl32") (param $a i32) (param $n i32) (result i32)
    (@effect pure) (<< $a $n))
  (func $shl64 (export "shl64") (param $a i64) (param $n i64) (result i64)
    (@effect pure) (<< $a $n))

  (func $logical_trace (export "logical-trace")
    (param $a i32) (param $b i32) (param $or i32)
    (result (@inst $tuple i32 i32)) (@effect allocates reads writes)
    (@let (($t (struct.new $Trace 0))
           ($r (if (result i32) $or
                 (then (|| (call $mark $t 1 $a) (call $mark $t 2 $b)))
                 (else (&& (call $mark $t 1 $a) (call $mark $t 2 $b))))))
      (@tuple.new $r (struct.get $Trace $log $t))))
  (func $short_trap (export "short-trap") (param $flag i32) (result i32)
    (@effect pure) (|| $flag (i32.div_s 1 0)))
  (func $async_short (export "async-short") (param $flag i32)
    (result (@inst $tuple i32 i32)) (@effect allocates reads writes suspends)
    (@let (($t (struct.new $Trace 0))
           ($r (|| $flag (block (result i32)
                  (struct.set $Trace $log $t 1)
                  (@future.await i32 (@future.ready i32 7))))))
      (@tuple.new $r (struct.get $Trace $log $t))))
)
