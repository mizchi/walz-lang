(module
  (%use "wlt:core" (type $future) (type $unit))
  (import "wlt:host/event-loop@0.1.0" "sleep" (func $sleep (param $ms i32)))
  (import "wlt:host/event-loop@0.1.0" "after" (func $after (param $ms i32) (result (%inst $future $unit))))
  (%closure $Work (%capture $ms i32) (result i32) (%effect host suspends)
    (block (result i32) (call $sleep $ms) 21))
  (func $children (export "children") (param $ms i32) (result i32) (%effect host reads writes allocates suspends)
    (%let $a (%task.spawn i32 $Work (%closure.new $Work $ms))
      (%let $b (%task.spawn i32 $Work (%closure.new $Work $ms))
        (+ (%task.join i32 (%move $a)) (%task.join i32 (%move $b))))))
  (func $value (export "value") (result i32) (%effect pure) 42)
  (func $timer (export "timer") (param $ms i32) (%effect host suspends)
    (%future.await $unit (call $after $ms)))
  (func $close (export "close-timer") (param $ms i32) (%effect host)
    (%future.close $unit (call $after $ms))))
