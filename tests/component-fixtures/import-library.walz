(module
  (@use "walz:core" (type $future))
  (@export (func $answer) (func $unused))
  (import "walz:host/event-loop@0.1.0" "defer-i64"
    (func $defer (param $delay i32) (param $value i64) (result (@inst $future i64))))
  (func $answer (result i32) (@effect pure) (i32.const 42))

  (func $unused
    (result (@inst $future i64))
    (@effect host)
    (call $defer (i32.const 1) (i64.const 99))))
