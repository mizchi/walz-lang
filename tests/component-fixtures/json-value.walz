(module
  (@use "walz:core"
    (type $option)
    (type $tuple)
    (type $result)
    (type $string))
  (@use "../../walz/core/json-value.walz"
    (type $json-value)
    (func $json.parse) (func $json.stringify)
    (func $json.get) (func $json.at))
  (@use "../../walz/core/json-value.walz" (func $json.null) (func $json.array)
    (func $json.prepend) (func $json.from-string) (func $json.number)
    (func $json.object) (func $json.set))
  (@use "../../walz/core/json.walz" (func $json.object-builder.new) (func $json.object-builder.number)
    (func $json.object-builder.null) (func $json.object-builder.value) (func $json.object-builder.finish))
  (func $constructed (export "constructed") (result (@inst $result $string i32)) (@effect reads writes allocates)
    (@result.let ($number) (call $json.number (@string.lit "1.25e2"))
      (@result.let ($array) (call $json.prepend (call $json.array) (call $json.null))
        (@result.let ($array) (call $json.prepend (local.get $array) (call $json.from-string (@string.lit "日本語")))
          (@result.let ($object) (call $json.set (call $json.object) (@string.lit "values") (local.get $array))
            (@result.let ($object) (call $json.set (local.get $object) (@string.lit "n") (local.get $number))
              (@result.ok $string i32 (call $json.stringify (local.get $object)))))))))
  (func $builder (export "builder") (result (@inst $result $string i32)) (@effect reads writes allocates)
    (@let $object (call $json.object-builder.new)
      (block (result (@inst $result $string i32))
        (drop (call $json.object-builder.number (local.get $object) (@string.lit "bad") (@string.lit "01")))
        (call $json.object-builder.null (local.get $object) (@string.lit "nothing"))
        (@result.let () (call $json.object-builder.number (local.get $object) (@string.lit "n") (@string.lit "1.25e2"))
          (@result.let ($value) (call $json.parse (@string.lit "[null,true]"))
            (block (result (@inst $result $string i32))
              (call $json.object-builder.value (local.get $object) (@string.lit "values") (local.get $value))
              (@result.ok $string i32 (call $json.object-builder.finish (local.get $object)))))))))
  (func $normalize (export "normalize") (param $source $string)
    (result (@inst $result $string i32)) (@effect reads writes allocates)
    (@match (@inst $result (ref $json-value) i32) (result (@inst $result $string i32))
      (call $json.parse (local.get $source))
      (case ok ($value) (@result.ok $string i32 (call $json.stringify (local.get $value))))
      (case err ($offset) (@result.err $string i32 (local.get $offset)))))
  ;; Observe the old value after creating another value sharing its list tail.
  (func $prepend-snapshot (export "prepend-snapshot") (param $source $string)
    (result (@inst $result (@inst $tuple $string $string) i32)) (@effect reads writes allocates)
    (@result.do
      ($original (call $json.parse (local.get $source)))
      ($updated (call $json.prepend (local.get $original) (call $json.null)))
      (@result.ok (@tuple.new
        (call $json.stringify (local.get $original))
        (call $json.stringify (local.get $updated))))))
  (func $set-snapshot (export "set-snapshot") (param $source $string)
    (result (@inst $result (@inst $tuple $string $string) i32)) (@effect reads writes allocates)
    (@result.do
      ($original (call $json.parse (local.get $source)))
      ($updated (call $json.set (local.get $original) (@string.lit "x") (call $json.null)))
      (@result.ok (@tuple.new
        (call $json.stringify (local.get $original))
        (call $json.stringify (local.get $updated))))))
  (func $get (export "get") (param $source $string) (param $key $string)
    (result (@inst $option $string)) (@effect reads writes allocates)
    (@match (@inst $result (ref $json-value) i32) (result (@inst $option $string))
      (call $json.parse (local.get $source))
      (case err ($offset) (@option.none $string))
      (case ok ($value)
        (@match (@inst $option (ref $json-value)) (result (@inst $option $string))
          (call $json.get (local.get $value) (local.get $key))
          (case none () (@option.none $string))
          (case some ($item) (@option.some $string (call $json.stringify (local.get $item)))))))))
