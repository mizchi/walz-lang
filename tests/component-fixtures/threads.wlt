(module
  (import "env" "memory" (memory $shared 1 2 shared))
  (func $add (export "add") (param $address i32) (param $n i32) (result i32)
    (%effect reads writes synchronizes)
    (i32.atomic.rmw.add $shared $address $n))
  (func $load (export "load") (param $address i32) (result i32)
    (%effect reads synchronizes) (i32.atomic.load $shared $address))
  (func $store (export "store") (param $address i32) (param $n i32)
    (%effect writes synchronizes) (i32.atomic.store $shared $address $n))
  (func $add64 (export "add64") (param $address i32) (param $n i64) (result i64)
    (%effect reads writes synchronizes) (i64.atomic.rmw.add $shared $address $n))
  (func $compare64 (export "compare64") (param $address i32) (param $expected i64) (param $replacement i64) (result i64)
    (%effect reads writes synchronizes) (i64.atomic.rmw.cmpxchg $shared $address $expected $replacement))
  (func $packed (export "packed") (param $address i32) (param $n i64) (result i64)
    (%effect reads writes synchronizes)
    (block (result i64)
      (i64.atomic.store8 $shared $address $n)
      (i64.atomic.rmw8.add_u $shared $address 1)))
  (func $wait32 (export "wait32") (param $address i32) (param $expected i32) (param $timeout i64) (result i32)
    (%effect reads synchronizes blocks) (memory.atomic.wait32 $shared $address $expected $timeout))
  (func $wait64 (export "wait64") (param $address i32) (param $expected i64) (param $timeout i64) (result i32)
    (%effect reads synchronizes blocks) (memory.atomic.wait64 $shared $address $expected $timeout))
  (func $notify (export "notify") (param $address i32) (param $n i32) (result i32)
    (%effect synchronizes) (memory.atomic.notify $shared $address $n))
  (func $fence (export "fence") (%effect synchronizes) (atomic.fence))
  (func $size (export "size") (result i32) (%effect reads synchronizes) (memory.size $shared))
  (func $grow (export "grow") (param $pages i32) (result i32)
    (%effect reads writes synchronizes) (memory.grow $shared $pages)))
