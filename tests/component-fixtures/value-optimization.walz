(module
  (@use "walz:core" (type $option) (type $result) (type $tuple) (type $unit)
    (func $i32.checked-add-u) (func $i32.checked-mul-u) (func $option.ok-or))
  (type $Cell (struct (field $n (mut i32))))
  (tag $Problem (param i32))
  (func $choose (param $flag i32) (param $n i32) (result (@inst $option i32)) (@effect pure)
    (if (result (@inst $option i32)) $flag
      (then (@option.some $n)) (else (@option.none))))
  (func $branch (export "branch") (param $flag i32) (param $n i32) (result i32) (@effect pure)
    (@let $v (call $choose $flag $n)
      (+ (@match $v (@case none () 0) (@case some ($x) $x))
         (@match $v (@case none () 1) (@case some ($x) (+ $x 1))))))
  (func $layout (export "layout") (param $count i32) (param $width i32) (param $header i32)
    (result i32) (@effect pure)
    (@match (call $i32.checked-mul-u $count $width)
      (@case none () -1)
      (@case some ($n)
        (@match (call $i32.checked-add-u $n $header)
          (@case none () -1) (@case some ($total) $total)))))
  (func $converted (export "converted") (param $flag i32) (param $n i32) (result i32) (@effect pure)
    (@match (call (@inst $option.ok-or i32 i32) (call $choose $flag $n) -7)
      (@case ok ($x) $x) (@case err ($e) $e)))
  (func $identity (export "identity") (result i32) (@effect allocates reads writes)
    (@let (($cell (struct.new $Cell 41))
           ($pair (@tuple.new (ref $Cell) (ref $Cell) $cell $cell)))
      (block (result i32)
        (@match $pair (@case pair ($a $b) (struct.set $Cell $n $a 42)))
        (@match $pair (@case pair ($a $b) (+ (ref.eq $a $b) (struct.get $Cell $n $b)))))))
  ;; Unit and nullable references retain their distinct discriminants.
  (func $unit (export "unit") (param $flag i32) (result i32) (@effect pure)
    (@match (if (result (@option $unit)) $flag (then (@option.some)) (else (@option.none)))
      (@case none () 10) (@case some () 20)))
  (func $null (export "null") (param $flag i32) (result i32) (@effect pure)
    (@match (if (result (@option (ref null $Cell))) $flag
      (then (@option.some (ref.null $Cell))) (else (@option.none)))
      (@case none () 10) (@case some ($value) (+ 20 (ref.is_null $value)))))
  (func $ignored (export "ignored") (param $denominator i32) (result i32) (@effect pure)
    (@match (@tuple.new i32 i32 1 (i32.div_s 1 $denominator)) (@default 42)))
  (func $caught (export "caught") (param $flag i32) (result i32) (@effect pure)
    (@try (result i32)
      (do (@let $v (@result.ok i32 i32 (if (result i32) $flag
        (then (throw $Problem 7)) (else 42)))
        (@match $v (@case ok ($n) $n) (@case err ($e) $e))))
      (catch $Problem ($code) (- 0 $code))))
  ;; The consumer's throw must remain outside the producer's handler.
  (func $handler (export "handler") (result i32) (@effect pure)
    (@try (result i32)
      (do (@let $v (@try (result (@option i32))
        (do (@option.some 42)) (catch $Problem ($code) (@option.none)))
        (@match $v (@case none () 0) (@case some ($n) (throw $Problem 7)))))
      (catch $Problem ($code) $code)))
  (func $escaped (export "escaped") (param $n i32) (result (@inst $result i32 i32)) (@effect pure)
    (@result.ok $n))
  (func $main (export "main") (result i32) (@effect pure)
    (call $layout 10 4 2)))
