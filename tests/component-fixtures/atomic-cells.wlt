(module
  (%race-free)
  (import "env" "memory" (memory $shared 1 1 shared))
  (%atomic.cell $counter $shared i32 0)
  (%atomic.cell $ready $shared i32 4)
  (%atomic.cell $wide $shared i64 8)
  (func $add (export "add") (param $n i32) (result i32)
    (%effect reads writes synchronizes)
    (i32.atomic.rmw.add (%atomic.at $counter) $n))
  (func $load (export "load") (result i32) (%effect reads synchronizes)
    (i32.atomic.load (%atomic.at $counter)))
  (func $store (export "store") (param $n i32) (%effect writes synchronizes)
    (i32.atomic.store (%atomic.at $counter) $n))
  (func $add64 (export "add64") (param $n i64) (result i64)
    (%effect reads writes synchronizes)
    (i64.atomic.rmw.add (%atomic.at $wide) $n))
  (func $wait (export "wait") (param $timeout i64) (result i32)
    (%effect reads synchronizes blocks)
    (memory.atomic.wait32 (%atomic.at $ready) 0 $timeout))
  (func $notify (export "notify") (param $n i32) (result i32)
    (%effect synchronizes) (memory.atomic.notify (%atomic.at $ready) $n))
  (func $fence (export "fence") (%effect synchronizes) (atomic.fence)))
