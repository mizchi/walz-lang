(module
  (%use "wlt:core" (type $list) (type $future) (type $stream))
  (import "wlt:host/event-loop@0.1.0" "yield" (func $yield))
  (func $pack (param $xs (%inst $list i32)) (result v128) (%effect pure)
    (i32x4.replace_lane 3
      (i32x4.replace_lane 2
        (i32x4.replace_lane 1
          (i32x4.replace_lane 0 (v128.const i32x4 0 0 0 0) (%list.get i32 (local.get $xs) (i32.const 0)))
          (%list.get i32 (local.get $xs) (i32.const 1)))
        (%list.get i32 (local.get $xs) (i32.const 2)))
      (%list.get i32 (local.get $xs) (i32.const 3))))
  (func $add (export "add") (param $a i32) (param $b i32) (result i32) (%effect pure)
    (i32x4.extract_lane 3 (i32x4.add (i32x4.splat (local.get $a)) (i32x4.splat (local.get $b)))))
  (func $dot (export "dot") (param $a (%inst $list i32)) (param $b (%inst $list i32)) (result i32) (%effect pure)
    (%let $p (i32x4.mul (call $pack (local.get $a)) (call $pack (local.get $b)))
      (i32.add (i32.add (i32x4.extract_lane 0 (local.get $p)) (i32x4.extract_lane 1 (local.get $p)))
        (i32.add (i32x4.extract_lane 2 (local.get $p)) (i32x4.extract_lane 3 (local.get $p))))))
  (func $shuffle (export "shuffle") (param $a (%inst $list i32)) (param $b (%inst $list i32)) (result (%inst $list i32)) (%effect pure)
    (%let $v (i8x16.shuffle 16 17 18 19 0 1 2 3 20 21 22 23 4 5 6 7 (call $pack (local.get $a)) (call $pack (local.get $b)))
      (%list.new i32 (i32x4.extract_lane 0 (local.get $v)) (i32x4.extract_lane 1 (local.get $v))
        (i32x4.extract_lane 2 (local.get $v)) (i32x4.extract_lane 3 (local.get $v)))))
  (func $suspended (export "suspended") (param $a i32) (result i32) (%effect host suspends)
    (%let $v (i32x4.splat (local.get $a))
      (block (result i32)
        (call $yield)
        (i32x4.extract_lane 2 (local.get $v)))))
  (func $ready (export "ready") (result i32) (%effect suspends)
    (%let (($pending (%future.ready v128 (v128.const i32x4 42 0 0 0)))
           ($v (%future.await v128 (%move $pending)))
           ($stream (%stream.cons v128 (local.get $v) (%stream.empty v128))))
      (%let ($rest $item) (%stream.next v128 (%move $stream))
        (block (result i32)
          (%stream.close v128 (%move $rest))
          (%match (local.get $item)
            (case none () (i32.const -1))
            (case some ($value) (i32x4.extract_lane 0 (local.get $value)))))))))
