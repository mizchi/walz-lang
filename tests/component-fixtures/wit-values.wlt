(module
  (%use "wlt:core" (type $string) (type $list))
  (type $Bool (%newtype i32)) (%abi.type $Bool (bool))
  (type $Char (%newtype i32)) (%abi.type $Char (char))
  (type $S8 (%newtype i32)) (%abi.type $S8 (s8))
  (type $S16 (%newtype i32)) (%abi.type $S16 (s16))
  (type $Triple (struct (field $a $Bool) (field $b $S8) (field $c $Char)))
  (%abi.type $Triple (tuple))
  (type $Value (%variant (empty) (text $string) (number f64) (items (%inst $list i32))))
  (%abi.type $Value (variant "empty" "text" "number" "items"))
  (func $boolean (export "boolean") (param $v $Bool) (result $Bool) (%effect pure) $v)
  (func $char (export "character") (param $v $Char) (result $Char) (%effect pure) $v)
  (func $s8 (export "signed8") (param $v $S8) (result $S8) (%effect pure) $v)
  (func $s16 (export "signed16") (param $v $S16) (result $S16) (%effect pure) $v)
  (func $triple (export "triple") (param $v (ref $Triple)) (result (ref $Triple)) (%effect pure) $v)
  (func $value (export "value") (param $v (ref $Value)) (result (ref $Value)) (%effect pure) $v)
  (func $values (export "values") (param $v (%inst $list (ref $Value))) (result (%inst $list (ref $Value))) (%effect pure) $v))
