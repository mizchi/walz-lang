  (func $view-i64-le (export "view-i64-le")
    (param $b $bytes) (param $start i32) (param $n i32) (param $p i32)
    (result i64) (@effect allocates)
    (call $bytes-view.read-i64-le
      (call $bytes-view.slice (call $bytes-view.new $b) $start $n) $p))
  (func $write-i64-le (export "write-i64-le")
    (param $b $bytes) (param $p i32) (param $value i64) (result $bytes)
    (@effect reads writes allocates)
    (@let $a (array.new $Storage 0 (@bytes.len $b))
      (block (result $bytes)
        (@bytes.copy-to-array $Storage $a 0 $b 0 (@bytes.len $b))
        (@array.write-i64-le $Storage $a $p $value)
        (@let $snapshot (@bytes.from-array $Storage $a)
          (block (result $bytes) (array.set $Storage $a 0 0) $snapshot)))))
  (func $read-i64-be (export "read-i64-be")
    (param $b $bytes) (param $p i32) (result i64) (@effect pure)
    (call $bytes.read-i64-be $b $p))
  (func $view-i64-be (export "view-i64-be")
    (param $b $bytes) (param $start i32) (param $n i32) (param $p i32)
    (result i64) (@effect allocates)
    (call $bytes-view.read-i64-be
      (call $bytes-view.slice (call $bytes-view.new $b) $start $n) $p))
  (func $write-i64-be (export "write-i64-be")
    (param $b $bytes) (param $p i32) (param $value i64) (result $bytes)
    (@effect reads writes allocates)
    (@let $a (array.new $Storage 0 (@bytes.len $b))
      (block (result $bytes)
        (@bytes.copy-to-array $Storage $a 0 $b 0 (@bytes.len $b))
        (@array.write-i64-be $Storage $a $p $value)
        (@let $snapshot (@bytes.from-array $Storage $a)
          (block (result $bytes) (array.set $Storage $a 0 0) $snapshot)))))
  (func $read-f32-le (export "read-f32-le")
    (param $b $bytes) (param $p i32) (result f32) (@effect pure)
    (call $bytes.read-f32-le $b $p))
  (func $view-f32-le (export "view-f32-le")
    (param $b $bytes) (param $start i32) (param $n i32) (param $p i32)
    (result f32) (@effect allocates)
    (call $bytes-view.read-f32-le
      (call $bytes-view.slice (call $bytes-view.new $b) $start $n) $p))
  (func $write-f32-le (export "write-f32-le")
    (param $b $bytes) (param $p i32) (param $value f32) (result $bytes)
    (@effect reads writes allocates)
    (@let $a (array.new $Storage 0 (@bytes.len $b))
      (block (result $bytes)
        (@bytes.copy-to-array $Storage $a 0 $b 0 (@bytes.len $b))
        (@array.write-f32-le $Storage $a $p $value)
        (@let $snapshot (@bytes.from-array $Storage $a)
          (block (result $bytes) (array.set $Storage $a 0 0) $snapshot)))))
  (func $read-f32-be (export "read-f32-be")
    (param $b $bytes) (param $p i32) (result f32) (@effect pure)
    (call $bytes.read-f32-be $b $p))
  (func $view-f32-be (export "view-f32-be")
    (param $b $bytes) (param $start i32) (param $n i32) (param $p i32)
    (result f32) (@effect allocates)
    (call $bytes-view.read-f32-be
      (call $bytes-view.slice (call $bytes-view.new $b) $start $n) $p))
  (func $write-f32-be (export "write-f32-be")
    (param $b $bytes) (param $p i32) (param $value f32) (result $bytes)
    (@effect reads writes allocates)
    (@let $a (array.new $Storage 0 (@bytes.len $b))
      (block (result $bytes)
        (@bytes.copy-to-array $Storage $a 0 $b 0 (@bytes.len $b))
        (@array.write-f32-be $Storage $a $p $value)
        (@let $snapshot (@bytes.from-array $Storage $a)
          (block (result $bytes) (array.set $Storage $a 0 0) $snapshot)))))
  (func $read-f64-le (export "read-f64-le")
    (param $b $bytes) (param $p i32) (result f64) (@effect pure)
    (call $bytes.read-f64-le $b $p))
  (func $view-f64-le (export "view-f64-le")
    (param $b $bytes) (param $start i32) (param $n i32) (param $p i32)
