  (func $view-u16-be (export "view-u16-be")
    (param $b $bytes) (param $start i32) (param $n i32) (param $p i32)
    (result i32) (@effect allocates)
    (call $bytes-view.read-u16-be
      (call $bytes-view.slice (call $bytes-view.new $b) $start $n) $p))
  (func $read-i32-le (export "read-i32-le")
    (param $b $bytes) (param $p i32) (result i32) (@effect pure)
    (call $bytes.read-i32-le $b $p))
  (func $view-i32-le (export "view-i32-le")
    (param $b $bytes) (param $start i32) (param $n i32) (param $p i32)
    (result i32) (@effect allocates)
    (call $bytes-view.read-i32-le
      (call $bytes-view.slice (call $bytes-view.new $b) $start $n) $p))
  (func $write-i32-le (export "write-i32-le")
    (param $b $bytes) (param $p i32) (param $value i32) (result $bytes)
    (@effect reads writes allocates)
    (@let $a (array.new $Storage 0 (@bytes.len $b))
      (block (result $bytes)
        (@bytes.copy-to-array $Storage $a 0 $b 0 (@bytes.len $b))
        (@array.write-i32-le $Storage $a $p $value)
        (@let $snapshot (@bytes.from-array $Storage $a)
          (block (result $bytes) (array.set $Storage $a 0 0) $snapshot)))))
  (func $read-i32-be (export "read-i32-be")
    (param $b $bytes) (param $p i32) (result i32) (@effect pure)
    (call $bytes.read-i32-be $b $p))
  (func $view-i32-be (export "view-i32-be")
    (param $b $bytes) (param $start i32) (param $n i32) (param $p i32)
    (result i32) (@effect allocates)
    (call $bytes-view.read-i32-be
      (call $bytes-view.slice (call $bytes-view.new $b) $start $n) $p))
  (func $write-i32-be (export "write-i32-be")
    (param $b $bytes) (param $p i32) (param $value i32) (result $bytes)
    (@effect reads writes allocates)
    (@let $a (array.new $Storage 0 (@bytes.len $b))
      (block (result $bytes)
        (@bytes.copy-to-array $Storage $a 0 $b 0 (@bytes.len $b))
        (@array.write-i32-be $Storage $a $p $value)
        (@let $snapshot (@bytes.from-array $Storage $a)
          (block (result $bytes) (array.set $Storage $a 0 0) $snapshot)))))
  (func $read-i64-le (export "read-i64-le")
    (param $b $bytes) (param $p i32) (result i64) (@effect pure)
