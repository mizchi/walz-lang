  (func $write-f64-le (export "write-f64-le")
    (param $b $bytes) (param $p i32) (param $value f64) (result $bytes)
    (@effect reads writes allocates)
    (@let $a (array.new $Storage 0 (@bytes.len $b))
      (block (result $bytes)
        (@bytes.copy-to-array $Storage $a 0 $b 0 (@bytes.len $b))
        (@array.write-f64-le $Storage $a $p $value)
        (@let $snapshot (@bytes.from-array $Storage $a)
          (block (result $bytes) (array.set $Storage $a 0 0) $snapshot)))))
  (func $read-f64-be (export "read-f64-be")
    (param $b $bytes) (param $p i32) (result f64) (@effect pure)
    (call $bytes.read-f64-be $b $p))
  (func $view-f64-be (export "view-f64-be")
    (param $b $bytes) (param $start i32) (param $n i32) (param $p i32)
    (result f64) (@effect allocates)
    (call $bytes-view.read-f64-be
      (call $bytes-view.slice (call $bytes-view.new $b) $start $n) $p))
  (func $write-f64-be (export "write-f64-be")
    (param $b $bytes) (param $p i32) (param $value f64) (result $bytes)
    (@effect reads writes allocates)
    (@let $a (array.new $Storage 0 (@bytes.len $b))
      (block (result $bytes)
        (@bytes.copy-to-array $Storage $a 0 $b 0 (@bytes.len $b))
        (@array.write-f64-be $Storage $a $p $value)
        (@let $snapshot (@bytes.from-array $Storage $a)
          (block (result $bytes) (array.set $Storage $a 0 0) $snapshot)))))
  (func $mark (param $t (ref $Trace)) (param $digit i32) (param $v i32) (result i32)
    (@effect reads writes)
    (block (result i32) (array.set $Trace $t 0 (+ (* (array.get $Trace $t 0) 10) $digit)) $v))
  (func $order (export "order") (result i32) (@effect reads writes allocates)
    (@let (($trace (array.new $Trace 0 1)) ($a (array.new $Storage 0 4)))
      (block (result i32)
        (@array.write-i32-le $Storage
          (block (result (ref $Storage)) (drop (call $mark $trace 1 0)) $a)
          (call $mark $trace 2 0) (call $mark $trace 3 42))
        (drop (@bytes.read-i32-be
          (block (result $bytes) (drop (call $mark $trace 4 0)) (@bytes.from-array $Storage $a))
          (call $mark $trace 5 0)))
        (array.get $Trace $trace 0))))
)
