(module
  (@use "walz:core"
    (type $bytes)
    (func $bytes-view.new)
    (func $bytes-view.slice)
    (func $bytes.read-i16-le)
    (func $bytes.read-i16-be)
    (func $bytes.read-u16-le)
    (func $bytes.read-u16-be)
    (func $bytes.read-i32-le)
    (func $bytes.read-i32-be)
    (func $bytes.read-i64-le)
    (func $bytes.read-i64-be)
    (func $bytes.read-f32-le)
    (func $bytes.read-f32-be)
    (func $bytes.read-f64-le)
    (func $bytes.read-f64-be)
    (func $bytes-view.read-i16-le)
    (func $bytes-view.read-i16-be)
    (func $bytes-view.read-u16-le)
    (func $bytes-view.read-u16-be)
    (func $bytes-view.read-i32-le)
    (func $bytes-view.read-i32-be)
    (func $bytes-view.read-i64-le)
    (func $bytes-view.read-i64-be)
    (func $bytes-view.read-f32-le)
    (func $bytes-view.read-f32-be)
    (func $bytes-view.read-f64-le)
    (func $bytes-view.read-f64-be))
  (type $Storage (array (mut i8)))
  (type $Trace (array (mut i32)))
  (func $read-i16-le (export "read-i16-le")
    (param $b $bytes) (param $p i32) (result i32) (@effect pure)
    (call $bytes.read-i16-le $b $p))
  (func $view-i16-le (export "view-i16-le")
    (param $b $bytes) (param $start i32) (param $n i32) (param $p i32)
    (result i32) (@effect allocates)
    (call $bytes-view.read-i16-le
      (call $bytes-view.slice (call $bytes-view.new $b) $start $n) $p))
  (func $write-i16-le (export "write-i16-le")
    (param $b $bytes) (param $p i32) (param $value i32) (result $bytes)
    (@effect reads writes allocates)
    (@let $a (array.new $Storage 0 (@bytes.len $b))
      (block (result $bytes)
        (@bytes.copy-to-array $Storage $a 0 $b 0 (@bytes.len $b))
        (@array.write-i16-le $Storage $a $p $value)
        (@let $snapshot (@bytes.from-array $Storage $a)
          (block (result $bytes) (array.set $Storage $a 0 0) $snapshot)))))
  (func $read-i16-be (export "read-i16-be")
    (param $b $bytes) (param $p i32) (result i32) (@effect pure)
    (call $bytes.read-i16-be $b $p))
  (func $view-i16-be (export "view-i16-be")
    (param $b $bytes) (param $start i32) (param $n i32) (param $p i32)
    (result i32) (@effect allocates)
    (call $bytes-view.read-i16-be
      (call $bytes-view.slice (call $bytes-view.new $b) $start $n) $p))
  (func $write-i16-be (export "write-i16-be")
    (param $b $bytes) (param $p i32) (param $value i32) (result $bytes)
    (@effect reads writes allocates)
    (@let $a (array.new $Storage 0 (@bytes.len $b))
      (block (result $bytes)
        (@bytes.copy-to-array $Storage $a 0 $b 0 (@bytes.len $b))
        (@array.write-i16-be $Storage $a $p $value)
        (@let $snapshot (@bytes.from-array $Storage $a)
          (block (result $bytes) (array.set $Storage $a 0 0) $snapshot)))))
