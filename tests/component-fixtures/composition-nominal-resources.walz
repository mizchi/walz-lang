(component
  (@world "example:nominal-resources@0.1.0" "app")
  (import "test:resources/host" (instance $host
    (export "file" (type $File (sub resource)))
    (export "make" (func (result (own $File))))
    (export "read" (func (param "f" (borrow $File)) (result s32)))))
  (@lib (type $Item (struct (field $value i32))) (@abi.type $Item (record "value")))
  (component $Files (@type.params $T) (@where (shared $T))
    (import "test:resources/host" (instance $files
      (export "file" (type $File (sub resource)))
      (export "make" (func (result (own $File))))
      (export "read" (func (param "f" (borrow $File)) (result s32)))))
    (@lib
      (@use "walz:core" (type $borrow))
      (tag $Stop)
      (type $File (@resource "test:resources/host/file" $drop))
      (import "test:resources/host" "make" (func $new (result (@resource $File))))
      (import "test:resources/host" "read" (func $read (param $f $borrow<$File>) (result i32)))
      (import "test:resources/host" "[resource-drop]file" (func $drop (param $f i32)))
      (func $make (result (@resource $File)) (@effect host writes allocates) (call $new))
      (func $borrow (param $f $borrow<$File>) (result i32) (@effect host reads) (call $read $f))
      (func $close (param $f (@resource $File)) (@effect host writes) (@resource.close (@move $f)))
      (func $echo (param $value $T) (result $T) (@effect pure) $value)
      (func $handled (result i32) (@effect host writes allocates)
        (@try (result i32)
          (do (@using $f (call $new) (block (result i32) (throw $Stop) 0)))
          (catch $Stop () 42))))
    (@bind "test:resources/host" (instance $files))
    (@expose "make" $make) (@expose "read" $borrow) (@expose "close" $close)
    (@expose "echo" $echo) (@expose "handled" $handled))
  (instance $left (instantiate $Files<(ref $Item)> (with "test:resources/host" (instance $host))))
  (instance $right (instantiate $Files<(ref $Item)> (with "test:resources/host" (instance $host))))
  (export "left" (instance $left)) (export "right" (instance $right)))
