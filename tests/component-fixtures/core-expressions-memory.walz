(module
  (@use "walz:core"
    (type $bytes)
    (type $result)
    (type $box)
    (type $list)
    (type $future)
    (type $stream)
    (type $option)
    (type $tuple))
  (type $Id (@newtype i64))
  (tag $Failure)
  (func $step
    (param $data $bytes)
    (param $fail i32)
    (result (@inst $result $bytes i32))
    (@effect pure)
    (if
      (result (@inst $result $bytes i32))
      (local.get $fail)
      (then (@result.err $bytes i32 (local.get $fail)))
      (else (@result.ok $bytes i32 (local.get $data))))
  )

  (func $chain
    (export "chain")
    (param $data $bytes)
    (param $fail i32)
    (result (@inst $result $bytes i32))
    (@effect pure)
    (@result.do
      ($a (call $step (local.get $data) (i32.eq (local.get $fail) (i32.const 1))))
      ($b (call $step (local.get $a) (i32.eq (local.get $fail) (i32.const 2))))
      (@result.ok $bytes i32 (local.get $b))))

  (func $early
    (export "early")
    (param $data $bytes)
    (result $bytes)
    (@effect pure)
    (return (local.get $data)))

  (func $branch
    (export "branch")
    (param $data $bytes)
    (param $take i32)
    (result $bytes)
    (@effect pure)
    (block $done
      (result $bytes)
      (drop (br_if $done (local.get $data) (local.get $take)))
      (local.get $data)))

  (func $fail
    (param $flag i32)
    (@effect (throws $Failure))
    (if (local.get $flag) (then (throw $Failure)) (else (nop))))

  (func $owned
    (export "owned")
    (param $data $bytes)
    (param $flag i32)
    (result $bytes)
    (@effect pure)
    (@let $owner (@box.new $bytes (local.get $data))
      (@try
        (result $bytes)
        (do
          (block
            (result $bytes)
            (call $fail (local.get $flag))
            (@match (@move $owner)
              (@case own ($value) (return (local.get $value))))
          ))
        (catch $Failure
          ()
          (@match (@move $owner)
            (@case own ($value) (return (local.get $value))))
        ))))

  (func $ids
    (export "ids")
    (param $data (@inst $list $Id))
    (result (@inst $list $Id))
    (@effect pure)
    (return (local.get $data)))

  (func $ints
    (export "ints")
    (param $data (@inst $list i64))
    (result (@inst $list i64))
    (@effect pure)
    (local.get $data))

  (func $ready
    (export "ready")
    (param $data (@inst $list $Id))
    (result (@inst $future (@inst $list $Id)))
    (@effect pure)
    (@future.ready (@inst $list $Id) (local.get $data)))

  (func $await
    (export "await")
    (param $f (@inst $future (@inst $list $Id)))
    (result (@inst $list $Id))
    (@effect suspends)
    (@future.await (@inst $list $Id) (@move $f)))

  (func $stream
    (export "stream")
    (param $data (@inst $list $Id))
    (result (@inst $stream (@inst $list $Id)))
    (@effect pure)
    (@stream.cons (@inst $list $Id) (local.get $data) (@stream.empty (@inst $list $Id))))

  (func $first
    (export "first")
    (param $s (@inst $stream (@inst $list $Id)))
    (result (@inst $option (@inst $list $Id)))
    (@effect suspends)
    (@match (@stream.next (@inst $list $Id) (@move $s))
      (@case pair ($next $item)
        (block
          (result (@inst $option (@inst $list $Id)))
          (@stream.close (@inst $list $Id) (@move $next))
          (local.get $item))))
  )

  (func $sqrt
    (export "sqrt")
    (param $n f64)
    (result i32)
    (@effect pure)
    (i32.trunc_sat_f64_s (f64.sqrt (local.get $n))))

  (func $trap (export "trap") (param $data $bytes) (@effect pure) (unreachable)))
