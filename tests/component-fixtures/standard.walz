(module
  (@use "walz:core"
    (type $future) (type $result) (type $option) (type $string)
    (func $string.u64 $format))
  (import "walz:host/event-loop@0.1.0" "defer-i64"
    (func $defer (param $ms i32) (param $value i64)
      (result (@inst $future i64))))

  (func $main (export "main") (param $n i64)
    (result (@inst $result $string i32))
    (@effect reads writes allocates host suspends)
    (@let (($pending (call $defer (i32.const 0) (local.get $n)))
           ($value (@future.await i64 (@move $pending)))
           ($label (call $format (local.get $value))))
      (@result.ok (local.get $label))))

  (func $optional (export "optional") (param $present i32)
    (result (@inst $option $string)) (@effect pure)
    (if (result (@inst $option $string)) (local.get $present)
      (then (@option.some (@string.lit "present")))
      (else (@option.none))))

  (func $future (export "future")
    (result (@inst $future (@inst $result $string i32))) (@effect pure)
    (@future.ready (@inst $result $string i32)
      (@result.ok (@string.lit "ready")))))
