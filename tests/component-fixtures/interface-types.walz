(module
  (@use "walz:core" (type $string) (type $list))
  (type $Count (@newtype i32))
  (@abi.type $Count (u32))
  (type $Wide (@newtype i64))
  (@abi.type $Wide (u64))
  (type $Access (@newtype i32))
  (@abi.type $Access (flags "read" "write"))
  (type $Color (@variant (red) (green) (blue)))
  (@abi.type $Color (enum "red" "green" "blue"))
  (type $Item (struct (field $name $string) (field $count $Count) (field $color (ref $Color))))
  (@abi.type $Item (record "name" "count" "color"))
  (func $item (export "item") (param $v (ref $Item)) (result (ref $Item)) (@effect pure) $v)
  (func $count (export "count") (param $v $Count) (result $Count) (@effect pure) $v)
  (func $wide (export "wide") (param $v $Wide) (result $Wide) (@effect pure) $v)
  (func $access (export "access") (param $v $Access) (result $Access) (@effect pure) $v)
  (func $items (export "items") (param $v (@inst $list (ref $Item))) (result (@inst $list (ref $Item))) (@effect pure) $v))
