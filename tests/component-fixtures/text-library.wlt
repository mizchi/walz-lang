(module
  (include "../../stdlib/text.wlt")
  (func $join
    (export "join")
    (param $a text)
    (param $b text)
    (result text)
    (effects reads writes allocates)
    (call $string.concat (local.get $a) (local.get $b))
  )
  (func $quote
    (export "quote")
    (param $a text)
    (result text)
    (effects reads writes allocates)
    (call $string.json (local.get $a))
  )
  (func $unsigned
    (export "unsigned")
    (param $a i64)
    (result text)
    (effects reads writes allocates)
    (call $string.u64 (local.get $a))
  )
  (func $signed
    (export "signed")
    (param $a i64)
    (result text)
    (effects reads writes allocates)
    (call $string.s64 (local.get $a))
  )
)
