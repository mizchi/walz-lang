(module
  (@use "walz:core" (type $option)
    (func $i32.checked-add-u) (func $i32.checked-mul-u) (func $i32.checked-align-up-u)
    (func $i64.checked-add-u) (func $i64.checked-mul-u) (func $i64.checked-align-up-u))
  (type $Counter (array (mut i32)))
  (func $add32 (export "add32") (param $a i32) (param $b i32)
    (result (@inst $option i32)) (@effect pure) (call $i32.checked-add-u $a $b))
  (func $mul32 (export "mul32") (param $a i32) (param $b i32)
    (result (@inst $option i32)) (@effect pure) (call $i32.checked-mul-u $a $b))
  (func $align32 (export "align32") (param $a i32) (param $alignment i32)
    (result (@inst $option i32)) (@effect pure) (call $i32.checked-align-up-u $a $alignment))
  (func $add64 (export "add64") (param $a i64) (param $b i64)
    (result (@inst $option i64)) (@effect pure) (call $i64.checked-add-u $a $b))
  (func $mul64 (export "mul64") (param $a i64) (param $b i64)
    (result (@inst $option i64)) (@effect pure) (call $i64.checked-mul-u $a $b))
  (func $align64 (export "align64") (param $a i64) (param $alignment i64)
    (result (@inst $option i64)) (@effect pure) (call $i64.checked-align-up-u $a $alignment))
  (func $mark (param $counter (ref $Counter)) (param $digit i32) (param $value i32)
    (result i32) (@effect reads writes)
    (block (result i32)
      (array.set $Counter $counter 0 (+ (* (array.get $Counter $counter 0) 10) $digit)) $value))
  (func $order (export "order") (result i32) (@effect reads writes allocates)
    (@let $counter (array.new $Counter 0 1)
      (block (result i32)
        (drop (call $i32.checked-add-u (call $mark $counter 1 -1) (call $mark $counter 2 1)))
        (drop (call $i64.checked-mul-u (i64.extend_i32_u (call $mark $counter 3 0))
          (i64.extend_i32_u (call $mark $counter 4 -1))))
        (drop (call $i32.checked-align-up-u (call $mark $counter 5 1) (call $mark $counter 6 0)))
        (array.get $Counter $counter 0)))))
