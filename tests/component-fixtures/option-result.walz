(module
  (@use "walz:core" (type $string) (type $option) (type $result) (type $tuple) (type $list)
    (func $option.ok-or) (func $result.map-err))
  (type $Counter (struct (field $n (mut i32))))
  (func $error (param $c (ref $Counter)) (result i32) (@effect reads writes)
    (block (result i32) (struct.set $Counter $n $c (+ (struct.get $Counter $n $c) 1)) 7))
  (@closure $Map (@capture $c (ref $Counter)) (@capture $offset i32)
    (param $code i32) (result i32) (@effect reads writes)
    (block (result i32) (drop (call $error $c)) (+ $code $offset)))
  (func $supply (export "supply") (param $v (@inst $option $string))
    (result (@inst $tuple (@inst $result $string i32) i32)) (@effect reads writes allocates)
    (@let (($c (@$Counter::{:n 0}))
           ($answer (call (@inst $option.ok-or $string i32) $v (call $error $c))))
      (@tuple.new $answer (struct.get $Counter $n $c))))
  (func $mapped (export "mapped") (param $v (@inst $result i64 i32)) (param $offset i32)
    (result (@inst $tuple (@inst $result i64 i32) i32)) (@effect reads writes allocates)
    (@let (($c (@$Counter::{:n 0}))
           ($answer (call (@inst $result.map-err i64 i32 i32 $Map) $v (@closure.new $Map $c $offset))))
      (@tuple.new $answer (struct.get $Counter $n $c))))
  (func $literal (export "literal") (result (@inst $list $string)) (@effect pure)
    (@list.new $string "日本😀" "" "quote\""))
  (func $identity (export "identity") (result i32) (@effect reads writes allocates)
    (@let (($c (@$Counter::{:n 0}))
           ($value (@result.ok (ref $Counter) i32 $c))
           ($mapped (call (@inst $result.map-err (ref $Counter) i32 i32 $Map) $value (@closure.new $Map $c 1))))
      (@match $mapped
        (@case ok ($same) (ref.eq $c $same)) (@case err ($error) 0)))))
