(module
  (@use "walz:core" (type $list) (type $tuple))
  (type $State (struct (field $sum (mut i64)) (field $count (mut i32)) (field $sources (mut i32))))
  (type $S (struct (field $x (mut i32)) (field $y i32)))
  (tag $Stop)
  (func $source (param $s (ref $State)) (param $xs (@inst $list (@inst $tuple i64 i32)))
    (result (@inst $list (@inst $tuple i64 i32)))
    (block (result (@inst $list (@inst $tuple i64 i32)))
      (@struct.update $State $s ($sources $old (+ $old 1))) $xs))
  (func $sum (export "sum") (param $xs (@inst $list (@inst $tuple i64 i32)))
    (result (@inst $list i64)) (@effect reads writes allocates)
    (@let $s (@$State::{:sum 0 :count 0 :sources 0})
      (block (result (@inst $list i64))
        (@for-each ($amount $weight) (call $source $s $xs)
          (block
            (@struct.update $State $s ($sum $old (+ $old $amount)))
            (@struct.update $State $s ($count $old (+ $old $weight)))))
        (@let {:sources $sources :sum $sum :count $count} $s
          (@list.new i64 $sum (i64.extend_i32_s $count) (i64.extend_i32_s $sources))))))
  (func $main (export "main") (result i32) (@effect reads writes allocates)
    (@let $answer (call $sum (@list.new (@inst $tuple i64 i32)
      (@tuple.new i64 i32 10 1) (@tuple.new i64 i32 30 1)))
      (+ (i32.wrap_i64 (@list.get i64 $answer 0)) (i32.wrap_i64 (@list.get i64 $answer 1)))))
  (func $target (param $s (ref $S)) (result (ref $S))
    (block (result (ref $S))
      (@struct.update $S $s ($x $old (+ (* $old 10) 1))) $s))
  (func $snapshots (export "snapshots") (result i32) (@effect reads writes allocates)
    (@let $s (@$S::{:x 1 :y 20})
      (@let {:x $a :y $b} (call $target $s)
        (block (result i32)
          (@struct.update $S (call $target $s) ($x $old (+ $old 2)))
          (+ (* $a 100) (+ $b (- (struct.get $S $x $s) 3)))))))
  (func $throw-update (export "throw-update") (result i32) (@effect reads writes allocates)
    (@let $s (@$S::{:x 1 :y 20})
      (@try (result i32)
        (do (block (result i32)
          (@struct.update $S (call $target $s) ($x $old (block (result i32)
            (struct.set $S $x $s 12) (throw $Stop)))) 0))
        (catch $Stop () (struct.get $S $x $s)))))
  (func $nested (export "nested") (result i32) (@effect reads writes allocates)
    (@let $s (@$S::{:x 0 :y 0})
      (block (result i32)
        (@for-each $x (@list.new i32 1 2)
          (@for-each $x (@list.new i32 3 6)
            (@struct.update $S $s ($x $old (+ $old $x)))))
        (struct.get $S $x $s))))
  (func $stop-at (export "stop-at") (param $limit i32) (result i32) (@effect reads writes allocates)
    (@let $s (@$S::{:x 0 :y 0})
      (block $done (result i32)
        (@for-each $x (@list.new i32 1 2 3 4)
          (if (< $x $limit)
            (then (@struct.update $S $s ($x $old (+ $old $x))))
            (else (br $done (struct.get $S $x $s)))))
        (struct.get $S $x $s))))
  (func $struct-patterns (export "struct-patterns") (result i32) (@effect reads writes allocates)
    (@let $s (@$S::{:x 0 :y 0})
      (block (result i32)
        (@for-each {:x $x :y $y} (@list.new (ref $S) (@$S::{:x 10 :y 1}) (@$S::{:x 30 :y 1}))
          (@struct.update $S $s ($x $old (+ $old (+ $x $y)))))
        (struct.get $S $x $s)))))
