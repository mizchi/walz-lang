(module
  (type $Cell (struct (field i64)))
  (import "gcwat:host/event-loop@0.1.0" "sleep" (func $sleep (param $ms i32)))
  (import "gcwat:host/event-loop@0.1.0" "yield" (func $yield))
  (import "gcwat:host/event-loop@0.1.0" "defer-i64" (func $defer (param $ms i32) (param $value i64) (result (future i64))))
  (import "gcwat:host/event-loop@0.1.0" "ticks" (func $ticks (param $count i32) (param $ms i32) (result (stream i64))))
  (import "gcwat:host/event-loop@0.1.0" "fallible-i64" (func $fallible (param $ms i32) (param $code i32) (result (future (result i64 i32)))))

  (func $main (export "main") (param $ms i32) (result i64) (effects allocates host suspends)
    (let $cell (struct.new $Cell (i64.const 40))
      (block (result i64)
        (call $yield)
        (call $sleep (local.get $ms))
        (i64.add (struct.get $Cell 0 (local.get $cell))
          (future.await i64 (call $defer (i32.const 1) (i64.const 2)))))))

  (func $sum (export "sum-ticks") (param $count i32) (param $ms i32) (result i64) (effects host suspends)
    (loop $read (bind $stream (stream i64) (call $ticks (local.get $count) (local.get $ms)))
                (bind $total i64 (i64.const 0)) (result i64)
      (match (pair (stream i64) (option i64)) (result i64) (stream.next i64 (move $stream))
        (case pair ($next $item)
          (match (option i64) (result i64) (local.get $item)
            (case none () (block (result i64) (stream.close i64 (move $next)) (local.get $total)))
            (case some ($n) (recur $read (move $next) (i64.add (local.get $total) (local.get $n)))))))))

  (func $error (export "completion-error") (param $code i32) (result i32) (effects host suspends)
    (match (result i64 i32) (result i32)
      (future.await (result i64 i32) (call $fallible (i32.const 1) (local.get $code)))
      (case ok ($value) (i32.const 0)) (case err ($code) (local.get $code))))

  (func $hold (export "hold") (param $ms i32) (result i64) (effects host suspends)
    (let $f (call $defer (local.get $ms) (i64.const 42))
      (let $s (call $ticks (i32.const 1) (local.get $ms))
        (block (result i64) (call $sleep (local.get $ms))
          (stream.close i64 (move $s)) (future.await i64 (move $f))))))
  (func $pending (export "pending") (param $ms i32) (result (future i64)) (effects host)
    (call $defer (local.get $ms) (i64.const 42)))
  (func $catch (export "catch-all") (param $ms i32) (result i64) (effects host suspends)
    (try (result i64) (do (block (result i64) (call $sleep (local.get $ms)) (i64.const 42)))
      (catch_all (i64.const 99))))

  (func $close (export "close-pending") (param $ms i32) (effects host)
    (future.close i64 (call $defer (local.get $ms) (i64.const 42)))))
