(module
  (%namespace $identity
    (%public (func $bytes) (func $text))
    (func $bytes (param $value %bytes) (result %bytes) (%effects pure) (local.get $value))
    (func $text (param $value %text) (result %text) (%effects pure) (local.get $value)))
  (%use $identity (func $bytes $id-bytes) (func $text $id-text))
  (func $bytes (export "bytes") (param $b %bytes) (result %bytes) (%effects pure)
    (call $id-bytes (local.get $b)))
  (func $text (export "text") (param $t %text) (result %text) (%effects pure)
    (call $id-text (local.get $t)))
  (func $literal (export "literal") (result %text) (%effects pure) (%text.lit "日本語🦀"))
  (func $decode (export "decode") (param $b %bytes) (result (%option %text)) (%effects pure)
    (%text.from-bytes (local.get $b)))
  (func $encode (export "encode") (param $t %text) (result %bytes) (%effects pure)
    (%text.bytes (local.get $t)))
  (func $slice (export "slice") (param $b %bytes) (param $start i32) (param $len i32)
    (result %bytes) (%effects pure) (%bytes.slice (local.get $b) (local.get $start) (local.get $len)))
  (func $get (export "get") (param $b %bytes) (param $i i32) (result i32) (%effects pure)
    (%bytes.get (local.get $b) (local.get $i)))
  (func $len (export "length") (param $t %text) (result i32) (%effects pure)
    (%text.byte-len (local.get $t)))
  (func $new (export "new-bytes") (result %bytes) (%effects pure)
    (%bytes.new (i32.const 0) (i32.const 255) (i32.const 256) (i32.const -1)))
  (func $nested (export "nested") (param $v (%option (%pair %text %bytes)))
    (result (%option (%pair %text %bytes))) (%effects pure) (local.get $v))
  (func $ready (export "ready") (param $t %text) (result (%future %text)) (%effects pure)
    (%future.ready %text (local.get $t)))
  (func $await (export "await") (param $f (%future %text)) (result %text) (%effects suspends)
    (%future.await %text (%move $f)))
  (func $stream (export "stream") (param $b %bytes) (result (%stream %bytes)) (%effects pure)
    (%stream.cons %bytes (local.get $b) (%stream.empty %bytes)))
  (func $first (export "first") (param $s (%stream %bytes)) (result (%option %bytes)) (%effects suspends)
    (%match (%pair (%stream %bytes) (%option %bytes)) (result (%option %bytes)) (%stream.next %bytes (%move $s))
      (case pair ($next $item)
        (block (result (%option %bytes)) (%stream.close %bytes (%move $next)) (local.get $item)))))

  (func $variant (export "variant") (param $v (%option (%result %text %bytes)))
    (result (%option (%result %text %bytes))) (%effects pure) (local.get $v))
  (func $wide (export "wide")
    (param $a0 %text) (param $a1 %text) (param $a2 %text)
    (param $a3 %text) (param $a4 %text) (param $a5 %text)
    (param $a6 %text) (param $a7 %text) (param $a8 %text)
    (result %text) (%effects pure) (local.get $a8))
)
