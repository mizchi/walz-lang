(module
  (@use "walz:core" (type $bytes))
  (type $A (array (mut i8)))
  (type $B (array (mut i8)))
  (type $Wide (array (mut i16)))
  (type $Counter (array (mut i32)))
  (func $snapshot (export "snapshot") (param $bytes $bytes) (param $start i32) (param $n i32)
    (result $bytes) (@effect reads writes allocates)
    (@let $a (array.new $A -1 (@bytes.len $bytes))
      (block (result $bytes)
        (@bytes.copy-to-array $A $a 0 $bytes 0 (@bytes.len $bytes))
        (@let $out (@bytes.from-array $A $a $start $n)
          (block (result $bytes)
            (if (@bytes.len $bytes) (then (array.set $A $a 0 0)) (else (nop)))
            $out)))))
  (func $overlap (export "overlap") (result $bytes) (@effect reads writes allocates)
    (@let $a (array.new_fixed $A 6 0 1 2 3 4 5)
      (block (result $bytes)
        (array.copy $A $A $a 1 $a 0 5)
        (@bytes.from-array $A $a))))
  (func $signed8 (export "signed8") (param $v i32) (result i32) (@effect reads allocates)
    (array.get_s $A (array.new $A $v 1) 0))
  (func $unsigned8 (export "unsigned8") (param $v i32) (result i32) (@effect reads allocates)
    (array.get_u $A (array.new $A $v 1) 0))
  (func $signed16 (export "signed16") (param $v i32) (result i32) (@effect reads allocates)
    (array.get_s $Wide (array.new $Wide $v 1) 0))
  (func $wide-range (export "wide-range") (param $value i32) (result $bytes) (@effect reads allocates)
    (@bytes.from-array $Wide (array.new_fixed $Wide 3 65535 $value 65535) 1 1))
  (func $numeric-range (export "numeric-range") (param $value i32) (result $bytes) (@effect reads allocates)
    (@bytes.from-array $Counter (array.new_fixed $Counter 3 -1 $value -1) 1 1))
  (func $copy (export "copy") (param $at i32) (param $from i32) (param $n i32) (result $bytes)
    (@effect reads writes allocates)
    (@let (($a (array.new $A 9 8)) ($b (array.new_fixed $B 4 1 2 3 4)))
      (block (result $bytes)
        (array.copy $A $B $a $at $b $from $n)
        (@bytes.from-array $A $a))))
  (func $mark (param $a (ref $Counter)) (param $digit i32) (param $value i32) (result i32)
    (@effect reads writes)
    (block (result i32) (array.set $Counter $a 0 (+ (* (array.get $Counter $a 0) 10) $digit)) $value))
  (func $order (export "order") (result i32) (@effect reads writes allocates)
    (@let (($trace (array.new $Counter 0 1)) ($a (array.new $A 0 1)))
      (block (result i32)
        (array.copy $A $A
          (block (result (ref $A)) (drop (call $mark $trace 1 0)) $a)
          (call $mark $trace 2 0)
          (block (result (ref $A)) (drop (call $mark $trace 3 0)) $a)
          (call $mark $trace 4 0) (call $mark $trace 5 1))
        (array.get $Counter $trace 0)))))
