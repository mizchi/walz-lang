(module
  (@use "walz:core"
    (type $bytes)
    (type $future)
    (type $list)
    (type $option)
    (type $tuple)
    (type $result)
    (type $stream)
    (type $string)
    (type $unit))
  (type $Numbers (array (mut i64)))
  (func $identity (export "identity") (param $xs (@inst $list i64)) (result (@inst $list i64)) (@effect pure)
    (local.get $xs))
  (func $texts (export "texts") (param $xs (@inst $list $string)) (result (@inst $list $string)) (@effect pure) (local.get $xs))
  (func $nested (export "nested") (param $xs (@inst $list (@inst $option (@inst $result (@inst $tuple i64 $string) $bytes))))
    (result (@inst $list (@inst $option (@inst $result (@inst $tuple i64 $string) $bytes)))) (@effect pure) (local.get $xs))
  (func $units (export "units") (param $xs (@inst $list $unit)) (result (@inst $list $unit)) (@effect pure) (local.get $xs))
  (func $new-units (export "new-units") (result (@inst $list $unit)) (@effect pure) (@list.new $unit (nop) (nop)))
  (func $unit-get (export "unit-get") (param $xs (@inst $list $unit)) (param $i i32) (@effect pure) (@list.get $unit (local.get $xs) (local.get $i)))
  (func $floats (export "floats") (param $xs (@inst $list f32)) (result (@inst $list f32)) (@effect pure) (local.get $xs))
  (func $doubles (export "doubles") (param $xs (@inst $list f64)) (result (@inst $list f64)) (@effect pure) (local.get $xs))
  (func $matrix (export "matrix") (param $xs (@inst $list (@inst $list i32))) (result (@inst $list (@inst $list i32))) (@effect pure) (local.get $xs))
  (func $literal (export "literal") (result (@inst $list i64)) (@effect pure)
    (@list.new i64 (i64.const 40) (i64.const 2)))
  (func $empty (export "empty") (result (@inst $list $string)) (@effect pure) (@list.new $string))
  (func $length (export "length") (param $xs (@inst $list i64)) (result i32) (@effect pure)
    (@list.len i64 (local.get $xs)))
  (func $get (export "get") (param $xs (@inst $list i64)) (param $i i32) (result i64) (@effect pure)
    (@list.get i64 (local.get $xs) (local.get $i)))
  (func $slice (export "slice") (param $xs (@inst $list i64)) (param $start i32) (param $length i32)
    (result (@inst $list i64)) (@effect pure) (@list.slice i64 (local.get $xs) (local.get $start) (local.get $length)))
  (func $snapshot (export "snapshot") (result (@inst $list i64)) (@effect reads writes allocates)
    (@let $source (array.new_fixed $Numbers 2 (i64.const 40) (i64.const 2))
      (@let $copy (@list.from-array i64 $Numbers (local.get $source))
        (block (result (@inst $list i64)) (array.set $Numbers (local.get $source) (i32.const 0) (i64.const 99)) (local.get $copy)))))
  (func $await (export "await") (param $f (@inst $future (@inst $list $string))) (result (@inst $list $string)) (@effect suspends)
    (@future.await (@inst $list $string) (@move $f)))
  (func $first (export "first") (param $s (@inst $stream (@inst $list $string))) (result (@inst $option (@inst $list $string))) (@effect suspends)
    (@match (@inst $tuple (@inst $stream (@inst $list $string)) (@inst $option (@inst $list $string))) (result (@inst $option (@inst $list $string)))
      (@stream.next (@inst $list $string) (@move $s))
      (@case pair ($next $item)
        (block (result (@inst $option (@inst $list $string))) (@stream.close (@inst $list $string) (@move $next)) (local.get $item)))))
  (func $trap-owned (export "trap-owned") (param $s (@inst $stream (@inst $list $string))) (result i32) (@effect pure)
    (block (result i32)
      (drop (i32.div_s (i32.const 1) (i32.const 0)))
      (@stream.close (@inst $list $string) (@move $s)) (i32.const 0))))
