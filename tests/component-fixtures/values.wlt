(module
  (func $value (export "value") (param $x (option (result i64 f64)))
    (result (option (result i64 f64))) (effects pure) (local.get $x))
  (func $wide (export "wide")
    (param $a0 i32) (param $a1 i32) (param $a2 i32) (param $a3 i32)
    (param $a4 i32) (param $a5 i32) (param $a6 i32) (param $a7 i32)
    (param $a8 i32) (param $a9 i32) (param $a10 i32) (param $a11 i32)
    (param $a12 i32) (param $a13 i32) (param $a14 i32) (param $a15 i32) (param $a16 i32)
    (result (pair i32 f64)) (effects pure)
    (pair.new i32 f64 (i32.add (local.get $a0) (local.get $a16)) (f64.const -1.25)))
  (func $option-stream (export "option-stream") (result (stream (option i64))) (effects pure)
    (stream.cons (option i64) (option.none i64)
      (stream.cons (option i64) (option.some i64 (i64.const 42)) (stream.empty (option i64)))))
  (func $units (export "units") (param $x (pair unit (option unit)))
    (result (pair unit (option unit))) (effects pure) (local.get $x))
  (func $future (export "future") (result (future i64)) (effects pure)
    (future.ready i64 (i64.const 42)))
  (func $stream (export "stream") (result (stream i64)) (effects pure)
    (stream.cons i64 (i64.const 40) (stream.cons i64 (i64.const 2) (stream.empty i64))))
  (func $await (export "await") (param $f (future i64)) (result i64) (effects suspends)
    (future.await i64 (move $f)))
  (func $prepend (export "prepend") (param $s (stream i64)) (result (stream i64)) (effects pure)
    (stream.cons i64 (i64.const 40) (move $s)))
  (func $first (export "first") (param $s (stream i64)) (result (option i64)) (effects suspends)
    (match (pair (stream i64) (option i64)) (result (option i64)) (stream.next i64 (move $s))
      (case pair ($next $item)
        (block (result (option i64)) (stream.close i64 (move $next)) (local.get $item)))))
  (func $close-stream (export "close-stream") (param $s (stream i64)) (effects pure)
    (stream.close i64 (move $s)))
  (func $unit-future (export "unit-future") (result (future unit)) (effects pure) (future.ready unit))
  (func $await-unit (export "await-unit") (param $f (future unit)) (effects suspends)
    (future.await unit (move $f)))
  (func $next-unit (export "next-unit") (param $s (stream unit)) (result (option unit)) (effects suspends)
    (match (pair (stream unit) (option unit)) (result (option unit)) (stream.next unit (move $s))
      (case pair ($next $item)
        (block (result (option unit)) (stream.close unit (move $next)) (local.get $item)))))
  (func $unit-stream (export "unit-stream") (result (stream unit)) (effects pure)
    (stream.cons unit (stream.empty unit))))
