(module
  (@use "walz:core" (type $list))
  (@use "../walz/simd/bitmap.walz" (func $bitmap.empty) (func $bitmap.full)
    (func $bitmap.from-words) (func $bitmap.word) (func $bitmap.count) (func $bitmap.not)
    (func $bitmap.and) (func $bitmap.or) (func $bitmap.xor) (func $bitmap.and-not)
    (func $bitmap.intersection-count))
  (@use "../walz/simd/i32-column.walz" (func $i32-column.from-list)
    (func $i32-column.sum) (func $i32-column.sum-where) (func $i32-column.eq)
    (func $i32-column.between) (func $i32-column.count-eq) (func $i32-column.count-between))
  (@test "empty and full bitmaps preserve the logical tail"
    (&& (= (call $bitmap.count (call $bitmap.empty 129)) 0)
      (&& (= (call $bitmap.count (call $bitmap.full 129)) 129)
        (= (call $bitmap.count (call $bitmap.not (call $bitmap.full 0))) 0))))
  (@test "unused source bits are masked rather than counted"
    (@let $b (call $bitmap.from-words 35 (@list.new i32 -1 -1))
      (&& (= (call $bitmap.word $b 1) 7)
        (&& (= (call $bitmap.count $b) 35) (= (call $bitmap.count (call $bitmap.not $b)) 0)))))
  (@test "boolean set operations operate on all 128 bits per block"
    (@let (($a (call $bitmap.from-words 8 (@list.new i32 85)))
           ($b (call $bitmap.from-words 8 (@list.new i32 60))))
      (&& (&& (= (call $bitmap.word (call $bitmap.and $a $b) 0) 20)
               (= (call $bitmap.word (call $bitmap.or $a $b) 0) 125))
        (&& (&& (= (call $bitmap.word (call $bitmap.xor $a $b) 0) 105)
                 (= (call $bitmap.word (call $bitmap.and-not $a $b) 0) 65))
             (= (call $bitmap.intersection-count $a $b) 2)))))
  (@test "column sums widen before adding signed i32 values"
    (= (call $i32-column.sum (call $i32-column.from-list
      (@list.new i32 2147483647 2147483647 -2147483648 42 -1))) 2147483687))
  (@test "zero padding never becomes an extra matching row"
    (@let $xs (call $i32-column.from-list (@list.new i32 0 1 0 2 0))
      (&& (= (call $bitmap.count (call $i32-column.eq $xs 0)) 3)
          (= (call $i32-column.count-eq $xs 0) 3))))
  (@test "signed half-open ranges have matching fused and materialized counts"
    (@let $xs (call $i32-column.from-list (@list.new i32 -2 -1 0 1 2))
      (&& (= (call $i32-column.count-between $xs -1 2) 3)
        (&& (= (call $bitmap.count (call $i32-column.between $xs -1 2)) 3)
            (= (call $i32-column.count-between $xs 2 -2) 0)))))
  (@test "two columns compose a selection for an exact selected sum"
    (@let (($p (call $i32-column.from-list (@list.new i32 10 20 22 70)))
           ($c (call $i32-column.from-list (@list.new i32 1 2 2 1)))
           ($s (call $bitmap.and (call $i32-column.between $p 10 30) (call $i32-column.eq $c 2))))
      (= (call $i32-column.sum-where $p $s) 42)))
)
