(module
  (@use "walz:core"
    (type $option)
    (type $box)
    (type $unit))
  (@closure $Take (@capture $x (@inst $box i64)) (result i64)
    (@match (@inst $box i64) (result i64) (@move $x)
      (case own ($n) (local.get $n))))

  (@test "owned values transfer through an option"
    (@let $x (@option.some (@inst $box i64) (@box.new i64 (i64.const 42)))
      (@match (@inst $option (@inst $box i64)) (result i32) (@move $x)
        (case none () (i32.const 0))
        (case some ($x)
          (i64.eq (@closure.call $Take (@closure.new $Take (@move $x))) (i64.const 42))))))

  (@test "unused owned data is explicitly closed"
    (@let $x (@box.new $unit)
      (block (result i32) (@box.close (@move $x)) (i32.const 1))))

  (@test "loop carries its owner explicitly"
    (i64.eq
      (@loop $next (bind $x (@inst $box i64) (@box.new i64 (i64.const 42)))
                  (bind $n i32 (i32.const 3)) (result i64)
        (if (result i64) (i32.eqz (local.get $n))
          (then (@match (@inst $box i64) (result i64) (@move $x)
            (case own ($value) (local.get $value))))
          (else (@recur $next (@move $x) (i32.sub (local.get $n) (i32.const 1))))))
      (i64.const 42))))
