(module
  (@use "walz:core" (type $string) (type $list) (type $option))
  (@use "../walz/simd/dictionary-column.walz"
    (func $dictionary-column.from-list) (func $dictionary-column.from-codes)
    (func $dictionary-column.len) (func $dictionary-column.dictionary-len)
    (func $dictionary-column.dictionary) (func $dictionary-column.codes)
    (func $dictionary-column.get) (func $dictionary-column.decode) (func $dictionary-column.find-code)
    (func $dictionary-column.eq) (func $dictionary-column.in)
    (func $dictionary-column.count-eq) (func $dictionary-column.count-many)
    (func $dictionary-column.query-between))
  (@use "../walz/simd/i32-column.walz" (type $i32-query-result) (func $i32-column.from-list)
    (func $i32-column.query-in-between))
  (@use "../walz/simd/bitmap.walz" (func $bitmap.count) (func $bitmap.indices))
  (@test "dictionary IDs follow first occurrence, including code zero"
    (@let (($c (call $dictionary-column.from-list (@list.new $string "JP" "US" "JP" "" "日本" "")))
           ($ids (call $dictionary-column.codes $c)))
      (&& (= (call $dictionary-column.dictionary-len $c) 4)
        (&& (= (@list.get i32 $ids 0) 0)
          (&& (= (@list.get i32 $ids 2) 0)
            (&& (= (@list.get i32 $ids 4) 3)
              (@match (call $dictionary-column.find-code $c "JP")
                (@case none () 0) (@case some ($code) (= $code 0)))))))))
  (@test "dictionary equality does not normalize Unicode or confuse NUL and empty"
    (@let $c (call $dictionary-column.from-list (@list.new $string "é" "é" "" "\00" "é"))
      (&& (= (call $dictionary-column.dictionary-len $c) 4)
        (&& (= (call $dictionary-column.count-eq $c "é") 2)
            (= (call $dictionary-column.count-eq $c "é") 1)))))
  (@test "empty columns and missing keys preserve an empty selection"
    (@let $c (call $dictionary-column.from-list (@list.new $string))
      (&& (= (call $dictionary-column.len $c) 0)
        (&& (= (@list.len $string (call $dictionary-column.decode $c)) 0)
          (&& (= (call $bitmap.count (call $dictionary-column.eq $c "missing")) 0)
              (@match (call $dictionary-column.find-code $c "missing")
                (@case none () 1) (@case some ($code) 0)))))))
  (@test "explicit dictionaries preserve ordering and permit unused unique keys"
    (@let $c (call $dictionary-column.from-codes
        (@list.new $string "unused" "JP" "US") (@list.new i32 2 1 2))
      (&& (= (call $dictionary-column.dictionary-len $c) 3)
        (&& (= (call $dictionary-column.count-eq $c "unused") 0)
          (&& (= (call $dictionary-column.count-eq $c "US") 2)
            (= (@string.byte-len (call $dictionary-column.get $c 0)) 2))))))
  (@test "IN ignores duplicate and missing query keys without double-counting"
    (@let (($c (call $dictionary-column.from-list (@list.new $string "JP" "US" "JP" "FR")))
           ($selected (call $dictionary-column.in $c (@list.new $string "JP" "missing" "JP")))
           ($rows (call $bitmap.indices $selected)))
      (&& (= (@list.len i32 $rows) 2)
        (&& (= (@list.get i32 $rows 0) 0) (= (@list.get i32 $rows 1) 2)))))
  (@test "batched counts retain query order and repeated keys"
    (@let (($c (call $dictionary-column.from-list (@list.new $string "JP" "US" "JP")))
           ($counts (call $dictionary-column.count-many $c (@list.new $string "JP" "US" "missing" "JP"))))
      (&& (= (@list.get i32 $counts 0) 2)
        (&& (= (@list.get i32 $counts 1) 1)
          (&& (= (@list.get i32 $counts 2) 0) (= (@list.get i32 $counts 3) 2))))))
  (@test "fused query deduplicates keys, keeps row order and sums in i64"
    (@let (($c (call $dictionary-column.from-list (@list.new $string "JP" "US" "JP" "JP" "FR")))
           ($v (call $i32-column.from-list (@list.new i32 2147483646 -2147483648 2147483646 2147483647 0)))
           ($a (call $dictionary-column.query-between $c $v
             (@list.new $string "JP" "JP" "missing") 2147483646 2147483647)))
      (&& (= (struct.get $i32-query-result $count $a) 2)
        (&& (= (struct.get $i32-query-result $sum $a) (i64.const 4294967292))
          (&& (= (@list.get i32 (struct.get $i32-query-result $indices $a) 0) 0)
              (= (@list.get i32 (struct.get $i32-query-result $indices $a) 1) 2))))))
  (@test "fused query excludes padded zero lanes"
    (@let (($c (call $i32-column.from-list (@list.new i32 0 0 0)))
           ($v (call $i32-column.from-list (@list.new i32 0 -1 1)))
           ($a (call $i32-column.query-in-between $c $v (@list.new i32 0 0) -1 2)))
      (&& (= (struct.get $i32-query-result $count $a) 3)
        (&& (= (struct.get $i32-query-result $sum $a) (i64.const 0))
            (= (@list.get i32 (struct.get $i32-query-result $indices $a) 2) 2)))))
  (@test "fused query handles no keys and empty inputs"
    (@let (($c (call $dictionary-column.from-list (@list.new $string)))
           ($v (call $i32-column.from-list (@list.new i32)))
           ($a (call $dictionary-column.query-between $c $v (@list.new $string) -1 1)))
      (&& (= (struct.get $i32-query-result $count $a) 0)
        (&& (= (struct.get $i32-query-result $sum $a) (i64.const 0))
            (= (@list.len i32 (struct.get $i32-query-result $indices $a)) 0)))))
  (@test "numeric fused IN accepts arbitrary signed i32 keys"
    (@let (($c (call $i32-column.from-list (@list.new i32 -2147483648 -1 0 2147483647 -1)))
           ($v (call $i32-column.from-list (@list.new i32 -2147483648 -2147483648 0 2147483647 -2147483648)))
           ($a (call $i32-column.query-in-between $c $v (@list.new i32 -1 -2147483648 -1)
             -2147483648 2147483647)))
      (&& (= (struct.get $i32-query-result $count $a) 3)
        (&& (= (struct.get $i32-query-result $sum $a) (i64.const -6442450944))
            (= (@list.get i32 (struct.get $i32-query-result $indices $a) 2) 4)))))
)
