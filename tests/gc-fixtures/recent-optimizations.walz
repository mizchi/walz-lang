(module
  (@use "walz:core" (type $bytes) (type $bytes-view) (type $option) (type $tuple) (type $result)
    (func $bytes-view.new) (func $bytes-view.slice) (func $bytes-view.to-bytes)
    (func $bytes-view.read-i32-le))
  (type $Storage (array (mut i8)))
  (type $Node (struct (field $data $bytes)))
  (type $Root (struct (field $node (mut (ref null $Node)))))
  (@closure $Reader (@capture $node (ref $Node)) (result i32) (@effect pure)
    (@bytes.len (struct.get $Node $data $node)))
  (func $make (export "make") (result (ref $Node)) (@effect allocates reads)
    (struct.new $Node (@bytes.from-array $Storage (array.new $Storage 0 16384))))
  (func $data (export "data") (param $node (ref $Node)) (result $bytes) (@effect pure)
    (struct.get $Node $data $node))
  (func $choose (param $node (ref $Node)) (param $mode i32)
    (result $result<$tuple<(ref $Node), i32>, i32>) (@effect pure)
    (if (result $result<$tuple<(ref $Node), i32>, i32>) $mode
      (then (@result.err 42)) (else (@result.ok (@tuple.new $node (i32.const 41))))))
  (func $exercise (export "exercise") (param $node (ref $Node)) (param $mode i32)
    (result i32) (@effect pure)
    (@match (call $choose $node $mode)
      (@case err ($code) $code)
      (@case ok ($pair) (@let ($same $value) $pair
        (@let $v (type $option<(ref $Node)>) (@option.some $same)
          (@match $v (@case none () 0) (@case some ($again) (+ $value (ref.eq $node $again)))))))))
  (func $view (export "view") (param $node (ref $Node)) (result (ref $bytes-view)) (@effect allocates)
    (call $bytes-view.slice (call $bytes-view.new (struct.get $Node $data $node)) 4 8))
  (func $read-view (export "read-view") (param $v (ref $bytes-view)) (result i32) (@effect pure)
    (call $bytes-view.read-i32-le $v 0))
  (func $copy (export "copy") (param $v (ref $bytes-view)) (result $bytes) (@effect pure)
    (call $bytes-view.to-bytes $v))
  (func $closure (export "closure") (param $node (ref $Node)) (result (ref $Reader)) (@effect allocates)
    (@closure.new $Reader $node))
  (func $root (export "root") (result (ref $Root)) (@effect allocates)
    (struct.new $Root (ref.null $Node)))
  (func $pin (export "pin") (param $root (ref $Root)) (param $node (ref $Node)) (@effect writes)
    (struct.set $Root $node $root $node))
  (func $clear (export "clear") (param $root (ref $Root)) (@effect writes)
    (struct.set $Root $node $root (ref.null $Node))))
