(module
  (include "program.gwat")
  (func $main
    (export "main")
    (result (result i32 i32))
    (effects reads writes allocates host suspends)
    (let $initial
      (pair.new (ref $stock.State) i32
        (call $stock.new (i32.const 4096))
        (i32.const 0))
      (result.let
        ($final)
        (result (pair (ref $stock.State) i32) i32)
        i32
        (stream.fold-result text
          (pair (ref $stock.State) i32)
          i32
          (call $read-lines)
          (local.get $initial)
          ($state $line)
          (match (pair (ref $stock.State) i32)
            (result (result (pair (ref $stock.State) i32) i32))
            (local.get $state)
            (case pair ($stock $count)
              (result.let
                ()
                (result unit i32)
                (pair (ref $stock.State) i32)
                (call $app.process (local.get $stock) (local.get $line))
                (result.ok (pair (ref $stock.State) i32) i32
                  (pair.new (ref $stock.State) i32
                    (local.get $stock)
                    (i32.add (local.get $count) (i32.const 1)))))))
        )
        (match (pair (ref $stock.State) i32)
          (result (result i32 i32))
          (local.get $final)
          (case pair ($stock $count)
            (result.ok i32 i32 (local.get $count))))
      )
    )
  )
)
