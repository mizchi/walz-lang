(module
  (include "program.gwat")
  (type.alias $Scan (pair (ref $stock.State) i32))
  (func $main (export "main") (result (result i32 i32))
    (effects reads writes allocates host suspends)
    (let $initial $Scan (pair.new (call $stock.new (i32.const 4096)) (i32.const 0))
      (result.let ($final)
        (stream.fold-result
          (call $read-lines)
          (local.get $initial)
          ($state $line)
          (let ($ledger $count) (local.get $state)
            ;; Count delivered lines, including comments and business errors.
            (result.let ()
              (call $app.process (local.get $ledger) (local.get $line))
              (result.ok
                (pair.new
                  (local.get $ledger)
                  (i32.add (local.get $count) (i32.const 1))))
            )))
        (let ($ledger $count) (local.get $final) (result.ok (local.get $count))))
    )))
