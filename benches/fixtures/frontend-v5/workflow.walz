      (case null () (%option.none))
      (case boolean ($x) (%option.none))
      (case number ($x) (%option.none))
      (case string ($x) (%option.none))
      (case array ($x)
        (%loop $at
          (bind $head (ref null $Items) $x)
          (bind $index i32 $index)
          (result (%inst $option (ref $json-value)))
          (if
            (result (%inst $option (ref $json-value)))
            (ref.is_null $head)
            (then (%option.none))
