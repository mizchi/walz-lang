          (($sign (+ $start 1))
           ($c (call $json.peek $b $sign))
           ($digits
             (if (result i32) (| (= $c 43) (= $c 45)) (then (+ $sign 1)) (else $sign))))
          (call $json.required-digits $b $digits))))
