      (%loop $scan
        (bind $p i32 $start)
        (result i32)
        (block
          (result i32)
          (if (i32.ge_u $p $length) (then (return $p)) (else (nop)))
          (if
            (result i32)
            (i32.ge_u (- $length $p) 8)
            (then
              (block
                (result i32)
                (%let $c (%bytes.get $b $p)
                  (if
                    (| (i32.lt_u $c 32) (| (= $c 34) (= $c 92)))
                    (then (return $p))
                    (else (nop))))
                (%let $c (%bytes.get $b (+ $p 1))
                  (if
                    (| (i32.lt_u $c 32) (| (= $c 34) (= $c 92)))
                    (then (return (+ $p 1)))
                    (else (nop))))
                (%let $c (%bytes.get $b (+ $p 2))
                  (if
                    (| (i32.lt_u $c 32) (| (= $c 34) (= $c 92)))
                    (then (return (+ $p 2)))
                    (else (nop))))
                (%let $c (%bytes.get $b (+ $p 3))
                  (if
                    (| (i32.lt_u $c 32) (| (= $c 34) (= $c 92)))
                    (then (return (+ $p 3)))
                    (else (nop))))
                (%let $c (%bytes.get $b (+ $p 4))
                  (if
                    (| (i32.lt_u $c 32) (| (= $c 34) (= $c 92)))
                    (then (return (+ $p 4)))
                    (else (nop))))
                (%let $c (%bytes.get $b (+ $p 5))
                  (if
                    (| (i32.lt_u $c 32) (| (= $c 34) (= $c 92)))
                    (then (return (+ $p 5)))
                    (else (nop))))
                (%let $c (%bytes.get $b (+ $p 6))
                  (if
                    (| (i32.lt_u $c 32) (| (= $c 34) (= $c 92)))
                    (then (return (+ $p 6)))
                    (else (nop))))
                (%let $c (%bytes.get $b (+ $p 7))
                  (if
                    (| (i32.lt_u $c 32) (| (= $c 34) (= $c 92)))
                    (then (return (+ $p 7)))
                    (else (nop))))
                (%recur $scan (+ $p 8))))
            (else
              (%let $c (%bytes.get $b $p)
                (if
                  (result i32)
                  (| (i32.lt_u $c 32) (| (= $c 34) (= $c 92)))
                  (then $p)
                  (else (%recur $scan (+ $p 1))))
