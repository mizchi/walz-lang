          (bind $head (ref null $Members) $x)
          (bind $found (%inst $option (ref $json-value)) (%option.none))
          (result (%inst $option (ref $json-value)))
          (if
            (result (%inst $option (ref $json-value)))
            (ref.is_null $head)
            (then $found)
            (else
