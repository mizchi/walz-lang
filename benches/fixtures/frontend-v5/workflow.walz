      (block
        (result i32)
        (if
          (= $w 1)
          (then (array.set $Array $out $i $b))
          (else
            (block
              (array.set $Array $out $i 92)
              (if
                (= $w 2)
                (then (array.set $Array $out (+ $i 1) $b))
