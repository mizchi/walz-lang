(%file.namespace $walz-file-1

  (%use "walz:core" (type $string) (type $bytes))
  (%export (func $json-string.quote))
  (type $Array (array (mut i32)))
  (func $json-string.valid (param $bytes $bytes) (result $string) (%effect pure)
