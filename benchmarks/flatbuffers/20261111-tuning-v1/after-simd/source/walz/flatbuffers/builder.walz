(module
  (@use "walz:core" (type $bytes) (type $string) (type $list))
  (@export (opaque $fb.builder) (func $fb.builder.new)
    (func $fb.builder.string) (func $fb.builder.bytes) (func $fb.builder.i32s)
    (func $fb.builder.start) (func $fb.builder.bits-field) (func $fb.builder.offset-field)
    (func $fb.builder.end) (func $fb.builder.finish))

  ;; Offsets count bytes from the end, so growing the buffer preserves them.
  ;; Storage is capped at 64 MiB; invalid builder calls trap.
  (type $Storage (array (mut i32)))
  (type $fb.builder (struct
    (field $data (mut (ref $Storage))) (field $head (mut i32)) (field $align (mut i32))
    (field $fields (mut (ref $Storage))) (field $start (mut i32))
    (field $open (mut i32)) (field $sealed (mut i32))))
  (func $fb.builder.new (result (ref $fb.builder)) (@effect allocates)
    (@$fb.builder::{:data (array.new $Storage 0 64) :head 64 :align 1
      :fields (array.new $Storage 0 0) :start 0 :open 0 :sealed 0}))
  (func $size (param $b (ref $fb.builder)) (result i32) (@effect reads)
    (- (array.len (struct.get $fb.builder $data $b)) (struct.get $fb.builder $head $b)))
  (func $idle (param $b (ref $fb.builder)) (@effect reads)
    (if (|| (struct.get $fb.builder $sealed $b) (struct.get $fb.builder $open $b))
      (then (unreachable)) (else (nop))))
  (func $ensure (param $b (ref $fb.builder)) (param $need i32) (@effect reads writes allocates)
    (if (i32.ge_u (struct.get $fb.builder $head $b) $need) (then (nop))
      (else (@let (($old (struct.get $fb.builder $data $b)) ($cap (array.len $old))
                   ($used (call $size $b))
                   ($next (type i32) (@loop $capacity (bind $n i32 $cap) (result i32)
                     (if (result i32) (i32.ge_u (- $n $used) $need) (then $n)
                       (else (if (result i32) (= $n 67108864) (then (unreachable))
                         (else (@recur $capacity (* $n 2))))))))
                   ($data (array.new $Storage 0 $next)))
        (block
          ;; Choose the final capacity before allocating or copying any data.
          (@for $copy (bind $i i32 0) (while (< $i $used)) (step (+ $i 1))
            (array.set $Storage $data (+ (- $next $used) $i)
              (array.get $Storage $old (+ (- $cap $used) $i))))
          (struct.set $fb.builder $data $b $data)
          (struct.set $fb.builder $head $b (- $next $used)))))))
  (func $put32 (param $data (ref $Storage)) (param $p i32) (param $v i32) (@effect writes)
    (block
      (array.set $Storage $data $p (& $v 255))
      (array.set $Storage $data (+ $p 1) (& (i32.shr_u $v 8) 255))
      (array.set $Storage $data (+ $p 2) (& (i32.shr_u $v 16) 255))
      (array.set $Storage $data (+ $p 3) (i32.shr_u $v 24))))
  ;; Experimental four-value pack; retained only if paired measurements improve.
  (func $put4 (param $data (ref $Storage)) (param $p i32)
    (param $values (@inst $list i32)) (param $i i32) (@effect writes)
    (@let $v (type v128)
      (i32x4.replace_lane 3
        (i32x4.replace_lane 2
          (i32x4.replace_lane 1
            (i32x4.splat (@list.get i32 $values $i))
            (@list.get i32 $values (+ $i 1)))
          (@list.get i32 $values (+ $i 2)))
        (@list.get i32 $values (+ $i 3)))
      (block
        (array.set $Storage $data (+ $p 0) (i8x16.extract_lane_u 0 $v))
        (array.set $Storage $data (+ $p 1) (i8x16.extract_lane_u 1 $v))
        (array.set $Storage $data (+ $p 2) (i8x16.extract_lane_u 2 $v))
        (array.set $Storage $data (+ $p 3) (i8x16.extract_lane_u 3 $v))
        (array.set $Storage $data (+ $p 4) (i8x16.extract_lane_u 4 $v))
        (array.set $Storage $data (+ $p 5) (i8x16.extract_lane_u 5 $v))
        (array.set $Storage $data (+ $p 6) (i8x16.extract_lane_u 6 $v))
        (array.set $Storage $data (+ $p 7) (i8x16.extract_lane_u 7 $v))
        (array.set $Storage $data (+ $p 8) (i8x16.extract_lane_u 8 $v))
        (array.set $Storage $data (+ $p 9) (i8x16.extract_lane_u 9 $v))
        (array.set $Storage $data (+ $p 10) (i8x16.extract_lane_u 10 $v))
        (array.set $Storage $data (+ $p 11) (i8x16.extract_lane_u 11 $v))
        (array.set $Storage $data (+ $p 12) (i8x16.extract_lane_u 12 $v))
        (array.set $Storage $data (+ $p 13) (i8x16.extract_lane_u 13 $v))
        (array.set $Storage $data (+ $p 14) (i8x16.extract_lane_u 14 $v))
        (array.set $Storage $data (+ $p 15) (i8x16.extract_lane_u 15 $v)))))
  (func $raw (param $b (ref $fb.builder)) (param $bits i64) (param $n i32)
    (@effect reads writes)
    (@let $head (- (struct.get $fb.builder $head $b) $n)
      (block
        (struct.set $fb.builder $head $b $head)
        (@for $write (bind $i i32 0) (while (< $i $n)) (step (+ $i 1))
          (array.set $Storage (struct.get $fb.builder $data $b) (+ $head $i)
            (i32.wrap_i64 (& (i64.shr_u $bits (i64.extend_i32_u (* $i 8))) 255)))))))
  (func $prep (param $b (ref $fb.builder)) (param $align i32) (param $extra i32)
    (@effect reads writes allocates)
    (@let (($used (call $size $b))
           ($padding (& (- (i32.const 0) (+ $used $extra)) (- $align 1)))
           ($need (+ (+ (i64.extend_i32_u $extra) (i64.extend_i32_u $align))
                     (i64.extend_i32_u $padding))))
      (block
        (if (|| (struct.get $fb.builder $sealed $b) (> (+ (i64.extend_i32_u $used) $need) 67108864))
          (then (unreachable)) (else (nop)))
        (if (> $align (struct.get $fb.builder $align $b))
          (then (struct.set $fb.builder $align $b $align)) (else (nop)))
        (call $ensure $b (i32.wrap_i64 $need))
        (@for $pad (bind $i i32 0) (while (< $i $padding)) (step (+ $i 1))
          (call $raw $b 0 1)))))
  (func $offset (param $b (ref $fb.builder)) (param $target i32) (@effect reads writes allocates)
    (block
      (if (|| (i32.eqz $target) (i32.gt_u $target (call $size $b)))
        (then (unreachable)) (else (nop)))
      (call $prep $b 4 0)
      (call $raw $b (i64.extend_i32_u (+ (- (call $size $b) $target) 4)) 4)))

  (func $bytes (param $b (ref $fb.builder)) (param $data $bytes) (param $terminated i32)
    (result i32) (@effect reads writes allocates)
    (block (result i32)
      (call $idle $b)
      (@let $n (@bytes.len $data)
        (block (result i32)
          (call $prep $b 4 (+ $n $terminated))
          (if $terminated (then (call $raw $b 0 1)) (else (nop)))
          (@let (($target (struct.get $fb.builder $data $b))
                 ($start (- (struct.get $fb.builder $head $b) $n)))
            (block
              (struct.set $fb.builder $head $b $start)
              (@for $bytes (bind $i i32 0) (while (< $i $n)) (step (+ $i 1))
                (array.set $Storage $target (+ $start $i) (@bytes.get $data $i)))))
          (call $raw $b (i64.extend_i32_u $n) 4)
          (call $size $b)))))
  (func $fb.builder.bytes (param $b (ref $fb.builder)) (param $data $bytes) (result i32)
    (@effect reads writes allocates) (call $bytes $b $data 0))
  (func $fb.builder.string (param $b (ref $fb.builder)) (param $s $string) (result i32)
    (@effect reads writes allocates) (call $bytes $b (@string.bytes $s) 1))
  (func $fb.builder.i32s (param $b (ref $fb.builder)) (param $values (@inst $list i32))
    (result i32) (@effect reads writes allocates)
    (block (result i32)
      (call $idle $b)
      (@let $n (@list.len i32 $values)
        (block (result i32)
          (if (i32.gt_u $n 16777215) (then (unreachable)) (else (nop)))
          (call $prep $b 4 (* $n 4))
          (@let (($data (struct.get $fb.builder $data $b))
                 ($start (- (struct.get $fb.builder $head $b) (* $n 4))))
            (block
              (struct.set $fb.builder $head $b $start)
              (@for $values4 (bind $i i32 0) (while (< $i (& $n -4))) (step (+ $i 4))
                (call $put4 $data (+ $start (* $i 4)) $values $i))
              (@for $tail (bind $i i32 (& $n -4)) (while (< $i $n)) (step (+ $i 1))
                (call $put32 $data (+ $start (* $i 4)) (@list.get i32 $values $i)))))
          (call $raw $b (i64.extend_i32_u $n) 4)
          (call $size $b)))))

  (func $fb.builder.start (param $b (ref $fb.builder)) (param $count i32)
    (@effect reads writes allocates)
    (block
      (call $idle $b)
      (if (i32.gt_u $count 32765) (then (unreachable)) (else (nop)))
      (struct.set $fb.builder $fields $b (array.new $Storage 0 $count))
      (struct.set $fb.builder $start $b (call $size $b))
      (struct.set $fb.builder $open $b 1)))
  (func $slot (param $b (ref $fb.builder)) (param $slot i32) (@effect reads)
    (block
      (if (|| (struct.get $fb.builder $sealed $b) (i32.eqz (struct.get $fb.builder $open $b)))
        (then (unreachable)) (else (nop)))
      (if (i32.ge_u $slot (array.len (struct.get $fb.builder $fields $b)))
        (then (unreachable)) (else (nop)))
      (if (array.get $Storage (struct.get $fb.builder $fields $b) $slot)
        (then (unreachable)) (else (nop)))))
  (func $fb.builder.bits-field (param $b (ref $fb.builder)) (param $slot i32)
    (param $width i32) (param $bits i64) (param $default i64) (@effect reads writes allocates)
    (block
      (call $slot $b $slot)
      (if (i32.eqz (|| (|| (= $width 1) (= $width 2)) (|| (= $width 4) (= $width 8))))
        (then (unreachable)) (else (nop)))
      (if (!= $bits $default)
        (then (block
          (call $prep $b $width 0)
          (call $raw $b $bits $width)
          (array.set $Storage (struct.get $fb.builder $fields $b) $slot (call $size $b))))
        (else (nop)))))
  (func $fb.builder.offset-field (param $b (ref $fb.builder)) (param $slot i32)
    (param $target i32) (@effect reads writes allocates)
    (block
      (call $slot $b $slot)
      (if $target
        (then (block
          (call $offset $b $target)
          (array.set $Storage (struct.get $fb.builder $fields $b) $slot (call $size $b))))
        (else (nop)))))
  (func $fb.builder.end (param $b (ref $fb.builder)) (result i32) (@effect reads writes allocates)
    (block (result i32)
      (if (|| (struct.get $fb.builder $sealed $b) (i32.eqz (struct.get $fb.builder $open $b)))
        (then (unreachable)) (else (nop)))
      (call $prep $b 4 0)
      (call $raw $b 0 4)
      (@let (($table (call $size $b)) ($fields (struct.get $fb.builder $fields $b))
             ($count (array.len $fields)) ($object-size (- $table (struct.get $fb.builder $start $b))))
        (block (result i32)
          (if (> $object-size 65535) (then (unreachable)) (else (nop)))
          (call $prep $b 2 (+ 4 (* $count 2)))
          (@for $vtable (bind $i i32 $count) (while (> $i 0)) (step (- $i 1))
            (@let $off (array.get $Storage $fields (- $i 1))
              (call $raw $b (i64.extend_i32_u
                (if (result i32) $off (then (- $table $off)) (else 0))) 2)))
          (call $raw $b (i64.extend_i32_u $object-size) 2)
          (call $raw $b (i64.extend_i32_u (+ 4 (* $count 2))) 2)
          (@let (($distance (- (call $size $b) $table)) ($data (struct.get $fb.builder $data $b))
                 ($pos (- (array.len $data) $table)))
            (@for $patch (bind $i i32 0) (while (< $i 4)) (step (+ $i 1))
              (array.set $Storage $data (+ $pos $i) (& (i32.shr_u $distance (* $i 8)) 255))))
          (struct.set $fb.builder $open $b 0)
          $table))))
  (func $fb.builder.finish (param $b (ref $fb.builder)) (param $root i32) (param $id $bytes)
    (result $bytes) (@effect reads writes allocates)
    (block (result $bytes)
      (call $idle $b)
      (@let $n (@bytes.len $id)
        (block (result $bytes)
          (if (i32.eqz (|| (= $n 0) (= $n 4))) (then (unreachable)) (else (nop)))
          (call $prep $b (struct.get $fb.builder $align $b) (+ 4 $n))
          (@for $identifier (bind $i i32 $n) (while (> $i 0)) (step (- $i 1))
            (call $raw $b (i64.extend_i32_u (@bytes.get $id (- $i 1))) 1))
          (call $offset $b $root)
          (@let (($size (call $size $b)) ($head (struct.get $fb.builder $head $b))
                 ($out (array.new $Storage 0 $size)))
            (block (result $bytes)
              (@for $copy (bind $i i32 0) (while (< $i $size)) (step (+ $i 1))
                (array.set $Storage $out $i (array.get $Storage (struct.get $fb.builder $data $b) (+ $head $i))))
              (struct.set $fb.builder $sealed $b 1)
              (@bytes.from-array $Storage $out))))))))
