(module
  (@use "walz:core" (type $bytes) (type $string) (type $option) (type $list) (type $tuple) (type $unit) (func $string.concat))
  (func $echo (export "echo") (param $s $string) (result $string) (@effect pure) $s)
  (func $length (export "length") (param $s $string) (result i32) (@effect pure) (@string.byte-len $s))
  (func $length-catch (export "length-catch") (param $s $string) (result i32) (@effect pure)
    (@try (result i32) (do (@string.byte-len $s)) (catch_all (i32.const 0))))
  (func $concat (export "concat") (param $a $string) (param $b $string) (result $string)
    (@effect reads writes allocates) (call $string.concat $a $b))
  (func $literal (export "literal") (result $string) (@effect pure) "\ef\bb\bf日本🦀")
  (func $from-bytes (export "from-bytes") (param $b $bytes) (result (@inst $option $string))
    (@effect allocates) (@string.from-bytes $b))
  (func $bytes (export "bytes") (param $b $bytes) (result $bytes) (@effect pure) $b)
  (func $longs (export "longs") (param $v (@inst $list i64)) (result (@inst $list i64)) (@effect pure) $v)
  (func $floats (export "floats") (param $v (@inst $list f32)) (result (@inst $list f32)) (@effect pure) $v)
  (func $nested (export "nested") (param $v (@inst $list (@inst $list i32))) (result (@inst $list (@inst $list i32))) (@effect pure) $v)
  (func $options (export "options") (param $v (@inst $option (@inst $option $string))) (result (@inst $option (@inst $option $string))) (@effect pure) $v)
  (func $units (export "units") (param $v (@inst $tuple $unit (@inst $option $unit))) (result (@inst $tuple $unit (@inst $option $unit))) (@effect pure) $v)
  (func $unit-list (export "unit-list") (param $v (@inst $list $unit)) (result (@inst $list $unit)) (@effect pure) $v)
  (func $trap (export "trap") (@effect pure) (unreachable)))
