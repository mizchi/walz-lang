(module
  (@use "walz:core" (type $bytes))
  (@export
    (opaque $bytes-view)
    (func $bytes-view.new)
    (func $bytes-view.len)
    (func $bytes-view.get)
    (func $bytes-view.slice)
    (func $bytes-view.to-bytes))
  ;; Every view points to the original immutable bytes, never to another view.
  (type $bytes-view
    (struct (field $source $bytes) (field $start i32) (field $length i32)))
  (func $bytes-view.new
    (param $source $bytes)
    (result (ref $bytes-view))
    (@effect allocates)
    (@$bytes-view::{:source $source :start 0 :length (@bytes.len $source)}))

  (func $bytes-view.len
    (param $v (ref $bytes-view))
    (result i32)
    (@effect pure)
    (struct.get $bytes-view $length $v))

  (func $bytes-view.get
    (param $v (ref $bytes-view))
    (param $index i32)
    (result i32)
    (@effect pure)
    (if
      (result i32)
      (i32.ge_u $index (call $bytes-view.len $v))
      (then (unreachable))
      (else
        (@bytes.get
          (struct.get $bytes-view $source $v)
          (+ (struct.get $bytes-view $start $v) $index))))
  )

  (func $bytes-view.slice
    (param $v (ref $bytes-view))
    (param $start i32)
    (param $length i32)
    (result (ref $bytes-view))
    (@effect allocates)
    (@let $n (call $bytes-view.len $v)
      (if
        (result (ref $bytes-view))
        (|| (i32.gt_u $start $n) (i32.gt_u $length (- $n $start)))
        (then (unreachable))
        (else
          (@$bytes-view::{
            :source (struct.get $bytes-view $source $v)
            :start (+ (struct.get $bytes-view $start $v) $start)
            :length $length
          }))))
  )
  ;; Always copy the visible range, so the result does not retain the source.
  (func $bytes-view.to-bytes
    (param $v (ref $bytes-view))
    (result $bytes)
    (@effect pure)
    (@bytes.slice
      (struct.get $bytes-view $source $v)
      (struct.get $bytes-view $start $v)
      (call $bytes-view.len $v))))
