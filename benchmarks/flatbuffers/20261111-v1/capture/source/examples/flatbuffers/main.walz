(module
  (@use "walz:core" (type $bytes) (type $list) (type $option) (type $result))
  (@use "./message.walz" (type $Bool) (type $Child) (type $Message)
    (func $message.encode) (func $message.decode))
  (func $encode (export "encode") (param $m (ref $Message)) (result $bytes)
    (@effect reads writes allocates) (call $message.encode $m))
  (func $decode (export "decode") (param $b $bytes) (result (@inst $result (ref $Message) i32))
    (@effect reads writes allocates) (call $message.decode $b))
  (func $main (export "main") (result i32) (@effect reads writes allocates)
    (@let $input (@$Message::{:id 42 :name "Walz" :values (@list.new i32 20 22)
        :payload (@bytes.new 0 128 255) :enabled (@newtype.wrap $Bool 1) :weight 1.25
        :child (@option.some (ref $Child) (@$Child::{:count 42 :label "child"}))})
      (@match (call $message.decode (call $message.encode $input))
        (@case ok ($m) (@match (struct.get $Message $child $m)
          (@case some ($c) (struct.get $Child $count $c)) (@case none () (i32.const -1))))
        (@case err ($code) (- (i32.const 0) $code))))))
