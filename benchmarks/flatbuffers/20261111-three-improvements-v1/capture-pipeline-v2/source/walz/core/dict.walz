(module
  (@use "walz:core" (type $string) (type $option) (type $list) (type $tuple))
  (@use "./list-builder.walz"
    (func $list-builder.new)
    (func $list-builder.push)
    (func $list-builder.finish))
  (@use "./bytes.walz" (func $bytes.equal))
  (@export
    (opaque $dict)
    (func $dict.new)
    (func $dict.len)
    (func $dict.get)
    (func $dict.set)
    (func $dict.remove)
    (func $dict.clear)
    (func $dict.entries))
  (type $Entry
    (@type.params $T)
    (@where (shared $T) (nonunit $T))
    (struct
      (field $key $string)
      (field $value (mut $T))
      (field $next (mut (ref null (@inst $Entry $T))))
    ))
  (type $Buckets
    (@type.params $T)
    (@where (shared $T) (nonunit $T))
    (array (mut (ref null (@inst $Entry $T))))
  )
  (type $dict
    (@type.params $T)
    (@where (shared $T) (nonunit $T))
    (struct (field $buckets (mut (ref (@inst $Buckets $T)))) (field $size (mut i32))))
  (func $dict.slot
    (param $key $string)
    (param $length i32)
    (result i32)
    (@effect pure)
    (@let $bytes (@string.bytes $key)
      (@loop $hash
        (bind $i i32 0)
        (bind $hash i32 2166136261)
        (result i32)
        (if
          (result i32)
          (= $i (@bytes.len $bytes))
          (then (& $hash (- $length 1)))
          (else (@recur $hash (+ $i 1) (* (^ $hash (@bytes.get $bytes $i)) 16777619))))
      )))

  (func $dict.new
    (@type.params $T)
    (@where (shared $T) (nonunit $T))
    (result (ref (@inst $dict $T)))
    (@effect allocates)
    (struct.new (@inst $dict $T)
      (array.new (@inst $Buckets $T) (ref.null (@inst $Entry $T)) 16)
      0))

  (func $dict.len
    (@type.params $T)
    (@where (shared $T) (nonunit $T))
    (param $d (ref (@inst $dict $T)))
    (result i32)
    (@effect reads)
    (struct.get (@inst $dict $T) $size $d))

  (func $dict.find
    (@type.params $T)
    (@where (shared $T) (nonunit $T))
    (param $d (ref (@inst $dict $T)))
    (param $key $string)
    (result (ref null (@inst $Entry $T)))
    (@effect reads)
    (@let $buckets (struct.get (@inst $dict $T) $buckets $d)
      (@loop $find
        (bind $entry
          (ref null (@inst $Entry $T))
          (array.get
            (@inst $Buckets $T)
            $buckets
            (call $dict.slot $key (array.len $buckets))))
        (result (ref null (@inst $Entry $T)))
        (if
          (result (ref null (@inst $Entry $T)))
          (ref.is_null $entry)
          (then (ref.null (@inst $Entry $T)))
          (else
            (@let $entry (ref.as_non_null $entry)
              (if
                (result (ref null (@inst $Entry $T)))
                (call $bytes.equal
                  (@string.bytes $key)
                  (@string.bytes (struct.get (@inst $Entry $T) $key $entry)))
                (then $entry)
                (else (@recur $find (struct.get (@inst $Entry $T) $next $entry))))
            ))))
    ))

  (func $dict.get
    (@type.params $T)
    (@where (shared $T) (nonunit $T))
    (param $d (ref (@inst $dict $T)))
    (param $key $string)
    (result (@inst $option $T))
    (@effect reads)
    (@let $entry (call (@inst $dict.find $T) $d $key)
      (if
        (result (@inst $option $T))
        (ref.is_null $entry)
        (then (@option.none))
        (else
          (@option.some (struct.get (@inst $Entry $T) $value (ref.as_non_null $entry))))
      )))

  (func $dict.grow
    (@type.params $T)
    (@where (shared $T) (nonunit $T))
    (param $d (ref (@inst $dict $T)))
    (@effect reads writes allocates)
    (@let
      (($old (struct.get (@inst $dict $T) $buckets $d))
       ($length (array.len $old)))
      (if
        (i32.ge_u $length 1073741824)
        (then (unreachable))
        (else
          (@let $new
            (array.new (@inst $Buckets $T) (ref.null (@inst $Entry $T)) (* $length 2))
            (block
              (@for $buckets
                (bind $i i32 0)
                (while (i32.lt_u $i $length))
                (step (+ $i 1))
                (@loop $chain
                  (bind $entry
                    (ref null (@inst $Entry $T))
                    (array.get (@inst $Buckets $T) $old $i))
                  (if
                    (ref.is_null $entry)
                    (then (nop))
                    (else
                      (@let
                        (($entry (ref.as_non_null $entry))
                         ($next (struct.get (@inst $Entry $T) $next $entry))
                         ($slot
                           (call $dict.slot
                             (struct.get (@inst $Entry $T) $key $entry)
                             (array.len $new))))
                        (block
                          (struct.set
                            (@inst $Entry $T)
                            $next
                            $entry
                            (array.get (@inst $Buckets $T) $new $slot))
                          (array.set (@inst $Buckets $T) $new $slot $entry)
                          (@recur $chain $next))))
                  )))
              (struct.set (@inst $dict $T) $buckets $d $new))))
      )))

  (func $dict.set
    (@type.params $T)
    (@where (shared $T) (nonunit $T))
    (param $d (ref (@inst $dict $T)))
    (param $key $string)
    (param $value $T)
    (result (@inst $option $T))
    (@effect reads writes allocates)
    (@let $entry (call (@inst $dict.find $T) $d $key)
      (if
        (result (@inst $option $T))
        (ref.is_null $entry)
        (then
          (block
            (result (@inst $option $T))
            (if
              (i32.ge_u
                (struct.get (@inst $dict $T) $size $d)
                (array.len (struct.get (@inst $dict $T) $buckets $d)))
              (then (call (@inst $dict.grow $T) $d))
              (else (nop)))
            (@let
              (($buckets (struct.get (@inst $dict $T) $buckets $d))
               ($slot (call $dict.slot $key (array.len $buckets))))
              (block
                (result (@inst $option $T))
                (array.set
                  (@inst $Buckets $T)
                  $buckets
                  $slot
                  (struct.new (@inst $Entry $T)
                    $key
                    $value
                    (array.get (@inst $Buckets $T) $buckets $slot)))
                (struct.set
                  (@inst $dict $T)
                  $size
                  $d
                  (+ (struct.get (@inst $dict $T) $size $d) 1))
                (@option.none))))
        )
        (else
          (@let
            (($entry (ref.as_non_null $entry))
             ($previous (struct.get (@inst $Entry $T) $value $entry)))
            (block
              (result (@inst $option $T))
              (struct.set (@inst $Entry $T) $value $entry $value)
              (@option.some $previous))))
      )))

  (func $dict.remove
    (@type.params $T)
    (@where (shared $T) (nonunit $T))
    (param $d (ref (@inst $dict $T)))
    (param $key $string)
    (result (@inst $option $T))
    (@effect reads writes)
    (@let
      (($buckets (struct.get (@inst $dict $T) $buckets $d))
       ($slot (call $dict.slot $key (array.len $buckets))))
      (@loop $remove
        (bind $entry
          (ref null (@inst $Entry $T))
          (array.get (@inst $Buckets $T) $buckets $slot))
        (bind $previous (ref null (@inst $Entry $T)) (ref.null (@inst $Entry $T)))
        (result (@inst $option $T))
        (if
          (result (@inst $option $T))
          (ref.is_null $entry)
          (then (@option.none))
          (else
            (@let $entry (ref.as_non_null $entry)
              (if
                (result (@inst $option $T))
                (call $bytes.equal
                  (@string.bytes $key)
                  (@string.bytes (struct.get (@inst $Entry $T) $key $entry)))
                (then
                  (@let $next (struct.get (@inst $Entry $T) $next $entry)
                    (block
                      (result (@inst $option $T))
                      (if
                        (ref.is_null $previous)
                        (then (array.set (@inst $Buckets $T) $buckets $slot $next))
                        (else
                          (struct.set
                            (@inst $Entry $T)
                            $next
                            (ref.as_non_null $previous)
                            $next)))
                      (struct.set
                        (@inst $Entry $T)
                        $next
                        $entry
                        (ref.null (@inst $Entry $T)))
                      (struct.set
                        (@inst $dict $T)
                        $size
                        $d
                        (- (struct.get (@inst $dict $T) $size $d) 1))
                      (@option.some (struct.get (@inst $Entry $T) $value $entry))))
                )
                (else
                  (@recur $remove (struct.get (@inst $Entry $T) $next $entry) $entry))))
          ))))
  )

  (func $dict.clear
    (@type.params $T)
    (@where (shared $T) (nonunit $T))
    (param $d (ref (@inst $dict $T)))
    (@effect reads writes)
    (@let $buckets (struct.get (@inst $dict $T) $buckets $d)
      (block
        (@for $clear
          (bind $i i32 0)
          (while (i32.lt_u $i (array.len $buckets)))
          (step (+ $i 1))
          (array.set (@inst $Buckets $T) $buckets $i (ref.null (@inst $Entry $T))))
        (struct.set (@inst $dict $T) $size $d 0))))

  (func $dict.entries
    (@type.params $T)
    (@where (shared $T) (nonunit $T))
    (param $d (ref (@inst $dict $T)))
    (result (@inst $list (@inst $tuple $string $T)))
    (@effect reads writes allocates)
    (@let
      (($buckets (struct.get (@inst $dict $T) $buckets $d))
       ($out (call (@inst $list-builder.new (@inst $tuple $string $T))))
      )
      (block
        (result (@inst $list (@inst $tuple $string $T)))
        (@for $buckets
          (bind $i i32 0)
          (while (i32.lt_u $i (array.len $buckets)))
          (step (+ $i 1))
          (@loop $chain
            (bind $entry
              (ref null (@inst $Entry $T))
              (array.get (@inst $Buckets $T) $buckets $i))
            (if
              (ref.is_null $entry)
              (then (nop))
              (else
                (@let $entry (ref.as_non_null $entry)
                  (block
                    (call
                      (@inst $list-builder.push (@inst $tuple $string $T))
                      $out
                      (@tuple.new
                        (struct.get (@inst $Entry $T) $key $entry)
                        (struct.get (@inst $Entry $T) $value $entry)))
                    (@recur $chain (struct.get (@inst $Entry $T) $next $entry))))
              ))))
        (call (@inst $list-builder.finish (@inst $tuple $string $T)) $out))))
)
