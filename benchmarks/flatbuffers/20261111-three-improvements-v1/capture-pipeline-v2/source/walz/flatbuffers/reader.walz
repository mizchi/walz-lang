(module
  (@use "walz:core" (type $bytes) (type $string) (type $list) (type $option)
    (type $bytes-view) (func $bytes-view.new) (func $bytes-view.slice))
  (@export (opaque $fb.table) (opaque $fb.vector) (tag $fb.invalid)
    (func $fb.root) (func $fb.table-at) (func $fb.target)
    (func $fb.bits) (func $fb.i32) (func $fb.i64) (func $fb.f64)
    (func $fb.string) (func $fb.vector) (func $fb.vector.len)
    (func $fb.vector.get) (func $fb.vector.bytes) (func $fb.vector.sum-i32) (func $fb.i32s))

  ;; 1 = bounds, 2 = layout/alignment, 3 = identifier, 4 = UTF-8.
  (tag $fb.invalid (param i32))
  (type $fb.table (struct (field $source $bytes) (field $pos i32)
    (field $vtable i32) (field $vsize i32) (field $size i32)))
  (type $fb.vector (struct (field $source $bytes) (field $start i32)
    (field $length i32) (field $width i32)))
  (type $Values (array (mut i32)))

  ;; All arithmetic on untrusted offsets/lengths stays in i64 until checked.
  (func $range (param $b $bytes) (param $p i64) (param $n i64) (param $align i32)
    (@effect (throws $fb.invalid))
    (@let $end (i64.extend_i32_u (@bytes.len $b))
      (block
        (if (|| (|| (< $p 0) (< $n 0)) (|| (> $p $end) (> $n (- $end $p))))
          (then (throw $fb.invalid 1)) (else (nop)))
        (if (!= (& $p (i64.extend_i32_u (- $align 1))) 0)
          (then (throw $fb.invalid 2)) (else (nop))))))
  (func $width (param $n i32) (@effect (throws $fb.invalid))
    (if (i32.eqz (|| (|| (= $n 1) (= $n 2)) (|| (= $n 4) (= $n 8))))
      (then (throw $fb.invalid 2)) (else (nop))))
  (func $read (param $b $bytes) (param $p i64) (param $n i32) (result i64)
    (@effect (throws $fb.invalid))
    (block (result i64)
      (call $range $b $p (i64.extend_i32_u $n) $n)
      (@loop $read (bind $i i32 0) (bind $bits i64 0) (result i64)
        (if (result i64) (= $i $n) (then $bits)
          (else (@recur $read (+ $i 1)
            (| $bits (i64.shl (i64.extend_i32_u (@bytes.get $b (+ (i32.wrap_i64 $p) $i)))
              (i64.extend_i32_u (* $i 8))))))))))

  (func $fb.table-at (param $b $bytes) (param $p i64) (result (ref $fb.table))
    (@effect allocates (throws $fb.invalid))
    (@let (($distance (i64.extend_i32_s (i32.wrap_i64 (call $read $b $p 4))))
           ($vt (- $p $distance))
           ($vsize (i32.wrap_i64 (call $read $b $vt 2)))
           ($size (i32.wrap_i64 (call $read $b (+ $vt 2) 2))))
      (block (result (ref $fb.table))
        (if (|| (|| (< $vsize 4) (!= (& $vsize 1) 0)) (< $size 4))
          (then (throw $fb.invalid 2)) (else (nop)))
        (call $range $b $vt (i64.extend_i32_u $vsize) 2)
        (call $range $b $p (i64.extend_i32_u $size) 4)
        (if (&& (< $vt (+ $p (i64.extend_i32_u $size))) (> (+ $vt (i64.extend_i32_u $vsize)) $p))
          (then (throw $fb.invalid 2)) (else (nop)))
        (@$fb.table::{:source $b :pos (i32.wrap_i64 $p) :vtable (i32.wrap_i64 $vt)
          :vsize $vsize :size $size}))))
  (func $fb.root (param $b $bytes) (param $identifier $bytes) (result (ref $fb.table))
    (@effect allocates (throws $fb.invalid))
    (@let (($n (@bytes.len $identifier)) ($p (call $read $b 0 4)))
      (block (result (ref $fb.table))
        (if (i32.eqz (|| (= $n 0) (= $n 4))) (then (throw $fb.invalid 3)) (else (nop)))
        (call $range $b 4 (i64.extend_i32_u $n) 1)
        (@for $id (bind $i i32 0) (while (< $i $n)) (step (+ $i 1))
          (if (!= (@bytes.get $b (+ 4 $i)) (@bytes.get $identifier $i))
            (then (throw $fb.invalid 3)) (else (nop))))
        (if (< $p (i64.extend_i32_u (+ 4 $n))) (then (throw $fb.invalid 2)) (else (nop)))
        (call $fb.table-at $b $p))))

  (func $field (param $t (ref $fb.table)) (param $slot i32) (param $width i32) (result i32)
    (@effect (throws $fb.invalid))
    (block (result i32)
      (call $width $width)
      (if (< $slot 0) (then (throw $fb.invalid 2)) (else (nop)))
      (@let $entry (+ (i64.const 4) (* (i64.extend_i32_u $slot) 2))
        (if (result i32) (>= $entry (i64.extend_i32_u (struct.get $fb.table $vsize $t)))
          (then 0)
          (else
            (@let $off (i32.wrap_i64 (call $read (struct.get $fb.table $source $t)
                    (+ (i64.extend_i32_u (struct.get $fb.table $vtable $t)) $entry) 2))
              (if (result i32) (= $off 0) (then 0)
                (else (block (result i32)
                  (if (|| (< $off 4) (> (+ $off $width) (struct.get $fb.table $size $t)))
                    (then (throw $fb.invalid 2)) (else (nop)))
                  (@let $p (+ (struct.get $fb.table $pos $t) $off)
                    (block (result i32)
                      (call $range (struct.get $fb.table $source $t) (i64.extend_i32_u $p)
                        (i64.extend_i32_u $width) $width)
                      $p)))))))))))
  (func $fb.bits (param $t (ref $fb.table)) (param $slot i32) (param $width i32)
    (param $default i64) (result i64) (@effect (throws $fb.invalid))
    (@let $p (call $field $t $slot $width)
      (if (result i64) (= $p 0) (then $default)
        (else (call $read (struct.get $fb.table $source $t) (i64.extend_i32_u $p) $width)))))
  (func $fb.i32 (param $t (ref $fb.table)) (param $slot i32) (param $default i32)
    (result i32) (@effect (throws $fb.invalid))
    (i32.wrap_i64 (call $fb.bits $t $slot 4 (i64.extend_i32_u $default))))
  (func $fb.i64 (param $t (ref $fb.table)) (param $slot i32) (param $default i64)
    (result i64) (@effect (throws $fb.invalid)) (call $fb.bits $t $slot 8 $default))
  (func $fb.f64 (param $t (ref $fb.table)) (param $slot i32) (param $default f64)
    (result f64) (@effect (throws $fb.invalid))
    (f64.reinterpret_i64 (call $fb.bits $t $slot 8 (i64.reinterpret_f64 $default))))
  (func $fb.target (param $t (ref $fb.table)) (param $slot i32) (result i32)
    (@effect (throws $fb.invalid))
    (@let $p (call $field $t $slot 4)
      (if (result i32) (= $p 0) (then 0)
        (else (@let (($b (struct.get $fb.table $source $t))
                     ($off (call $read $b (i64.extend_i32_u $p) 4))
                     ($target (+ (i64.extend_i32_u $p) $off)))
          (block (result i32)
            (if (< $off 4) (then (throw $fb.invalid 2)) (else (nop)))
            (call $range $b $target 4 4)
            (i32.wrap_i64 $target)))))))

  (func $fb.string (param $t (ref $fb.table)) (param $slot i32) (result $string)
    (@effect (throws $fb.invalid))
    (@let $p (call $fb.target $t $slot)
      (if (result $string) (= $p 0) (then "")
        (else (@let (($b (struct.get $fb.table $source $t))
                     ($n (call $read $b (i64.extend_i32_u $p) 4))
                     ($start (+ (i64.extend_i32_u $p) 4)))
          (block (result $string)
            (call $range $b $start (+ $n 1) 1)
            (if (!= (@bytes.get $b (i32.wrap_i64 (+ $start $n))) 0)
              (then (throw $fb.invalid 2)) (else (nop)))
            (@match (@string.from-bytes (@bytes.slice $b (i32.wrap_i64 $start) (i32.wrap_i64 $n)))
              (@case some ($s) $s) (@case none () (throw $fb.invalid 4)))))))))
  (func $fb.vector (param $t (ref $fb.table)) (param $slot i32) (param $width i32)
    (result (ref $fb.vector)) (@effect allocates (throws $fb.invalid))
    (block (result (ref $fb.vector))
      (call $width $width)
      (@let (($b (struct.get $fb.table $source $t)) ($p (call $fb.target $t $slot)))
        (if (result (ref $fb.vector)) (= $p 0)
          (then (@$fb.vector::{:source $b :start 0 :length 0 :width $width}))
          (else (@let (($n (call $read $b (i64.extend_i32_u $p) 4))
                       ($start (+ (i64.extend_i32_u $p) 4)))
            (block (result (ref $fb.vector))
              (call $range $b $start (* $n (i64.extend_i32_u $width)) $width)
              (@$fb.vector::{:source $b :start (i32.wrap_i64 $start)
                :length (i32.wrap_i64 $n) :width $width}))))))))
  (func $fb.vector.len (param $v (ref $fb.vector)) (result i32) (@effect pure)
    (struct.get $fb.vector $length $v))
  (func $fb.vector.get (param $v (ref $fb.vector)) (param $i i32) (result i64)
    (@effect (throws $fb.invalid))
    (block (result i64)
      (if (i32.ge_u $i (call $fb.vector.len $v)) (then (throw $fb.invalid 1)) (else (nop)))
      (call $read (struct.get $fb.vector $source $v)
        (+ (i64.extend_i32_u (struct.get $fb.vector $start $v))
          (* (i64.extend_i32_u $i) (i64.extend_i32_u (struct.get $fb.vector $width $v))))
        (struct.get $fb.vector $width $v))))
  (func $fb.vector.bytes (param $v (ref $fb.vector)) (result (ref $bytes-view)) (@effect allocates)
    (call $bytes-view.slice (call $bytes-view.new (struct.get $fb.vector $source $v))
      (struct.get $fb.vector $start $v) (* (call $fb.vector.len $v) (struct.get $fb.vector $width $v))))
  (func $i32-at (param $b $bytes) (param $p i32) (result i32) (@effect pure)
    (| (| (@bytes.get $b $p) (i32.shl (@bytes.get $b (+ $p 1)) 8))
       (| (i32.shl (@bytes.get $b (+ $p 2)) 16) (i32.shl (@bytes.get $b (+ $p 3)) 24))))
  (func $fb.vector.sum-i32 (param $v (ref $fb.vector)) (result i64)
    (@effect (throws $fb.invalid))
    (block (result i64)
      (if (!= (struct.get $fb.vector $width $v) 4)
        (then (throw $fb.invalid 2)) (else (nop)))
      (@let (($b (struct.get $fb.vector $source $v)) ($start (struct.get $fb.vector $start $v))
             ($n (call $fb.vector.len $v)))
        (@loop $sum (bind $i i32 0) (bind $total i64 0) (result i64)
          (if (result i64) (= $i $n) (then $total)
            (else (@recur $sum (+ $i 1)
              (+ $total (i64.extend_i32_s (call $i32-at $b (+ $start (* $i 4))))))))))))
  (func $fb.i32s (param $t (ref $fb.table)) (param $slot i32) (result (@inst $list i32))
    (@effect reads writes allocates (throws $fb.invalid))
    (@let (($v (call $fb.vector $t $slot 4)) ($n (call $fb.vector.len $v))
           ($b (struct.get $fb.vector $source $v)) ($start (struct.get $fb.vector $start $v))
           ($out (array.new $Values 0 $n)))
      (block (result (@inst $list i32))
        (@for $copy (bind $i i32 0) (while (< $i $n)) (step (+ $i 1))
          ;; fb.vector already checked the full immutable byte range and alignment.
          (array.set $Values $out $i (call $i32-at $b (+ $start (* $i 4)))))
        (@list.from-array i32 $Values $out)))))
