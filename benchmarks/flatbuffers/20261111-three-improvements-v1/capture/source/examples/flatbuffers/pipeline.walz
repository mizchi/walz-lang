(module
  (@use "walz:core" (type $bytes) (type $string) (type $list) (type $option) (type $result)
    (func $list.map))
  (@use "./message.walz" (type $Bool) (type $Child) (type $Message)
    (func $message.encode) (func $message.decode))
  (@use "../../walz/flatbuffers/reader.walz" (tag $fb.invalid)
    (func $fb.root) (func $fb.table-at) (func $fb.target) (func $fb.bits)
    (func $fb.i32) (func $fb.i64) (func $fb.f64) (func $fb.string)
    (func $fb.vector) (func $fb.vector.len) (func $fb.vector.sum-i32))

  ;; A query returns only what the caller needs. Neither vector crosses the ABI.
  (type $Summary (struct (field $id i64) (field $name $string) (field $count i32)
    (field $sum i64) (field $size i32) (field $enabled $Bool) (field $weight f64)
    (field $child (@inst $option i32))))
  (@abi.type $Summary (record "id" "name" "count" "sum" "size" "enabled" "weight" "child"))
  (func $inspect (export "inspect") (param $b $bytes) (result (@inst $result (ref $Summary) i32))
    (@effect reads writes allocates)
    (@try (result (@inst $result (ref $Summary) i32))
      (do (@let (($t (call $fb.root $b (@bytes.new 87 76 90 70)))
                 ($values (call $fb.vector $t 2 4)) ($payload (call $fb.vector $t 3 1))
                 ($p (call $fb.target $t 6))
                 ($child (type (@inst $option i32))
                   (if (result (@inst $option i32)) (= $p 0) (then (@option.none i32))
                     (else (@let $c (call $fb.table-at $b (i64.extend_i32_u $p))
                       (block (result (@inst $option i32))
                         (drop (call $fb.string $c 1))
                         (@option.some i32 (call $fb.i32 $c 0 0))))))))
        (@result.ok (ref $Summary) i32 (@$Summary::{
          :id (call $fb.i64 $t 0 0) :name (call $fb.string $t 1)
          :count (call $fb.vector.len $values) :sum (call $fb.vector.sum-i32 $values)
          :size (call $fb.vector.len $payload)
          :enabled (@newtype.wrap $Bool (i64.ne (call $fb.bits $t 4 1 1) 0))
          :weight (call $fb.f64 $t 5 0) :child $child}))))
      (catch $fb.invalid ($code) (@result.err (ref $Summary) i32 $code))))

  (@closure $Add (@capture $delta i32) (param $value i32) (result i32) (@effect pure)
    (+ $value $delta))
  (func $transform (export "transform") (param $b $bytes) (param $delta i32)
    (result (@inst $result $bytes i32)) (@effect reads writes allocates)
    (@match (call $message.decode $b)
      (@case err ($code) (@result.err $bytes i32 $code))
      (@case ok ($m)
        (@result.ok $bytes i32 (call $message.encode (@$Message::{
          :id (struct.get $Message $id $m) :name (struct.get $Message $name $m)
          :values (call (@inst $list.map i32 i32 $Add) (struct.get $Message $values $m) (@closure.new $Add $delta))
          :payload (struct.get $Message $payload $m) :enabled (struct.get $Message $enabled $m)
          :weight (struct.get $Message $weight $m) :child (struct.get $Message $child $m)}))))))

  (@closure $Inspect (param $b $bytes) (result (@inst $result (ref $Summary) i32))
    (@effect reads writes allocates) (call $inspect $b))
  (@closure $Transform (@capture $delta i32) (param $b $bytes) (result (@inst $result $bytes i32))
    (@effect reads writes allocates) (call $transform $b $delta))
  (func $inspect-batch (export "inspect-batch") (param $inputs (@inst $list $bytes))
    (result (@inst $list (@inst $result (ref $Summary) i32))) (@effect reads writes allocates)
    (call (@inst $list.map $bytes (@inst $result (ref $Summary) i32) $Inspect) $inputs (@closure.new $Inspect)))
  (func $transform-batch (export "transform-batch") (param $inputs (@inst $list $bytes)) (param $delta i32)
    (result (@inst $list (@inst $result $bytes i32))) (@effect reads writes allocates)
    (call (@inst $list.map $bytes (@inst $result $bytes i32) $Transform) $inputs (@closure.new $Transform $delta)))
  ;; Keep equivalent materialized APIs for measuring both paths in one instance.
  (func $encode (export "encode") (param $m (ref $Message)) (result $bytes)
    (@effect reads writes allocates) (call $message.encode $m))
  (func $decode (export "decode") (param $b $bytes) (result (@inst $result (ref $Message) i32))
    (@effect reads writes allocates) (call $message.decode $b)))
