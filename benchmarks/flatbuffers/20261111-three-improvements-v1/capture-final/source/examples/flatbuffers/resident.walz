(module
  (@use "walz:core" (type $bytes) (type $result))
  (@use "./message.walz" (type $Message) (func $message.encode) (func $message.decode))
  (type $Input (array (mut i32)))
  ;; Setup and GC-reference results bypass the JS value ABI for resident timing.
  (func $new (export "input-new") (param $n i32) (result (ref $Input)) (@effect allocates)
    (array.new $Input 0 $n))
  (func $set (export "input-set") (param $a (ref $Input)) (param $i i32) (param $v i32) (@effect writes)
    (array.set $Input $a $i $v))
  (func $bytes (export "input-bytes") (param $a (ref $Input)) (result $bytes) (@effect reads)
    (@bytes.from-array $Input $a))
  (func $len (export "byte-length") (param $b $bytes) (result i32) (@effect pure) (@bytes.len $b))
  (func $get (export "byte-get") (param $b $bytes) (param $i i32) (result i32) (@effect pure)
    (@bytes.get $b $i))
  (func $encode (export "encode") (param $m (ref $Message)) (result $bytes)
    (@effect reads writes allocates) (call $message.encode $m))
  (func $decode (export "decode") (param $b $bytes) (result (ref $Message))
    (@effect reads writes allocates)
    (@match (call $message.decode $b)
      (@case ok ($m) $m) (@case err ($code) (unreachable)))))
