(module
  (@use "walz:core" (type $list))
  (@export (opaque $bitmap)
    (func $bitmap.empty) (func $bitmap.full) (func $bitmap.from-words)
    (func $bitmap.len) (func $bitmap.word-len) (func $bitmap.word) (func $bitmap.get)
    (func $bitmap.to-words) (func $bitmap.indices) (func $bitmap.count)
    (func $bitmap.and) (func $bitmap.or) (func $bitmap.xor) (func $bitmap.and-not)
    (func $bitmap.not) (func $bitmap.intersection-count) (func $bitmap.intersects))

  ;; Storage never escapes and no public operation mutates an existing bitmap.
  ;; Bit i is the low-to-high bit of word i/32. Padding is always zero.
  (type $Blocks (array (mut v128)))
  (type $Words (array (mut i32)))
  (type $bitmap (struct (field $length i32) (field $blocks (ref $Blocks))))

  (func $blocks-for (param $n i32) (result i32) (@effect pure)
    (if (result i32) (< $n 0) (then (unreachable))
      (else (+ (i32.shr_u $n 7) (i32.ne (& $n 127) 0)))))
  (func $words-for (param $n i32) (result i32) (@effect pure)
    (+ (i32.shr_u $n 5) (i32.ne (& $n 31) 0)))
  (func $same-length (param $a (ref $bitmap)) (param $b (ref $bitmap)) (@effect pure)
    (if (!= (call $bitmap.len $a) (call $bitmap.len $b)) (then (unreachable)) (else (nop))))
  (func $low-mask (param $n i32) (result i32) (@effect pure)
    (if (result i32) (<= $n 0) (then 0)
      (else (if (result i32) (>= $n 32) (then -1)
        (else (- (i32.shl (i32.const 1) $n) 1))))))
  (func $tail-mask (param $n i32) (result v128) (@effect pure)
    (@let $r (& $n 127)
      (if (result v128) (= $r 0) (then (v128.const i32x4 -1 -1 -1 -1))
        (else
          (i32x4.replace_lane 3
            (i32x4.replace_lane 2
              (i32x4.replace_lane 1 (i32x4.splat (call $low-mask $r))
                (call $low-mask (- $r 32))) (call $low-mask (- $r 64)))
            (call $low-mask (- $r 96)))))))
  (func $seal (param $n i32) (param $blocks (ref $Blocks))
    (result (ref $bitmap)) (@effect reads writes allocates)
    (block (result (ref $bitmap))
      (if (i32.ne (array.len $blocks) 0)
        (then (@let $last (- (array.len $blocks) 1)
          (array.set $Blocks $blocks $last
            (v128.and (array.get $Blocks $blocks $last) (call $tail-mask $n)))))
        (else (nop)))
      (struct.new $bitmap $n $blocks)))

  (func $bitmap.len (param $b (ref $bitmap)) (result i32) (@effect pure)
    (struct.get $bitmap $length $b))
  (func $bitmap.word-len (param $b (ref $bitmap)) (result i32) (@effect pure)
    (call $words-for (call $bitmap.len $b)))
  (func $bitmap.empty (param $n i32) (result (ref $bitmap)) (@effect allocates)
    (struct.new $bitmap $n (array.new $Blocks (v128.const i32x4 0 0 0 0) (call $blocks-for $n))))
  (func $bitmap.full (param $n i32) (result (ref $bitmap)) (@effect reads writes allocates)
    (call $seal $n (array.new $Blocks (v128.const i32x4 -1 -1 -1 -1) (call $blocks-for $n))))
  (func $input-word (param $words $list<i32>) (param $i i32) (result i32) (@effect pure)
    (if (result i32) (i32.lt_u $i (@list.len i32 $words))
      (then (@list.get i32 $words $i)) (else 0)))
  (func $bitmap.from-words (param $n i32) (param $words $list<i32>)
    (result (ref $bitmap)) (@effect reads writes allocates)
    (@let $count (call $blocks-for $n)
      (block (result (ref $bitmap))
        (if (!= (@list.len i32 $words) (call $words-for $n)) (then (unreachable)) (else (nop)))
        (@let $out (array.new $Blocks (v128.const i32x4 0 0 0 0) $count)
          (block (result (ref $bitmap))
            (@for $pack (bind $i i32 0) (while (< $i $count)) (step (+ $i 1))
              (@let $at (i32.shl $i 2)
                (array.set $Blocks $out $i
                  (i32x4.replace_lane 3
                    (i32x4.replace_lane 2
                      (i32x4.replace_lane 1 (i32x4.splat (call $input-word $words $at))
                        (call $input-word $words (+ $at 1))) (call $input-word $words (+ $at 2)))
                    (call $input-word $words (+ $at 3))))))
            (call $seal $n $out))))))
  (func $bitmap.word (param $b (ref $bitmap)) (param $i i32) (result i32) (@effect reads)
    (block (result i32)
      (if (i32.ge_u $i (call $bitmap.word-len $b)) (then (unreachable)) (else (nop)))
      (@let (($v (array.get $Blocks (struct.get $bitmap $blocks $b) (i32.shr_u $i 2)))
             ($lane (& $i 3)))
        (if (result i32) (= $lane 0) (then (i32x4.extract_lane 0 $v))
          (else (if (result i32) (= $lane 1) (then (i32x4.extract_lane 1 $v))
            (else (if (result i32) (= $lane 2) (then (i32x4.extract_lane 2 $v))
              (else (i32x4.extract_lane 3 $v))))))))))
  (func $bitmap.get (param $b (ref $bitmap)) (param $i i32) (result i32) (@effect reads)
    (block (result i32)
      (if (i32.ge_u $i (call $bitmap.len $b)) (then (unreachable)) (else (nop)))
      (i32.ne (& (call $bitmap.word $b (i32.shr_u $i 5))
        (i32.shl (i32.const 1) (& $i 31))) 0)))
  (func $bitmap.to-words (param $b (ref $bitmap)) (result $list<i32>)
    (@effect reads writes allocates)
    (@let (($n (call $bitmap.word-len $b)) ($out (array.new $Words 0 $n)))
      (block (result $list<i32>)
        (@for $copy (bind $i i32 0) (while (< $i $n)) (step (+ $i 1))
          (array.set $Words $out $i (call $bitmap.word $b $i)))
        (@list.from-array i32 $Words $out))))

  (func $popcount (param $v v128) (result i32) (@effect pure)
    (@let $s (i32x4.extadd_pairwise_i16x8_u
        (i16x8.extadd_pairwise_i8x16_u (i8x16.popcnt $v)))
      (+ (+ (i32x4.extract_lane 0 $s) (i32x4.extract_lane 1 $s))
         (+ (i32x4.extract_lane 2 $s) (i32x4.extract_lane 3 $s)))))
  (func $bitmap.count (param $b (ref $bitmap)) (result i32) (@effect reads)
    (@let $xs (struct.get $bitmap $blocks $b)
      (@loop $count (bind $i i32 0) (bind $total i32 0) (result i32)
        (if (result i32) (= $i (array.len $xs)) (then $total)
          (else (@recur $count (+ $i 1) (+ $total (call $popcount (array.get $Blocks $xs $i)))))))))
  (func $bitmap.intersection-count (param $a (ref $bitmap)) (param $b (ref $bitmap))
    (result i32) (@effect reads)
    (block (result i32)
      (call $same-length $a $b)
      (@let (($xs (struct.get $bitmap $blocks $a)) ($ys (struct.get $bitmap $blocks $b)))
        (@loop $count (bind $i i32 0) (bind $total i32 0) (result i32)
          (if (result i32) (= $i (array.len $xs)) (then $total)
            (else (@recur $count (+ $i 1) (+ $total
              (call $popcount (v128.and (array.get $Blocks $xs $i) (array.get $Blocks $ys $i)))))))))))
  (func $bitmap.intersects (param $a (ref $bitmap)) (param $b (ref $bitmap))
    (result i32) (@effect reads)
    (block (result i32)
      (call $same-length $a $b)
      (@let (($xs (struct.get $bitmap $blocks $a)) ($ys (struct.get $bitmap $blocks $b)))
        (@loop $find (bind $i i32 0) (result i32)
          (if (result i32) (= $i (array.len $xs)) (then 0)
            (else (if (result i32)
              (v128.any_true (v128.and (array.get $Blocks $xs $i) (array.get $Blocks $ys $i)))
              (then 1) (else (@recur $find (+ $i 1))))))))))
  (func $bitmap.not (param $b (ref $bitmap)) (result (ref $bitmap))
    (@effect reads writes allocates)
    (@let (($xs (struct.get $bitmap $blocks $b))
           ($out (array.new $Blocks (v128.const i32x4 0 0 0 0) (array.len $xs))))
      (block (result (ref $bitmap))
        (@for $map (bind $i i32 0) (while (< $i (array.len $xs))) (step (+ $i 1))
          (array.set $Blocks $out $i (v128.not (array.get $Blocks $xs $i))))
        (call $seal (call $bitmap.len $b) $out))))
  (func $bitmap.indices (param $b (ref $bitmap)) (result $list<i32>)
    (@effect reads writes allocates)
    (@let $out (array.new $Words 0 (call $bitmap.count $b))
      (block (result $list<i32>)
        (@loop $words (bind $i i32 0) (bind $at i32 0)
          (if (< $i (call $bitmap.word-len $b))
            (then (@let $next
              (@loop $bits (bind $word i32 (call $bitmap.word $b $i)) (bind $cursor i32 $at) (result i32)
                (if (result i32) (= $word 0) (then $cursor)
                  (else (block (result i32)
                    (array.set $Words $out $cursor (+ (i32.shl $i 5) (i32.ctz $word)))
                    (@recur $bits (& $word (- $word 1)) (+ $cursor 1))))))
              (@recur $words (+ $i 1) $next))) (else (nop))))
        (@list.from-array i32 $Words $out))))
  (func $bitmap.and (param $a (ref $bitmap)) (param $b (ref $bitmap))
    (result (ref $bitmap)) (@effect reads writes allocates)
    (block (result (ref $bitmap))
      (call $same-length $a $b)
      (@let (($xs (struct.get $bitmap $blocks $a)) ($ys (struct.get $bitmap $blocks $b))
             ($out (array.new $Blocks (v128.const i32x4 0 0 0 0) (array.len $xs))))
        (block (result (ref $bitmap))
          (@for $map (bind $i i32 0) (while (< $i (array.len $xs))) (step (+ $i 1))
            (array.set $Blocks $out $i (v128.and (array.get $Blocks $xs $i) (array.get $Blocks $ys $i))))
          (struct.new $bitmap (call $bitmap.len $a) $out)))))
  (func $bitmap.or (param $a (ref $bitmap)) (param $b (ref $bitmap))
    (result (ref $bitmap)) (@effect reads writes allocates)
    (block (result (ref $bitmap))
      (call $same-length $a $b)
      (@let (($xs (struct.get $bitmap $blocks $a)) ($ys (struct.get $bitmap $blocks $b))
             ($out (array.new $Blocks (v128.const i32x4 0 0 0 0) (array.len $xs))))
        (block (result (ref $bitmap))
          (@for $map (bind $i i32 0) (while (< $i (array.len $xs))) (step (+ $i 1))
            (array.set $Blocks $out $i (v128.or (array.get $Blocks $xs $i) (array.get $Blocks $ys $i))))
          (struct.new $bitmap (call $bitmap.len $a) $out)))))
  (func $bitmap.xor (param $a (ref $bitmap)) (param $b (ref $bitmap))
    (result (ref $bitmap)) (@effect reads writes allocates)
    (block (result (ref $bitmap))
      (call $same-length $a $b)
      (@let (($xs (struct.get $bitmap $blocks $a)) ($ys (struct.get $bitmap $blocks $b))
             ($out (array.new $Blocks (v128.const i32x4 0 0 0 0) (array.len $xs))))
        (block (result (ref $bitmap))
          (@for $map (bind $i i32 0) (while (< $i (array.len $xs))) (step (+ $i 1))
            (array.set $Blocks $out $i (v128.xor (array.get $Blocks $xs $i) (array.get $Blocks $ys $i))))
          (struct.new $bitmap (call $bitmap.len $a) $out)))))
  (func $bitmap.and-not (param $a (ref $bitmap)) (param $b (ref $bitmap))
    (result (ref $bitmap)) (@effect reads writes allocates)
    (block (result (ref $bitmap))
      (call $same-length $a $b)
      (@let (($xs (struct.get $bitmap $blocks $a)) ($ys (struct.get $bitmap $blocks $b))
             ($out (array.new $Blocks (v128.const i32x4 0 0 0 0) (array.len $xs))))
        (block (result (ref $bitmap))
          (@for $map (bind $i i32 0) (while (< $i (array.len $xs))) (step (+ $i 1))
            (array.set $Blocks $out $i (v128.andnot (array.get $Blocks $xs $i) (array.get $Blocks $ys $i))))
          (struct.new $bitmap (call $bitmap.len $a) $out)))))
)
