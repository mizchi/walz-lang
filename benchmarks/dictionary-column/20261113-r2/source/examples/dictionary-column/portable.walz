(module
  (@use "walz:core" (type $string) (type $list))
  (@use "../../walz/simd/dictionary-column.walz"
    (func $dictionary-column.from-list) (func $dictionary-column.from-codes)
    (func $dictionary-column.dictionary) (func $dictionary-column.codes)
    (func $dictionary-column.get) (func $dictionary-column.decode)
    (func $dictionary-column.eq) (func $dictionary-column.in) (func $dictionary-column.count-many))
  (@use "../../walz/simd/bitmap.walz" (func $bitmap.indices) (func $bitmap.and) (func $bitmap.count))
  (@use "../../walz/simd/i32-column.walz" (func $i32-column.from-list)
    (func $i32-column.between) (func $i32-column.sum-where))
  (type $encoded (struct (field $dictionary $list<$string>) (field $codes $list<i32>)))
  (@abi.type $encoded (record "dictionary" "codes"))
  (type $query-result (struct (field $count i32) (field $sum i64) (field $indices $list<i32>)))
  (@abi.type $query-result (record "count" "sum" "indices"))

  (func $encode (export "encode") (param $values $list<$string>) (result (ref $encoded))
    (@effect reads writes allocates)
    (@let $column (call $dictionary-column.from-list $values)
      (@$encoded::{:dictionary (call $dictionary-column.dictionary $column)
        :codes (call $dictionary-column.codes $column)})))
  (func $decode (export "decode") (param $value (ref $encoded)) (result $list<$string>)
    (@effect reads writes allocates)
    (call $dictionary-column.decode (call $dictionary-column.from-codes
      (struct.get $encoded $dictionary $value) (struct.get $encoded $codes $value))))
  (func $get (export "get") (param $value (ref $encoded)) (param $i i32) (result $string)
    (@effect reads writes allocates)
    (call $dictionary-column.get (call $dictionary-column.from-codes
      (struct.get $encoded $dictionary $value) (struct.get $encoded $codes $value)) $i))
  (func $select (export "select") (param $values $list<$string>) (param $keys $list<$string>)
    (result $list<i32>) (@effect reads writes allocates)
    (call $bitmap.indices (call $dictionary-column.in (call $dictionary-column.from-list $values) $keys)))
  (func $equal (export "equal") (param $value (ref $encoded)) (param $key $string)
    (result $list<i32>) (@effect reads writes allocates)
    (call $bitmap.indices (call $dictionary-column.eq
      (call $dictionary-column.from-codes (struct.get $encoded $dictionary $value) (struct.get $encoded $codes $value)) $key)))
  (func $count-many (export "count-many") (param $values $list<$string>) (param $keys $list<$string>)
    (result $list<i32>) (@effect reads writes allocates)
    (call $dictionary-column.count-many (call $dictionary-column.from-list $values) $keys))
  (func $count-encoded (export "count-encoded") (param $value (ref $encoded)) (param $keys $list<$string>)
    (result $list<i32>) (@effect reads writes allocates)
    (call $dictionary-column.count-many (call $dictionary-column.from-codes
      (struct.get $encoded $dictionary $value) (struct.get $encoded $codes $value)) $keys))
  (func $query (export "query") (param $categories $list<$string>) (param $amounts $list<i32>)
    (param $keys $list<$string>) (param $lo i32) (param $hi i32)
    (result (ref $query-result)) (@effect reads writes allocates)
    (@let (($labels (call $dictionary-column.from-list $categories))
           ($numbers (call $i32-column.from-list $amounts))
           ($selected (call $bitmap.and (call $dictionary-column.in $labels $keys)
             (call $i32-column.between $numbers $lo $hi))))
      (@$query-result::{:count (call $bitmap.count $selected)
        :sum (call $i32-column.sum-where $numbers $selected) :indices (call $bitmap.indices $selected)})))
)
