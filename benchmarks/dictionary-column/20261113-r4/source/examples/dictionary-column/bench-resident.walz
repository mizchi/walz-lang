(module
  (@use "walz:core" (type $string) (type $bytes) (type $list) (func $bytes.equal)
    (func $string.s64) (func $string.concat))
  (@use "../../walz/simd/dictionary-column.walz" (type $dictionary-column)
    (func $dictionary-column.from-list) (func $dictionary-column.from-codes)
    (func $dictionary-column.dictionary) (func $dictionary-column.dictionary-len)
    (func $dictionary-column.code-column) (func $dictionary-column.find-code)
    (func $dictionary-column.count-many) (func $dictionary-column.in) (func $dictionary-column.query-between))
  (@use "../../walz/simd/i32-column.walz" (type $i32-column) (type $i32-query-result) (func $i32-column.from-list)
    (func $i32-column.get) (func $i32-column.between) (func $i32-column.sum-where))
  (@use "../../walz/simd/bitmap.walz" (func $bitmap.and) (func $bitmap.count) (func $bitmap.indices))
  (type $Strings (array (mut $string)))
  (type $Numbers (array (mut i32)))
  (type $Answer (struct (field $count i32) (field $sum i64) (field $indices $list<i32>)))

  (func $strings (export "strings-new") (param $n i32) (result (ref $Strings)) (@effect allocates)
    (array.new $Strings "" $n))
  (func $set-label (export "label-set") (param $xs (ref $Strings)) (param $i i32)
    (param $token i32) (param $unicode i32) (@effect reads writes allocates)
    (array.set $Strings $xs $i (call $string.concat
      (if (result $string) $unicode (then "地域🦀-") (else "category-"))
      (call $string.s64 (i64.extend_i32_s $token)))))
  (func $copy-label (export "label-copy") (param $to (ref $Strings)) (param $i i32)
    (param $from (ref $Strings)) (param $j i32) (@effect reads writes)
    (array.set $Strings $to $i (array.get $Strings $from $j)))
  (func $freeze (export "strings-freeze") (param $xs (ref $Strings)) (result $list<$string>) (@effect reads allocates)
    (@list.from-array $string $Strings $xs))
  (func $numbers (export "numbers-new") (param $n i32) (result (ref $Numbers)) (@effect allocates)
    (array.new $Numbers 0 $n))
  (func $set-number (export "number-set") (param $xs (ref $Numbers)) (param $i i32) (param $value i32)
    (@effect writes) (array.set $Numbers $xs $i $value))
  (func $number-list (export "numbers-freeze") (param $xs (ref $Numbers)) (result $list<i32>) (@effect reads allocates)
    (@list.from-array i32 $Numbers $xs))
  (func $dictionary-key-equal (export "dictionary-key-equal") (param $column (ref $dictionary-column))
    (param $i i32) (param $vocabulary (ref $Strings)) (param $id i32) (result i32) (@effect reads)
    (call $bytes.equal
      (@string.bytes (@list.get $string (call $dictionary-column.dictionary $column) $i))
      (@string.bytes (array.get $Strings $vocabulary $id))))
  (func $column-code (export "column-code") (param $column (ref $dictionary-column)) (param $i i32)
    (result i32) (@effect reads)
    (call $i32-column.get (call $dictionary-column.code-column $column) $i))
  (func $counts-get (export "counts-get") (param $counts $list<i32>) (param $i i32) (result i32) (@effect pure)
    (@list.get i32 $counts $i))
  (func $counts-len (export "counts-len") (param $counts $list<i32>) (result i32) (@effect pure)
    (@list.len i32 $counts))
  (func $scalar-count-many (export "scalar-count-many") (param $column (ref $dictionary-column))
    (param $codes (ref $Numbers)) (param $queries $list<$string>) (result $list<i32>)
    (@effect reads writes allocates)
    (@let (($n (@list.len $string $queries)) ($out (array.new $Numbers 0 $n)))
      (block (result $list<i32>)
        (@for $queries (bind $q i32 0) (while (< $q $n)) (step (+ $q 1))
          (array.set $Numbers $out $q
            (@match (call $dictionary-column.find-code $column (@list.get $string $queries $q))
              (@case none () 0)
              (@case some ($id)
                (@loop $count (bind $i i32 0) (bind $total i32 0) (result i32)
                  (if (result i32) (= $i (array.len $codes)) (then $total)
                    (else (@recur $count (+ $i 1) (+ $total (= (array.get $Numbers $codes $i) $id))))))))))
        (@list.from-array i32 $Numbers $out))))
  (func $query (export "query") (param $column (ref $dictionary-column)) (param $amounts (ref $i32-column))
    (param $keys $list<$string>) (param $lo i32) (param $hi i32) (result (ref $Answer))
    (@effect reads writes allocates)
    (@let $selected (call $bitmap.and (call $dictionary-column.in $column $keys)
        (call $i32-column.between $amounts $lo $hi))
      (@$Answer::{:count (call $bitmap.count $selected)
        :sum (call $i32-column.sum-where $amounts $selected) :indices (call $bitmap.indices $selected)})))
  (func $query-fused (export "query-fused") (param $column (ref $dictionary-column)) (param $amounts (ref $i32-column))
    (param $keys $list<$string>) (param $lo i32) (param $hi i32) (result (ref $Answer))
    (@effect reads writes allocates)
    (@let $answer (call $dictionary-column.query-between $column $amounts $keys $lo $hi)
      (@$Answer::{:count (struct.get $i32-query-result $count $answer)
        :sum (struct.get $i32-query-result $sum $answer) :indices (struct.get $i32-query-result $indices $answer)})))
  (func $answer-count (export "answer-count") (param $answer (ref $Answer)) (result i32) (@effect pure)
    (struct.get $Answer $count $answer))
  (func $answer-sum (export "answer-sum") (param $answer (ref $Answer)) (result i64) (@effect pure)
    (struct.get $Answer $sum $answer))
  (func $answer-indices (export "answer-indices") (param $answer (ref $Answer)) (result $list<i32>) (@effect pure)
    (struct.get $Answer $indices $answer))
  (export "encode" (func $dictionary-column.from-list))
  (export "from-codes" (func $dictionary-column.from-codes))
  (export "dictionary-len" (func $dictionary-column.dictionary-len))
  (export "count-many" (func $dictionary-column.count-many))
  (export "amounts" (func $i32-column.from-list)))
