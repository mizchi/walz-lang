(module
  (@use "walz:core" (type $list) (type $string))
  (@use "./value.walz" (type $cell) (func $cell.new) (func $cell.kind) (func $cell.number))
  (@use "./numeric-store.walz" (type $numeric-store) (func $numeric-store.len) (func $numeric-store.kind) (func $numeric-store.number))
  (@use "./number-column.walz" (type $number-column) (func $number-column.prepare) (func $number-column.prepare-store))
  (@export (opaque $column) (func $column.new) (func $column.new-numeric) (func $column.len) (func $column.name)
    (func $column.get) (func $column.kind) (func $column.number) (func $column.values) (func $column.numeric) (func $column.boxed-count))
  (type $Cache (array (mut (ref null $cell))))
  (type $Cells (array (mut (ref $cell))))
  ;; Logical values are immutable. Views/caches are private and monotone.
  ;; Lazy per-row Cells are canonical: repeated get and full views share identity.
  (type $column (struct (field $name $string) (field $length i32) (field $store (ref null $numeric-store)) (field $empty $string)
    (field $values (mut (@inst $list (ref $cell)))) (field $boxed (mut i32))
    (field $cache (mut (ref null $Cache))) (field $boxed-count (mut i32))
    (field $numeric-known (mut i32)) (field $numeric (mut (ref null $number-column)))))
  (func $column.new (param $name $string) (param $values (@inst $list (ref $cell))) (result (ref $column)) (@effect allocates)
    (struct.new $column $name (@list.len (ref $cell) $values) (ref.null $numeric-store) "" $values 1
      (ref.null $Cache) (@list.len (ref $cell) $values) 0 (ref.null $number-column)))
  (func $column.new-numeric (param $name $string) (param $store (ref $numeric-store)) (param $empty $string)
    (result (ref $column)) (@effect allocates)
    (struct.new $column $name (call $numeric-store.len $store) $store $empty (@list.new (ref $cell)) 0
      (ref.null $Cache) 0 0 (ref.null $number-column)))
  (func $column.len (param $c (ref $column)) (result i32) (@effect pure) (struct.get $column $length $c))
  (func $column.name (param $c (ref $column)) (result $string) (@effect pure) (struct.get $column $name $c))
  (func $column.boxed-count (param $c (ref $column)) (result i32) (@effect reads) (struct.get $column $boxed-count $c))
  (func $column.kind (param $c (ref $column)) (param $row i32) (result i32) (@effect reads)
    (@let $store (struct.get $column $store $c)
      (if (result i32) (ref.is_null $store)
        (then (call $cell.kind (@list.get (ref $cell) (struct.get $column $values $c) $row)))
        (else (call $numeric-store.kind (ref.as_non_null $store) $row)))))
  (func $column.number (param $c (ref $column)) (param $row i32) (result f64) (@effect reads)
    (@let $store (struct.get $column $store $c)
      (if (result f64) (ref.is_null $store)
        (then (call $cell.number (@list.get (ref $cell) (struct.get $column $values $c) $row)))
        (else (call $numeric-store.number (ref.as_non_null $store) $row)))))
  (func $column.get (param $c (ref $column)) (param $row i32) (result (ref $cell)) (@effect reads writes allocates)
    (block (result (ref $cell))
      (if (i32.ge_u $row (call $column.len $c)) (then (unreachable)) (else (nop)))
      (if (struct.get $column $boxed $c) (then (return (@list.get (ref $cell) (struct.get $column $values $c) $row))) (else (nop)))
      (@let (($cache (if (result (ref $Cache)) (ref.is_null (struct.get $column $cache $c))
                 (then (@let $v (array.new $Cache (ref.null $cell) (call $column.len $c))
                   (block (result (ref $Cache)) (struct.set $column $cache $c $v) $v)))
                 (else (ref.as_non_null (struct.get $column $cache $c)))))
             ($found (array.get $Cache $cache $row)))
        (if (result (ref $cell)) (ref.is_null $found)
          (then (@let $v (call $cell.new (call $column.kind $c $row) (call $column.number $c $row) (struct.get $column $empty $c))
            (block (result (ref $cell))
              (array.set $Cache $cache $row $v)
              (struct.set $column $boxed-count $c (+ (struct.get $column $boxed-count $c) 1)) $v)))
          (else (ref.as_non_null $found))))))
  (func $column.values (param $c (ref $column)) (result (@inst $list (ref $cell))) (@effect reads writes allocates)
    (block (result (@inst $list (ref $cell)))
      (if (struct.get $column $boxed $c) (then (return (struct.get $column $values $c))) (else (nop)))
      (@let (($n (call $column.len $c)) ($out (array.new $Cells (call $cell.new 0 (f64.const 0) (struct.get $column $empty $c)) $n)))
        (block (result (@inst $list (ref $cell)))
          (@for $box (bind $i i32 0) (while (< $i $n)) (step (+ $i 1)) (array.set $Cells $out $i (call $column.get $c $i)))
          (@let $view (@list.from-array (ref $cell) $Cells $out)
            (block (result (@inst $list (ref $cell)))
              (struct.set $column $values $c $view) (struct.set $column $boxed $c 1)
              (struct.set $column $cache $c (ref.null $Cache)) $view))))))
  (func $column.numeric (param $c (ref $column)) (result (ref null $number-column)) (@effect reads writes allocates)
    (block (result (ref null $number-column))
      (if (i32.eqz (struct.get $column $numeric-known $c))
        (then (@let $store (struct.get $column $store $c)
          (block
            (struct.set $column $numeric $c (if (result (ref null $number-column)) (ref.is_null $store)
              (then (call $number-column.prepare (struct.get $column $values $c)))
              (else (call $number-column.prepare-store (ref.as_non_null $store)))))
            (struct.set $column $numeric-known $c 1)))) (else (nop)))
      (struct.get $column $numeric $c)))
)
