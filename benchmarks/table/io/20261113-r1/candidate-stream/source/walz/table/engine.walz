  (type $Ints (array (mut i32)))
  (type $Masks (array (mut i8)))
  (type $Cells (array (mut (ref $cell))))
  (type $Columns (array (mut (ref $column))))
  (type $Exprs (array (mut (ref $expr))))
  (type $Group (struct (field $first i32) (field $rows (ref (@inst $list-builder i32)))))
  (type $Output (struct (field $name $string) (field $values (ref (@inst $list-builder (ref $cell))))))
  (type $Outputs (array (mut (ref $Output))))
  (func $min (param $a i32) (param $b i32) (result i32) (@effect pure)
    (if (result i32) (< $a $b) (then $a) (else $b)))
  (func $max (param $a i32) (param $b i32) (result i32) (@effect pure)
    (if (result i32) (> $a $b) (then $a) (else $b)))
  (func $undefined (result (ref $cell)) (@effect allocates) (call $cell.new 0 (f64.const 0) ""))
  (func $number (param $v f64) (result (ref $cell)) (@effect allocates) (call $cell.new 3 $v ""))
  (func $boolean (param $v i32) (result (ref $cell)) (@effect allocates) (call $cell.new 2 (f64.convert_i32_s $v) ""))
  (func $check-columns (param $columns (@inst $list (ref $column))) (param $n i32) (@effect reads writes allocates)
    (@let $names (call $dict.new<i32>)
      (@for $check (bind $i i32 0) (while (< $i (@list.len (ref $column) $columns))) (step (+ $i 1))
        (@let $c (@list.get (ref $column) $columns $i)
          (block
            (if (!= (call $column.len $c) $n) (then (unreachable)) (else (nop)))
            (@match (call $dict.set<i32> $names (call $column.name $c) $i)
              (@case some ($previous) (unreachable)) (@case none () (nop))))))))
  (func $identity (param $n i32) (result $list<i32>) (@effect reads writes allocates)
    (@let $out (array.new $Ints 0 $n)
      (block (result $list<i32>)
        (@for $fill (bind $i i32 0) (while (< $i $n)) (step (+ $i 1)) (array.set $Ints $out $i $i))
        (@list.from-array i32 $Ints $out))))
  (func $table.new (param $columns (@inst $list (ref $column))) (param $n i32) (result (ref $table))
    (@effect reads writes allocates)
    (block (result (ref $table))
      (if (< $n 0) (then (unreachable)) (else (nop)))
      (call $check-columns $columns $n)
      (@let $rows (call $identity $n) (struct.new $table $columns $n $rows $rows (@list.new (ref $column)) 1))))
  (func $table.num-rows (param $t (ref $table)) (result i32) (@effect pure) (@list.len i32 (struct.get $table $order $t)))
  (func $table.num-cols (param $t (ref $table)) (result i32) (@effect pure) (@list.len (ref $column) (struct.get $table $columns $t)))
  (func $table.column (param $t (ref $table)) (param $i i32) (result (ref $column)) (@effect pure)
