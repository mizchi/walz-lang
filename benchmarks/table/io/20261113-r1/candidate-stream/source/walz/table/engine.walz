          (if (= $op 11) (then (return (call $number (f64.sub $x $y)))) (else (nop)))
          (if (= $op 12) (then (return (call $number (f64.mul $x $y)))) (else (nop)))
          (if (= $op 13) (then (return (call $number (f64.div $x $y)))) (else (nop)))
          (if (= $op 22) (then (return (call $boolean (f64.lt $x $y)))) (else (nop)))
          (if (= $op 23) (then (return (call $boolean (f64.le $x $y)))) (else (nop)))
          (if (= $op 24) (then (return (call $boolean (f64.gt $x $y)))) (else (nop)))
          (if (= $op 25) (then (return (call $boolean (f64.ge $x $y)))) (else (nop)))
