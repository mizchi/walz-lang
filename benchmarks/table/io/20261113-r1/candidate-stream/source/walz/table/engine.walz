  (func $prefix (param $data (ref $Ints)) (param $n i32) (result $list<i32>) (@effect reads writes allocates)
    (@let $out (array.new $Ints 0 $n)
      (block (result $list<i32>) (array.copy $Ints $Ints $out 0 $data 0 $n) (@list.from-array i32 $Ints $out))))
  (func $filter-rows (param $t (ref $table)) (param $rows $list<i32>) (param $e (ref $expr))
    (result $list<i32>) (@effect reads writes allocates)
    (@let $out (array.new $Ints 0 (@list.len i32 $rows))
