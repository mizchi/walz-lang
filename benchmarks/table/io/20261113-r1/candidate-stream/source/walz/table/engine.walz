        (if (= $op 0) (then (return (struct.new $predicate 0 (f64.const 0)
          (* 3 (call $cell.truthy (struct.get $expr $value $e))) (ref.null $number-column) (ref.null $predicate) (ref.null $predicate) -1 0))) (else (nop)))
