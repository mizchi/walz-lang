    (result (ref $cell)) (@effect reads writes allocates)
    (block (result (ref $cell))
      (if (|| (= $op 20) (= $op 21))
        (then (return (call $boolean (^ (call $cell.equal $a $b) (= $op 21))))) (else (nop)))
      (if (|| (= $op 26) (= $op 27))
        (then (return (call $boolean (^
          (if (result i32) (|| (< (call $cell.kind $a) 2) (< (call $cell.kind $b) 2))
            (then (&& (< (call $cell.kind $a) 2) (< (call $cell.kind $b) 2)))
