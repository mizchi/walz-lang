  (func $table.groupby (param $t (ref $table)) (param $columns (@inst $list (ref $column)))
    (result (ref $table)) (@effect reads writes allocates)
    (block (result (ref $table))
      (call $check-columns $columns (struct.get $table $length $t))
      (struct.new $table (struct.get $table $columns $t) (struct.get $table $length $t)
        (struct.get $table $rows $t) (struct.get $table $order $t) $columns (struct.get $table $aligned $t))))
  (func $table.ungroup (param $t (ref $table)) (result (ref $table)) (@effect reads writes allocates)
    (call $table.groupby $t (@list.new (ref $column))))
  (func $table.unorder (param $t (ref $table)) (result (ref $table)) (@effect allocates)
    (call $with-rows $t (struct.get $table $rows $t) (struct.get $table $rows $t) 1))
  (func $expr.literal (param $v (ref $cell)) (result (ref $expr)) (@effect allocates)
    (struct.new $expr 0 $v 0 (ref.null $expr) (ref.null $expr) (ref.null $expr)))
  (func $expr.column (param $i i32) (result (ref $expr)) (@effect allocates)
    (if (result (ref $expr)) (< $i 0) (then (unreachable))
