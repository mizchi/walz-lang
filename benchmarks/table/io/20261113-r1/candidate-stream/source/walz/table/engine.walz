    (func $string-builder.new) (func $string-builder.text) (func $string-builder.finish)
    (func $list-builder.new) (func $list-builder.push) (func $list-builder.finish)
    (func $dict.new) (func $dict.get) (func $dict.set) (func $dict.len))
