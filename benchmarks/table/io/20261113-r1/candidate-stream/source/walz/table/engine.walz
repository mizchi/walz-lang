    (func $expr.number) (func $expr.string) (func $expr.boolean) (func $expr.count) (func $expr.add) (func $expr.sub) (func $expr.mul) (func $expr.div) (func $expr.eq) (func $expr.ne) (func $expr.lt) (func $expr.le) (func $expr.gt) (func $expr.ge) (func $expr.and) (func $expr.or) (func $expr.coalesce) (func $expr.sum) (func $expr.mean) (func $expr.min) (func $expr.max) (func $expr.valid) (func $expr.invalid) (func $expr.distinct))
  (type $predicate (struct (field $op i32) (field $number f64) (field $bits i32)
