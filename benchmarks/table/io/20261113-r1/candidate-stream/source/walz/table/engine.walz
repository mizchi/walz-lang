  (func $expr.node (param $op i32) (param $a (ref $expr)) (param $b (ref $expr)) (param $c (ref $expr))
    (result (ref $expr)) (@effect allocates)
    (if (result (ref $expr)) (|| (&& (>= $op 10) (<= $op 13))
        (|| (&& (>= $op 20) (<= $op 27)) (|| (&& (>= $op 30) (<= $op 36)) (&& (>= $op 100) (<= $op 107)))))
      (then (struct.new $expr $op (call $undefined) 0 $a $b $c)) (else (unreachable))))
  ;; Bind the full expression to its schema before scanning any row. Invalid
  ;; columns and aggregate placement are errors even on empty inputs and in a
  ;; branch that would not execute for the current data.
  (func $check-expr (param $t (ref $table)) (param $e (ref $expr)) (param $aggregate i32)
    (@effect pure)
    (@let $op (struct.get $expr $op $e)
      (block
        (if (= $op 0) (then (return)) (else (nop)))
        (if (= $op 1) (then (block
          (if $aggregate (then (unreachable)) (else (nop)))
          (drop (call $table.column $t (struct.get $expr $column $e))) (return))) (else (nop)))
        (if (>= $op 100)
          (then (block
            (if (i32.eqz $aggregate) (then (unreachable)) (else (nop)))
            (call $check-expr $t (ref.as_non_null (struct.get $expr $a $e)) 0)
            (return))) (else (nop)))
        (call $check-expr $t (ref.as_non_null (struct.get $expr $a $e)) $aggregate)
        (if (|| (= $op 32) (|| (= $op 33) (= $op 36))) (then (return)) (else (nop)))
        (call $check-expr $t (ref.as_non_null (struct.get $expr $b $e)) $aggregate)
        (if (= $op 34) (then (call $check-expr $t (ref.as_non_null (struct.get $expr $c $e)) $aggregate)) (else (nop))))))

  ;; Convenience builders for native Walz programs. The numeric node protocol
  ;; remains available for the JS/WIT adapters; application code can use names.
  (func $expr.number (param $v f64) (result (ref $expr)) (@effect allocates)
    (call $expr.literal (call $cell.new 3 $v "")))
  (func $expr.string (param $v $string) (result (ref $expr)) (@effect allocates)
    (call $expr.literal (call $cell.new 4 (f64.const 0) $v)))
  (func $expr.boolean (param $v i32) (result (ref $expr)) (@effect allocates)
    (call $expr.literal (call $cell.new 2 (f64.convert_i32_s (i32.ne $v 0)) "")))
  (func $expr.count (result (ref $expr)) (@effect allocates)
    (@let $e (call $expr.literal (call $undefined)) (call $expr.node 100 $e $e $e)))
  (func $expr.add (param $a (ref $expr)) (param $b (ref $expr)) (result (ref $expr)) (@effect allocates)
    (call $expr.node 10 $a $b $b))
  (func $expr.sub (param $a (ref $expr)) (param $b (ref $expr)) (result (ref $expr)) (@effect allocates)
    (call $expr.node 11 $a $b $b))
  (func $expr.mul (param $a (ref $expr)) (param $b (ref $expr)) (result (ref $expr)) (@effect allocates)
    (call $expr.node 12 $a $b $b))
  (func $expr.div (param $a (ref $expr)) (param $b (ref $expr)) (result (ref $expr)) (@effect allocates)
    (call $expr.node 13 $a $b $b))
  (func $expr.eq (param $a (ref $expr)) (param $b (ref $expr)) (result (ref $expr)) (@effect allocates)
    (call $expr.node 20 $a $b $b))
  (func $expr.ne (param $a (ref $expr)) (param $b (ref $expr)) (result (ref $expr)) (@effect allocates)
    (call $expr.node 21 $a $b $b))
  (func $expr.lt (param $a (ref $expr)) (param $b (ref $expr)) (result (ref $expr)) (@effect allocates)
    (call $expr.node 22 $a $b $b))
  (func $expr.le (param $a (ref $expr)) (param $b (ref $expr)) (result (ref $expr)) (@effect allocates)
    (call $expr.node 23 $a $b $b))
  (func $expr.gt (param $a (ref $expr)) (param $b (ref $expr)) (result (ref $expr)) (@effect allocates)
    (call $expr.node 24 $a $b $b))
  (func $expr.ge (param $a (ref $expr)) (param $b (ref $expr)) (result (ref $expr)) (@effect allocates)
    (call $expr.node 25 $a $b $b))
  (func $expr.and (param $a (ref $expr)) (param $b (ref $expr)) (result (ref $expr)) (@effect allocates)
    (call $expr.node 30 $a $b $b))
  (func $expr.or (param $a (ref $expr)) (param $b (ref $expr)) (result (ref $expr)) (@effect allocates)
    (call $expr.node 31 $a $b $b))
  (func $expr.coalesce (param $a (ref $expr)) (param $b (ref $expr)) (result (ref $expr)) (@effect allocates)
    (call $expr.node 35 $a $b $b))
  (func $expr.sum (param $e (ref $expr)) (result (ref $expr)) (@effect allocates)
    (call $expr.node 101 $e $e $e))
  (func $expr.mean (param $e (ref $expr)) (result (ref $expr)) (@effect allocates)
    (call $expr.node 102 $e $e $e))
  (func $expr.min (param $e (ref $expr)) (result (ref $expr)) (@effect allocates)
    (call $expr.node 103 $e $e $e))
  (func $expr.max (param $e (ref $expr)) (result (ref $expr)) (@effect allocates)
    (call $expr.node 104 $e $e $e))
  (func $expr.valid (param $e (ref $expr)) (result (ref $expr)) (@effect allocates)
    (call $expr.node 105 $e $e $e))
  (func $expr.invalid (param $e (ref $expr)) (result (ref $expr)) (@effect allocates)
    (call $expr.node 106 $e $e $e))
  (func $expr.distinct (param $e (ref $expr)) (result (ref $expr)) (@effect allocates)
    (call $expr.node 107 $e $e $e))
