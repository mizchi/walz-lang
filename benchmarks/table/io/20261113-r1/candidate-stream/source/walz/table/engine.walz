               ($field (if (result (ref $expr)) $reverse (then $b) (else $a)))
               ($value (if (result (ref $expr)) $reverse (then $a) (else $b)))
               ($column (call $column.numeric (call $table.column $t (struct.get $expr $column $field))))
               ($code (if (result i32) (&& $reverse (&& (>= $op 22) (<= $op 25)))
                 (then (if (result i32) (< $op 24) (then (+ $op 2)) (else (- $op 2)))) (else $op))))
          (if (result (ref null $predicate)) (ref.is_null $column) (then (ref.null $predicate))
            (else (struct.new $predicate $code (call $literal-number $value) 0
              $column (ref.null $predicate) (ref.null $predicate) (struct.get $expr $column $field) 0)))))))
  (func $numeric-mask (param $p (ref $predicate)) (param $row0 i32) (param $row1 i32) (param $scalar i32)
    (result i32) (@effect reads)
    (@let $op (struct.get $predicate $op $p)
      (block (result i32)
        (if (= $op 0) (then (return (struct.get $predicate $bits $p))) (else (nop)))
        (if (< $op 30) (then (return (call $number-column.compare
          (ref.as_non_null (struct.get $predicate $column $p)) $op (struct.get $predicate $number $p) $row0 $row1 $scalar))) (else (nop)))
        (if (&& (i32.eqz $scalar) (struct.get $predicate $fused $p))
          (then (@let (($a (ref.as_non_null (struct.get $predicate $a $p))) ($b (ref.as_non_null (struct.get $predicate $b $p))))
            (return (call $number-column.compare-pair (ref.as_non_null (struct.get $predicate $column $a))
              (struct.get $predicate $op $a) (struct.get $predicate $number $a)
              (struct.get $predicate $op $b) (struct.get $predicate $number $b) (= $op 31) $row0 $row1)))) (else (nop)))
        (@let $a (call $numeric-mask (ref.as_non_null (struct.get $predicate $a $p)) $row0 $row1 $scalar)
          (if (result i32) (= $op 32) (then (^ $a 3))
            (else (if (result i32) (|| (&& (= $op 30) (= $a 0)) (&& (= $op 31) (= $a 3)))
              (then $a)
              (else (@let $b (call $numeric-mask (ref.as_non_null (struct.get $predicate $b $p)) $row0 $row1 $scalar)
                (if (result i32) (= $op 30) (then (& $a $b)) (else (| $a $b))))))))))))
  ;; Mask storage is private and does not escape. Allocate row IDs at their
  ;; exact final length, then publish through the ordinary snapshot constructor.
  ;; This removes prefix allocation/copy without weakening list immutability.
  (func $collect-masks (param $rows $list<i32>) (param $masks (ref $Masks)) (param $kept i32)
    (result $list<i32>) (@effect reads writes allocates)
    (@let (($length (@list.len i32 $rows)) ($out (array.new $Ints 0 $kept)))
      (@loop $emit (bind $i i32 0) (bind $at i32 0) (result $list<i32>)
        (if (result $list<i32>) (= $i $length) (then (@list.from-array i32 $Ints $out))
          (else (@let (($bits (array.get_u $Masks $masks (i32.shr_u $i 1)))
                       ($keep0 (& $bits 1)) ($keep1 (& (i32.shr_u $bits 1) 1))
                       ($pair (< (+ $i 1) $length)))
            (block (result $list<i32>)
              (if $keep0 (then (array.set $Ints $out $at (@list.get i32 $rows $i))) (else (nop)))
              (if $keep1 (then (array.set $Ints $out (+ $at $keep0) (@list.get i32 $rows (+ $i 1)))) (else (nop)))
              (@recur $emit (+ $i (+ 1 $pair)) (+ $at (+ $keep0 $keep1))))))))))
  (func $filter-packed (param $rows $list<i32>) (param $p (ref $predicate)) (param $scalar i32)
    (result $list<i32>) (@effect reads writes allocates)
    (block (result $list<i32>)
      (if (= (struct.get $predicate $op $p) 0)
        (then (return (if (result $list<i32>) (struct.get $predicate $bits $p) (then $rows) (else (@list.new i32))))) (else (nop)))
      (@let (($length (@list.len i32 $rows)) ($masks (array.new $Masks 0 (+ (i32.shr_u $length 1) (& $length 1)))))
        (@loop $scan (bind $i i32 0) (bind $n i32 0) (result $list<i32>)
          (if (result $list<i32>) (= $i $length) (then (call $collect-masks $rows $masks $n))
            (else (@let (($pair (< (+ $i 1) $length)) ($row0 (@list.get i32 $rows $i))
                         ($row1 (if (result i32) $pair (then (@list.get i32 $rows (+ $i 1))) (else -1)))
                         ($bits (& (call $numeric-mask $p $row0 $row1 $scalar) (if (result i32) $pair (then 3) (else 1)))))
              (block (result $list<i32>)
                (array.set $Masks $masks (i32.shr_u $i 1) $bits)
                (@recur $scan (+ $i (+ 1 $pair)) (+ $n (i32.popcnt $bits)))))))))))
  (func $table.filter-scalar (param $t (ref $table)) (param $e (ref $expr)) (result (ref $table)) (@effect reads writes allocates)
    (block (result (ref $table))
      (call $check-expr $t $e 0)
      (@let (($rows (struct.get $table $rows $t)) ($order (struct.get $table $order $t)) ($selected (call $filter-rows $t $rows $e)))
        (call $with-rows $t $selected
          (if (result $list<i32>) (struct.get $table $aligned $t) (then $selected) (else (call $filter-rows $t $order $e)))
          (struct.get $table $aligned $t)))))
  (func $filter-mode (param $t (ref $table)) (param $e (ref $expr)) (param $scalar i32)
    (result (ref $table)) (@effect reads writes allocates)
    (block (result (ref $table))
      (call $check-expr $t $e 0)
      (if (i32.eqz (call $numeric-shape $e)) (then (return (call $table.filter-scalar $t $e))) (else (nop)))
      (@let $p (call $plan-numeric $t $e)
        (if (result (ref $table)) (ref.is_null $p) (then (call $table.filter-scalar $t $e))
          (else (@let $selected (call $filter-packed (struct.get $table $rows $t) (ref.as_non_null $p) $scalar)
            (call $with-rows $t $selected
              (if (result $list<i32>) (struct.get $table $aligned $t) (then $selected)
                (else (call $filter-packed (struct.get $table $order $t) (ref.as_non_null $p) $scalar)))
              (struct.get $table $aligned $t))))))))
  (func $table.filter (param $t (ref $table)) (param $e (ref $expr)) (result (ref $table)) (@effect reads writes allocates)
    (call $filter-mode $t $e 0))
  (func $table.filter-packed-scalar (param $t (ref $table)) (param $e (ref $expr)) (result (ref $table)) (@effect reads writes allocates)
    (call $filter-mode $t $e 1))
  (func $table.derive (param $t (ref $table)) (param $name $string) (param $e (ref $expr))
    (result (ref $column)) (@effect reads writes allocates)
    (@let (($out (array.new $Cells (call $undefined) (struct.get $table $length $t))) ($rows (struct.get $table $rows $t)))
      (block (result (ref $column))
        (call $check-expr $t $e 0)
        (@for $fill (bind $i i32 0) (while (< $i (@list.len i32 $rows))) (step (+ $i 1))
          (@let $row (@list.get i32 $rows $i) (array.set $Cells $out $row (call $eval $e $t $row $rows))))
        (call $column.new $name (@list.from-array (ref $cell) $Cells $out)))))
  (func $table.slice (param $t (ref $table)) (param $start i32) (param $end i32) (result (ref $table))
    (@effect reads writes allocates)
    (@let (($order (struct.get $table $order $t)) ($n (@list.len i32 $order))
           ($lo (if (result i32) (< $start 0) (then (call $max 0 (+ $n $start))) (else (call $min $start $n))))
           ($hi (if (result i32) (< $end 0) (then (call $max 0 (+ $n $end))) (else (call $min $end $n))))
           ($out (@list.slice i32 $order $lo (call $max 0 (- $hi $lo)))))
      (block (result (ref $table))
        (if (struct.get $table $aligned $t) (then (return (call $with-rows $t $out $out 1))) (else (nop)))
        (@let (($mask (array.new $Ints 0 (struct.get $table $length $t)))
               ($base (struct.get $table $rows $t)) ($base-out (array.new $Ints 0 (@list.len i32 $base))))
          (block (result (ref $table))
        (@for $mask (bind $i i32 0) (while (< $i (@list.len i32 $out))) (step (+ $i 1))
          (array.set $Ints $mask (@list.get i32 $out $i) 1))
        (@loop $base (bind $i i32 0) (bind $n i32 0) (result (ref $table))
          (if (result (ref $table)) (= $i (@list.len i32 $base)) (then (call $with-rows $t (call $prefix $base-out $n) $out 0))
            (else (@let (($row (@list.get i32 $base $i)) ($keep (array.get $Ints $mask $row)))
              (block (result (ref $table))
                (if $keep (then (array.set $Ints $base-out $n $row)) (else (nop)))
                (@recur $base (+ $i 1) (+ $n $keep))))))))))))

  (func $compare-rows (param $t (ref $table)) (param $a i32) (param $b i32)
    (param $keys (@inst $list (ref $expr))) (param $descending $list<i32>) (result i32) (@effect reads writes allocates)
    (@loop $key (bind $k i32 0) (result i32)
      (if (result i32) (= $k (@list.len (ref $expr) $keys)) (then 0)
        (else (@let (($e (@list.get (ref $expr) $keys $k)) ($rows (struct.get $table $rows $t))
                     ($cmp (call $cell.compare (call $eval $e $t $a $rows) (call $eval $e $t $b $rows))))
          (if (result i32) (= $cmp 0) (then (@recur $key (+ $k 1)))
            (else (if (result i32) (@list.get i32 $descending $k) (then (- 0 $cmp)) (else $cmp)))))))))
  (func $table.orderby (param $t (ref $table)) (param $keys (@inst $list (ref $expr))) (param $descending $list<i32>)
    (result (ref $table)) (@effect reads writes allocates)
    (@let (($rows (struct.get $table $rows $t)) ($n (@list.len i32 $rows))
           ($src (array.new $Ints 0 $n)) ($dst (array.new $Ints 0 $n)))
      (block (result (ref $table))
        (if (!= (@list.len (ref $expr) $keys) (@list.len i32 $descending)) (then (unreachable)) (else (nop)))
        (@for $check (bind $i i32 0) (while (< $i (@list.len (ref $expr) $keys))) (step (+ $i 1))
          (block (call $check-expr $t (@list.get (ref $expr) $keys $i) 0)
            (if (i32.gt_u (@list.get i32 $descending $i) 1) (then (unreachable)) (else (nop)))))
        (@for $copy (bind $i i32 0) (while (< $i $n)) (step (+ $i 1)) (array.set $Ints $src $i (@list.get i32 $rows $i)))
        (@loop $width (bind $width i32 1) (result (ref $table))
          (if (result (ref $table)) (>= $width $n)
            (then (call $with-rows $t $rows (@list.from-array i32 $Ints $src) 0))
            (else (block (result (ref $table))
              (@loop $blocks (bind $lo i32 0)
                (if (< $lo $n)
                  (then (@let (($mid (+ $lo (call $min $width (- $n $lo)))) ($hi (+ $mid (call $min $width (- $n $mid)))))
                    (block
                      (@loop $merge (bind $i i32 $lo) (bind $j i32 $mid) (bind $out i32 $lo)
                        (if (< $out $hi)
                          (then (@let $left (|| (= $j $hi) (&& (< $i $mid)
                              (<= (call $compare-rows $t (array.get $Ints $src $i) (array.get $Ints $src $j) $keys $descending) 0)))
                            (block
                              (array.set $Ints $dst $out (if (result i32) $left (then (array.get $Ints $src $i)) (else (array.get $Ints $src $j))))
                              (@recur $merge (+ $i $left) (+ $j (i32.eqz $left)) (+ $out 1)))))
                          (else (nop))))
                      (@recur $blocks $hi)))) (else (nop))))
              (array.copy $Ints $Ints $src 0 $dst 0 $n)
              (@recur $width (if (result i32) (> $width (i32.shr_u $n 1)) (then $n) (else (* $width 2)))))))))))

  (func $aggregate (param $op i32) (param $arg (ref $expr)) (param $t (ref $table)) (param $rows $list<i32>)
    (result (ref $cell)) (@effect reads writes allocates)
    (if (result (ref $cell)) (= $op 100) (then (call $number (f64.convert_i32_s (@list.len i32 $rows))))
      (else (@let $distinct (call $dict.new<i32>)
        (@loop $scan (bind $i i32 0) (bind $count i32 0) (bind $sum f64 (f64.const 0))
          (bind $best (ref $cell) (call $undefined)) (result (ref $cell))
          (if (result (ref $cell)) (= $i (@list.len i32 $rows))
            (then (if (result (ref $cell)) (|| (= $op 101) (= $op 102))
              (then (if (result (ref $cell)) (= $count 0) (then (call $undefined))
                (else (call $number (if (result f64) (= $op 101) (then $sum) (else (f64.div $sum (f64.convert_i32_s $count))))))))
              (else (if (result (ref $cell)) (|| (= $op 103) (= $op 104)) (then $best)
                (else (if (result (ref $cell)) (= $op 105) (then (call $number (f64.convert_i32_s $count)))
                  (else (if (result (ref $cell)) (= $op 106) (then (call $number (f64.convert_i32_s (- (@list.len i32 $rows) $count))))
                    (else (if (result (ref $cell)) (= $op 107) (then (call $number (f64.convert_i32_s (call $dict.len<i32> $distinct))))
                      (else (unreachable))))))))))))
            (else (@let (($v (call $eval $arg $t (@list.get i32 $rows $i) $rows)) ($valid (call $cell.valid $v)))
              (block (result (ref $cell))
                (if (= $op 107)
                  (then (drop (call $dict.set<i32> $distinct
                    (if (result $string) $valid (then (call $cell.key $v)) (else "invalid")) 1)))
                  (else (nop)))
                (@recur $scan (+ $i 1) (+ $count $valid)
                  (if (result f64) (&& $valid (|| (= $op 101) (= $op 102)))
                    (then (f64.add $sum (call $cell.numeric $v))) (else $sum))
                  (if (result (ref $cell)) (&& $valid (|| (= $count 0)
                    (|| (&& (= $op 103) (< (call $cell.compare $v $best) 0))
                        (&& (= $op 104) (> (call $cell.compare $v $best) 0)))))
                    (then $v) (else $best))))))))))))

  (func $group-key (param $groups (@inst $list (ref $column))) (param $row i32) (result $string)
    (@effect reads writes allocates)
    (@let $out (call $string-builder.new)
      (block (result $string)
        (@for $keys (bind $i i32 0) (while (< $i (@list.len (ref $column) $groups))) (step (+ $i 1))
          (call $string-builder.text $out (call $cell.key
            (call $column.get (@list.get (ref $column) $groups $i) $row))))
        (call $string-builder.finish $out))))
  (func $table.rollup (param $t (ref $table)) (param $names $list<$string>) (param $exprs (@inst $list (ref $expr)))
    (result (ref $table)) (@effect reads writes allocates)
    (@let (($groups (struct.get $table $groups $t)) ($g (@list.len (ref $column) $groups))
           ($rows (struct.get $table $rows $t)) ($order (struct.get $table $order $t))
           ($lookup (call (@inst $dict.new (ref $Group)))) ($found (call (@inst $list-builder.new (ref $Group))))
           ($m (+ $g (@list.len $string $names)))
           ($empty (struct.new $Output "" (call (@inst $list-builder.new (ref $cell)))))
           ($out (array.new $Outputs $empty $m)))
      (block (result (ref $table))
        (if (!= (@list.len $string $names) (@list.len (ref $expr) $exprs)) (then (unreachable)) (else (nop)))
        (@for $check (bind $i i32 0) (while (< $i (@list.len (ref $expr) $exprs))) (step (+ $i 1))
          (call $check-expr $t (@list.get (ref $expr) $exprs $i) 1))
        (if (= $m 0) (then (return (call $table.new (@list.new (ref $column)) 0))) (else (nop)))
        (if (= $g 0)
          (then (@let $group (struct.new $Group -1 (call $list-builder.new<i32>))
            (block (drop (call (@inst $dict.set (ref $Group)) $lookup "" $group))
              (call (@inst $list-builder.push (ref $Group)) $found $group))))
          (else (@for $discover (bind $i i32 0) (while (< $i (@list.len i32 $rows))) (step (+ $i 1))
            (@let (($row (@list.get i32 $rows $i)) ($key (call $group-key $groups $row)))
              (@match (call (@inst $dict.get (ref $Group)) $lookup $key)
                (@case some ($group) (nop))
                (@case none () (@let $group (struct.new $Group $row (call $list-builder.new<i32>))
                  (block (drop (call (@inst $dict.set (ref $Group)) $lookup $key $group))
                    (call (@inst $list-builder.push (ref $Group)) $found $group)))))))))
        (@for $fill (bind $i i32 0) (while (< $i (@list.len i32 $order))) (step (+ $i 1))
          (@let $row (@list.get i32 $order $i)
            (@match (call (@inst $dict.get (ref $Group)) $lookup (call $group-key $groups $row))
              (@case none () (unreachable))
              (@case some ($group) (call $list-builder.push<i32> (struct.get $Group $rows $group) $row)))))
        (@for $columns (bind $i i32 0) (while (< $i $m)) (step (+ $i 1))
          (array.set $Outputs $out $i (struct.new $Output
            (if (result $string) (< $i $g) (then (call $column.name (@list.get (ref $column) $groups $i)))
              (else (@list.get $string $names (- $i $g))))
            (call (@inst $list-builder.new (ref $cell))))))
        (@let $all (call (@inst $list-builder.finish (ref $Group)) $found)
          (block (result (ref $table))
            (@for $each (bind $i i32 0) (while (< $i (@list.len (ref $Group) $all))) (step (+ $i 1))
              (@let (($group (@list.get (ref $Group) $all $i)) ($first (struct.get $Group $first $group))
                     ($members (call $list-builder.finish<i32> (struct.get $Group $rows $group))))
                (@for $cells (bind $j i32 0) (while (< $j $m)) (step (+ $j 1))
                  (call (@inst $list-builder.push (ref $cell)) (struct.get $Output $values (array.get $Outputs $out $j))
                    (if (result (ref $cell)) (< $j $g)
                      (then (call $column.get (@list.get (ref $column) $groups $j) $first))
                      (else (call $eval (@list.get (ref $expr) $exprs (- $j $g)) $t $first $members)))))))
            (@let $columns (call (@inst $list-builder.new (ref $column)))
              (block (result (ref $table))
                (@for $finish (bind $i i32 0) (while (< $i $m)) (step (+ $i 1))
                  (@let $c (array.get $Outputs $out $i)
                    (call (@inst $list-builder.push (ref $column)) $columns
                      (call $column.new (struct.get $Output $name $c)
                        (call (@inst $list-builder.finish (ref $cell)) (struct.get $Output $values $c))))))
                (call $table.new (call (@inst $list-builder.finish (ref $column)) $columns) (@list.len (ref $Group) $all)))))))))
)
