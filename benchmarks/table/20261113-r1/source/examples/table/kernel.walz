(module
  (@use "walz:core" (type $string) (type $list) (type $option))
  (@use "../../walz/table/value.walz" (type $cell) (func $cell.new) (func $cell.kind) (func $cell.number) (func $cell.text))
  (@use "../../walz/table/engine.walz" (type $column) (type $table) (type $expr)
    (func $column.new) (func $column.name) (func $table.new) (func $table.num-rows) (func $table.num-cols)
    (func $table.column) (func $table.get) (func $table.select) (func $table.filter) (func $table.derive)
    (func $table.filter-scalar) (func $table.filter-packed-scalar)
    (func $table.groupby) (func $table.ungroup) (func $table.slice) (func $table.orderby) (func $table.rollup)
    (func $table.is-grouped) (func $expr.literal) (func $expr.column) (func $expr.node))
  (@use "../../walz/table/join.walz" (type $join-column) (func $join-column.new) (func $table.join))
  (type $Bytes (array (mut i8)))
  (type $Cells (array (mut (ref $cell))))
  (type $Columns (array (mut (ref $column))))
  (type $Exprs (array (mut (ref $expr))))
  (type $Ints (array (mut i32)))
  (type $Names (array (mut $string)))
  (type $Layouts (array (mut (ref $join-column))))
  (func $bytes (export "bytes-new") (param $n i32) (result (ref $Bytes)) (@effect allocates) (array.new $Bytes 0 $n))
  (func $byte-set (export "byte-set") (param $v (ref $Bytes)) (param $i i32) (param $x i32) (@effect writes) (array.set $Bytes $v $i $x))
  (func $text (export "text") (param $v (ref $Bytes)) (result $string) (@effect reads writes allocates)
    (@match (@string.from-bytes (@bytes.from-array $Bytes $v))
      (@case none () (unreachable)) (@case some ($text) $text)))
  (func $text-len (export "text-len") (param $v $string) (result i32) (@effect pure) (@string.byte-len $v))
  (func $text-byte (export "text-byte") (param $v $string) (param $i i32) (result i32) (@effect pure) (@bytes.get (@string.bytes $v) $i))
  (func $cells (export "cells-new") (param $n i32) (result (ref $Cells)) (@effect allocates)
    (array.new $Cells (call $cell.new 0 (f64.const 0) "") $n))
  (func $cell-set (export "cell-set") (param $v (ref $Cells)) (param $i i32) (param $x (ref $cell)) (@effect writes) (array.set $Cells $v $i $x))
  (func $column (export "column-new") (param $name $string) (param $v (ref $Cells)) (result (ref $column)) (@effect reads writes allocates)
    (call $column.new $name (@list.from-array (ref $cell) $Cells $v)))
  (func $columns (export "columns-new") (param $n i32) (result (ref $Columns)) (@effect allocates)
    (array.new $Columns (call $column.new "" (@list.new (ref $cell))) $n))
  (func $column-set (export "column-set") (param $v (ref $Columns)) (param $i i32) (param $x (ref $column)) (@effect writes) (array.set $Columns $v $i $x))
  (func $table (export "table-new") (param $v (ref $Columns)) (param $n i32) (result (ref $table)) (@effect reads writes allocates)
    (call $table.new (@list.from-array (ref $column) $Columns $v) $n))
  (func $select (export "select") (param $t (ref $table)) (param $v (ref $Columns)) (result (ref $table)) (@effect reads writes allocates)
    (call $table.select $t (@list.from-array (ref $column) $Columns $v)))
  (func $groupby (export "groupby") (param $t (ref $table)) (param $v (ref $Columns)) (result (ref $table)) (@effect reads writes allocates)
    (call $table.groupby $t (@list.from-array (ref $column) $Columns $v)))
  (func $exprs (export "exprs-new") (param $n i32) (result (ref $Exprs)) (@effect allocates)
    (array.new $Exprs (call $expr.literal (call $cell.new 0 (f64.const 0) "")) $n))
  (func $expr-set (export "expr-set") (param $v (ref $Exprs)) (param $i i32) (param $x (ref $expr)) (@effect writes) (array.set $Exprs $v $i $x))
  (func $ints (export "ints-new") (param $n i32) (result (ref $Ints)) (@effect allocates) (array.new $Ints 0 $n))
  (func $int-set (export "int-set") (param $v (ref $Ints)) (param $i i32) (param $x i32) (@effect writes) (array.set $Ints $v $i $x))
  (func $names (export "names-new") (param $n i32) (result (ref $Names)) (@effect allocates) (array.new $Names "" $n))
  (func $name-set (export "name-set") (param $v (ref $Names)) (param $i i32) (param $x $string) (@effect writes) (array.set $Names $v $i $x))
  (func $orderby (export "orderby") (param $t (ref $table)) (param $keys (ref $Exprs)) (param $desc (ref $Ints))
    (result (ref $table)) (@effect reads writes allocates)
    (call $table.orderby $t (@list.from-array (ref $expr) $Exprs $keys) (@list.from-array i32 $Ints $desc)))
  (func $rollup (export "rollup") (param $t (ref $table)) (param $names (ref $Names)) (param $exprs (ref $Exprs))
    (result (ref $table)) (@effect reads writes allocates)
    (call $table.rollup $t (@list.from-array $string $Names $names) (@list.from-array (ref $expr) $Exprs $exprs)))
  (func $layouts (export "layouts-new") (param $n i32) (result (ref $Layouts)) (@effect allocates)
    (array.new $Layouts (call $join-column.new "" 0 0 0) $n))
  (func $layout-set (export "layout-set") (param $v (ref $Layouts)) (param $i i32) (param $x (ref $join-column))
    (@effect writes) (array.set $Layouts $v $i $x))
  (func $join (export "join") (param $a (ref $table)) (param $b (ref $table))
    (param $left (ref $Ints)) (param $right (ref $Ints)) (param $layout (ref $Layouts)) (param $mode i32)
    (result (ref $table)) (@effect reads writes allocates)
    (call $table.join $a $b (@list.from-array i32 $Ints $left) (@list.from-array i32 $Ints $right)
      (@list.from-array (ref $join-column) $Layouts $layout) $mode))
  (export "layout-new" (func $join-column.new))
  (export "cell-new" (func $cell.new)) (export "cell-kind" (func $cell.kind))
  (export "cell-number" (func $cell.number)) (export "cell-text" (func $cell.text))
  (export "column-name" (func $column.name)) (export "column" (func $table.column))
  (export "num-rows" (func $table.num-rows)) (export "num-cols" (func $table.num-cols))
  (export "get" (func $table.get)) (export "is-grouped" (func $table.is-grouped))
  (export "filter" (func $table.filter)) (export "derive" (func $table.derive))
  (export "filter-scalar" (func $table.filter-scalar))
  (export "filter-packed-scalar" (func $table.filter-packed-scalar))
  (export "ungroup" (func $table.ungroup)) (export "slice" (func $table.slice))
  (export "literal" (func $expr.literal)) (export "field" (func $expr.column)) (export "node" (func $expr.node)))
