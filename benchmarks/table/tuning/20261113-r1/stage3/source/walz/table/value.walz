(module
  (@use "walz:core" (type $string) (func $bytes.equal) (func $string.concat) (func $string.s64)
    (func $string-builder.new) (func $string-builder.text) (func $string-builder.s64) (func $string-builder.finish))
  (@export (opaque $cell) (func $cell.new) (func $cell.kind) (func $cell.number) (func $cell.text)
    (func $cell.truthy) (func $cell.valid) (func $cell.numeric) (func $cell.equal) (func $cell.compare) (func $cell.key))
  ;; 0 undefined, 1 null, 2 boolean, 3 number, 4 string. Public construction
  ;; validates the tag; payloads and published state have no setters.
  (type $cell (struct (field $kind i32) (field $number f64) (field $text $string)))
  (func $cell.new (param $kind i32) (param $number f64) (param $text $string)
    (result (ref $cell)) (@effect allocates)
    (if (result (ref $cell)) (|| (i32.gt_u $kind 4) (&& (= $kind 2)
        (&& (f64.ne $number (f64.const 0)) (f64.ne $number (f64.const 1))))) (then (unreachable))
      (else (struct.new $cell $kind $number $text))))
  (func $cell.kind (param $v (ref $cell)) (result i32) (@effect pure) (struct.get $cell $kind $v))
  (func $cell.number (param $v (ref $cell)) (result f64) (@effect pure) (struct.get $cell $number $v))
  (func $cell.text (param $v (ref $cell)) (result $string) (@effect pure) (struct.get $cell $text $v))
  (func $cell.numeric (param $v (ref $cell)) (result f64) (@effect pure)
    (@let $kind (call $cell.kind $v)
      (if (result f64) (= $kind 0) (then (f64.const nan))
        (else (if (result f64) (= $kind 1) (then (f64.const 0))
          (else (if (result f64) (= $kind 4) (then (unreachable)) (else (call $cell.number $v)))))))))
  (func $cell.truthy (param $v (ref $cell)) (result i32) (@effect pure)
    (@let $kind (call $cell.kind $v)
      (if (result i32) (< $kind 2) (then 0)
        (else (if (result i32) (= $kind 4) (then (!= (@string.byte-len (call $cell.text $v)) 0))
          (else (@let $n (call $cell.number $v) (&& (f64.ne $n (f64.const 0)) (f64.eq $n $n)))))))))
  (func $cell.valid (param $v (ref $cell)) (result i32) (@effect pure)
    (&& (>= (call $cell.kind $v) 2)
      (|| (!= (call $cell.kind $v) 3) (f64.eq (call $cell.number $v) (call $cell.number $v)))))
  (func $cell.equal (param $a (ref $cell)) (param $b (ref $cell)) (result i32) (@effect pure)
    (@let $kind (call $cell.kind $a)
      (&& (= $kind (call $cell.kind $b))
        (if (result i32) (< $kind 2) (then 1)
          (else (if (result i32) (= $kind 4)
            (then (call $bytes.equal (@string.bytes (call $cell.text $a)) (@string.bytes (call $cell.text $b))))
            (else (f64.eq (call $cell.number $a) (call $cell.number $b)))))))))

  ;; Decode well-formed UTF-8 and compare in UTF-16 code-unit order, as JS does.
  ;; Astral scalars sort after D7FF and before E000; order within each range is
  ;; monotonic. Lone surrogates are rejected at the JS ingestion boundary.
  (func $width (param $s $string) (param $i i32) (result i32) (@effect pure)
    (@let $b (@bytes.get (@string.bytes $s) $i)
      (if (result i32) (< $b 128) (then 1)
        (else (if (result i32) (< $b 224) (then 2) (else (if (result i32) (< $b 240) (then 3) (else 4))))))))
  (func $scalar (param $s $string) (param $i i32) (result i32) (@effect pure)
    (@let (($b (@string.bytes $s)) ($n (call $width $s $i)) ($first (@bytes.get $b $i)))
      (if (result i32) (= $n 1) (then $first)
        (else (@loop $decode (bind $j i32 1)
          (bind $cp i32 (& $first (if (result i32) (= $n 2) (then 31) (else (if (result i32) (= $n 3) (then 15) (else 7))))))
          (result i32)
          (if (result i32) (= $j $n)
            (then (if (result i32) (>= $cp 65536) (then (+ (- $cp 65536) 55296))
              (else (if (result i32) (>= $cp 57344) (then (+ $cp 1048576)) (else $cp)))))
            (else (@recur $decode (+ $j 1) (| (i32.shl $cp 6) (& (@bytes.get $b (+ $i $j)) 63))))))))))
  (func $text-compare (param $a $string) (param $b $string) (result i32) (@effect pure)
    (@loop $compare (bind $i i32 0) (bind $j i32 0) (result i32)
      (if (result i32) (= $i (@string.byte-len $a))
        (then (if (result i32) (= $j (@string.byte-len $b)) (then 0) (else -1)))
        (else (if (result i32) (= $j (@string.byte-len $b)) (then 1)
          (else (@let (($x (call $scalar $a $i)) ($y (call $scalar $b $j)))
            (if (result i32) (= $x $y)
              (then (@recur $compare (+ $i (call $width $a $i)) (+ $j (call $width $b $j))))
              (else (if (result i32) (< $x $y) (then -1) (else 1)))))))))))
  (func $rank (param $v (ref $cell)) (result i32) (@effect pure)
    (if (result i32) (< (call $cell.kind $v) 2) (then 0)
      (else (if (result i32) (call $cell.valid $v) (then 2) (else 1)))))
  (func $cell.compare (param $a (ref $cell)) (param $b (ref $cell)) (result i32) (@effect pure)
    (@let (($x (call $rank $a)) ($y (call $rank $b)))
      (if (result i32) (!= $x $y) (then (if (result i32) (< $x $y) (then -1) (else 1)))
        (else (if (result i32) (< $x 2) (then 0)
          (else (if (result i32) (&& (= (call $cell.kind $a) 4) (= (call $cell.kind $b) 4))
            (then (call $text-compare (call $cell.text $a) (call $cell.text $b)))
            (else (@let (($n (call $cell.numeric $a)) ($m (call $cell.numeric $b)))
              (if (result i32) (f64.eq $n $m) (then 0)
                (else (if (result i32) (f64.lt $n $m) (then -1) (else 1)))))))))))))
  ;; Length-prefix strings and tag scalar keys, so composite grouping keys
  ;; cannot collide. Normalize numeric zero and NaN for SameValueZero grouping.
  (func $cell.key (param $v (ref $cell)) (result $string) (@effect reads writes allocates)
    (@let (($kind (call $cell.kind $v)) ($out (call $string-builder.new)))
      (block (result $string)
        (call $string-builder.s64 $out (i64.extend_i32_s $kind))
        (call $string-builder.text $out ":")
        (if (= $kind 4)
          (then (block
            (call $string-builder.s64 $out (i64.extend_i32_u (@string.byte-len (call $cell.text $v))))
            (call $string-builder.text $out ":")
            (call $string-builder.text $out (call $cell.text $v))))
          (else (if (>= $kind 2)
            (then (@let $n (call $cell.number $v)
              (if (f64.ne $n $n) (then (call $string-builder.text $out "NaN"))
                (else (call $string-builder.s64 $out
                  (if (result i64) (f64.eq $n (f64.const 0)) (then (i64.const 0)) (else (i64.reinterpret_f64 $n))))))))
            (else (nop)))))
        (call $string-builder.text $out ";")
        (call $string-builder.finish $out))))
)
