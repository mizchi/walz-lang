(module
  (@use "walz:core" (type $list))
  (@use "./value.walz" (type $cell) (func $cell.kind) (func $cell.numeric))
  (@export (opaque $number-column) (func $number-column.prepare) (func $number-column.compare))
  ;; Private, immutable after publication. No source cells or table references.
  ;; Each flag word holds two strict-number bits and two non-null numeric bits.
  (type $Blocks (array (mut v128)))
  (type $Flags (array (mut i32)))
  (type $number-column (struct (field $length i32) (field $blocks (ref $Blocks)) (field $flags (ref $Flags))))
  (func $flag (param $v (ref $cell)) (result i32) (@effect pure)
    (| (= (call $cell.kind $v) 3) (i32.shl (>= (call $cell.kind $v) 2) 2)))
  (func $number-column.prepare (param $xs (@inst $list (ref $cell))) (result (ref null $number-column))
    (@effect reads writes allocates)
    (@let $n (@list.len (ref $cell) $xs)
      (block (result (ref null $number-column))
        (@for $eligible (bind $i i32 0) (while (< $i $n)) (step (+ $i 1))
          (if (> (call $cell.kind (@list.get (ref $cell) $xs $i)) 3)
            (then (return (ref.null $number-column))) (else (nop))))
        (@let (($count (+ (i32.shr_u $n 1) (& $n 1)))
               ($blocks (array.new $Blocks (v128.const f64x2 0 0) $count))
               ($flags (array.new $Flags 0 $count)))
          (block (result (ref null $number-column))
            (@for $pack (bind $i i32 0) (while (< $i $count)) (step (+ $i 1))
              (@let (($at (i32.shl $i 1)) ($a (@list.get (ref $cell) $xs $at)))
                (block
                  (array.set $Blocks $blocks $i (f64x2.splat (call $cell.numeric $a)))
                  (array.set $Flags $flags $i (call $flag $a))
                  (if (< (+ $at 1) $n)
                    (then (@let $b (@list.get (ref $cell) $xs (+ $at 1))
                      (block
                        (array.set $Blocks $blocks $i (f64x2.replace_lane 1 (array.get $Blocks $blocks $i) (call $cell.numeric $b)))
                        (array.set $Flags $flags $i (| (call $flag $a) (i32.shl (call $flag $b) 1))))))
                    (else (nop))))))
            (struct.new $number-column $n $blocks $flags))))))
  (func $get (param $c (ref $number-column)) (param $row i32) (result f64) (@effect reads)
    (block (result f64)
      (if (i32.ge_u $row (struct.get $number-column $length $c)) (then (unreachable)) (else (nop)))
      (@let $v (array.get $Blocks (struct.get $number-column $blocks $c) (i32.shr_u $row 1))
        (if (result f64) (& $row 1) (then (f64x2.extract_lane 1 $v)) (else (f64x2.extract_lane 0 $v))))))
  (func $flags (param $c (ref $number-column)) (param $row i32) (result i32) (@effect reads)
    (& (i32.shr_u (array.get $Flags (struct.get $number-column $flags $c) (i32.shr_u $row 1)) (& $row 1)) 5))
  (func $scalar (param $op i32) (param $x f64) (param $y f64) (result i32) (@effect pure)
    (block (result i32)
      (if (= $op 22) (then (return (f64.lt $x $y))) (else (nop)))
      (if (= $op 23) (then (return (f64.le $x $y))) (else (nop)))
      (if (= $op 24) (then (return (f64.gt $x $y))) (else (nop)))
      (if (= $op 25) (then (return (f64.ge $x $y))) (else (nop)))
      (f64.eq $x $y)))
  (func $vector (param $op i32) (param $x v128) (param $y v128) (result i32) (@effect pure)
    (block (result i32)
      (if (= $op 22) (then (return (i64x2.bitmask (f64x2.lt $x $y)))) (else (nop)))
      (if (= $op 23) (then (return (i64x2.bitmask (f64x2.le $x $y)))) (else (nop)))
      (if (= $op 24) (then (return (i64x2.bitmask (f64x2.gt $x $y)))) (else (nop)))
      (if (= $op 25) (then (return (i64x2.bitmask (f64x2.ge $x $y)))) (else (nop)))
      (i64x2.bitmask (f64x2.eq $x $y))))
  ;; row1=-1 denotes a tail lane. Callers mask that lane before emitting IDs.
  (func $number-column.compare (param $c (ref $number-column)) (param $op i32) (param $needle f64)
    (param $row0 i32) (param $row1 i32) (param $scalar i32) (result i32) (@effect reads)
    (@let (($adjacent (&& (= (& $row0 1) 0) (= $row1 (+ $row0 1))))
           ($x (if (result v128) $adjacent
             (then (array.get $Blocks (struct.get $number-column $blocks $c) (i32.shr_u $row0 1)))
             (else (f64x2.replace_lane 1 (f64x2.splat (call $get $c $row0))
               (if (result f64) (< $row1 0) (then (f64.const 0)) (else (call $get $c $row1)))))))
           ($bits (if (result i32) $scalar
             (then (| (call $scalar $op (f64x2.extract_lane 0 $x) $needle)
               (i32.shl (call $scalar $op (f64x2.extract_lane 1 $x) $needle) 1)))
             (else (call $vector $op $x (f64x2.splat $needle))))))
      (block (result i32)
        ;; Ordered comparisons already encode null/undefined/Boolean conversion
        ;; in the f64 lanes. Only equality needs a separate read of type masks.
        (if (&& (>= $op 22) (<= $op 25)) (then (return $bits)) (else (nop)))
        (@let (($flags (if (result i32) $adjacent
                 (then (array.get $Flags (struct.get $number-column $flags $c) (i32.shr_u $row0 1)))
                 (else (| (call $flags $c $row0)
                   (if (result i32) (< $row1 0) (then 0) (else (i32.shl (call $flags $c $row1) 1)))))))
               ($shift (if (result i32) (>= $op 26) (then 2) (else 0))))
          (^ (& $bits (& (i32.shr_u $flags $shift) 3)) (* 3 (& $op 1)))))))
)
