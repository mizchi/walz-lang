(module
  (@use "./parse.walz" (type $Row) (type $Error) (func $parse))
  (@use "walz:core"
    (type $string) (type $list) (type $tuple) (type $option) (type $result) (type $dict)
    (func $bytes.equal) (func $dict.new) (func $dict.get) (func $dict.set) (func $dict.entries)
    (func $json.object-builder.new) (func $json.object-builder.u64)
    (func $json.object-builder.s64) (func $json.object-builder.object)
    (func $json.object-builder.finish))
  (type $State (struct (field $accepted (mut i32)) (field $rejected (mut i32))
    (field $totals (ref (@inst $dict i64)))))
  (@type.alias $Entry (@inst $tuple $string i64))

  (func $add (param $a i64) (param $b i64)
    (result (@inst $result i64 (ref $Error))) (@effect allocates)
    (@let $sum (+ $a $b)
      (if (result (@inst $result i64 (ref $Error)))
        (|| (&& (> $b 0) (< $sum $a)) (&& (< $b 0) (> $sum $a)))
        (then (@result.err (@variant.new $Error overflow)))
        (else (@result.ok $sum)))))

  (func $reject (param $state (ref $State)) (@effect reads writes)
    (struct.set $State $rejected $state (+ (struct.get $State $rejected $state) 1)))

  (func $accept (param $state (ref $State)) (param $row (ref $Row))
    (@effect reads writes allocates)
    (@let (($totals (struct.get $State $totals $state))
           ($key (struct.get $Row $category $row))
           ($amount (struct.get $Row $amount $row)))
      (@let $previous
        (@match (@inst $option i64) (result i64) (call (@inst $dict.get i64) $totals $key)
          (case none () (i64.const 0)) (case some ($n) $n))
        (@match (call $add $previous $amount)
          (case err ($error) (call $reject $state))
          (case ok ($sum)
            (block
              (drop (call (@inst $dict.set i64) $totals $key $sum))
              (struct.set $State $accepted $state (+ (struct.get $State $accepted $state) 1))))))))

  (func $render (param $state (ref $State)) (result $string)
    (@effect reads writes allocates)
    (@let (($output (call $json.object-builder.new))
           ($totals (call $json.object-builder.new))
           ($entries (call (@inst $dict.entries i64) (struct.get $State $totals $state))))
      (block (result $string)
        (@for $items (bind $i i32 0)
          (while (< $i (@list.len $Entry $entries))) (step (+ $i 1))
          (@let ($key $amount) (@list.get $Entry $entries $i)
            (call $json.object-builder.s64 $totals $key $amount)))
        (call $json.object-builder.u64 $output (@string.lit "accepted") (i64.extend_i32_u (struct.get $State $accepted $state)))
        (call $json.object-builder.u64 $output (@string.lit "rejected") (i64.extend_i32_u (struct.get $State $rejected $state)))
        (call $json.object-builder.object $output (@string.lit "totals") $totals)
        (call $json.object-builder.finish $output))))

  (func $summarize (export "summarize") (param $lines (@inst $list $string))
    (result $string) (@effect reads writes allocates)
    (@let $state (@$State::{:accepted 0 :rejected 0 :totals (call (@inst $dict.new i64))})
      (block (result $string)
        (@for $rows (bind $i i32 0)
          (while (< $i (@list.len $string $lines))) (step (+ $i 1))
          (@match (call $parse (@list.get $string $lines $i))
            (case err ($error) (call $reject $state))
            (case ok ($row) (call $accept $state $row))))
        (call $render $state))))

  (func $main (export "main") (result $string) (@effect reads writes allocates)
    (call $summarize (@list.new $string (@string.lit "{\"category\":\"food\",\"amount\":40}")
      (@string.lit "{\"category\":\"food\",\"amount\":2}") (@string.lit "invalid"))))
  (@test "public entry runs"
    (call $bytes.equal (@string.bytes (call $main))
      (@string.bytes (@string.lit "{\"accepted\":2,\"rejected\":1,\"totals\":{\"food\":42}}"))))
  (@bench "expense aggregation" (result i32) (@bytes.len (@string.bytes (call $main)))))
