;; Parent-only positive control, appended to counted.wlt by the harness test.
;; This source is never part of either evaluation role's materials.
(module
  (%import "wlt:std"
    (func $string.parse-u64)
    (func $builder.new)
    (func $builder.text)
    (func $builder.u64)
    (func $builder.finish))
  (%type.alias $EvalWide (%inst $pair (ref $stock.State) i64))
  (func $count64 (export "count64")
    (result (%inst $result i64 i32))
    (%effects reads writes allocates host suspends)
    (%let (($ledger (call $stock.new (i32.const 4096)))
           ($initial $EvalWide (%pair.new (local.get $ledger) (i64.const 0)))
           ($input (call $read-lines)))
      (%result.let ($final)
        (%stream.fold-result (%move $input) (local.get $initial) ($state $line)
          (%let ($ledger $count) (local.get $state)
            (%result.let () (call $app.process (local.get $ledger) (local.get $line))
              (%result.ok (%pair.new (local.get $ledger) (i64.add (local.get $count) (i64.const 1)))))))
        (%let ($ledger $count) (local.get $final)
          (%result.ok (local.get $count))))))
  (func $format-count (export "format-count") (param $input $text)
    (result (%inst $result $text i32)) (%effects reads writes allocates)
    (%match (call $string.parse-u64 (local.get $input))
      (case none () (%result.err (i32.const 1)))
      (case some ($n)
        (%let $builder (call $builder.new)
          (block (result (%inst $result $text i32))
            (call $builder.text (local.get $builder) (%text.lit "count="))
            (call $builder.u64 (local.get $builder) (local.get $n))
            (%result.ok (call $builder.finish (local.get $builder)))))))))
