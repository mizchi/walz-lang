;; Parent-only positive control, appended to counted.walz by the harness test.
;; This source is never part of either evaluation role's materials.
(module
  (@use "walz:core"
    (func $string.parse-u64)
    (func $string-builder.new)
    (func $string-builder.text)
    (func $string-builder.u64)
    (func $string-builder.finish))
  (@type.alias $EvalWide (@inst $tuple (ref $stock.State) i64))
  (func $count64 (export "count64")
    (result (@inst $result i64 i32))
    (@effect reads writes allocates host suspends)
    (@let (($ledger (call $stock.new (i32.const 4096)))
           ($initial $EvalWide (@tuple.new (local.get $ledger) (i64.const 0)))
           ($input (call $read-lines)))
      (@result.let ($final)
        (@stream.fold-result (@move $input) (local.get $initial) ($state $line)
          (@let ($ledger $count) (local.get $state)
            (@result.let () (call $app.process (local.get $ledger) (local.get $line))
              (@result.ok (@tuple.new (local.get $ledger) (i64.add (local.get $count) (i64.const 1)))))))
        (@let ($ledger $count) (local.get $final)
          (@result.ok (local.get $count))))))
  (func $format-count (export "format-count") (param $input $string)
    (result (@inst $result $string i32)) (@effect reads writes allocates)
    (@match (call $string.parse-u64 (local.get $input))
      (case none () (@result.err (i32.const 1)))
      (case some ($n)
        (@let $builder (call $string-builder.new)
          (block (result (@inst $result $string i32))
            (call $string-builder.text (local.get $builder) (@string.lit "count="))
            (call $string-builder.u64 (local.get $builder) (local.get $n))
            (@result.ok (call $string-builder.finish (local.get $builder)))))))))
