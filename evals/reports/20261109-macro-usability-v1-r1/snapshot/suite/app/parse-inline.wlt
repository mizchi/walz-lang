(module
  (%use "./schema.wlt" (type $Row) (type $Error) (func $parse-json) (func $field))
  (%use "wlt:core" (type $string) (type $result)
    (func $json.as-string) (func $json.as-number)
    (func $option.ok-or) (func $string.parse-s64))
  (%export (type $Row) (type $Error) (func $parse))
  (%type.alias $Failure (ref $Error))
  (func $parse (param $line $string)
    (result (%inst $result (ref $Row) $Failure))
    (%effect reads writes allocates)
    (%result.do
      ($object (call $parse-json $line))
      ($category-value (call $field $object "category"))
      ($category (call (%inst $option.ok-or $string $Failure)
        (call $json.as-string $category-value) (%variant.new $Error wrong-type "category")))
      ($amount-value (call $field $object "amount"))
      ($amount-text (call (%inst $option.ok-or $string $Failure)
        (call $json.as-number $amount-value) (%variant.new $Error wrong-type "amount")))
      ($amount (call (%inst $option.ok-or i64 $Failure)
        (call $string.parse-s64 $amount-text) (%variant.new $Error invalid-amount)))
      (%result.ok (%$Row::{:category $category :amount $amount})))))
