(module
  (%use "./schema.wlt" (type $Row) (type $Error) (func $parse-json) (func $field))
  (%use "./syntax.wlt" (macro $ok-or))
  (%use "wlt:core" (type $string) (type $result)
    (func $json.as-string) (func $json.as-number) (func $string.parse-s64))
  (%export (type $Row) (type $Error) (func $parse))
  (func $parse (param $line $string)
    (result (%inst $result (ref $Row) (ref $Error)))
    (%effect reads writes allocates)
    (%result.do
      ($object (call $parse-json $line))
      ($category-value (call $field $object "category"))
      ($category (%$ok-or (call $json.as-string $category-value)
        (%variant.new $Error wrong-type "category")))
      ($amount-value (call $field $object "amount"))
      ($amount-text (%$ok-or (call $json.as-number $amount-value)
        (%variant.new $Error wrong-type "amount")))
      ($amount (%$ok-or (call $string.parse-s64 $amount-text)
        (%variant.new $Error invalid-amount)))
      (%result.ok (%$Row::{:category $category :amount $amount})))))
