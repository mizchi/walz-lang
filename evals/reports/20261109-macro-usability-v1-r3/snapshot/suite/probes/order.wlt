(module
  (type $Counter (struct (field $value (mut i32))))
  (%macro $twice (rule (?value:expr) (when (Add ?value))
    (%let $saved ?value (+ $saved $saved))))
  (%macro $with (rule (?name:ident ?value:expr ?body:expr)
    (bind ?name ?body) (%let ?name ?value ?body)))
  (func $next (param $counter (ref $Counter)) (result i32)
    (%effect reads writes)
    (block (result i32)
      (struct.set $Counter $value $counter (+ (struct.get $Counter $value $counter) 1))
      (struct.get $Counter $value $counter)))
  (func $main (export "main") (result i32) (%effect reads writes allocates)
    (%let (($saved (type i32) 20) ($counter (struct.new $Counter 0)))
      (+ (%$with $saved (+ $saved (call $next $counter)) (%$twice $saved))
        (- (struct.get $Counter $value $counter) 1)))))
