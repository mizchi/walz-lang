(module
  (@use "walz:core"
    (type $string) (type $option) (type $result) (type $json-value)
    (func $json.parse) (func $json.get) (func $json.as-string)
    (func $json.as-number) (func $option.ok-or) (func $string.parse-s64))
  (@export (type $Row) (type $Error)
    (func $parse-json) (func $field) (func $string-field) (func $s64-field))
  (type $Row (struct (field $category $string) (field $amount i64)))
  (type $Error
    (@variant (invalid-json i32) (missing-field $string) (wrong-type $string)
      (invalid-amount) (overflow)))
  (@type.alias $Failure (ref $Error))
  (func $parse-json (param $line $string)
    (result (@inst $result (ref $json-value) $Failure))
    (@effect reads writes allocates)
    (@match (call $json.parse $line)
      (case err ($offset) (@result.err (@variant.new $Error invalid-json $offset)))
      (case ok ($value) (@result.ok $value))))
  (func $field (param $object (ref $json-value)) (param $key $string)
    (result (@inst $result (ref $json-value) $Failure))
    (@effect reads writes allocates)
    (call (@inst $option.ok-or (ref $json-value) $Failure)
      (call $json.get $object $key) (@variant.new $Error missing-field $key)))
  (func $string-field (param $object (ref $json-value)) (param $key $string)
    (result (@inst $result $string $Failure))
    (@effect reads writes allocates)
    (@result.do
      ($value (call $field $object $key))
      (call (@inst $option.ok-or $string $Failure)
        (call $json.as-string $value) (@variant.new $Error wrong-type $key))))
  (func $s64-field (param $object (ref $json-value)) (param $key $string)
    (result (@inst $result i64 $Failure))
    (@effect reads writes allocates)
    (@result.do
      ($value (call $field $object $key))
      ($lexeme (call (@inst $option.ok-or $string $Failure)
        (call $json.as-number $value) (@variant.new $Error wrong-type $key)))
      (call (@inst $option.ok-or i64 $Failure)
        (call $string.parse-s64 $lexeme) (@variant.new $Error invalid-amount)))))
