(module
  (@use "walz:core" (type $stream) (type $future) (type $result) (type $task) (type $tuple) (type $option))
  (type $StreamWriter (@resource "stream-writer" $close-stream))
  (type $FutureWriter (@resource "future-writer" $close-future))
  (import "channels" "stream" (func $stream (param $capacity i32) (result i32)))
  (import "channels" "stream-reader" (func $stream-reader (param $id i32) (result (@inst $stream i32))))
  (import "channels" "send" (func $send (param $id i32) (param $value i32) (result i32)))
  (import "channels" "close-stream" (func $close-stream (param $id i32)))
  (import "channels" "future" (func $future (result i32)))
  (import "channels" "future-reader" (func $future-reader (param $id i32) (result (@inst $future (@inst $result i32 i32)))))
  (import "channels" "resolve" (func $resolve (param $id i32) (param $value i32) (result i32)))
  (import "channels" "close-future" (func $close-future (param $id i32)))
  ;; Explicit host consumer starts reading concurrently. No detached guest task.
  (import "consumer" "start" (func $start (param $items (@inst $stream i32))))
  (func $produce (export "produce") (result i32) (@effect host reads writes allocates suspends)
    (@using $w (@resource.new $StreamWriter (call $stream 0))
      (block (result i32)
        (call $start (call $stream-reader (@resource.handle $w)))
        (drop (call $send (@resource.handle $w) 20))
        (call $send (@resource.handle $w) 22))))
  (func $pending (export "pending") (@effect host reads writes allocates suspends)
    (@using $w (@resource.new $StreamWriter (call $stream 0))
      (@let $reader (call $stream-reader (@resource.handle $w))
        (block
          ;; No reader advances: cancellation must dispose the pending send.
          (drop (call $send (@resource.handle $w) 42))
          (@stream.close i32 (@move $reader))))))
  (func $resolved (export "resolved") (result (@inst $result i32 i32)) (@effect host reads writes allocates suspends)
    (@using $w (@resource.new $FutureWriter (call $future))
      (@let $reader (call $future-reader (@resource.handle $w))
        (block (result (@inst $result i32 i32))
          (drop (call $resolve (@resource.handle $w) 42))
          (@future.await (@inst $result i32 i32) (@move $reader))))))
  (@closure $Consume (@capture $items (@inst $stream i32)) (result i32) (@effect suspends)
    (@loop $read (bind $current (@inst $stream i32) (@move $items)) (bind $total i32 0) (result i32)
      (@match (@inst $tuple (@inst $stream i32) (@inst $option i32)) (result i32)
        (@stream.next i32 (@move $current))
        (@case pair ($next $item)
          (@match (@inst $option i32) (result i32) $item
            (@case none () (block (result i32) (@stream.close i32 (@move $next)) $total))
            (@case some ($n) (@recur $read (@move $next) (+ $total $n))))))))
  (func $pipeline (export "pipeline") (result i32) (@effect host reads writes allocates suspends)
    (@let $consumer
      (@using $w (@resource.new $StreamWriter (call $stream 0))
        (@let $items (call $stream-reader (@resource.handle $w))
          (@let $task (@task.spawn i32 $Consume (@closure.new $Consume (@move $items)))
            (block (result (@inst $task i32))
              (drop (call $send (@resource.handle $w) 20))
              (drop (call $send (@resource.handle $w) 22))
              (@move $task)))))
      ;; The writer closes before joining, so the consumer observes EOF.
      (@task.join i32 (@move $consumer)))))
