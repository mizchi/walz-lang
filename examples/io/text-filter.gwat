(module
  (import "gcwat:host/text-io@0.1.0" "read-lines"
    (func $read-lines (result (stream (result text i32)))))
  (import "gcwat:host/text-io@0.1.0" "write-line"
    (func $write-line (param $line text) (result (future (result unit i32)))))

  ;; Keep non-empty lines. All I/O errors are explicit Result values.
  (func $main (export "main") (result (result i32 i32)) (effects host suspends)
    (loop $read (bind $lines (stream (result text i32)) (call $read-lines))
                (bind $count i32 (i32.const 0)) (result (result i32 i32))
      (match (pair (stream (result text i32)) (option (result text i32)))
        (result (result i32 i32)) (stream.next (result text i32) (move $lines))
        (case pair ($next $item)
          (match (option (result text i32)) (result (result i32 i32)) (local.get $item)
            (case none ()
              (block (result (result i32 i32)) (stream.close (result text i32) (move $next))
                (result.ok i32 i32 (local.get $count))))
            (case some ($line)
              (match (result text i32) (result (result i32 i32)) (local.get $line)
                (case err ($code)
                  (block (result (result i32 i32)) (stream.close (result text i32) (move $next))
                    (result.err i32 i32 (local.get $code))))
                (case ok ($text)
                  (if (result (result i32 i32)) (i32.eqz (text.byte-len (local.get $text)))
                    (then (recur $read (move $next) (local.get $count)))
                    (else
                      (match (result unit i32) (result (result i32 i32))
                        (future.await (result unit i32) (call $write-line (local.get $text)))
                        (case ok () (recur $read (move $next) (i32.add (local.get $count) (i32.const 1))))
                        (case err ($code)
                          (block (result (result i32 i32)) (stream.close (result text i32) (move $next))
                            (result.err i32 i32 (local.get $code)))))))))))))))
)
