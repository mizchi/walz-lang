(module
  (%import "wlt:std"
    (type $future)
    (type $option)
    (type $pair)
    (type $result)
    (type $stream)
    (type $text)
    (type $unit))
  (import "wlt:host/text-io@0.1.0" "read-lines"
    (func $read-lines (result (%inst $stream (%inst $result $text i32)))))
  (import "wlt:host/text-io@0.1.0" "write-line"
    (func $write-line (param $line $text) (result (%inst $future (%inst $result $unit i32)))))

  ;; Keep non-empty lines. All I/O errors are explicit Result values.
  (func $main (export "main") (result (%inst $result i32 i32)) (%effects host suspends)
    (%loop $read (bind $lines (%inst $stream (%inst $result $text i32)) (call $read-lines))
                (bind $count i32 (i32.const 0)) (result (%inst $result i32 i32))
      (%match (%inst $pair (%inst $stream (%inst $result $text i32)) (%inst $option (%inst $result $text i32)))
        (result (%inst $result i32 i32)) (%stream.next (%inst $result $text i32) (%move $lines))
        (case pair ($next $item)
          (%match (%inst $option (%inst $result $text i32)) (result (%inst $result i32 i32)) (local.get $item)
            (case none ()
              (block (result (%inst $result i32 i32)) (%stream.close (%inst $result $text i32) (%move $next))
                (%result.ok i32 i32 (local.get $count))))
            (case some ($line)
              (%match (%inst $result $text i32) (result (%inst $result i32 i32)) (local.get $line)
                (case err ($code)
                  (block (result (%inst $result i32 i32)) (%stream.close (%inst $result $text i32) (%move $next))
                    (%result.err i32 i32 (local.get $code))))
                (case ok ($text)
                  (if (result (%inst $result i32 i32)) (i32.eqz (%text.byte-len (local.get $text)))
                    (then (%recur $read (%move $next) (local.get $count)))
                    (else
                      (%match (%inst $result $unit i32) (result (%inst $result i32 i32))
                        (%future.await (%inst $result $unit i32) (call $write-line (local.get $text)))
                        (case ok () (%recur $read (%move $next) (i32.add (local.get $count) (i32.const 1))))
                        (case err ($code)
                          (block (result (%inst $result i32 i32)) (%stream.close (%inst $result $text i32) (%move $next))
                            (%result.err i32 i32 (local.get $code)))))))))))))))
)
