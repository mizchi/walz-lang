(module
  (type $Ints (array (mut i64)))

  (func $dot (param $a (ref $Ints)) (param $b (ref $Ints))
    (param $n i32) (param $row i32) (param $column i32) (result i64)
    (loop $go (bind $k i32 (i32.const 0)) (bind $sum i64 (i64.const 0))
      (result i64)
      (if (result i64) (i32.lt_u (local.get $k) (local.get $n))
        (then (recur $go (i32.add (local.get $k) (i32.const 1))
          (i64.add (local.get $sum)
            (i64.mul
              (array.get $Ints (local.get $a)
                (i32.add (i32.mul (local.get $row) (local.get $n)) (local.get $k)))
              (array.get $Ints (local.get $b)
                (i32.add (i32.mul (local.get $k) (local.get $n)) (local.get $column)))))))
        (else (local.get $sum)))))

  (func $multiply (param $a (ref $Ints)) (param $b (ref $Ints)) (param $n i32)
    (result (ref $Ints))
    (let $output (array.new $Ints (i64.const 0) (i32.mul (local.get $n) (local.get $n)))
      (loop $rows (bind $row i32 (i32.const 0)) (result (ref $Ints))
        (if (result (ref $Ints)) (i32.lt_u (local.get $row) (local.get $n))
          (then (block (result (ref $Ints))
            (loop $columns (bind $column i32 (i32.const 0))
              (if (i32.lt_u (local.get $column) (local.get $n))
                (then (block
                  (array.set $Ints (local.get $output)
                    (i32.add (i32.mul (local.get $row) (local.get $n)) (local.get $column))
                    (call $dot (local.get $a) (local.get $b) (local.get $n)
                      (local.get $row) (local.get $column)))
                  (recur $columns (i32.add (local.get $column) (i32.const 1)))))
                (else (nop))))
            (recur $rows (i32.add (local.get $row) (i32.const 1)))))
          (else (local.get $output))))))

  ;; [[1,2],[3,4]] * [[5,6],[7,8]] = [[19,22],[43,50]].
  (func $example-product (result (ref $Ints))
    (let $a (array.new_fixed $Ints 4 (i64.const 1) (i64.const 2) (i64.const 3) (i64.const 4))
      (let $b (array.new_fixed $Ints 4 (i64.const 5) (i64.const 6) (i64.const 7) (i64.const 8))
        (call $multiply (local.get $a) (local.get $b) (i32.const 2)))))
  (func $entry (export "entry") (param $row i32) (param $column i32) (result i64)
    (array.get $Ints (call $example-product)
      (i32.add (i32.mul (local.get $row) (i32.const 2)) (local.get $column))))
  (func $main (export "main") (result i64)
    (let $c (call $example-product)
      (i64.add
        (i64.add (array.get $Ints (local.get $c) (i32.const 0))
          (array.get $Ints (local.get $c) (i32.const 1)))
        (i64.add (array.get $Ints (local.get $c) (i32.const 2))
          (array.get $Ints (local.get $c) (i32.const 3)))))))
