(module
  (@use "walz:core" (type $result) (type $tuple))
  (type $Box (@type.params $T) (struct (field $value $T)))
  (@closure $Adder (@type.params $T) (@where (Add $T) (shared $T))
    (@capture $base $T) (param $value $T) (result $T) (@effect pure)
    (+ $base $value))
  (func $id (@type.params $T) (param $value $T) (result $T) (@effect pure) $value)
  (func $split (export "split") (param $n i32)
    (result $result<$tuple<i32, i32>, i32>) (@effect pure)
    (if (result $result<$tuple<i32, i32>, i32>) (< $n 0)
      (then (@result.err 1))
      (else (@result.ok (@tuple.new $n (i32.const 2))))))
  (func $main (export "main") (result i32) (@effect allocates)
    (@let $box (@$Box<i32>::{:value (call $id<i32> 40)})
      (@match (call $split (struct.get $Box<i32> $value $box))
        (@case err ($code) (- 0 $code))
        (@case ok ($pair)
          (@let ($a $b) $pair
            (@let $add (@closure.new $Adder<i32> $b)
              (@closure.call $Adder<i32> $add $a))))))))
