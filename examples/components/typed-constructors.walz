(component
  (@world "example:typed-constructors@0.1.0" "app")
  (import "test:constructors/host" (instance $host
    (type $ItemDef (record (field "value" u32) (field "label" string)))
    (export "item" (type $Item (eq $ItemDef)))))
  (@lib
    (@use "walz:core" (type $future) (type $stream))
    (@type.alias $Item (@component.type "host" (type "item"))))
  (component $Echo (@type.params $T) (@where (shared $T))
    (@lib
      (@use "walz:core" (type $future) (type $stream))
      (func $echo (param $value $T) (result $T) (@effect pure) $value)
      (func $ready (param $value $T) (result $future<$T>) (@effect allocates)
        (@future.ready $T $value))
      (func $stream (param $value $T) (result $stream<$T>) (@effect allocates)
        (@stream.cons $T $value (@stream.empty $T))))
    (@expose "echo" $echo) (@expose "ready" $ready) (@expose "stream" $stream))
  (component $Transfer (@type.params $T)
    (@lib (func $transfer (param $value $T) (result $T) (@effect pure) (@move $value)))
    (@expose "transfer" $transfer))
  (component $Await (@type.params $T) (@where (shared $T))
    (@lib (@use "walz:core" (type $future))
      (func $consume (param $value $future<$T>) (result $T) (@effect suspends)
        (@future.await $T (@move $value))))
    (@expose "consume" $consume))
  (instance $first (instantiate $Echo<$Item>))
  (@bind "first" (instance $first))
  (instance $again (instantiate $Echo<(@component.type "host" (type "item"))>))
  (instance $relay (instantiate $Echo<(@component.type "first" (result "echo"))>))
  (instance $future (instantiate $Transfer<$future<$Item>>))
  (instance $stream (instantiate $Transfer<$stream<$Item>>))
  (instance $await (instantiate $Await<$Item>))
  (@bind "host" (instance $host))
  (export "first" (instance $first)) (export "again" (instance $again))
  (export "relay" (instance $relay))
  (export "future" (instance $future)) (export "stream" (instance $stream))
  (export "await" (instance $await)))
