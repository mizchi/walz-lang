(component
  (@world "example:composition@0.1.0" "app")
  (@use "./math.walz" (func $add) (func $identity))
  (@use "./counter.walz" (component $Counter))
  (instance $a (instantiate $Counter))
  (instance $b (instantiate $Counter))
  (alias export $a "next" (func $next))
  (@lib
    (@use "walz:core" (type $bytes) (type $string) (type $future) (type $stream))
    (import "counter" "next" (func $next (result i32)))
    (func $run (result i32) (@effect host) (call $add 40 (call $next)))
    (func $echo (param $value $bytes) (result $bytes) (@effect pure) $value)
    (func $consume (param $f $future<i32>) (result i32)
      (@effect suspends) (@future.await i32 (@move $f)))
    (func $ready (param $value $string) (result $future<$string>)
      (@effect allocates) (@future.ready $string $value))
    (func $prepend (param $tail $stream<i32>) (result $stream<i32>)
      (@effect allocates) (@stream.cons i32 7 (@move $tail))))
  (@connect "counter" "next" $next)
  (@expose "add" $add)
  (@expose "identity" $identity<i64>)
  (@expose "run" $run)
  (@expose "echo" $echo)
  (@expose "consume" $consume)
  (@expose "ready-text" $ready)
  (@expose "prepend" $prepend)
  (export "other-counter" (instance $b)))
