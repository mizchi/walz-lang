(component
  (@world "example:component-queries@0.1.0" "app")
  (import "test:queries/host" (instance $host
    (type $ItemDef (record (field "value" s32) (field "label" string)))
    (export "item" (type $Item (eq $ItemDef)))
    (export "echo" (func (param "value" (option (list s32))) (result (option (list s32)))))
    (export "number" (func (param "value" u32) (result u32)))
    (export "item-value" (func (param "value" $Item) (result s32)))
    (export "copy-item" (func async (param "value" $Item) (result $Item)))
    (export "ready-item" (func (param "value" $Item) (result (future $Item))))
    (export "consume" (func async (param "value" (future string)) (result string)))))
  (@lib
    (@type.alias $Input (@component.type "host" (param "echo" "value")))
    (@type.alias $Output (@component.type "host" (result "echo")))
    (@type.alias $Number (@component.type "host" (param "number" 0)))
    (@type.alias $Item (@component.type "host" (type "item")))
    (@type.alias $PendingItem (@component.type "host" (result "ready-item")))
    (@type.alias $PendingString (@component.type "host" (param "consume" 0)))
    (@type.alias $String (@component.type "host" (result "consume")))
    (import "host" "echo" (func $host-echo (param $v $Input) (result $Output)))
    (import "host" "number" (func $host-number (param $v $Number) (result $Number)))
    (import "host" "item-value" (func $host-item-value (param $v $Item) (result i32)))
    (import "host" "copy-item" (func $host-copy (param $v $Item) (result $Item)))
    (import "host" "ready-item" (func $host-ready (param $v $Item) (result $PendingItem)))
    (import "host" "consume" (func $host-consume (param $v $PendingString) (result $String)))
    (func $echo (param $v $Input) (result $Output) (@effect host) (call $host-echo $v))
    (func $number (param $v $Number) (result $Number) (@effect host) (call $host-number $v))
    (func $read (param $v $Item) (result i32) (@effect host) (call $host-item-value $v))
    (func $echo-item (param $v $Item) (result $Item) (@effect pure) $v)
    (func $copy-item (param $v $Item) (result $Item) (@effect host suspends) (call $host-copy $v))
    (func $ready-item (param $v $Item) (result $PendingItem) (@effect host) (call $host-ready $v))
    (func $consume (param $v $PendingString) (result $String) (@effect host suspends) (call $host-consume (@move $v)))
    (func $field (param $v (@component.type "host" (type "item") (field "value")))
      (result i32) (@effect pure) $v))
  (@connect "host" (instance $host))
  (@expose "echo" $echo) (@expose "number" $number) (@expose "read" $read)
  (@expose "echo-item" $echo-item) (@expose "ready-item" $ready-item)
  (@expose "copy-item" $copy-item)
  (@expose "consume" $consume) (@expose "field" $field))
