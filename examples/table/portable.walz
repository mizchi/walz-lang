(module
  (@use "walz:core" (type $string) (type $list) (func $bytes.equal)
    (func $list-builder.new) (func $list-builder.push) (func $list-builder.finish))
  (@use "../../walz/table/value.walz" (type $cell) (func $cell.new) (func $cell.kind) (func $cell.number) (func $cell.text))
  (@use "../../walz/table/engine.walz" (type $table) (type $column) (type $expr)
    (func $column.new) (func $column.name) (func $table.new) (func $table.num-rows) (func $table.num-cols)
    (func $table.column) (func $table.get) (func $table.select) (func $table.filter) (func $table.derive)
    (func $table.filter-scalar) (func $table.filter-packed-scalar)
    (func $table.groupby) (func $table.ungroup) (func $table.slice) (func $table.orderby) (func $table.rollup)
    (func $expr.literal) (func $expr.column) (func $expr.node))
  (@use "../../walz/table/join.walz" (type $join-column) (func $join-column.new) (func $table.join))
  (type $wire-cell (struct (field $kind i32) (field $number f64) (field $text $string)))
  (@abi.type $wire-cell (record "kind" "number" "text"))
  (type $wire-column (struct (field $name $string) (field $values (@inst $list (ref $wire-cell)))))
  (@abi.type $wire-column (record "name" "values"))
  (type $wire-table (struct (field $columns (@inst $list (ref $wire-column))) (field $length i32)))
  (@abi.type $wire-table (record "columns" "length"))
  (type $wire-node (struct (field $op i32) (field $value (ref $wire-cell)) (field $a i32) (field $b i32) (field $c i32)))
  (@abi.type $wire-node (record "op" "value" "a" "b" "c"))
  (type $wire-program (struct (field $nodes (@inst $list (ref $wire-node))) (field $root i32)))
  (@abi.type $wire-program (record "nodes" "root"))
  (type $wire-layout (struct (field $name $string) (field $side i32) (field $left i32) (field $right i32)))
  (@abi.type $wire-layout (record "name" "side" "left" "right"))
  (type $wire-command (struct (field $op i32) (field $names $list<$string>)
    (field $programs (@inst $list (ref $wire-program))) (field $indices $list<i32>)
    (field $other (ref $wire-table)) (field $left-keys $list<i32>) (field $right-keys $list<i32>)
    (field $layout (@inst $list (ref $wire-layout))) (field $mode i32)))
  (@abi.type $wire-command (record "op" "names" "programs" "indices" "other" "left-keys" "right-keys" "layout" "mode"))
  (type $Exprs (array (mut (ref $expr))))
  (type $Flags (array (mut i32)))
  (func $lift (param $input (ref $wire-table)) (result (ref $table)) (@effect reads writes allocates)
    (@let (($columns (struct.get $wire-table $columns $input)) ($out (call (@inst $list-builder.new (ref $column)))))
      (block (result (ref $table))
        (@for $columns (bind $i i32 0) (while (< $i (@list.len (ref $wire-column) $columns))) (step (+ $i 1))
          (@let (($column (@list.get (ref $wire-column) $columns $i)) ($values (struct.get $wire-column $values $column))
                 ($out-values (call (@inst $list-builder.new (ref $cell)))))
            (block
              (@for $cells (bind $j i32 0) (while (< $j (@list.len (ref $wire-cell) $values))) (step (+ $j 1))
                (@let $v (@list.get (ref $wire-cell) $values $j)
                  (call (@inst $list-builder.push (ref $cell)) $out-values (call $cell.new
                    (struct.get $wire-cell $kind $v) (struct.get $wire-cell $number $v) (struct.get $wire-cell $text $v)))))
              (call (@inst $list-builder.push (ref $column)) $out
                (call $column.new (struct.get $wire-column $name $column) (call (@inst $list-builder.finish (ref $cell)) $out-values))))))
        (call $table.new (call (@inst $list-builder.finish (ref $column)) $out) (struct.get $wire-table $length $input)))))
  (func $lower (param $t (ref $table)) (result (ref $wire-table)) (@effect reads writes allocates)
    (@let $columns (call (@inst $list-builder.new (ref $wire-column)))
      (block (result (ref $wire-table))
        (@for $columns (bind $i i32 0) (while (< $i (call $table.num-cols $t))) (step (+ $i 1))
          (@let $values (call (@inst $list-builder.new (ref $wire-cell)))
            (block
              (@for $cells (bind $j i32 0) (while (< $j (call $table.num-rows $t))) (step (+ $j 1))
                (@let $v (call $table.get $t $i $j)
                  (call (@inst $list-builder.push (ref $wire-cell)) $values
                    (struct.new $wire-cell (call $cell.kind $v) (call $cell.number $v) (call $cell.text $v)))))
              (call (@inst $list-builder.push (ref $wire-column)) $columns
                (struct.new $wire-column (call $column.name (call $table.column $t $i))
                  (call (@inst $list-builder.finish (ref $wire-cell)) $values))))))
        (struct.new $wire-table (call (@inst $list-builder.finish (ref $wire-column)) $columns) (call $table.num-rows $t)))))
  (func $child (param $xs (ref $Exprs)) (param $at i32) (param $before i32) (param $empty (ref $expr))
    (result (ref $expr)) (@effect reads)
    (if (result (ref $expr)) (= $at -1) (then $empty)
      (else (if (result (ref $expr)) (i32.ge_u $at $before) (then (unreachable)) (else (array.get $Exprs $xs $at))))))
  (func $program (param $t (ref $table)) (param $input (ref $wire-program)) (param $aggregates i32)
    (result (ref $expr)) (@effect reads writes allocates)
    (@let (($nodes (struct.get $wire-program $nodes $input)) ($n (@list.len (ref $wire-node) $nodes))
           ($empty (call $expr.literal (call $cell.new 0 (f64.const 0) "")))
           ($out (array.new $Exprs $empty $n)) ($flags (array.new $Flags 0 $n)))
      (block (result (ref $expr))
        (@for $nodes (bind $i i32 0) (while (< $i $n)) (step (+ $i 1))
          (@let (($node (@list.get (ref $wire-node) $nodes $i)) ($op (struct.get $wire-node $op $node)))
            (array.set $Exprs $out $i
              (if (result (ref $expr)) (= $op 0)
                (then (@let $v (struct.get $wire-node $value $node)
                  (call $expr.literal (call $cell.new (struct.get $wire-cell $kind $v)
                    (struct.get $wire-cell $number $v) (struct.get $wire-cell $text $v)))))
                (else (if (result (ref $expr)) (= $op 1)
                  (then (block (result (ref $expr))
                    (drop (call $table.column $t (struct.get $wire-node $a $node)))
                    (call $expr.column (struct.get $wire-node $a $node))))
                  (else (@let (($ia (struct.get $wire-node $a $node)) ($ib (struct.get $wire-node $b $node)) ($ic (struct.get $wire-node $c $node))
                               ($a (call $child $out $ia $i $empty)) ($b (call $child $out $ib $i $empty)) ($c (call $child $out $ic $i $empty))
                               ($flags-a (if (result i32) (= $ia -1) (then 0) (else (array.get $Flags $flags $ia))))
                               ($flags-b (if (result i32) (= $ib -1) (then 0) (else (array.get $Flags $flags $ib))))
                               ($flags-c (if (result i32) (= $ic -1) (then 0) (else (array.get $Flags $flags $ic))))
                               ($nested (| $flags-a (| $flags-b $flags-c))))
                    (block (result (ref $expr))
                      (if (&& (>= $op 100) (|| (i32.eqz $aggregates) $nested)) (then (unreachable)) (else (nop)))
                      (array.set $Flags $flags $i (| $nested (>= $op 100)))
                      (call $expr.node $op $a $b $c))))))))))
        (@let $root (struct.get $wire-program $root $input)
          (if (result (ref $expr)) (i32.ge_u $root $n) (then (unreachable)) (else (array.get $Exprs $out $root)))))))
  (func $find (param $names $list<$string>) (param $name $string) (result i32) (@effect pure)
    (@loop $find (bind $i i32 0) (result i32)
      (if (result i32) (= $i (@list.len $string $names)) (then -1)
        (else (if (result i32) (call $bytes.equal (@string.bytes (@list.get $string $names $i)) (@string.bytes $name))
          (then $i) (else (@recur $find (+ $i 1))))))))
  (func $apply (param $t (ref $table)) (param $cmd (ref $wire-command)) (param $mode i32) (result (ref $table)) (@effect reads writes allocates)
    (@let (($op (struct.get $wire-command $op $cmd)) ($names (struct.get $wire-command $names $cmd))
           ($programs (struct.get $wire-command $programs $cmd)) ($indices (struct.get $wire-command $indices $cmd)))
      (block (result (ref $table))
        (if (= $op 7) (then (return (call $table.ungroup $t))) (else (nop)))
        (if (= $op 6)
          (then (block (if (!= (@list.len i32 $indices) 2) (then (unreachable)) (else (nop)))
            (return (call $table.slice $t (@list.get i32 $indices 0) (@list.get i32 $indices 1))))) (else (nop)))
        (if (= $op 8)
          (then (@let $layout (call (@inst $list-builder.new (ref $join-column)))
            (block
              (@for $layout (bind $i i32 0) (while (< $i (@list.len (ref $wire-layout) (struct.get $wire-command $layout $cmd)))) (step (+ $i 1))
                (@let $v (@list.get (ref $wire-layout) (struct.get $wire-command $layout $cmd) $i)
                  (call (@inst $list-builder.push (ref $join-column)) $layout (call $join-column.new
                    (struct.get $wire-layout $name $v) (struct.get $wire-layout $side $v)
                    (struct.get $wire-layout $left $v) (struct.get $wire-layout $right $v)))))
              (return (call $table.join $t (call $lift (struct.get $wire-command $other $cmd))
                (struct.get $wire-command $left-keys $cmd) (struct.get $wire-command $right-keys $cmd)
                (call (@inst $list-builder.finish (ref $join-column)) $layout) (struct.get $wire-command $mode $cmd))))))
          (else (nop)))
        (@let $exprs (call (@inst $list-builder.new (ref $expr)))
          (block (result (ref $table))
            (@for $programs (bind $i i32 0) (while (< $i (@list.len (ref $wire-program) $programs))) (step (+ $i 1))
              (call (@inst $list-builder.push (ref $expr)) $exprs
                (call $program $t (@list.get (ref $wire-program) $programs $i) (= $op 4))))
            (@let $exprs (call (@inst $list-builder.finish (ref $expr)) $exprs)
              (block (result (ref $table))
                (if (= $op 1) (then (block
                  (if (!= (@list.len (ref $expr) $exprs) 1) (then (unreachable)) (else (nop)))
                  (@let $e (@list.get (ref $expr) $exprs 0)
                    (return (if (result (ref $table)) (= $mode 1) (then (call $table.filter-scalar $t $e))
                      (else (if (result (ref $table)) (= $mode 2) (then (call $table.filter-packed-scalar $t $e))
                        (else (call $table.filter $t $e))))))))) (else (nop)))
                (if (= $op 4) (then (return (call $table.rollup $t $names $exprs))) (else (nop)))
                (if (= $op 5) (then (return (call $table.orderby $t $exprs $indices))) (else (nop)))
                (@let $columns (call (@inst $list-builder.new (ref $column)))
                  (block (result (ref $table))
                    (if (= $op 0)
                      (then (block
                        (@for $select (bind $i i32 0) (while (< $i (@list.len i32 $indices))) (step (+ $i 1))
                          (call (@inst $list-builder.push (ref $column)) $columns (call $table.column $t (@list.get i32 $indices $i))))
                        (return (call $table.select $t (call (@inst $list-builder.finish (ref $column)) $columns))))) (else (nop)))
                    (if (!= (@list.len $string $names) (@list.len (ref $expr) $exprs)) (then (unreachable)) (else (nop)))
                    (if (= $op 3)
                      (then (block
                        (@for $groups (bind $i i32 0) (while (< $i (@list.len $string $names))) (step (+ $i 1))
                          (call (@inst $list-builder.push (ref $column)) $columns
                            (call $table.derive $t (@list.get $string $names $i) (@list.get (ref $expr) $exprs $i))))
                        (return (call $table.groupby $t (call (@inst $list-builder.finish (ref $column)) $columns))))) (else (nop)))
                    (if (!= $op 2) (then (unreachable)) (else (nop)))
                    (@for $existing (bind $i i32 0) (while (< $i (call $table.num-cols $t))) (step (+ $i 1))
                      (@let (($c (call $table.column $t $i)) ($index (call $find $names (call $column.name $c))))
                        (call (@inst $list-builder.push (ref $column)) $columns
                          (if (result (ref $column)) (< $index 0) (then $c)
                            (else (call $table.derive $t (call $column.name $c) (@list.get (ref $expr) $exprs $index)))))))
                    (@for $new (bind $i i32 0) (while (< $i (@list.len $string $names))) (step (+ $i 1))
                      (@let $name (@list.get $string $names $i)
                        (@loop $find (bind $j i32 0)
                          (if (= $j (call $table.num-cols $t))
                            (then (call (@inst $list-builder.push (ref $column)) $columns (call $table.derive $t $name (@list.get (ref $expr) $exprs $i))))
                            (else (if (call $bytes.equal (@string.bytes $name) (@string.bytes (call $column.name (call $table.column $t $j))))
                              (then (nop)) (else (@recur $find (+ $j 1)))))))))
                    (call $table.select $t (call (@inst $list-builder.finish (ref $column)) $columns)))))))))))
  (func $execute (param $input (ref $wire-table)) (param $commands (@inst $list (ref $wire-command))) (param $mode i32)
    (result (ref $wire-table)) (@effect reads writes allocates)
    (@loop $execute (bind $i i32 0) (bind $t (ref $table) (call $lift $input)) (result (ref $wire-table))
      (if (result (ref $wire-table)) (= $i (@list.len (ref $wire-command) $commands)) (then (call $lower $t))
        (else (@recur $execute (+ $i 1) (call $apply $t (@list.get (ref $wire-command) $commands $i) $mode))))))
  (func $run (export "run") (param $input (ref $wire-table)) (param $commands (@inst $list (ref $wire-command)))
    (result (ref $wire-table)) (@effect reads writes allocates) (call $execute $input $commands 0))
  (func $run-scalar (export "run-scalar") (param $input (ref $wire-table)) (param $commands (@inst $list (ref $wire-command)))
    (result (ref $wire-table)) (@effect reads writes allocates) (call $execute $input $commands 1))
  (func $run-packed-scalar (export "run-packed-scalar") (param $input (ref $wire-table)) (param $commands (@inst $list (ref $wire-command)))
    (result (ref $wire-table)) (@effect reads writes allocates) (call $execute $input $commands 2))
)
