(module
  (@use "walz:core"
    (type $option)
    (type $string))
  (func $main (export "main") (result i32) (@effect pure)
    (@let $raw (@string.bytes (@string.lit "*日本語"))
      (@let $head (@bytes.slice (local.get $raw) (i32.const 0) (i32.const 1))
        (@match (@inst $option $string) (result i32) (@string.from-bytes (local.get $head))
          (case none () (i32.const -1))
          (case some ($text) (@bytes.get (@string.bytes (local.get $text)) (i32.const 0))))))))
