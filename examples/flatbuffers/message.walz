(module
  (@use "walz:core" (type $bytes) (type $string) (type $list) (type $option) (type $result)
    (func $bytes-view.to-bytes))
  (@use "../../walz/flatbuffers/reader.walz" (type $fb.table) (tag $fb.invalid)
    (func $fb.root) (func $fb.table-at) (func $fb.target) (func $fb.bits)
    (func $fb.i32) (func $fb.i64) (func $fb.f64) (func $fb.string)
    (func $fb.vector) (func $fb.vector.bytes) (func $fb.i32s))
  (@use "../../walz/flatbuffers/builder.walz" (type $fb.builder) (func $fb.builder.new)
    (func $fb.builder.string) (func $fb.builder.bytes) (func $fb.builder.i32s)
    (func $fb.builder.start) (func $fb.builder.bits-field) (func $fb.builder.offset-field)
    (func $fb.builder.end) (func $fb.builder.finish))
  (@export (type $Bool) (type $Child) (type $Message) (func $message.encode) (func $message.decode))

  ;; This is the schema-specific layer corresponding to message.fbs.
  (type $Bool (@newtype i32))
  (@abi.type $Bool (bool))
  (type $Child (struct (field $count i32) (field $label $string)))
  (@abi.type $Child (record "count" "label"))
  (type $Message (struct
    (field $id i64) (field $name $string) (field $values (@inst $list i32))
    (field $payload $bytes) (field $enabled $Bool) (field $weight f64)
    (field $child (@inst $option (ref $Child)))))
  (@abi.type $Message (record "id" "name" "values" "payload" "enabled" "weight" "child"))

  (func $child.encode (param $b (ref $fb.builder)) (param $c (ref $Child)) (result i32)
    (@effect reads writes allocates)
    (@let $label (call $fb.builder.string $b (struct.get $Child $label $c))
      (block (result i32)
        (call $fb.builder.start $b 2)
        (call $fb.builder.bits-field $b 0 4 (i64.extend_i32_s (struct.get $Child $count $c)) 0)
        (call $fb.builder.offset-field $b 1 $label)
        (call $fb.builder.end $b))))
  (func $message.encode (param $m (ref $Message)) (result $bytes) (@effect reads writes allocates)
    (@let (($b (call $fb.builder.new))
           ($name (call $fb.builder.string $b (struct.get $Message $name $m)))
           ($values (call $fb.builder.i32s $b (struct.get $Message $values $m)))
           ($payload (call $fb.builder.bytes $b (struct.get $Message $payload $m)))
           ($child (type i32) (@match (struct.get $Message $child $m)
             (@case some ($c) (call $child.encode $b $c)) (@case none () (i32.const 0)))))
      (block (result $bytes)
        (call $fb.builder.start $b 7)
        (call $fb.builder.bits-field $b 0 8 (struct.get $Message $id $m) 0)
        (call $fb.builder.offset-field $b 1 $name)
        (call $fb.builder.offset-field $b 2 $values)
        (call $fb.builder.offset-field $b 3 $payload)
        (call $fb.builder.bits-field $b 4 1
          (i64.extend_i32_u (@newtype.unwrap $Bool (struct.get $Message $enabled $m))) 1)
        (call $fb.builder.bits-field $b 5 8 (i64.reinterpret_f64 (struct.get $Message $weight $m)) 0)
        (call $fb.builder.offset-field $b 6 $child)
        (call $fb.builder.finish $b (call $fb.builder.end $b) (@bytes.new 87 76 90 70)))))

  (func $child.decode (param $b $bytes) (param $p i32) (result (@inst $option (ref $Child)))
    (@effect allocates (throws $fb.invalid))
    (if (result (@inst $option (ref $Child))) (= $p 0)
      (then (@option.none (ref $Child)))
      (else (@let $t (call $fb.table-at $b (i64.extend_i32_u $p))
        (@option.some (ref $Child) (@$Child::{
          :count (call $fb.i32 $t 0 0) :label (call $fb.string $t 1)}))))))
  (func $message.decode (param $b $bytes) (result (@inst $result (ref $Message) i32))
    (@effect reads writes allocates)
    (@try (result (@inst $result (ref $Message) i32))
      (do (@let $t (call $fb.root $b (@bytes.new 87 76 90 70))
        (@result.ok (ref $Message) i32 (@$Message::{
          :id (call $fb.i64 $t 0 0)
          :name (call $fb.string $t 1)
          :values (call $fb.i32s $t 2)
          :payload (call $bytes-view.to-bytes (call $fb.vector.bytes (call $fb.vector $t 3 1)))
          :enabled (@newtype.wrap $Bool (i64.ne (call $fb.bits $t 4 1 1) 0))
          :weight (call $fb.f64 $t 5 0)
          :child (call $child.decode $b (call $fb.target $t 6))}))))
      (catch $fb.invalid ($code) (@result.err (ref $Message) i32 $code)))))
