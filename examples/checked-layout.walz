(module
  (@use "walz:core" (type $option)
    (func $i32.checked-add-u) (func $i32.checked-mul-u) (func $i32.checked-align-up-u))
  (@export (func $layout))
  ;; count * stride + header, rounded up; the application limit is separate.
  (func $layout (export "layout")
    (param $count i32) (param $stride i32) (param $header i32)
    (param $alignment i32) (param $limit i32)
    (result (@inst $option i32)) (@effect pure)
    (@let
      (($payload (type i32)
        (@match (call $i32.checked-mul-u $count $stride)
          (@case none () (return (@option.none)))
          (@case some ($value) $value)))
       ($total (type i32)
        (@match (call $i32.checked-add-u $payload $header)
          (@case none () (return (@option.none)))
          (@case some ($value) $value)))
       ($aligned (type i32)
        (@match (call $i32.checked-align-up-u $total $alignment)
          (@case none () (return (@option.none)))
          (@case some ($value) $value))))
      (if (result (@inst $option i32)) (i32.gt_u $aligned $limit)
        (then (@option.none))
        (else (@option.some $aligned)))))
  (func $main (export "main") (result i32) (@effect pure)
    (@match (call $layout 10 4 1 2 1024)
      (@case none () -1)
      (@case some ($size) $size))))
