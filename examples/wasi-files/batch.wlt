(module
  (%use "wlt:core" (type $stream) (type $future) (type $tuple) (type $result) (type $unit) (type $string) (type $list) (func $list.fold))
  (%use "./generated/bindings.wlt" (func $files.read-file) (type $wit-u8) (type $files.error-code))
  (%export (func $sum-batch))
  (%closure $AddByte (param $sum i32) (param $byte $wit-u8) (result i32) (%effect pure)
    (+ $sum (%newtype.unwrap $wit-u8 $byte)))
  (func $sum-batch (param $size i32) (result i32) (%effect allocates host suspends)
    (%match (call $files.read-file (%string.lit "input"))
      (case pair ($bytes $completion)
        (%let $total (type i32)
          (%loop $read (bind $stream (%inst $stream $wit-u8) (%move $bytes)) (bind $sum i32 0) (result i32)
            (%match (%stream.read-batch $wit-u8 $size (%move $stream))
              (case pair ($next $items)
                (if (result i32) (= (%list.len $wit-u8 $items) 0)
                  (then (block (result i32) (%stream.close $wit-u8 (%move $next)) $sum))
                  (else (%recur $read (%move $next)
                    (call (%inst $list.fold $wit-u8 i32 $AddByte) $items (%closure.new $AddByte) $sum)))))))
          (%match (%future.await (%inst $result $unit (ref $files.error-code)) (%move $completion))
            (case ok () $total) (case err ($error) -1))))))
)
