(module
  (@use "./domain.walz" (type $Error $domain.Error))
  (@use "./graph.walz"
    (func $add $graph.add)
    (func $after $graph.after)
    (func $at $graph.at)
    (func $id $graph.id)
    (func $new $graph.new)
    (type $Graph $graph.Graph))
  (@use "./planner.walz" (func $makespan $planner.makespan) (func $run $planner.run))
  (@use "walz:core" (type $result) (type $unit))
  (@use "../../../walz/core/text.walz" (func $string.u64))
  (func $must
    (param $result (@inst $result $unit (ref $domain.Error)))
    (@match (local.get $result)
      (case ok () (nop))
      (case err ($e) (unreachable))))

  (func $jobs
    (param $n i32)
    (result (ref $graph.Graph))
    (@let $g (call $graph.new)
      (block
        (result (ref $graph.Graph))
        (@for $add
          (bind $i i32 (i32.const 0))
          (while (i32.lt_u (local.get $i) (local.get $n)))
          (step (i32.add (local.get $i) (i32.const 1)))
          (call $must
            (call $graph.add
              (local.get $g)
              (call $string.u64 (i64.extend_i32_u (local.get $i)))
              (i64.const 1000000))))
        (local.get $g))))

  (func $chain
    (export "chain")
    (param $n i32)
    (param $rounds i32)
    (result i64)
    (@effect reads writes allocates)
    (if
      (result i64)
      (i32.or
        (i32.gt_u (local.get $n) (i32.const 4096))
        (i32.gt_u (local.get $rounds) (i32.const 100)))
      (then (unreachable))
      (else
        (@loop $repeat
          (bind $round i32 (i32.const 0))
          (bind $sum i64 (i64.const 0))
          (result i64)
          (if
            (result i64)
            (i32.eq (local.get $round) (local.get $rounds))
            (then (local.get $sum))
            (else
              (@let $g (call $jobs (local.get $n))
                (block
                  (result i64)
                  (@for $link
                    (bind $i i32 (i32.const 1))
                    (while (i32.lt_u (local.get $i) (local.get $n)))
                    (step (i32.add (local.get $i) (i32.const 1)))
                    (call $must
                      (call $graph.after
                        (local.get $g)
                        (call $graph.id (call $graph.at (local.get $g) (local.get $i)))
                        (call $graph.id
                          (call $graph.at
                            (local.get $g)
                            (i32.sub (local.get $i) (i32.const 1))))
                      )))
                  (@match (call $planner.run (local.get $g) (i32.const 7))
                    (case err ($e) (unreachable))
                    (case ok ($r)
                      (@recur $repeat
                        (i32.add (local.get $round) (i32.const 1))
                        (i64.add
                          (local.get $sum)
                          (call $planner.makespan (local.get $r))))
                    ))))
            ))))
    ))

  (func $edge-limit
    (export "edge-limit")
    (result i32)
    (@effect reads writes allocates)
    (@let $g (call $jobs (i32.const 257))
      (block
        (result i32)
        (@for $row
          (bind $i i32 (i32.const 0))
          (while (i32.lt_u (local.get $i) (i32.const 256)))
          (step (i32.add (local.get $i) (i32.const 1)))
          (@for $column
            (bind $j i32 (i32.const 0))
            (while (i32.lt_u (local.get $j) (i32.const 256)))
            (step (i32.add (local.get $j) (i32.const 1)))
            (call $must
              (call $graph.after
                (local.get $g)
                (call $graph.id (call $graph.at (local.get $g) (local.get $i)))
                (call $graph.id (call $graph.at (local.get $g) (local.get $j))))
            )))
        ;; Existing edges remain idempotent even after the capacity is reached.
        (call $must
          (call $graph.after (local.get $g) (@string.lit "0") (@string.lit "0")))
        (@match (call $graph.after (local.get $g) (@string.lit "256") (@string.lit "0"))
          (case ok () (i32.const 0))
          (case err ($e)
            (@match (local.get $e)
              (case invalid ($d) (i32.const 0))
              (case duplicate ($d) (i32.const 0))
              (case unknown ($d) (i32.const 0))
              (case cycle ($d) (i32.const 0))
              (case capacity ($d) (i32.const 1))))
        ))))
)
