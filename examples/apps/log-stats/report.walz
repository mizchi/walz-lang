(module
  (@use "./parse.walz" (type $Level $parse.Level))
  (@use "./stats.walz"
    (func $accepted $stats.accepted)
    (func $count $stats.count)
    (func $ignored $stats.ignored)
    (func $maximum $stats.maximum)
    (func $rejected $stats.rejected)
    (func $total $stats.total)
    (type $State $stats.State))
  (@use "walz:core" (type $future) (type $result) (type $string) (type $unit))
  (@use "../../../walz/core/json.walz"
    (type $json-object)
    (func $json.object-builder.finish)
    (func $json.object-builder.new)
    (func $json.object-builder.object)
    (func $json.object-builder.u64))
  (import "walz:host/text-io@0.1.0" "write-line"
    (func $write-line
      (param $line $string)
      (result (@inst $future (@inst $result $unit i32))))
  )
  (@export (func $write))
  (func $bucket
    (param $s (ref $stats.State))
    (param $level (ref $parse.Level))
    (result (ref $json-object))
    (@effect reads writes allocates)
    (@let $o (call $json.object-builder.new)
      (block
        (result (ref $json-object))
        (call $json.object-builder.u64
          (local.get $o)
          (@string.lit "count")
          (call $stats.count (local.get $s) (local.get $level)))
        (call $json.object-builder.u64
          (local.get $o)
          (@string.lit "total_ms")
          (call $stats.total (local.get $s) (local.get $level)))
        (call $json.object-builder.u64
          (local.get $o)
          (@string.lit "max_ms")
          (call $stats.maximum (local.get $s) (local.get $level)))
        (local.get $o))))

  (func $write
    (param $s (ref $stats.State))
    (result (@inst $result $unit i32))
    (@effect reads writes allocates host suspends)
    (@let $o (call $json.object-builder.new)
      (@let $levels (call $json.object-builder.new)
        (block
          (result (@inst $result $unit i32))
          (call $json.object-builder.u64
            (local.get $o)
            (@string.lit "accepted")
            (call $stats.accepted (local.get $s)))
          (call $json.object-builder.u64
            (local.get $o)
            (@string.lit "rejected")
            (call $stats.rejected (local.get $s)))
          (call $json.object-builder.u64
            (local.get $o)
            (@string.lit "ignored")
            (call $stats.ignored (local.get $s)))
          (call $json.object-builder.object
            (local.get $levels)
            (@string.lit "INFO")
            (call $bucket (local.get $s) (@variant.new $parse.Level info)))
          (call $json.object-builder.object
            (local.get $levels)
            (@string.lit "WARN")
            (call $bucket (local.get $s) (@variant.new $parse.Level warn)))
          (call $json.object-builder.object
            (local.get $levels)
            (@string.lit "ERROR")
            (call $bucket (local.get $s) (@variant.new $parse.Level error)))
          (call $json.object-builder.object
            (local.get $o)
            (@string.lit "levels")
            (local.get $levels))
          (@future.await
            (@inst $result $unit i32)
            (call $write-line (call $json.object-builder.finish (local.get $o))))
        ))))
)
