(module
  (namespace $report
    (import "gcwat:host/text-io@0.1.0" "write-line"
      (func $write (param $line text) (result (future (result unit i32))))
    )
    (public (func $success) (func $failure) (func $invalid))
    (func $error-name
      (param $e (ref $stock.Error))
      (result text)
      (effects pure)
      (match $stock.Error
        (result text)
        (local.get $e)
        (case insufficient () (text.lit "insufficient-stock"))
        (case overflow () (text.lit "quantity-overflow"))
        (case capacity () (text.lit "capacity"))
      )
    )
    (func $success
      (param $op text)
      (param $key text)
      (param $quantity i64)
      (result (result unit i32))
      (effects reads writes allocates host suspends)
      (future.await
        (result unit i32)
        (call $write
          (call $string.concat
            (call $string.concat
              (text.lit "{\"op\":")
              (call $string.concat
                (call $string.json (local.get $op))
                (text.lit ",\"key\":")
              )
            )
            (call $string.concat
              (call $string.concat
                (call $string.json (local.get $key))
                (text.lit ",\"ok\":true,\"quantity\":")
              )
              (call $string.concat
                (call $string.u64 (local.get $quantity))
                (text.lit "}")
              )
            )
          )
        )
      )
    )
    (func $failure
      (param $op text)
      (param $key text)
      (param $error (ref $stock.Error))
      (result (result unit i32))
      (effects reads writes allocates host suspends)
      (future.await
        (result unit i32)
        (call $write
          (call $string.concat
            (call $string.concat
              (text.lit "{\"op\":")
              (call $string.concat
                (call $string.json (local.get $op))
                (text.lit ",\"key\":")
              )
            )
            (call $string.concat
              (call $string.concat
                (call $string.json (local.get $key))
                (text.lit ",\"ok\":false,\"error\":")
              )
              (call $string.concat
                (call $string.json (call $error-name (local.get $error)))
                (text.lit "}")
              )
            )
          )
        )
      )
    )
    (func $invalid
      (result (result unit i32))
      (effects host suspends)
      (future.await
        (result unit i32)
        (call $write (text.lit "{\"ok\":false,\"error\":\"invalid-command\"}"))
      )
    )
  )
)
