(module
  (include "program.gwat")
  ;; A ledger reference and the number of delivered lines.
  (type.alias $ScanState (pair (ref $stock.State) i32))
  (func $advance (param $progress $ScanState) (param $line text)
    (result (result $ScanState i32)) (effects reads writes allocates host suspends)
    (let ($ledger $count) (local.get $progress)
      ;; Count comments and business errors too, when their I/O succeeds.
      (result.let ()
        (call $app.process (local.get $ledger) (local.get $line))
        (result.ok
          (pair.new (local.get $ledger) (i32.add (local.get $count) (i32.const 1))))
      )))

  (func $main (export "main") (result (result i32 i32))
    (effects reads writes allocates host suspends)
    (let $initial-state $ScanState
      (pair.new (call $stock.new (i32.const 4096)) (i32.const 0))
      (result.let ($final-state)
        (stream.fold-result
          (call $read-lines)
          (local.get $initial-state)
          ($progress $line)
          (call $advance (local.get $progress) (local.get $line)))
        (let ($final-ledger $final-count) (local.get $final-state)
          (result.ok (local.get $final-count))))
    )))
