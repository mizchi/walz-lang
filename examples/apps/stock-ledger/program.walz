(module
  (@use "./parse.walz" (func $command $parse.command) (type $Command $parse.Command))
  (@use "./report.walz"
    (func $failure $report.failure)
    (func $invalid $report.invalid)
    (func $success $report.success))
  (@use "./stock.walz"
    (func $add $stock.add)
    (func $get $stock.get)
    (func $new $stock.new)
    (func $take $stock.take)
    (type $Error $stock.Error)
    (type $State $stock.State))
  (@use "walz:core" (type $result) (type $stream) (type $string) (type $unit))
  (import "walz:host/text-io@0.1.0" "read-lines"
    (func $read-lines (result (@inst $stream (@inst $result $string i32))))
  )
  (@export (func $app.process))
  (func $app.process
    (param $s (ref $stock.State))
    (param $line $string)
    (result (@inst $result $unit i32))
    (@effect reads writes allocates host suspends)
    (@match $parse.Command (result (@inst $result $unit i32))
      (call $parse.command (local.get $line))
      (@case skip () (@result.ok $unit i32))
      (@case invalid () (call $report.invalid))
      (@case add ($key $n)
        (@match (@inst $result i64 (ref $stock.Error))
          (result (@inst $result $unit i32))
          (call $stock.add (local.get $s) (local.get $key) (local.get $n))
          (@case ok ($quantity)
            (call $report.success
              (@string.lit "ADD")
              (local.get $key)
              (local.get $quantity)))
          (@case err ($error)
            (call $report.failure
              (@string.lit "ADD")
              (local.get $key)
              (local.get $error))))
      )
      (@case take ($key $n)
        (@match (@inst $result i64 (ref $stock.Error))
          (result (@inst $result $unit i32))
          (call $stock.take (local.get $s) (local.get $key) (local.get $n))
          (@case ok ($quantity)
            (call $report.success
              (@string.lit "TAKE")
              (local.get $key)
              (local.get $quantity)))
          (@case err ($error)
            (call $report.failure
              (@string.lit "TAKE")
              (local.get $key)
              (local.get $error))))
      )
      (@case show ($key)
        (call $report.success
          (@string.lit "SHOW")
          (local.get $key)
          (call $stock.get (local.get $s) (local.get $key))))
    )))
