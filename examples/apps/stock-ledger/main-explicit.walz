(module
  (@use "walz:core"
    (type $option)
    (type $tuple)
    (type $result)
    (type $stream)
    (type $string)
    (type $unit))
  (@include "program.walz")
  (func $main
    (export "main")
    (result (@inst $result i32 i32))
    (@effect reads writes allocates host suspends)
    (@let $initial (call $stock.new (i32.const 4096))
      (@loop $read
        (bind $lines (@inst $stream (@inst $result $string i32)) (call $read-lines))
        (bind $state (ref $stock.State) (local.get $initial))
        (result (@inst $result i32 i32))
        (@match
          (@inst $tuple (@inst $stream (@inst $result $string i32)) (@inst $option (@inst $result $string i32)))
          (result (@inst $result i32 i32))
          (@stream.next (@inst $result $string i32) (@move $lines))
          (case pair ($next $item)
            (@match (@inst $option (@inst $result $string i32))
              (result (@inst $result i32 i32))
              (local.get $item)
              (case none ()
                (block
                  (result (@inst $result i32 i32))
                  (@stream.close (@inst $result $string i32) (@move $next))
                  (@result.ok i32 i32 (i32.const 0))))
              (case some ($result)
                (@match (@inst $result $string i32) (result (@inst $result i32 i32))
                  (local.get $result)
                  (case err ($code)
                    (block
                      (result (@inst $result i32 i32))
                      (@stream.close (@inst $result $string i32) (@move $next))
                      (@result.err i32 i32 (local.get $code))))
                  (case ok ($line)
                    (@match (@inst $result $unit i32) (result (@inst $result i32 i32))
                      (call $app.process (local.get $state) (local.get $line))
                      (case err ($code)
                        (block
                          (result (@inst $result i32 i32))
                          (@stream.close (@inst $result $string i32) (@move $next))
                          (@result.err i32 i32 (local.get $code))))
                      (case ok () (@recur $read (@move $next) (local.get $state))))
                  ))))
          ))))
  ))
