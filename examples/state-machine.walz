(module
  ;; States: 0 = idle, 1 = running, 2 = done. Events: 1 = start, 2 = finish.
  (type $Machine (struct (field $state (mut i32)) (field $events (mut i32))))

  (func $step (param $machine (ref $Machine)) (param $event i32)
    (block
      (if (i32.and
        (i32.eqz (struct.get $Machine $state (local.get $machine)))
        (i32.eq (local.get $event) (i32.const 1)))
        (then (struct.set $Machine $state (local.get $machine) (i32.const 1)))
        (else
          (if (i32.and
            (i32.eq (struct.get $Machine $state (local.get $machine)) (i32.const 1))
            (i32.eq (local.get $event) (i32.const 2)))
            (then (struct.set $Machine $state (local.get $machine) (i32.const 2)))
            (else (nop)))))
      (struct.set $Machine $events (local.get $machine)
        (i32.add (struct.get $Machine $events (local.get $machine)) (i32.const 1)))))

  (func $main (export "main") (result i32)
    (@let $machine (struct.new $Machine (i32.const 0) (i32.const 0))
      (block (result i32)
        (call $step (local.get $machine) (i32.const 1))
        (call $step (local.get $machine) (i32.const 0))
        (call $step (local.get $machine) (i32.const 2))
        (call $step (local.get $machine) (i32.const 1))
        (i32.add (i32.mul (struct.get $Machine $state (local.get $machine)) (i32.const 100))
          (struct.get $Machine $events (local.get $machine)))))))
