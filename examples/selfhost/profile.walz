(module
  (@use "walz:core" (type $bytes) (type $list) (type $result))
  (@use "../../walz/frontend/tree.walz" (type $source-file) (type $project-error))
  (@use "../../walz/frontend/frontend.walz"
    (type $profile-report)
    (func $frontend.profile-project))
  (@use "../../walz/frontend/modules.walz" (func $modules.imports))
  (func $profile-project
    (export "profile-project")
    (param $files $list<(ref $source-file)>)
    (result (ref $profile-report))
    (@effect reads writes allocates)
    (call $frontend.profile-project $files))

  (func $imports
    (export "imports")
    (param $source $bytes)
    (result $result<$list<(ref $source-file)>, (ref $project-error)>)
    (@effect reads writes allocates)
    (call $modules.imports $source))
  (@use "../../walz/codegen/compiler.walz"
    (func $compiler.compile-project)
    (func $compiler.check-project))
  (func $compile-project
    (export "compile-project")
    (param $files $list<(ref $source-file)>)
    (result $result<$bytes, (ref $project-error)>)
    (@effect reads writes allocates)
    (call $compiler.compile-project $files))

  (func $check-project
    (export "check-project")
    (param $files $list<(ref $source-file)>)
    (result $result<i32, (ref $project-error)>)
    (@effect reads writes allocates)
    (call $compiler.check-project $files)))
