(module
  ;; n >= 0; multiplication follows wrapping i64 arithmetic.
  (func $factorial (export "factorial") (param $n i64) (result i64)
    (@loop $go (bind $i i64 (local.get $n)) (bind $product i64 (i64.const 1))
      (result i64)
      (if (result i64) (i64.le_s (local.get $i) (i64.const 1))
        (then (local.get $product))
        (else (@recur $go
          (i64.sub (local.get $i) (i64.const 1))
          (i64.mul (local.get $product) (local.get $i)))))))
  (func $main (export "main") (result i64)
    (call $factorial (i64.const 10))))
