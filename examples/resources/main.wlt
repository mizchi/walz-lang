(module
  (%import "wlt:std"
    (type $borrow)
    (type $result))
  (type $File (%resource "file" $close))
  (tag $Failure)
  (import "files" "open" (func $open (result i32)))
  (import "files" "read" (func $read (param $id i32) (result i32)))
  (import "files" "close" (func $close (param $id i32)))
  (import "wlt:host/event-loop@0.1.0" "sleep" (func $sleep (param $ms i32)))
  (func $read-file (param $f (%inst $borrow $File)) (result i32) (%effects host reads)
    (call $read (%resource.handle (local.get $f))))
  (func $normal (export "normal") (result i32) (%effects host reads writes allocates)
    (%using $file (%resource.new $File (call $open)) (call $read-file (local.get $file))))
  (func $err (export "err") (result (%inst $result i32 i32)) (%effects host writes allocates)
    (%using $file (%resource.new $File (call $open)) (%result.err i32 i32 (i32.const 7))))
  (func $explicit (export "explicit") (%effects host writes allocates)
    (%let $f (%resource.new $File (call $open)) (%resource.close (%move $f))))
  (func $nested (export "nested") (%effects host writes allocates)
    (%using $outer (%resource.new $File (call $open))
      (%using $inner (%resource.new $File (call $open)) (nop))))
  (func $throws (%effects host writes allocates (throws $Failure))
    (%using $file (%resource.new $File (call $open)) (throw $Failure)))
  (func $caught (export "caught") (result i32) (%effects host writes allocates)
    (%try (result i32) (do (block (result i32) (call $throws) (i32.const 0)))
      (catch $Failure () (i32.const 42))))
  (func $trap (export "trap") (%effects host writes allocates)
    (%using $file (%resource.new $File (call $open)) (unreachable)))
  (func $pending (export "pending") (%effects host writes allocates suspends)
    (%using $file (%resource.new $File (call $open)) (call $sleep (i32.const 10000)))))
