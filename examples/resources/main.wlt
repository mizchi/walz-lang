(module
  (%import "wlt:std"
    (type $borrow)
    (type $result))
  (type $File (%resource "file" $close))
  (tag $Failure)
  (import "files" "open" (func $open (result i32)))
  (import "files" "read" (func $read (param $id i32) (result i32)))
  (import "files" "close" (func $close (param $id i32)))
  (import "wlt:host/event-loop@0.1.0" "sleep" (func $sleep (param $ms i32)))
  (func $read-file (param $f (%inst $borrow $File)) (result i32) (%effect host reads)
    (call $read (%resource.handle (local.get $f))))
  (func $normal (export "normal") (result i32) (%effect host reads writes allocates)
    (%using $file (%resource.new $File (call $open)) (call $read-file (local.get $file))))
  (func $err (export "err") (result (%inst $result i32 i32)) (%effect host writes allocates)
    (%using $file (%resource.new $File (call $open)) (%result.err i32 i32 (i32.const 7))))
  (func $explicit (export "explicit") (%effect host writes allocates)
    (%let $f (%resource.new $File (call $open)) (%resource.close (%move $f))))
  (func $nested (export "nested") (%effect host writes allocates)
    (%using $outer (%resource.new $File (call $open))
      (%using $inner (%resource.new $File (call $open)) (nop))))
  (func $throws (%effect host writes allocates (throws $Failure))
    (%using $file (%resource.new $File (call $open)) (throw $Failure)))
  (func $caught (export "caught") (result i32) (%effect host writes allocates)
    (%try (result i32) (do (block (result i32) (call $throws) (i32.const 0)))
      (catch $Failure () (i32.const 42))))
  (func $trap (export "trap") (%effect host writes allocates)
    (%using $file (%resource.new $File (call $open)) (unreachable)))
  (func $pending (export "pending") (%effect host writes allocates suspends)
    (%using $file (%resource.new $File (call $open)) (call $sleep (i32.const 10000))))
  (func $early-return (export "early-return") (result i32) (%effect host reads writes allocates)
    (%using $outer (%resource.new $File (call $open))
      (%using $inner (%resource.new $File (call $open))
        (return (call $read-file (local.get $inner))))))
  (func $early-branch (export "early-branch") (result i32) (%effect host reads writes allocates)
    (block $done (result i32)
      (%using $outer (%resource.new $File (call $open))
        (%using $inner (%resource.new $File (call $open))
          (br $done (call $read-file (local.get $inner)))))))
  (func $conditional (export "conditional") (param $exit i32) (result i32) (%effect host reads writes allocates)
    (block $done (result i32)
      (%using $file (%resource.new $File (call $open))
        (block (result i32)
          (drop (br_if $done (i32.const 42) (local.get $exit)))
          (call $read-file (local.get $file))))))
  (func $inner-branch (export "inner-branch") (result i32) (%effect host reads writes allocates)
    (%using $file (%resource.new $File (call $open))
      (block (result i32) (block $done (br $done)) (call $read-file (local.get $file)))))
  (func $recur (export "recur") (result i32) (%effect host reads writes allocates)
    (%loop $again (bind $n i32 (i32.const 0)) (result i32)
      (%using $file (%resource.new $File (call $open))
        (if (result i32) (i32.lt_s (local.get $n) (i32.const 2))
          (then (%recur $again (i32.add (local.get $n) (i32.const 1))))
          (else (call $read-file (local.get $file))))))))
