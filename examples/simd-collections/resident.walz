(module
  (@use "walz:core" (type $list))
  (@use "../../walz/simd/bitmap.walz" (type $bitmap)
    (func $bitmap.empty) (func $bitmap.full) (func $bitmap.from-words)
    (func $bitmap.len) (func $bitmap.word-len) (func $bitmap.word) (func $bitmap.get)
    (func $bitmap.count) (func $bitmap.not) (func $bitmap.and) (func $bitmap.or)
    (func $bitmap.xor) (func $bitmap.and-not) (func $bitmap.intersection-count) (func $bitmap.intersects))
  (@use "../../walz/simd/i32-column.walz" (type $i32-column) (func $i32-column.from-list)
    (func $i32-column.len) (func $i32-column.get) (func $i32-column.eq) (func $i32-column.between)
    (func $i32-column.count-eq) (func $i32-column.count-between)
    (func $i32-column.sum) (func $i32-column.sum-where))
  ;; Explicit Core-only resident interface. JS retains opaque GC objects; no
  ;; vector value crosses the JS/WIT ABI, and inputs can be released after pack.
  (type $Input (array (mut i32)))
  (func $input (export "input") (param $n i32) (result (ref $Input)) (@effect allocates)
    (if (result (ref $Input)) (< $n 0) (then (unreachable)) (else (array.new $Input 0 $n))))
  (func $set (export "set") (param $xs (ref $Input)) (param $i i32) (param $value i32)
    (@effect writes) (array.set $Input $xs $i $value))
  (func $column (export "column") (param $xs (ref $Input)) (result (ref $i32-column))
    (@effect reads writes allocates) (call $i32-column.from-list (@list.from-array i32 $Input $xs)))
  (func $bitmap (export "bitmap") (param $n i32) (param $xs (ref $Input)) (result (ref $bitmap))
    (@effect reads writes allocates) (call $bitmap.from-words $n (@list.from-array i32 $Input $xs)))
  ;; Scalar Wasm controls distinguish moving work into Wasm from using a packed
  ;; SIMD layout. Intersection inputs are canonical, already tail-masked words.
  (func $scalar-intersection-count (export "scalar-intersection-count")
    (param $a (ref $Input)) (param $b (ref $Input)) (result i32) (@effect reads)
    (block (result i32)
      (if (!= (array.len $a) (array.len $b)) (then (unreachable)) (else (nop)))
      (@loop $count (bind $i i32 0) (bind $total i32 0) (result i32)
        (if (result i32) (= $i (array.len $a)) (then $total)
          (else (@recur $count (+ $i 1) (+ $total (i32.popcnt
            (& (array.get $Input $a $i) (array.get $Input $b $i))))))))))
  (func $scalar-count-between (export "scalar-count-between") (param $xs (ref $Input))
    (param $lo i32) (param $hi i32) (result i32) (@effect reads)
    (@loop $count (bind $i i32 0) (bind $total i32 0) (result i32)
      (if (result i32) (= $i (array.len $xs)) (then $total)
        (else (@let $v (array.get $Input $xs $i)
          (@recur $count (+ $i 1) (+ $total (i32.and (i32.ge_s $v $lo) (i32.lt_s $v $hi)))))))))
  (func $scalar-sum-where (export "scalar-sum-where") (param $xs (ref $Input))
    (param $words (ref $Input)) (result i64) (@effect reads)
    (block (result i64)
      (if (!= (array.len $words) (+ (i32.shr_u (array.len $xs) 5) (i32.ne (& (array.len $xs) 31) 0)))
        (then (unreachable)) (else (nop)))
      (@loop $sum (bind $i i32 0) (bind $total i64 0) (result i64)
        (if (result i64) (= $i (array.len $xs)) (then $total)
          (else (@recur $sum (+ $i 1) (+ $total
            (* (i64.extend_i32_s (array.get $Input $xs $i))
              (i64.extend_i32_u (& (i32.shr_u
                (array.get $Input $words (i32.shr_u $i 5)) (& $i 31)) 1))))))))))
  (export "column-len" (func $i32-column.len))
  (export "column-get" (func $i32-column.get))
  (export "column-eq" (func $i32-column.eq))
  (export "column-between" (func $i32-column.between))
  (export "column-count-eq" (func $i32-column.count-eq))
  (export "column-count-between" (func $i32-column.count-between))
  (export "column-sum" (func $i32-column.sum))
  (export "column-sum-where" (func $i32-column.sum-where))
  (export "bitmap-empty" (func $bitmap.empty))
  (export "bitmap-full" (func $bitmap.full))
  (export "bitmap-len" (func $bitmap.len))
  (export "bitmap-word-len" (func $bitmap.word-len))
  (export "bitmap-word" (func $bitmap.word))
  (export "bitmap-get" (func $bitmap.get))
  (export "bitmap-count" (func $bitmap.count))
  (export "bitmap-and" (func $bitmap.and))
  (export "bitmap-or" (func $bitmap.or))
  (export "bitmap-xor" (func $bitmap.xor))
  (export "bitmap-and-not" (func $bitmap.and-not))
  (export "bitmap-not" (func $bitmap.not))
  (export "bitmap-intersection-count" (func $bitmap.intersection-count))
  (export "bitmap-intersects" (func $bitmap.intersects)))
