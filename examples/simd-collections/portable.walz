(module
  (@use "walz:core" (type $list))
  (@use "../../walz/simd/bitmap.walz"
    (type $bitmap) (func $bitmap.from-words) (func $bitmap.to-words) (func $bitmap.indices)
    (func $bitmap.count) (func $bitmap.intersection-count) (func $bitmap.intersects)
    (func $bitmap.not) (func $bitmap.and) (func $bitmap.or) (func $bitmap.xor) (func $bitmap.and-not))
  (@use "../../walz/simd/i32-column.walz"
    (func $i32-column.from-list) (func $i32-column.to-list) (func $i32-column.get)
    (func $i32-column.sum) (func $i32-column.sum-where) (func $i32-column.eq) (func $i32-column.between)
    (func $i32-column.count-eq) (func $i32-column.count-between))
  (type $query-result (struct (field $count i32) (field $sum i64) (field $indices $list<i32>)))
  (@abi.type $query-result (record "count" "sum" "indices"))
  (type $Counts (array (mut i32)))
  (func $combine (export "combine") (param $n i32) (param $a $list<i32>) (param $b $list<i32>)
    (param $op i32) (result $list<i32>) (@effect reads writes allocates)
    (@let (($x (call $bitmap.from-words $n $a)) ($y (call $bitmap.from-words $n $b)))
      (call $bitmap.to-words
        (if (result (ref $bitmap)) (= $op 0) (then (call $bitmap.and $x $y))
          (else (if (result (ref $bitmap)) (= $op 1) (then (call $bitmap.or $x $y))
            (else (if (result (ref $bitmap)) (= $op 2) (then (call $bitmap.xor $x $y))
              (else (if (result (ref $bitmap)) (= $op 3) (then (call $bitmap.and-not $x $y))
                (else (unreachable))))))))))))
  (func $complement (export "complement") (param $n i32) (param $words $list<i32>)
    (result $list<i32>) (@effect reads writes allocates)
    (call $bitmap.to-words (call $bitmap.not (call $bitmap.from-words $n $words))))
  (func $count (export "count") (param $n i32) (param $words $list<i32>)
    (result i32) (@effect reads writes allocates)
    (call $bitmap.count (call $bitmap.from-words $n $words)))
  (func $intersection-count (export "intersection-count") (param $n i32)
    (param $a $list<i32>) (param $b $list<i32>) (result i32) (@effect reads writes allocates)
    (call $bitmap.intersection-count (call $bitmap.from-words $n $a) (call $bitmap.from-words $n $b)))
  (func $indices (export "indices") (param $n i32) (param $words $list<i32>)
    (result $list<i32>) (@effect reads writes allocates)
    (call $bitmap.indices (call $bitmap.from-words $n $words)))
  (func $roundtrip (export "roundtrip") (param $values $list<i32>) (result $list<i32>)
    (@effect reads writes allocates)
    (call $i32-column.to-list (call $i32-column.from-list $values)))
  (func $get (export "get") (param $values $list<i32>) (param $i i32) (result i32)
    (@effect reads writes allocates)
    (call $i32-column.get (call $i32-column.from-list $values) $i))
  (func $sum (export "sum") (param $values $list<i32>) (result i64) (@effect reads writes allocates)
    (call $i32-column.sum (call $i32-column.from-list $values)))
  (func $sum-where (export "sum-where") (param $values $list<i32>) (param $words $list<i32>)
    (result i64) (@effect reads writes allocates)
    (call $i32-column.sum-where (call $i32-column.from-list $values)
      (call $bitmap.from-words (@list.len i32 $values) $words)))
  (func $equal (export "equal") (param $values $list<i32>) (param $needle i32) (result $list<i32>)
    (@effect reads writes allocates)
    (call $bitmap.indices (call $i32-column.eq (call $i32-column.from-list $values) $needle)))
  (func $between (export "between") (param $values $list<i32>) (param $lo i32) (param $hi i32)
    (result $list<i32>) (@effect reads writes allocates)
    (call $bitmap.indices (call $i32-column.between (call $i32-column.from-list $values) $lo $hi)))
  (func $count-eq (export "count-eq") (param $values $list<i32>) (param $needle i32)
    (result i32) (@effect reads writes allocates)
    (call $i32-column.count-eq (call $i32-column.from-list $values) $needle))
  (func $count-between (export "count-between") (param $values $list<i32>) (param $lo i32) (param $hi i32)
    (result i32) (@effect reads writes allocates)
    (call $i32-column.count-between (call $i32-column.from-list $values) $lo $hi))
  ;; Transfer and pack the data once for a batch. An empty batch skips packing.
  (func $count-many (export "count-many") (param $values $list<i32>)
    (param $lower $list<i32>) (param $upper $list<i32>) (result $list<i32>)
    (@effect reads writes allocates)
    (@let $n (@list.len i32 $lower)
      (block (result $list<i32>)
        (if (!= $n (@list.len i32 $upper)) (then (unreachable)) (else (nop)))
        (if (result $list<i32>) (= $n 0) (then (@list.new i32))
          (else (@let (($column (call $i32-column.from-list $values)) ($out (array.new $Counts 0 $n)))
            (block (result $list<i32>)
              (@for $queries (bind $i i32 0) (while (< $i $n)) (step (+ $i 1))
                (array.set $Counts $out $i (call $i32-column.count-between $column
                  (@list.get i32 $lower $i) (@list.get i32 $upper $i))))
              (@list.from-array i32 $Counts $out))))))))
  (func $query (export "query") (param $prices $list<i32>) (param $categories $list<i32>)
    (param $lo i32) (param $hi i32) (param $category i32)
    (result (ref $query-result)) (@effect reads writes allocates)
    (@let (($p (call $i32-column.from-list $prices)) ($c (call $i32-column.from-list $categories))
           ($selected (call $bitmap.and (call $i32-column.between $p $lo $hi) (call $i32-column.eq $c $category))))
      (@$query-result::{:count (call $bitmap.count $selected)
        :sum (call $i32-column.sum-where $p $selected) :indices (call $bitmap.indices $selected)})))
)
