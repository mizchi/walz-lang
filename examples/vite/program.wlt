(module
  (%use "wlt:core" (type $string) (type $bytes) (type $future))
  (%use "./helper.wlt" (func $answer))
  (func $main (export "main") (result i32) (%effect pure) (call $answer))
  (func $echo (export "echo") (param $value $string) (result $string) (%effect pure) $value)
  (func $bytes (export "bytes") (param $value $bytes) (result $bytes) (%effect pure) $value)
  (func $wide (export "add-one") (param $value i64) (result i64) (%effect pure) (+ $value 1))
  (func $wait (export "wait") (param $value (%inst $future i32)) (result i32) (%effect suspends)
    (%future.await i32 (%move $value)))
  (func $trap (export "trap") (result i32) (%effect pure) (unreachable)))
