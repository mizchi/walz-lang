(module
  (@use "walz:core" (type $result) (type $tuple)
    (func $i32.checked-mul-u))
  ;; Private value containers can disappear when their caller only decomposes
  ;; them. Returning this value from a public ABI still uses the normal adapter.
  (func $layout (param $count i32) (param $stride i32)
    (result $result<$tuple<i32, i32>, i32>) (@effect pure)
    (@match (call $i32.checked-mul-u $count $stride)
      (@case none () (@result.err 1))
      (@case some ($payload) (@result.ok (@tuple.new $payload (i32.const 2))))))
  (func $main (export "main") (result i32) (@effect pure)
    (@match (call $layout 10 4)
      (@case err ($code) (- 0 $code))
      (@case ok ($pair) (@let ($payload $header) $pair (+ $payload $header))))))
