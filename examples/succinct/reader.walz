(module
  (@race-free)
  (@use "./memory.walz" (memory $memory $shared))
  (@use "./read.walz" (func $validate) (func $query))
  (@atomic.cell $cancel $shared i32 0)
  (@atomic.cell $ready $shared i32 4)
  (memory $private (export "output") 1 256)
  (func $init
    (export "init")
    (param $length i32)
    (@effect reads synchronizes)
    (block
      (if
        (!= (i32.atomic.load (@atomic.at $ready)) 1)
        (then (unreachable))
        (else (nop)))
      (call $validate $length)))

  (func $reserve
    (export "reserve")
    (param $count i32)
    (result i32)
    (@effect reads writes)
    (block
      (result i32)
      (if (i32.gt_u $count 524288) (then (unreachable)) (else (nop)))
      (@let
        (($bytes (* $count 20))
         ($pages (i32.shr_u (+ $bytes 65535) 16))
         ($have (memory.size $private)))
        (block
          (result i32)
          (if
            (> $pages $have)
            (then
              (if
                (= (memory.grow $private (- $pages $have)) -1)
                (then (unreachable))
                (else (nop))))
            (else (nop)))
          (* $count 16))))
  )

  (func $batch
    (export "batch")
    (param $count i32)
    (param $worker i32)
    (result i32)
    (@effect reads writes synchronizes)
    (@let $output (call $reserve $count)
      (@loop $queries
        (bind $i i32 0)
        (result i32)
        (if
          (result i32)
          (= $i $count)
          (then $count)
          (else
            (if
              (result i32)
              (&& (= (i32.and $i 63) 0) (i32.and (i32.atomic.load (@atomic.at $cancel)) (i32.shl 1 $worker)))
              (then -1)
              (else
                (@let $p (* $i 16)
                  (block
                    (result i32)
                    (i32.store $private
                      (+ $output (* $i 4))
                      (call $query
                        (i32.load $private $p)
                        (i32.load $private (+ $p 4))
                        (i32.load $private (+ $p 8))
                        (i32.load $private (+ $p 12))))
                    (@recur $queries (+ $i 1))))
              ))))
      ))))
