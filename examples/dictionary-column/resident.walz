(module
  (@use "walz:core" (type $string) (type $list) (func $string.s64))
  (@use "../../walz/simd/dictionary-column.walz" (type $dictionary-column)
    (func $dictionary-column.from-list) (func $dictionary-column.dictionary)
    (func $dictionary-column.code-column) (func $dictionary-column.len)
    (func $dictionary-column.dictionary-len) (func $dictionary-column.get)
    (func $dictionary-column.count-eq) (func $dictionary-column.eq))
  (@use "../../walz/simd/i32-column.walz" (func $i32-column.get))
  (@use "../../walz/simd/bitmap.walz" (type $bitmap) (func $bitmap.count))
  ;; Core-only reachability fixture. Every input row has its own source slot;
  ;; published dictionary/code/selection objects must not retain the container.
  (type $Source (array (mut $string)))
  (func $input (export "input") (param $n i32) (result (ref $Source)) (@effect allocates)
    (array.new $Source "" $n))
  (func $set (export "set") (param $xs (ref $Source)) (param $i i32) (param $value i32)
    (@effect reads writes allocates)
    (array.set $Source $xs $i (call $string.s64 (i64.extend_i32_s $value))))
  (func $pack (export "pack") (param $xs (ref $Source)) (result (ref $dictionary-column))
    (@effect reads writes allocates)
    (call $dictionary-column.from-list (@list.from-array $string $Source $xs)))
  (func $count (export "count") (param $column (ref $dictionary-column)) (param $value i32)
    (result i32) (@effect reads writes allocates)
    (call $dictionary-column.count-eq $column (call $string.s64 (i64.extend_i32_s $value))))
  (func $equal (export "equal") (param $column (ref $dictionary-column)) (param $value i32)
    (result (ref $bitmap)) (@effect reads writes allocates)
    (call $dictionary-column.eq $column (call $string.s64 (i64.extend_i32_s $value))))
  (func $key-length (export "key-length") (param $keys $list<$string>) (param $i i32)
    (result i32) (@effect pure) (@string.byte-len (@list.get $string $keys $i)))
  (export "dictionary" (func $dictionary-column.dictionary))
  (export "codes" (func $dictionary-column.code-column))
  (export "len" (func $dictionary-column.len))
  (export "dictionary-len" (func $dictionary-column.dictionary-len))
  (export "code-get" (func $i32-column.get))
  (export "bitmap-count" (func $bitmap.count)))
