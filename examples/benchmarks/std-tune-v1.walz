(module
  (@import "walz:std" (type $string) (type $bytes) (type $result) (type $json-value)
    (func $string.concat) (func $string.json) (func $bytes.concat)
    (func $string-builder.new) (func $string-builder.text) (func $string-builder.finish)
    (func $json-value.parse))
  (func $input64 (param $i i32) (result $string)
    (if (result $string) (& $i 1) (then (@string.lit "abcXYZ09abcXYZ09abcXYZ09abcXYZ09abcXYZ09abcXYZ09abcXYZ09abcXYZ09")) (else (@string.lit "ZbcXYZ09abcXYZ09abcXYZ09abcXYZ09abcXYZ09abcXYZ09abcXYZ09abcXYZ09"))))
  (@bench "input 64" (param $i i32) (result $string) (call $input64 $i))
  (@bench "string.concat 64" (param $i i32) (result $string)
    (call $string.concat (call $input64 $i) (call $input64 (+ $i 1))))
  (@bench "string.json ASCII 64" (param $i i32) (result $string)
    (call $string.json (call $input64 $i)))
  (func $input1024 (param $i i32) (result $string)
    (if (result $string) (& $i 1) (then (@string.lit "")) (else (@string.lit ""))))
  (@bench "input 1024" (param $i i32) (result $string) (call $input1024 $i))
  (@bench "string.concat 1024" (param $i i32) (result $string)
    (call $string.concat (call $input1024 $i) (call $input1024 (+ $i 1))))
  (@bench "string.json ASCII 1024" (param $i i32) (result $string)
    (call $string.json (call $input1024 $i)))
  (@bench "string.json Unicode" (param $i i32) (result $string)
    (call $string.json (@string.lit "日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a日🦀a")))
  (@bench "string.json escaped" (param $i i32) (result $string)
    (call $string.json (@string.lit "a\22\5c\0a\09\0d\00ba\22\5c\0a\09\0d\00ba\22\5c\0a\09\0d\00ba\22\5c\0a\09\0d\00ba\22\5c\0a\09\0d\00ba\22\5c\0a\09\0d\00ba\22\5c\0a\09\0d\00ba\22\5c\0a\09\0d\00ba\22\5c\0a\09\0d\00ba\22\5c\0a\09\0d\00ba\22\5c\0a\09\0d\00ba\22\5c\0a\09\0d\00ba\22\5c\0a\09\0d\00ba\22\5c\0a\09\0d\00ba\22\5c\0a\09\0d\00ba\22\5c\0a\09\0d\00b")))
  (@bench "bytes.concat 1024" (param $i i32) (result $bytes)
    (call $bytes.concat (@string.bytes (call $input1024 $i)) (@string.bytes (call $input1024 (+ $i 1)))))
  (@bench "builder 16x64" (param $i i32) (result $string)
    (@let $b (call $string-builder.new)
      (block (result $string)
        (@for $fill (bind $j i32 0) (while (< $j 16)) (step (+ $j 1))
          (call $string-builder.text $b (call $input64 (+ $i $j))))
        (call $string-builder.finish $b))))
  (@bench "JSON parse long string" (param $i i32) (result (@inst $result (ref $json-value) i32))
    (call $json-value.parse (@string.lit "{\"text\":\"\",\"count\":42}")))
)
