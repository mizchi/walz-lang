(module
  (@use "walz:core" (type $list))
  (@export (opaque $numeric-store) (func $numeric-store.new) (func $numeric-store.len)
    (func $numeric-store.kind) (func $numeric-store.number) (func $numeric-store.numeric))
  ;; Raw f64 payloads and four one-byte kind tags per word. Both lists are
  ;; immutable snapshots. Nullish payloads are preserved for native Cell views.
  (type $numeric-store (struct (field $numbers $list<f64>) (field $tags $list<i32>) (field $length i32)))
  (func $numeric-store.len (param $s (ref $numeric-store)) (result i32) (@effect pure)
    (struct.get $numeric-store $length $s))
  (func $numeric-store.kind (param $s (ref $numeric-store)) (param $row i32) (result i32) (@effect pure)
    (block (result i32)
      (if (i32.ge_u $row (call $numeric-store.len $s)) (then (unreachable)) (else (nop)))
      (& (i32.shr_u (@list.get i32 (struct.get $numeric-store $tags $s) (i32.shr_u $row 2))
        (i32.shl (& $row 3) 3)) 255)))
  (func $numeric-store.number (param $s (ref $numeric-store)) (param $row i32) (result f64) (@effect pure)
    (@list.get f64 (struct.get $numeric-store $numbers $s) $row))
  (func $numeric-store.numeric (param $s (ref $numeric-store)) (param $row i32) (result f64) (@effect pure)
    (@let $kind (call $numeric-store.kind $s $row)
      (if (result f64) (= $kind 0) (then (f64.const nan))
        (else (if (result f64) (= $kind 1) (then (f64.const 0)) (else (call $numeric-store.number $s $row)))))))
  (func $numeric-store.new (param $numbers $list<f64>) (param $tags $list<i32>) (result (ref $numeric-store)) (@effect allocates)
    (@let $n (@list.len f64 $numbers)
      (block (result (ref $numeric-store))
        (if (|| (< $n 0) (!= (@list.len i32 $tags) (+ (i32.shr_u $n 2) (!= (& $n 3) 0)))) (then (unreachable)) (else (nop)))
        (@let $out (struct.new $numeric-store $numbers $tags $n)
          (block (result (ref $numeric-store))
            (@for $check (bind $i i32 0) (while (< $i $n)) (step (+ $i 1))
              (@let (($kind (call $numeric-store.kind $out $i)) ($v (call $numeric-store.number $out $i)))
                (if (|| (> $kind 3) (&& (= $kind 2) (&& (f64.ne $v (f64.const 0)) (f64.ne $v (f64.const 1)))))
                  (then (unreachable)) (else (nop)))))
            $out)))))
)
