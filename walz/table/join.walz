(module
  (@use "walz:core" (type $string) (type $list) (type $option) (type $list-builder)
    (func $dict.new) (func $dict.get) (func $dict.set)
    (func $list-builder.new) (func $list-builder.push) (func $list-builder.finish) (func $list-builder.len)
    (func $string-builder.new) (func $string-builder.text) (func $string-builder.finish))
  (@use "./value.walz" (type $cell) (func $cell.new) (func $cell.kind) (func $cell.valid) (func $cell.key))
  (@use "./engine.walz" (type $table) (type $column) (func $table.new) (func $table.unorder)
    (func $table.num-rows) (func $table.num-cols) (func $table.column) (func $table.get) (func $table.is-grouped)
    (func $column.new) (func $column.name))
  (@export (opaque $join-column) (func $join-column.new) (func $table.join))
  ;; side 0 = left, 1 = right, 2 = coalesced shared key for a full join.
  (type $join-column (struct (field $name $string) (field $side i32) (field $left i32) (field $right i32)))
  (type $Node (struct (field $position i32) (field $next (ref null $Node))))
  (type $Bucket (struct (field $head (mut (ref null $Node)))))
  (type $Pair (struct (field $left i32) (field $right i32)))
  (type $Hits (array (mut i32)))
  (func $emit (param $pairs (ref (@inst $list-builder (ref $Pair)))) (param $left i32) (param $right i32)
    (@effect reads writes allocates)
    (if (= (call (@inst $list-builder.len (ref $Pair)) $pairs) 2147483647) (then (unreachable))
      (else (call (@inst $list-builder.push (ref $Pair)) $pairs (struct.new $Pair $left $right)))))
  (func $join-column.new (param $name $string) (param $side i32) (param $left i32) (param $right i32)
    (result (ref $join-column)) (@effect allocates)
    (if (result (ref $join-column)) (i32.gt_u $side 2) (then (unreachable))
      (else (struct.new $join-column $name $side $left $right))))
  (func $key (param $t (ref $table)) (param $columns $list<i32>) (param $row i32) (result $option<$string>)
    (@effect reads writes allocates)
    (@let $out (call $string-builder.new)
      (block (result $option<$string>)
        (@for $each (bind $i i32 0) (while (< $i (@list.len i32 $columns))) (step (+ $i 1))
          (@let $v (call $table.get $t (@list.get i32 $columns $i) $row)
            (if (call $cell.valid $v)
              (then (call $string-builder.text $out (call $cell.key $v)))
              (else (return (@option.none))))))
        (@option.some (call $string-builder.finish $out)))))
  (func $value (param $t (ref $table)) (param $column i32) (param $row i32) (result (ref $cell)) (@effect reads writes allocates)
    (if (result (ref $cell)) (< $row 0) (then (call $cell.new 0 (f64.const 0) ""))
      (else (call $table.get $t $column $row))))
  (func $table.join (param $input-left (ref $table)) (param $input-right (ref $table))
    (param $left-keys $list<i32>) (param $right-keys $list<i32>)
    (param $layout (@inst $list (ref $join-column))) (param $mode i32)
    (result (ref $table)) (@effect reads writes allocates)
    (@let (($semi (>= $mode 4))
           ($left (if (result (ref $table)) $semi (then $input-left) (else (call $table.unorder $input-left))))
           ($right (call $table.unorder $input-right))
           ($n-left (call $table.num-rows $left)) ($n-right (call $table.num-rows $right))
           ($hash-right (|| $semi (>= $n-left $n-right)))
           ($hashed (if (result (ref $table)) $hash-right (then $right) (else $left)))
           ($scanned (if (result (ref $table)) $hash-right (then $left) (else $right)))
           ($hash-keys (if (result $list<i32>) $hash-right (then $right-keys) (else $left-keys)))
           ($scan-keys (if (result $list<i32>) $hash-right (then $left-keys) (else $right-keys)))
           ($lookup (call (@inst $dict.new (ref $Bucket))))
           ($hit-left (array.new $Hits 0 $n-left)) ($hit-right (array.new $Hits 0 $n-right))
           ($pairs (call (@inst $list-builder.new (ref $Pair)))))
      (block (result (ref $table))
        (if (|| (call $table.is-grouped $input-left) (call $table.is-grouped $input-right)) (then (unreachable)) (else (nop)))
        (if (|| (i32.gt_u $mode 5) (|| (= (@list.len i32 $left-keys) 0)
            (!= (@list.len i32 $left-keys) (@list.len i32 $right-keys)))) (then (unreachable)) (else (nop)))
        (@for $keys (bind $i i32 0) (while (< $i (@list.len i32 $left-keys))) (step (+ $i 1))
          (block (drop (call $table.column $left (@list.get i32 $left-keys $i)))
            (drop (call $table.column $right (@list.get i32 $right-keys $i)))))
        (@for $layout (bind $i i32 0) (while (< $i (@list.len (ref $join-column) $layout))) (step (+ $i 1))
          (@let (($c (@list.get (ref $join-column) $layout $i)) ($side (struct.get $join-column $side $c)))
            (block
              (if (!= $side 1) (then (drop (call $table.column $left (struct.get $join-column $left $c)))) (else (nop)))
              (if (!= $side 0) (then (drop (call $table.column $right (struct.get $join-column $right $c)))) (else (nop))))))
        ;; Prepending in reverse preserves input order within a hash bucket.
        (@loop $build (bind $i i32 (- (call $table.num-rows $hashed) 1))
          (if (>= $i 0)
            (then (block
              (@match (call $key $hashed $hash-keys $i)
                (@case none () (nop))
                (@case some ($key)
                  (@match (call (@inst $dict.get (ref $Bucket)) $lookup $key)
                    (@case none () (drop (call (@inst $dict.set (ref $Bucket)) $lookup $key
                      (struct.new $Bucket (struct.new $Node $i (ref.null $Node))))))
                    (@case some ($bucket) (struct.set $Bucket $head $bucket
                      (struct.new $Node $i (struct.get $Bucket $head $bucket)))))))
              (@recur $build (- $i 1)))) (else (nop))))
        (@for $scan (bind $i i32 0) (while (< $i (call $table.num-rows $scanned))) (step (+ $i 1))
          (@match (call $key $scanned $scan-keys $i)
            (@case none () (nop))
            (@case some ($key)
              (@match (call (@inst $dict.get (ref $Bucket)) $lookup $key)
                (@case none () (nop))
                (@case some ($bucket)
                  (@loop $matches (bind $node (ref null $Node) (struct.get $Bucket $head $bucket))
                    (if (ref.is_null $node) (then (nop))
                      (else (@let (($node (ref.as_non_null $node)) ($j (struct.get $Node $position $node))
                                   ($l (if (result i32) $hash-right (then $i) (else $j)))
                                   ($r (if (result i32) $hash-right (then $j) (else $i))))
                        (block
                          (array.set $Hits $hit-left $l 1) (array.set $Hits $hit-right $r 1)
                          (if $semi (then (nop))
                            (else (call $emit $pairs $l $r)))
                          (@recur $matches (struct.get $Node $next $node))))))))))))
        (@for $left (bind $i i32 0) (while (< $i $n-left)) (step (+ $i 1))
          (if (if (result i32) $semi
                (then (= (array.get $Hits $hit-left $i) (if (result i32) (= $mode 4) (then 1) (else 0))))
                (else (&& (|| (= $mode 1) (= $mode 3)) (i32.eqz (array.get $Hits $hit-left $i)))))
            (then (call $emit $pairs $i -1)) (else (nop))))
        (@for $right (bind $i i32 0) (while (< $i $n-right)) (step (+ $i 1))
          (if (&& (|| (= $mode 2) (= $mode 3)) (i32.eqz (array.get $Hits $hit-right $i)))
            (then (call $emit $pairs -1 $i)) (else (nop))))
        (@let (($pairs (call (@inst $list-builder.finish (ref $Pair)) $pairs))
               ($columns (call (@inst $list-builder.new (ref $column)))))
          (block (result (ref $table))
            (@for $columns (bind $c i32 0) (while (< $c (@list.len (ref $join-column) $layout))) (step (+ $c 1))
              (@let (($spec (@list.get (ref $join-column) $layout $c)) ($side (struct.get $join-column $side $spec))
                     ($values (call (@inst $list-builder.new (ref $cell)))))
                (block
                  (@for $rows (bind $i i32 0) (while (< $i (@list.len (ref $Pair) $pairs))) (step (+ $i 1))
                    (@let (($pair (@list.get (ref $Pair) $pairs $i))
                           ($a (if (result (ref $cell)) (= $side 1) (then (call $cell.new 0 (f64.const 0) ""))
                             (else (call $value $left (struct.get $join-column $left $spec) (struct.get $Pair $left $pair))))))
                      (call (@inst $list-builder.push (ref $cell)) $values
                        (if (result (ref $cell)) (|| (= $side 1) (&& (= $side 2) (< (call $cell.kind $a) 2)))
                          (then (call $value $right (struct.get $join-column $right $spec) (struct.get $Pair $right $pair))) (else $a)))))
                  (call (@inst $list-builder.push (ref $column)) $columns
                    (call $column.new (struct.get $join-column $name $spec)
                      (call (@inst $list-builder.finish (ref $cell)) $values))))))
            (call $table.new (call (@inst $list-builder.finish (ref $column)) $columns) (@list.len (ref $Pair) $pairs)))))))
)
