              (else (nop)))
            (@match (call $types.collect $syntax)
              (@case err ($e) (return (@result.err $e)))
              (@case ok ($env) (struct.set $State $gc $s $env)))
            (@let
              (($decls (call $list-builder.new<(ref $Decl)>))
               ($exports (call $list-builder.new<(ref $export-ir)>))
               ($functions (call $list-builder.new<(ref $function-ir)>))
               ($start
                 (+ 1
                   (&& (> (call $len $root) 1) (call $name (call $child $s $root 1))))
