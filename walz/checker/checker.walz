  (func $checker.check
    (param $syntax (ref $syntax))
    (result $result<(ref $module-ir), (ref $diagnostic)>)
    (@effect reads writes allocates)
    (@let
      (($s
         (struct.new $State
           (ref.null $type-env)
           (call $syntax.nodes $syntax)
           (@list.new (ref $Decl))
           (ref.null $diagnostic)))
       ($roots (call $syntax.roots $syntax)))
      (block
        (result $result<(ref $module-ir), (ref $diagnostic)>)
        (if
          (!= (@list.len i32 $roots) 1)
          (then (return (@result.err (struct.new $diagnostic 100 0 0))))
          (else (nop)))
        (@let $root (call $node $s (@list.get i32 $roots 0))
          (block
            (result $result<(ref $module-ir), (ref $diagnostic)>)
            (if
              (i32.eqz (call $head $s $root "module"))
              (then
                (return
                  (@result.err
                    (struct.new $diagnostic
                      100
                      (call $node.start $root)
                      (call $node.end $root))))
