                              (bind $j i32 0)
                              (while (< $j $i))
                              (step (+ $j 1))
                              (@let $b
                                (struct.get $Decl $name (@list.get (ref $Decl) $all $j))
                                (if
                                  (&&
                                    (i32.eqz (ref.is_null $b))
                                    (call $same
