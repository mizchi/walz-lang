(module
  (@use "walz:core"
    (type $bytes)
    (type $string)
    (type $list)
    (type $result)
    (type $option)
    (type $tuple))
  (@use "../parser/parser.walz"
    (type $syntax)
    (type $node)
    (type $diagnostic)
    (func $syntax.nodes)
    (func $syntax.roots)
    (func $node.kind)
    (func $node.start)
    (func $node.end)
    (func $node.value)
    (func $node.children)
    (func $node.is))
  (@use "../parser/number.walz" (func $number.i32) (func $number.i64))
  (@use "../core/bytes.walz" (func $bytes.equal))
  (@use "walz:core"
    (type $list-builder)
    (func $list-builder.new)
    (func $list-builder.len)
    (func $list-builder.push)
    (func $list-builder.finish)
    (func $list-builder.extend))
  (@use "./ir.walz"
    (type $function-ir)
    (type $instruction-ir)
    (type $export-ir)
    (func $ir.value-type))
  (@use "./stack.walz" (func $stack.validate))
  (@use "./operators.walz"
    (func $operator.code)
    (func $operator.alias)
    (func $operator.comparison)
    (func $operator.input)
    (func $operator.result)
    (func $operator.arity))
  (@use "./ir.walz"
    (type $gc-type-ir)
    (type $field-ir)
    (func $ir.ref)
    (func $ir.is-ref)
    (func $ir.heap)
    (func $ir.nullable)
    (func $ir.unpack))
  (@use "./type-env.walz"
    (type $type-env)
    (func $types.collect)
    (func $types.defs)
    (func $types.value)
    (func $types.heap)
    (func $types.field))
  (@use "./gc-types.walz" (func $gc.value-valid))
  (@use "./gc-operators.walz" (func $gc-op.code))
  (@use "./stack.walz" (func $stack.validate-gc))
  (@use "./gc-effects.walz" (func $gc-effects.validate))
  (@export
    (opaque $module-ir)
    (func $checker.check)
    (func $checker.validate)
    (func $module-ir.functions)
    (func $module-ir.exports)
    (func $module-ir.types)
    (func $checker.validate-gc))
  (type $module-ir
    (struct
      (field $types $list<(ref $gc-type-ir)>)
      (field $functions $list<(ref $function-ir)>)
      (field $exports $list<(ref $export-ir)>)))
  (type $Variable (struct (field $name (ref null $node)) (field $type i32)))
  (type $Decl
    (struct
      (field $name (ref null $node))
      (field $params $list<(ref $Variable)>)
      (field $locals $list<(ref $Variable)>)
      (field $result i32)
      (field $body $list<(ref $node)>)
      (field $effect i32)
      (field $source (ref $node))))
  (type $State
    (struct
      (field $gc (mut (ref null $type-env)))
      (field $nodes $list<(ref $node)>)
      (field $decls (mut $list<(ref $Decl)>))
      (field $error (mut (ref null $diagnostic))))
  )
  (type $Signature
    (struct
      (field $params (ref $list-builder<(ref $Variable)>))
      (field $locals (ref $list-builder<(ref $Variable)>))
      (field $body (ref $list-builder<(ref $node)>))
      (field $result (mut i32))
      (field $seen (mut i32))
      (field $effect (mut i32))
      (field $started (mut i32))))
  (type $Binding
    (struct
      (field $name (ref $node))
      (field $type i32)
      (field $index i32)
      (field $parent (ref null $Binding))))
  (type $Label
    (struct
      (field $name (ref null $node))
      (field $type i32)
      (field $parent (ref null $Label))))
  (type $Context
    (struct
      (field $state (ref $State))
      (field $decl (ref $Decl))
      (field $instructions (ref $list-builder<(ref $instruction-ir)>))
      (field $extra (ref $list-builder<i32>))))
  (func $module-ir.functions
    (param $m (ref $module-ir))
    (result $list<(ref $function-ir)>)
    (@effect pure)
    (struct.get $module-ir $functions $m))

  (func $module-ir.exports
    (param $m (ref $module-ir))
    (result $list<(ref $export-ir)>)
    (@effect pure)
    (struct.get $module-ir $exports $m))

  (func $module-ir.types
    (param $m (ref $module-ir))
    (result $list<(ref $gc-type-ir)>)
    (@effect pure)
    (struct.get $module-ir $types $m))

  (func $checker.validate
    (param $functions $list<(ref $function-ir)>)
    (param $exports $list<(ref $export-ir)>)
    (result $result<(ref $module-ir), (ref $diagnostic)>)
    (@effect reads writes allocates)
    (call $checker.validate-gc (@list.new (ref $gc-type-ir)) $functions $exports))

  (func $checker.validate-gc
    (param $types $list<(ref $gc-type-ir)>)
    (param $functions $list<(ref $function-ir)>)
    (param $exports $list<(ref $export-ir)>)
    (result $result<(ref $module-ir), (ref $diagnostic)>)
    (@effect reads writes allocates)
    (@match (call $stack.validate-gc $types $functions $exports)
      (@case err ($e) (@result.err $e))
      (@case ok ($n) (@result.ok (struct.new $module-ir $types $functions $exports))))
  )

  (func $ok
    (param $s (ref $State))
    (result i32)
    (@effect reads)
    (ref.is_null (struct.get $State $error $s)))

  (func $bad
    (param $s (ref $State))
    (param $n (ref $node))
    (param $code i32)
    (@effect reads writes allocates)
    (if
      (call $ok $s)
      (then
        (struct.set $State $error $s
          (struct.new $diagnostic $code (call $node.start $n) (call $node.end $n))))
      (else (nop))))

  (func $node
    (param $s (ref $State))
    (param $id i32)
    (result (ref $node))
    (@effect pure)
    (@list.get (ref $node) (struct.get $State $nodes $s) $id))

  (func $len
    (param $n (ref $node))
    (result i32)
    (@effect pure)
    (@list.len i32 (call $node.children $n)))

  (func $child
    (param $s (ref $State))
    (param $n (ref $node))
    (param $i i32)
    (result (ref $node))
    (@effect pure)
    (call $node $s (@list.get i32 (call $node.children $n) $i)))

  (func $head
    (param $s (ref $State))
    (param $n (ref $node))
    (param $word $string)
    (result i32)
    (@effect pure)
    (&&
      (= (call $node.kind $n) 2)
      (&& (> (call $len $n) 0) (call $node.is (call $child $s $n 0) $word))))

  (func $name
    (param $n (ref $node))
    (result i32)
    (@effect pure)
    (@let $b (call $node.value $n)
      (block
        (result i32)
        (if
          (i32.eqz
            (&&
              (= (call $node.kind $n) 0)
              (&& (> (@bytes.len $b) 1) (= (@bytes.get $b 0) 36))))
          (then (return 0))
          (else (nop)))
        (@loop $identifier
          (bind $i i32 1)
          (result i32)
          (if
            (result i32)
            (= $i (@bytes.len $b))
            (then 1)
            (else
              (@let $c (@bytes.get $b $i)
                (if
                  (result i32)
                  (||
                    (< $c 33)
                    (||
                      (> $c 126)
                      (||
                        (= $c 34)
                        (||
                          (= $c 40)
                          (||
                            (= $c 41)
                            (||
                              (= $c 44)
                              (||
                                (= $c 59)
                                (|| (= $c 91) (|| (= $c 93) (|| (= $c 123) (= $c 125))))
                              ))))
                      )))
                  (then 0)
                  (else (@recur $identifier (+ $i 1))))
              ))))
      )))

  (func $same
    (param $a (ref $node))
    (param $b (ref $node))
    (result i32)
    (@effect pure)
    (call $bytes.equal (call $node.value $a) (call $node.value $b)))

  (func $type
    (param $s (ref $State))
    (param $n (ref $node))
    (result i32)
    (@effect reads writes allocates)
    (@let $t (call $types.value (ref.as_non_null (struct.get $State $gc $s)) $n)
      (block (result i32) (if (= $t 0) (then (call $bad $s $n 118)) (else (nop))) $t)))

  (func $variable
    (param $s (ref $State))
    (param $sig (ref $Signature))
    (param $n (ref $node))
    (param $local i32)
    (@effect reads writes allocates)
    (block
      (if
        (||
          (struct.get $Signature $started $sig)
          (|| (< (call $len $n) 2) (> (call $len $n) 3)))
        (then (block (call $bad $s $n 104) (return)))
        (else (nop)))
      (if
        (&&
          (= $local 0)
          (||
            (struct.get $Signature $seen $sig)
            (>
              (call $list-builder.len<(ref $Variable)>
                (struct.get $Signature $locals $sig))
              0)))
        (then (block (call $bad $s $n 104) (return)))
        (else (nop)))
      (@let
        (($named (= (call $len $n) 3))
         ($value (call $child $s $n 1))
         ($t (call $type $s (call $child $s $n (- (call $len $n) 1))))
         ($out
           (if
             (result (ref $list-builder<(ref $Variable)>))
             $local
             (then (struct.get $Signature $locals $sig))
             (else (struct.get $Signature $params $sig))))
        )
        (block
          (if
            (|| (= $t 0) (&& $named (i32.eqz (call $name $value))))
            (then (block (call $bad $s $n 104) (return)))
            (else (nop)))
          (if
            (>=
              (call $list-builder.len<(ref $Variable)> $out)
              (if (result i32) $local (then 1024) (else 256)))
            (then (block (call $bad $s $n 150) (return)))
            (else (nop)))
          (call $list-builder.push<(ref $Variable)> $out
            (struct.new $Variable
              (if
                (result (ref null $node))
                $named
                (then $value)
                (else (ref.null $node)))
              $t))))
    ))

  (func $declare
    (param $s (ref $State))
    (param $n (ref $node))
    (result (ref null $Decl))
    (@effect reads writes allocates)
    (@let
      (($has-name (&& (> (call $len $n) 1) (call $name (call $child $s $n 1))))
       ($sig
         (struct.new $Signature
           (call $list-builder.new<(ref $Variable)>)
           (call $list-builder.new<(ref $Variable)>)
           (call $list-builder.new<(ref $node)>)
           64
           0
           0
           0)))
      (block
        (result (ref null $Decl))
        (@for $fields
          (bind $i i32 (+ 1 $has-name))
          (while (&& (< $i (call $len $n)) (call $ok $s)))
          (step (+ $i 1))
          (@let $field (call $child $s $n $i)
            (if
              (call $head $s $field "param")
              (then (call $variable $s $sig $field 0))
              (else
                (if
                  (call $head $s $field "local")
                  (then (call $variable $s $sig $field 1))
                  (else
                    (if
                      (call $head $s $field "result")
                      (then
                        (if
                          (||
                            (struct.get $Signature $seen $sig)
                            (||
                              (struct.get $Signature $started $sig)
                              (||
                                (>
                                  (call $list-builder.len<(ref $Variable)>
                                    (struct.get $Signature $locals $sig))
                                  0)
                                (|| (< (call $len $field) 1) (> (call $len $field) 2))))
                          )
                          (then (call $bad $s $field 104))
                          (else
                            (@let $t
                              (if (result i32) (= (call $len $field) 1) (then 64) (else (call $type $s (call $child $s $field 1))))
                              (if
                                (= $t 0)
                                (then (call $bad $s $field 104))
                                (else
                                  (block
                                    (struct.set $Signature $result $sig $t)
                                    (struct.set $Signature $seen $sig 1))))
                            ))))
                      (else
                        (if
                          (call $head $s $field "export")
                          (then
                            (if
                              (struct.get $Signature $started $sig)
                              (then (call $bad $s $field 104))
                              (else (nop))))
                          (else
                            (if
                              (call $head $s $field "@effect")
                              (then
                                (if
                                  (&&
                                    (= (struct.get $Signature $started $sig) 0)
                                    (&&
                                      (> (call $len $field) 1)
                                      (= (struct.get $Signature $effect $sig) 0)))
                                  (then
                                    (@let $bits (call $effect-bits $s $field)
                                      (struct.set $Signature $effect $sig (+ $bits 1))))
                                  (else (call $bad $s $field 104))))
                              (else
                                (block
                                  (struct.set $Signature $started $sig 1)
                                  (call $list-builder.push<(ref $node)>
                                    (struct.get $Signature $body $sig)
                                    $field))))
                          ))))
                  ))))
          ))
        (@let
          (($params
             (call $list-builder.finish<(ref $Variable)>
               (struct.get $Signature $params $sig)))
           ($locals
             (call $list-builder.finish<(ref $Variable)>
               (struct.get $Signature $locals $sig)))
           ($all (call $list-builder.new<(ref $Variable)>)))
          (block
            (result (ref null $Decl))
            (call $list-builder.extend<(ref $Variable)> $all $params)
            (call $list-builder.extend<(ref $Variable)> $all $locals)
            (@let $vars (call $list-builder.finish<(ref $Variable)> $all)
              (@for $outer
                (bind $i i32 0)
                (while (< $i (@list.len (ref $Variable) $vars)))
                (step (+ $i 1))
                (@let $a
                  (struct.get $Variable $name (@list.get (ref $Variable) $vars $i))
                  (if
                    (ref.is_null $a)
                    (then (nop))
                    (else
                      (@for $inner
                        (bind $j i32 0)
                        (while (< $j $i))
                        (step (+ $j 1))
                        (@let $b
                          (struct.get $Variable $name (@list.get (ref $Variable) $vars $j))
                          (if
                            (&&
                              (i32.eqz (ref.is_null $b))
                              (call $same (ref.as_non_null $a) (ref.as_non_null $b)))
                            (then (call $bad $s (ref.as_non_null $a) 104))
                            (else (nop))))
                      ))))
              ))
            (if
              (result (ref null $Decl))
              (call $ok $s)
              (then
                (struct.new $Decl
                  (if
                    (result (ref null $node))
                    $has-name
                    (then (call $child $s $n 1))
                    (else (ref.null $node)))
                  $params
                  $locals
                  (struct.get $Signature $result $sig)
                  (call $list-builder.finish<(ref $node)>
                    (struct.get $Signature $body $sig))
                  (struct.get $Signature $effect $sig)
                  $n))
              (else (ref.null $Decl))))
        ))))

  (func $find
    (param $s (ref $State))
    (param $n (ref $node))
    (result i32)
    (@effect reads writes allocates)
    (block
      (result i32)
      (if (!= (call $node.kind $n) 0) (then (return -1)) (else (nop)))
      (@let $decls (struct.get $State $decls $s)
        (if
          (result i32)
          (call $name $n)
          (then
            (@loop $search
              (bind $i i32 0)
              (result i32)
              (if
                (result i32)
                (= $i (@list.len (ref $Decl) $decls))
                (then -1)
                (else
                  (@let $name (struct.get $Decl $name (@list.get (ref $Decl) $decls $i))
                    (if
                      (result i32)
                      (&&
                        (i32.eqz (ref.is_null $name))
                        (call $same (ref.as_non_null $name) $n))
                      (then $i)
                      (else (@recur $search (+ $i 1))))
                  ))))
          )
          (else
            (@match (call $number.i32 (call $node.value $n))
              (@case none () -1)
              (@case some ($i)
                (if
                  (result i32)
                  (i32.lt_u $i (@list.len (ref $Decl) $decls))
                  (then $i)
                  (else -1))))
          ))))
  )

  (func $instruction
    (param $c (ref $Context))
    (param $n (ref $node))
    (param $op i32)
    (param $imm i64)
    (@effect reads writes allocates)
    (call $list-builder.push<(ref $instruction-ir)>
      (struct.get $Context $instructions $c)
      (struct.new $instruction-ir $op $imm (call $node.start $n) (call $node.end $n))))

  (func $base-count
    (param $d (ref $Decl))
    (result i32)
    (@effect pure)
    (+
      (@list.len (ref $Variable) (struct.get $Decl $params $d))
      (@list.len (ref $Variable) (struct.get $Decl $locals $d))))

  (func $base-var
    (param $d (ref $Decl))
    (param $i i32)
    (result (ref $Variable))
    (@effect pure)
    (@let $n (@list.len (ref $Variable) (struct.get $Decl $params $d))
      (if
        (result (ref $Variable))
        (< $i $n)
        (then (@list.get (ref $Variable) (struct.get $Decl $params $d) $i))
        (else (@list.get (ref $Variable) (struct.get $Decl $locals $d) (- $i $n))))
    ))

  (func $lookup
    (param $c (ref $Context))
    (param $n (ref $node))
    (param $env (ref null $Binding))
    (param $write i32)
    (result $tuple<i32, i32>)
    (@effect reads writes allocates)
    (@let
      (($s (struct.get $Context $state $c))
       ($d (struct.get $Context $decl $c)))
      (block
        (result $tuple<i32, i32>)
        (if
          (call $name $n)
          (then
            (block
              (@loop $lets
                (bind $p (ref null $Binding) $env)
                (if
                  (ref.is_null $p)
                  (then (nop))
                  (else
                    (@let $b (ref.as_non_null $p)
                      (if
                        (call $same $n (struct.get $Binding $name $b))
                        (then
                          (block
                            (if $write (then (call $bad $s $n 113)) (else (nop)))
                            (return
                              (@tuple.new
                                (struct.get $Binding $index $b)
                                (struct.get $Binding $type $b))))
                        )
                        (else (@recur $lets (struct.get $Binding $parent $b))))
                    ))))
              (@for $vars
                (bind $i i32 0)
                (while (< $i (call $base-count $d)))
                (step (+ $i 1))
                (@let
                  (($v (call $base-var $d $i))
                   ($name (struct.get $Variable $name $v)))
                  (if
                    (&&
                      (i32.eqz (ref.is_null $name))
                      (call $same $n (ref.as_non_null $name)))
                    (then (return (@tuple.new $i (struct.get $Variable $type $v))))
                    (else (nop))))
              )))
          (else
            (if
              (= (call $node.kind $n) 0)
              (then
                (@match (call $number.i32 (call $node.value $n))
                  (@case none () (nop))
                  (@case some ($i)
                    (if
                      (i32.lt_u $i (call $base-count $d))
                      (then
                        (return
                          (@tuple.new $i
                            (struct.get $Variable $type (call $base-var $d $i))))
                      )
                      (else (nop))))
                ))
              (else (nop))))
        )
        (call $bad $s $n 109)
        (@tuple.new -1 0))))

  (func $label
    (param $s (ref $State))
    (param $n (ref $node))
    (param $labels (ref $Label))
    (result $tuple<i32, i32>)
    (@effect reads writes allocates)
    (block
      (result $tuple<i32, i32>)
      (if
        (call $name $n)
        (then
          (@loop $names
            (bind $p (ref null $Label) $labels)
            (bind $i i32 0)
            (if
              (ref.is_null $p)
              (then (nop))
              (else
                (@let
                  (($l (ref.as_non_null $p))
                   ($name (struct.get $Label $name $l)))
                  (if
                    (&&
                      (i32.eqz (ref.is_null $name))
                      (call $same $n (ref.as_non_null $name)))
                    (then (return (@tuple.new $i (struct.get $Label $type $l))))
                    (else (@recur $names (struct.get $Label $parent $l) (+ $i 1))))
                ))))
        )
        (else
          (if
            (= (call $node.kind $n) 0)
            (then
              (@match (call $number.i32 (call $node.value $n))
                (@case none () (nop))
                (@case some ($depth)
                  (@loop $depths
                    (bind $p (ref null $Label) $labels)
                    (bind $i i32 0)
                    (if
                      (ref.is_null $p)
                      (then (nop))
                      (else
                        (@let $l (ref.as_non_null $p)
                          (if
                            (= $i $depth)
                            (then (return (@tuple.new $i (struct.get $Label $type $l))))
                            (else
                              (@recur $depths (struct.get $Label $parent $l) (+ $i 1))))
                        ))))
                )))
            (else (nop))))
      )
      (call $bad $s $n 112)
      (@tuple.new -1 0)))

  (func $literal
    (param $c (ref $Context))
    (param $n (ref $node))
    (param $t i32)
    (@effect reads writes allocates)
    (@let $s (struct.get $Context $state $c)
      (if
        (!= (call $node.kind $n) 0)
        (then (call $bad $s $n 105))
        (else
          (if
            (= $t 127)
            (then
              (@match (call $number.i32 (call $node.value $n))
                (@case none () (call $bad $s $n 105))
                (@case some ($v) (call $instruction $c $n 65 (i64.extend_i32_s $v))))
            )
            (else
              (if
                (= $t 126)
                (then
                  (@match (call $number.i64 (call $node.value $n))
                    (@case none () (call $bad $s $n 105))
                    (@case some ($v) (call $instruction $c $n 66 $v))))
                (else (call $bad $s $n 116))))
          ))))
  )

  (func $block-type
    (param $s (ref $State))
    (param $n (ref $node))
    (result i32)
    (@effect reads writes allocates)
    (if
      (result i32)
      (= (call $len $n) 1)
      (then 64)
      (else
        (if
          (result i32)
          (= (call $len $n) 2)
          (then
            (@let $t (call $type $s (call $child $s $n 1))
              (block
                (result i32)
                (if (= $t 0) (then (call $bad $s $n 104)) (else (nop)))
                $t)))
          (else (block (result i32) (call $bad $s $n 104) 0))))
    ))
  (type $Control
    (struct (field $name (ref null $node)) (field $type i32) (field $at i32)))
  (func $control
    (param $s (ref $State))
    (param $n (ref $node))
    (result (ref $Control))
    (@effect reads writes allocates)
    (@let
      (($named (&& (> (call $len $n) 1) (call $name (call $child $s $n 1))))
       ($at (+ 1 $named))
       ($has-type
         (&& (< $at (call $len $n)) (call $head $s (call $child $s $n $at) "result"))))
      (struct.new $Control
        (if
          (result (ref null $node))
          $named
          (then (call $child $s $n 1))
          (else (ref.null $node)))
        (if
          (result i32)
          $has-type
          (then (call $block-type $s (call $child $s $n $at)))
          (else 64))
        (+ $at $has-type))))

  (func $hint
    (param $c (ref $Context))
    (param $n (ref $node))
    (param $env (ref null $Binding))
    (result i32)
    (@effect reads writes allocates)
    (@let $s (struct.get $Context $state $c)
      (block
        (result i32)
        (if
          (call $name $n)
          (then
            (@let ($i $t) (call $lookup $c $n $env 0)
              (return $t)))
          (else (nop)))
        (if
