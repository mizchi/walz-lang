(module
  (@use "walz:core" (type $result))
  (@export (func $result.map-err))
  ;; The callback runs once for err, and is never invoked for ok.
  (func $result.map-err
    (@type.params $T $E $U $F)
    (@where (shared $T $E $U) (nonunit $T $E $U)
      (callable $F (param $E) (result $U)))
    (param $value (@inst $result $T $E))
    (param $mapper (ref $F))
    (result (@inst $result $T $U))
    (@match $value
      (case ok ($payload) (@result.ok $payload))
      (case err ($error) (@result.err (@closure.call $F $mapper $error))))))
