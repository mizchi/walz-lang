(module
  (@use "walz:core" (type $string) (type $bytes) (type $list) (type $option)
    (func $bytes.equal) (func $dict.new) (func $dict.len) (func $dict.get) (func $dict.set)
    (func $list-builder.new) (func $list-builder.push) (func $list-builder.finish))
  (@use "./i32-column.walz" (type $i32-column) (type $i32-query-result) (func $i32-column.from-list)
    (func $i32-column.to-list) (func $i32-column.len) (func $i32-column.get)
    (func $i32-column.eq) (func $i32-column.count-eq) (func $i32-column.query-in-between))
  (@use "./bitmap.walz" (type $bitmap) (func $bitmap.empty) (func $bitmap.or))
  (@export (opaque $dictionary-column)
    (func $dictionary-column.from-list) (func $dictionary-column.from-codes)
    (func $dictionary-column.len) (func $dictionary-column.dictionary-len)
    (func $dictionary-column.dictionary) (func $dictionary-column.codes) (func $dictionary-column.code-column)
    (func $dictionary-column.get) (func $dictionary-column.decode) (func $dictionary-column.find-code)
    (func $dictionary-column.eq) (func $dictionary-column.in)
    (func $dictionary-column.count-eq) (func $dictionary-column.count-many)
    (func $dictionary-column.query-between))

  ;; Published state contains only immutable values. The hash index and list
  ;; builder exist during construction; neither is stored in the column.
  (type $dictionary-column
    (struct (field $dictionary $list<$string>) (field $codes (ref $i32-column))))
  (type $Codes (array (mut i32)))
  (type $Strings (array (mut $string)))

  (func $dictionary-column.from-list (param $values $list<$string>)
    (result (ref $dictionary-column)) (@effect reads writes allocates)
    (@let $n (@list.len $string $values)
      (block (result (ref $dictionary-column))
        (if (< $n 0) (then (unreachable)) (else (nop)))
        (@let (($index (call $dict.new<i32>)) ($keys (call $list-builder.new<$string>))
               ($codes (array.new $Codes 0 $n)))
          (block (result (ref $dictionary-column))
            (@for $encode (bind $i i32 0) (while (< $i $n)) (step (+ $i 1))
              (@let $value (@list.get $string $values $i)
                (@match (call $dict.get<i32> $index $value)
                  (@case some ($code) (array.set $Codes $codes $i $code))
                  (@case none ()
                    (@let $code (call $dict.len<i32> $index)
                      (block
                        (drop (call $dict.set<i32> $index $value $code))
                        (call $list-builder.push<$string> $keys $value)
                        (array.set $Codes $codes $i $code)))))))
            (struct.new $dictionary-column (call $list-builder.finish<$string> $keys)
              (call $i32-column.from-list (@list.from-array i32 $Codes $codes))))))))

  (func $validate-dictionary (param $keys $list<$string>) (@effect reads writes allocates)
    (block
      (if (< (@list.len $string $keys) 0) (then (unreachable)) (else (nop)))
      (@let $index (call $dict.new<i32>)
        (@for $unique (bind $i i32 0) (while (< $i (@list.len $string $keys))) (step (+ $i 1))
          (@match (call $dict.set<i32> $index (@list.get $string $keys $i) $i)
            (@case none () (nop)) (@case some ($previous) (unreachable)))))))
  (func $dictionary-column.from-codes (param $keys $list<$string>) (param $codes $list<i32>)
    (result (ref $dictionary-column)) (@effect reads writes allocates)
    (block (result (ref $dictionary-column))
      (call $validate-dictionary $keys)
      (@for $bounds (bind $i i32 0) (while (< $i (@list.len i32 $codes))) (step (+ $i 1))
        (if (i32.ge_u (@list.get i32 $codes $i) (@list.len $string $keys))
          (then (unreachable)) (else (nop))))
      (struct.new $dictionary-column $keys (call $i32-column.from-list $codes))))
  (func $dictionary-column.dictionary (param $column (ref $dictionary-column))
    (result $list<$string>) (@effect pure)
    (struct.get $dictionary-column $dictionary $column))
  (func $dictionary-column.code-column (param $column (ref $dictionary-column))
    (result (ref $i32-column)) (@effect pure)
    (struct.get $dictionary-column $codes $column))
  (func $dictionary-column.len (param $column (ref $dictionary-column)) (result i32) (@effect pure)
    (call $i32-column.len (call $dictionary-column.code-column $column)))
  (func $dictionary-column.dictionary-len (param $column (ref $dictionary-column)) (result i32) (@effect pure)
    (@list.len $string (call $dictionary-column.dictionary $column)))
  (func $dictionary-column.codes (param $column (ref $dictionary-column)) (result $list<i32>)
    (@effect reads writes allocates)
    (call $i32-column.to-list (call $dictionary-column.code-column $column)))
  (func $dictionary-column.get (param $column (ref $dictionary-column)) (param $i i32)
    (result $string) (@effect reads)
    (@list.get $string (call $dictionary-column.dictionary $column)
      (call $i32-column.get (call $dictionary-column.code-column $column) $i)))
  (func $dictionary-column.decode (param $column (ref $dictionary-column)) (result $list<$string>)
    (@effect reads writes allocates)
    (@let $n (call $dictionary-column.len $column)
      (if (result $list<$string>) (= $n 0) (then (@list.new $string))
        (else (@let $out (array.new $Strings (call $dictionary-column.get $column 0) $n)
          (block (result $list<$string>)
            (@for $copy (bind $i i32 1) (while (< $i $n)) (step (+ $i 1))
              (array.set $Strings $out $i (call $dictionary-column.get $column $i)))
            (@list.from-array $string $Strings $out)))))))

  ;; Codes are local to this dictionary. Byte equality is exact UTF-8 equality,
  ;; without Unicode normalization. The small immutable dictionary is scanned
  ;; once per query; row comparison then uses the packed SIMD code column.
  (func $dictionary-column.find-code (param $column (ref $dictionary-column)) (param $value $string)
    (result $option<i32>) (@effect pure)
    (@let $keys (call $dictionary-column.dictionary $column)
      (@loop $find (bind $i i32 0) (result $option<i32>)
        (if (result $option<i32>) (= $i (@list.len $string $keys)) (then (@option.none))
          (else (if (result $option<i32>)
            (call $bytes.equal (@string.bytes $value) (@string.bytes (@list.get $string $keys $i)))
            (then (@option.some $i)) (else (@recur $find (+ $i 1)))))))))
  (func $dictionary-column.eq (param $column (ref $dictionary-column)) (param $value $string)
    (result (ref $bitmap)) (@effect reads writes allocates)
    (@match (call $dictionary-column.find-code $column $value)
      (@case none () (call $bitmap.empty (call $dictionary-column.len $column)))
      (@case some ($code) (call $i32-column.eq (call $dictionary-column.code-column $column) $code))))
  (func $dictionary-column.count-eq (param $column (ref $dictionary-column)) (param $value $string)
    (result i32) (@effect reads)
    (@match (call $dictionary-column.find-code $column $value)
      (@case none () 0)
      (@case some ($code) (call $i32-column.count-eq (call $dictionary-column.code-column $column) $code))))
  (func $dictionary-column.in (param $column (ref $dictionary-column)) (param $values $list<$string>)
    (result (ref $bitmap)) (@effect reads writes allocates)
    (@loop $select (bind $i i32 0)
      (bind $selected (ref $bitmap) (call $bitmap.empty (call $dictionary-column.len $column)))
      (result (ref $bitmap))
      (if (result (ref $bitmap)) (= $i (@list.len $string $values)) (then $selected)
        (else (@match (call $dictionary-column.find-code $column (@list.get $string $values $i))
          (@case none () (@recur $select (+ $i 1) $selected))
          (@case some ($code) (@recur $select (+ $i 1)
            (call $bitmap.or $selected (call $i32-column.eq (call $dictionary-column.code-column $column) $code)))))))))
  (func $dictionary-column.count-many (param $column (ref $dictionary-column)) (param $values $list<$string>)
    (result $list<i32>) (@effect reads writes allocates)
    (@let (($n (@list.len $string $values)) ($out (array.new $Codes 0 $n)))
      (block (result $list<i32>)
        (@for $queries (bind $i i32 0) (while (< $i $n)) (step (+ $i 1))
          (array.set $Codes $out $i (call $dictionary-column.count-eq $column (@list.get $string $values $i))))
        (@list.from-array i32 $Codes $out))))
  (func $dictionary-column.query-between (param $column (ref $dictionary-column))
    (param $amounts (ref $i32-column)) (param $values $list<$string>) (param $lo i32) (param $hi i32)
    (result (ref $i32-query-result)) (@effect reads writes allocates)
    (@let $codes (call $list-builder.new<i32>)
      (block (result (ref $i32-query-result))
        (@for $resolve (bind $i i32 0) (while (< $i (@list.len $string $values))) (step (+ $i 1))
          (@match (call $dictionary-column.find-code $column (@list.get $string $values $i))
            (@case none () (nop))
            (@case some ($code) (call $list-builder.push<i32> $codes $code))))
        (call $i32-column.query-in-between (call $dictionary-column.code-column $column) $amounts
          (call $list-builder.finish<i32> $codes) $lo $hi))))
)
