(module
  (@use "walz:core" (type $list))
  (@use "./bitmap.walz" (type $bitmap) (func $bitmap.len) (func $bitmap.word)
    (func $bitmap.from-words))
  (@export (opaque $i32-column)
    (func $i32-column.from-list) (func $i32-column.to-list) (func $i32-column.len)
    (func $i32-column.get) (func $i32-column.sum) (func $i32-column.sum-where)
    (func $i32-column.eq) (func $i32-column.between)
    (func $i32-column.count-eq) (func $i32-column.count-between)
    (type $i32-query-result) (func $i32-column.query-in-between))
  (type $Blocks (array (mut v128)))
  (type $Words (array (mut i32)))
  (type $i32-column (struct (field $length i32) (field $blocks (ref $Blocks))))
  ;; A query result owns only immutable scalar values and its row-ID snapshot.
  (type $i32-query-result
    (struct (field $count i32) (field $sum i64) (field $indices $list<i32>)))
  (type $Rows (struct (field $length (mut i32)) (field $data (mut (ref $Words)))))

  (func $i32-column.len (param $xs (ref $i32-column)) (result i32) (@effect pure)
    (struct.get $i32-column $length $xs))
  (func $input (param $xs $list<i32>) (param $i i32) (result i32) (@effect pure)
    (if (result i32) (i32.lt_u $i (@list.len i32 $xs))
      (then (@list.get i32 $xs $i)) (else 0)))
  (func $i32-column.from-list (param $xs $list<i32>) (result (ref $i32-column))
    (@effect writes allocates)
    (@let $n (@list.len i32 $xs)
      (block (result (ref $i32-column))
        (if (< $n 0) (then (unreachable)) (else (nop)))
        (@let (($count (+ (i32.shr_u $n 2) (i32.ne (& $n 3) 0)))
               ($out (array.new $Blocks (v128.const i32x4 0 0 0 0) $count)))
          (block (result (ref $i32-column))
            (@for $pack (bind $i i32 0) (while (< $i $count)) (step (+ $i 1))
              (@let $at (i32.shl $i 2)
                (array.set $Blocks $out $i
                  (i32x4.replace_lane 3
                    (i32x4.replace_lane 2
                      (i32x4.replace_lane 1 (i32x4.splat (call $input $xs $at))
                        (call $input $xs (+ $at 1))) (call $input $xs (+ $at 2)))
                    (call $input $xs (+ $at 3))))))
            (struct.new $i32-column $n $out))))))
  (func $i32-column.get (param $xs (ref $i32-column)) (param $i i32) (result i32) (@effect reads)
    (block (result i32)
      (if (i32.ge_u $i (call $i32-column.len $xs)) (then (unreachable)) (else (nop)))
      (@let (($v (array.get $Blocks (struct.get $i32-column $blocks $xs) (i32.shr_u $i 2)))
             ($lane (& $i 3)))
        (if (result i32) (= $lane 0) (then (i32x4.extract_lane 0 $v))
          (else (if (result i32) (= $lane 1) (then (i32x4.extract_lane 1 $v))
            (else (if (result i32) (= $lane 2) (then (i32x4.extract_lane 2 $v))
              (else (i32x4.extract_lane 3 $v))))))))))
  (func $i32-column.to-list (param $xs (ref $i32-column)) (result $list<i32>)
    (@effect reads writes allocates)
    (@let (($n (call $i32-column.len $xs)) ($out (array.new $Words 0 $n)))
      (block (result $list<i32>)
        (@for $copy (bind $i i32 0) (while (< $i $n)) (step (+ $i 1))
          (array.set $Words $out $i (call $i32-column.get $xs $i)))
        (@list.from-array i32 $Words $out))))

  ;; Widen before addition. For any nonnegative i32 length the exact signed sum
  ;; fits in i64; neither lane nor horizontal reduction wraps an i32 subtotal.
  (func $wide-pair (param $v v128) (result v128) (@effect pure)
    (i64x2.add (i64x2.extend_low_i32x4_s $v) (i64x2.extend_high_i32x4_s $v)))
  (func $reduce (param $v v128) (result i64) (@effect pure)
    (+ (i64x2.extract_lane 0 $v) (i64x2.extract_lane 1 $v)))
  (func $i32-column.sum (param $column (ref $i32-column)) (result i64) (@effect reads)
    (@let $xs (struct.get $i32-column $blocks $column)
      (call $reduce
        (@loop $sum (bind $i i32 0) (bind $total v128 (v128.const i64x2 0 0)) (result v128)
          (if (result v128) (= $i (array.len $xs)) (then $total)
            (else (@recur $sum (+ $i 1)
              (i64x2.add $total (call $wide-pair (array.get $Blocks $xs $i))))))))))
  (func $i32-column.sum-where (param $column (ref $i32-column)) (param $selection (ref $bitmap))
    (result i64) (@effect reads)
    (block (result i64)
      (if (!= (call $i32-column.len $column) (call $bitmap.len $selection))
        (then (unreachable)) (else (nop)))
      (@let $xs (struct.get $i32-column $blocks $column)
        (call $reduce
          (@loop $sum (bind $i i32 0) (bind $total v128 (v128.const i64x2 0 0)) (result v128)
            (if (result v128) (= $i (array.len $xs)) (then $total)
              (else
                (@let (($bits (i32.shr_u (call $bitmap.word $selection (i32.shr_u $i 3))
                                (i32.shl (& $i 7) 2)))
                       ($mask (i32x4.ne
                         (v128.and (i32x4.splat $bits) (v128.const i32x4 1 2 4 8))
                         (v128.const i32x4 0 0 0 0))))
                  (@recur $sum (+ $i 1) (i64x2.add $total
                    (call $wide-pair (v128.and (array.get $Blocks $xs $i) $mask))))))))))))

  ;; One 32-bit output word describes eight vector comparisons (32 rows).
  ;; The bitmap constructor masks the final logical tail, including zero lanes.
  (func $eq-word (param $xs (ref $Blocks)) (param $word i32) (param $needle v128)
    (result i32) (@effect reads)
    (@loop $pack (bind $j i32 0) (bind $bits i32 0) (result i32)
      (@let $at (+ (i32.shl $word 3) $j)
        (if (result i32) (|| (= $j 8) (i32.ge_u $at (array.len $xs))) (then $bits)
          (else (@recur $pack (+ $j 1)
            (| $bits (i32.shl (i32x4.bitmask (i32x4.eq (array.get $Blocks $xs $at) $needle))
                       (i32.shl $j 2)))))))))
  (func $between-word (param $xs (ref $Blocks)) (param $word i32) (param $lo v128) (param $hi v128)
    (result i32) (@effect reads)
    (@loop $pack (bind $j i32 0) (bind $bits i32 0) (result i32)
      (@let $at (+ (i32.shl $word 3) $j)
        (if (result i32) (|| (= $j 8) (i32.ge_u $at (array.len $xs))) (then $bits)
          (else (@let $v (array.get $Blocks $xs $at)
            (@recur $pack (+ $j 1)
              (| $bits (i32.shl
                (i32x4.bitmask (v128.and (i32x4.ge_s $v $lo) (i32x4.lt_s $v $hi)))
                (i32.shl $j 2))))))))))
  (func $i32-column.eq (param $column (ref $i32-column)) (param $needle i32)
    (result (ref $bitmap)) (@effect reads writes allocates)
    (@let (($n (call $i32-column.len $column))
           ($words (+ (i32.shr_u $n 5) (i32.ne (& $n 31) 0)))
           ($out (array.new $Words 0 $words))
           ($xs (struct.get $i32-column $blocks $column)) ($value (i32x4.splat $needle)))
      (block (result (ref $bitmap))
        (@for $scan (bind $i i32 0) (while (< $i $words)) (step (+ $i 1))
          (array.set $Words $out $i (call $eq-word $xs $i $value)))
        (call $bitmap.from-words $n (@list.from-array i32 $Words $out)))))
  (func $i32-column.between (param $column (ref $i32-column)) (param $lower i32) (param $upper i32)
    (result (ref $bitmap)) (@effect reads writes allocates)
    (@let (($n (call $i32-column.len $column))
           ($words (+ (i32.shr_u $n 5) (i32.ne (& $n 31) 0)))
           ($out (array.new $Words 0 $words)) ($xs (struct.get $i32-column $blocks $column))
           ($lo (i32x4.splat $lower)) ($hi (i32x4.splat $upper)))
      (block (result (ref $bitmap))
        (@for $scan (bind $i i32 0) (while (< $i $words)) (step (+ $i 1))
          (array.set $Words $out $i (call $between-word $xs $i $lo $hi)))
        (call $bitmap.from-words $n (@list.from-array i32 $Words $out)))))

  ;; Fused count paths avoid allocating a selection bitmap for one aggregate.
  (func $tail (param $n i32) (result i32) (@effect pure)
    (@let $r (& $n 3)
      (if (result i32) (= $r 0) (then 15) (else (- (i32.shl (i32.const 1) $r) 1)))))
  (func $i32-column.count-eq (param $column (ref $i32-column)) (param $needle i32)
    (result i32) (@effect reads)
    (@let (($xs (struct.get $i32-column $blocks $column)) ($last (- (array.len $xs) 1))
           ($mask (call $tail (call $i32-column.len $column))) ($value (i32x4.splat $needle)))
      (@loop $count (bind $i i32 0) (bind $total i32 0) (result i32)
        (if (result i32) (= $i (array.len $xs)) (then $total)
          (else (@let $bits (i32x4.bitmask (i32x4.eq (array.get $Blocks $xs $i) $value))
            (@recur $count (+ $i 1) (+ $total (i32.popcnt
              (& $bits (if (result i32) (= $i $last) (then $mask) (else 15))))))))))))
  (func $i32-column.count-between (param $column (ref $i32-column)) (param $lower i32) (param $upper i32)
    (result i32) (@effect reads)
    (@let (($xs (struct.get $i32-column $blocks $column)) ($last (- (array.len $xs) 1))
           ($mask (call $tail (call $i32-column.len $column)))
           ($lo (i32x4.splat $lower)) ($hi (i32x4.splat $upper)))
      (@loop $count (bind $i i32 0) (bind $total i32 0) (result i32)
        (if (result i32) (= $i (array.len $xs)) (then $total)
          (else (@let $v (array.get $Blocks $xs $i)
            (@let $bits (i32x4.bitmask (v128.and (i32x4.ge_s $v $lo) (i32x4.lt_s $v $hi)))
              (@recur $count (+ $i 1) (+ $total (i32.popcnt
                (& $bits (if (result i32) (= $i $last) (then $mask) (else 15)))))))))))))
  ;; Grow only the selected row IDs, without one GC node per match or an
  ;; input-sized result allocation. The private buffer never escapes.
  (func $rows.push (param $rows (ref $Rows)) (param $row i32) (@effect reads writes allocates)
    (@let (($n (struct.get $Rows $length $rows)) ($data (struct.get $Rows $data $rows)))
      (block
        (if (= $n 2147483647) (then (unreachable)) (else (nop)))
        (if (= $n (array.len $data))
          (then (@let (($capacity (if (result i32) (= $n 0) (then 16)
                            (else (if (result i32) (> $n 1073741823) (then 2147483647) (else (* $n 2))))))
                         ($next (array.new $Words 0 $capacity)))
            (block
              (array.copy $Words $Words $next 0 $data 0 $n)
              (struct.set $Rows $data $rows $next))))
          (else (nop)))
        (array.set $Words (struct.get $Rows $data $rows) $n $row)
        (struct.set $Rows $length $rows (+ $n 1)))))
  (func $rows.finish (param $rows (ref $Rows)) (result $list<i32>) (@effect reads writes allocates)
    (@let (($n (struct.get $Rows $length $rows)) ($out (array.new $Words 0 $n)))
      (block (result $list<i32>)
        (array.copy $Words $Words $out 0 (struct.get $Rows $data $rows) 0 $n)
        (@list.from-array i32 $Words $out))))
  (func $in-mask (param $v v128) (param $needles $list<i32>) (result v128) (@effect pure)
    (@loop $keys (bind $q i32 0) (bind $mask v128 (v128.const i32x4 0 0 0 0)) (result v128)
      (if (result v128) (= $q (@list.len i32 $needles)) (then $mask)
        (else (@recur $keys (+ $q 1)
          (v128.or $mask (i32x4.eq $v (i32x4.splat (@list.get i32 $needles $q)))))))))

  ;; One forward scan of aligned columns. IN is a union, range comparison is
  ;; signed and half-open, and widening precedes every sum. Padding never emits
  ;; a row; its zero values also contribute zero to the widened vector sum.
  (func $i32-column.query-in-between (param $codes (ref $i32-column)) (param $amounts (ref $i32-column))
    (param $needles $list<i32>) (param $lower i32) (param $upper i32)
    (result (ref $i32-query-result)) (@effect reads writes allocates)
    (@let (($n (call $i32-column.len $codes)) ($k (@list.len i32 $needles)))
      (block (result (ref $i32-query-result))
        ;; Length mismatch traps even when the query would otherwise be empty.
        (if (!= $n (call $i32-column.len $amounts)) (then (unreachable)) (else (nop)))
        (if (result (ref $i32-query-result)) (|| (= $n 0) (|| (= $k 0) (>= $lower $upper)))
          (then (struct.new $i32-query-result 0 (i64.const 0) (@list.new i32)))
          (else
            (@let (($xs (struct.get $i32-column $blocks $codes))
                   ($ys (struct.get $i32-column $blocks $amounts))
                   ($first (i32x4.splat (@list.get i32 $needles 0)))
                   ($lo (i32x4.splat $lower)) ($hi (i32x4.splat $upper))
                   ($last (- (array.len $xs) 1)) ($tail (call $tail $n))
                   ($rows (struct.new $Rows 0 (array.new $Words 0 0))))
              (@loop $scan (bind $i i32 0) (bind $sum v128 (v128.const i64x2 0 0)) (result (ref $i32-query-result))
                (if (result (ref $i32-query-result)) (= $i (array.len $xs))
                  (then (struct.new $i32-query-result (struct.get $Rows $length $rows)
                    (call $reduce $sum) (call $rows.finish $rows)))
                  (else
                    (@let (($v (array.get $Blocks $xs $i))
                           ($keys (if (result v128) (= $k 1) (then (i32x4.eq $v $first))
                             (else (call $in-mask $v $needles)))))
                      (if (result (ref $i32-query-result)) (v128.any_true $keys)
                        (then
                          (@let (($value (array.get $Blocks $ys $i))
                                 ($selected (v128.and $keys
                                   (v128.and (i32x4.ge_s $value $lo) (i32x4.lt_s $value $hi))))
                                 ($bits (& (i32x4.bitmask $selected)
                                   (if (result i32) (= $i $last) (then $tail) (else 15)))))
                            (block (result (ref $i32-query-result))
                              (@loop $emit (bind $bits i32 $bits)
                                (if (= $bits 0) (then (nop))
                                  (else (block
                                    (call $rows.push $rows (+ (i32.shl $i 2) (i32.ctz $bits)))
                                    (@recur $emit (& $bits (- $bits 1)))))))
                              (@recur $scan (+ $i 1)
                                (i64x2.add $sum (call $wide-pair (v128.and $value $selected)))))))
                        (else (@recur $scan (+ $i 1) $sum)))))))))))))
)
