(module
  (@use "walz:core" (type $bytes) (type $option))
  (@export (func $number.i32) (func $number.i64))
  (func $digit
    (param $c i32)
    (result i32)
    (@effect pure)
    (if
      (result i32)
      (&& (>= $c 48) (<= $c 57))
      (then (- $c 48))
      (else
        (if
          (result i32)
          (&& (>= (| $c 32) 97) (<= (| $c 32) 102))
          (then (- (| $c 32) 87))
          (else -1))))
  )
  ;; Checked unsigned accumulation, then apply the spelling's sign.
  (func $parse
    (param $b $bytes)
    (param $positive i64)
    (param $negative-limit i64)
    (result $option<i64>)
    (@effect pure)
    (block
      (result $option<i64>)
      (if (= (@bytes.len $b) 0) (then (return (@option.none))) (else (nop)))
      (@let
        (($negative (= (@bytes.get $b 0) 45))
         ($sign (|| $negative (= (@bytes.get $b 0) 43)))
         ($hex
           (&&
             (< (+ $sign 1) (@bytes.len $b))
             (&& (= (@bytes.get $b $sign) 48) (= (@bytes.get $b (+ $sign 1)) 120))))
         ($start (+ $sign (* $hex 2)))
         ($base (if (result i64) $hex (then 16) (else 10)))
         ($limit (if (result i64) $negative (then $negative-limit) (else $positive))))
        (@loop $scan
          (bind $i i32 $start)
          (bind $value i64 0)
          (bind $previous i32 0)
          (result $option<i64>)
          (if
            (result $option<i64>)
            (= $i (@bytes.len $b))
            (then
              (if
                (result $option<i64>)
                $previous
                (then
                  (@option.some
                    (if (result i64) $negative (then (- 0 $value)) (else $value))))
                (else (@option.none))))
            (else
              (@let
                (($c (@bytes.get $b $i))
                 ($d (call $digit $c)))
                (if
                  (result $option<i64>)
                  (= $c 95)
                  (then
                    (if
                      (result $option<i64>)
                      (&& $previous (< (+ $i 1) (@bytes.len $b)))
                      (then (@recur $scan (+ $i 1) $value 0))
                      (else (@option.none))))
                  (else
                    (if
                      (result $option<i64>)
                      (||
                        (< $d 0)
                        (||
                          (i64.ge_u (i64.extend_i32_u $d) $base)
                          (i64.gt_u $value
                            (i64.div_u (- $limit (i64.extend_i32_u $d)) $base))))
                      (then (@option.none))
                      (else
                        (@recur $scan
                          (+ $i 1)
                          (+ (* $value $base) (i64.extend_i32_u $d))
                          1))))
                ))))
        ))))

  (func $number.i32
    (param $b $bytes)
    (result $option<i32>)
    (@effect pure)
    (@match (call $parse $b (i64.const 4294967295) (i64.const 2147483648))
      (@case none () (@option.none))
      (@case some ($n) (@option.some (i32.wrap_i64 $n))))
  )

  (func $number.i64
    (param $b $bytes)
    (result $option<i64>)
    (@effect pure)
    (call $parse $b (i64.const -1) (i64.const -9223372036854775808))))
