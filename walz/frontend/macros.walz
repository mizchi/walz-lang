(module
  (@use "walz:core"
    (type $bytes)
    (type $string)
    (type $list)
    (type $result)
    (type $list-builder)
    (func $list-builder.new)
    (func $list-builder.push)
    (func $list-builder.extend)
    (func $list-builder.finish))
  (@use "./tree.walz"
    (type $tree)
    (type $project-error)
    (func $tree.slice)
    (func $tree.at)
    (func $tree.len)
    (func $tree.is)
    (func $tree.head)
    (func $tree.atom)
    (func $tree.copy)
    (func $tree.form)
    (func $tree.eq)
    (func $tree.is-name)
    (func $work.snapshot)
    (func $t1)
    (func $t2)
    (func $t3)
    (func $t4))
  (@use "./macro-patterns.walz"
    (type $macro-variable)
    (type $macro-rule)
    (type $macro-match)
    (type $macro-capture)
    (func $macro.variable)
    (func $macro.capture)
    (func $macro.one)
    (func $macro.match))
  (@use "./macro-context.walz"
    (type $macro-context)
    (func $macro.error)
    (func $macro.fail)
    (func $macro.charge)
    (func $macro.fresh)
    (func $macro.global)
    (func $macro.called)
    (func $macro.rules))
  (@export (func $macro.expand))
  (type $Scope
    (struct
      (field $key (ref $tree))
      (field $source (ref $tree))
      (field $target (ref $tree))
      (field $kind i32)
      (field $parent (ref null $Scope))))
  (type $Walk
    (struct
      (field $context (ref $macro-context))
      (field $match (ref $macro-match))
      (field $introduced (ref $list-builder< (ref $Scope) >))
      (field $depth (mut i32))))
  (type $Carry
    (struct (field $env (mut (ref null $Scope))))
  )
  (func $fail
    (param $s (ref $Walk))
    (param $n (ref $tree))
    (param $code i32)
    (@effect reads writes allocates)
    (call $macro.fail (struct.get $Walk $context $s) $n $code))

  (func $substitute
    (param $s (ref $Walk))
    (param $n (ref $tree))
    (param $index i32)
    (result (ref $tree))
    (@effect reads writes allocates)
    (block
      (result (ref $tree))
      (call $macro.charge (struct.get $Walk $context $s) $n)
      (if
        (i32.eqz (ref.is_null (call $macro.error (struct.get $Walk $context $s))))
        (then (return $n))
        (else (nop)))
      (if
        (call $macro.variable $n)
        (then
          (@let $c (call $macro.capture (struct.get $Walk $match $s) $n)
            (block
              (if
                (ref.is_null $c)
                (then (block (call $fail $s $n 214) (return $n)))
                (else (nop)))
              (@let
                (($c (ref.as_non_null $c))
                 ($xs
                   (call $work.snapshot< (ref $tree) >
                     (struct.get $macro-capture $values $c)))
                 ($many
                   (struct.get $macro-variable $repeated
                     (struct.get $macro-capture $variable $c)))
                 ($at (if (result i32) $many (then $index) (else 0))))
                (if
                  (i32.ge_u $at (@list.len (ref $tree) $xs))
                  (then (block (call $fail $s $n 214) (return $n)))
                  (else
                    (return
                      (call $tree.copy $n 9
                        (struct.get $tree $value $n)
                        (@list.new (ref $tree) (@list.get (ref $tree) $xs $at))))
                  ))))
          ))
        (else (nop)))
      (if (!= (struct.get $tree $kind $n) 2) (then (return $n)) (else (nop)))
      (@let
        (($len (call $tree.len $n))
         ($rest (&& (> $len 0) (call $tree.is (call $tree.at $n (- $len 1)) "...")))
         ($fixed (- $len (* 2 $rest)))
         ($b (call $list-builder.new< (ref $tree) >)))
        (block
          (result (ref $tree))
          (if
            (&& $rest (|| (< $len 2) (>= $index 0)))
            (then (block (call $fail $s $n 214) (return $n)))
            (else (nop)))
          (@for $i
            (bind $i i32 0)
            (while (< $i $fixed))
            (step (+ $i 1))
            (block
              (if
                (call $tree.is (call $tree.at $n $i) "...")
                (then (call $fail $s (call $tree.at $n $i) 214))
                (else (nop)))
              (call $list-builder.push< (ref $tree) > $b
                (call $substitute $s (call $tree.at $n $i) $index))))
          (if $rest
            (then
              (@let $count (call $repeat-count $s (call $tree.at $n $fixed))
                (if
                  (< $count 0)
                  (then (call $fail $s (call $tree.at $n (- $len 1)) 214))
                  (else
                    (@for $i
                      (bind $i i32 0)
                      (while (< $i $count))
                      (step (+ $i 1))
                      (call $list-builder.push< (ref $tree) > $b
                        (call $substitute $s (call $tree.at $n $fixed) $i))))
                )))
            (else (nop)))
          (call $tree.copy $n 2
            (@bytes.new)
            (call $list-builder.finish< (ref $tree) > $b))))
    ))

  (func $repeat-count
    (param $s (ref $Walk))
    (param $n (ref $tree))
    (result i32)
    (@effect reads writes allocates)
    (block
      (result i32)
      (if
        (call $macro.variable $n)
        (then
          (@let $c (call $macro.capture (struct.get $Walk $match $s) $n)
            (if
              (&&
                (i32.eqz (ref.is_null $c))
                (struct.get $macro-variable $repeated
                  (struct.get $macro-capture $variable (ref.as_non_null $c))))
              (then
                (return
                  (@list.len
                    (ref $tree)
                    (call $work.snapshot< (ref $tree) >
                      (struct.get $macro-capture $values (ref.as_non_null $c))))
                ))
              (else (nop))))
        )
        (else (nop)))
      (@loop $scan
        (bind $i i32 0)
        (bind $count i32 -1)
        (result i32)
        (if
          (result i32)
          (= $i (call $tree.len $n))
          (then $count)
          (else
            (@let $next (call $repeat-count $s (call $tree.at $n $i))
              (if
                (result i32)
                (|| (= $next -2) (&& (>= $count 0) (&& (>= $next 0) (!= $count $next))))
                (then -2)
                (else
                  (@recur $scan
                    (+ $i 1)
                    (if (result i32) (>= $next 0) (then $next) (else $count))))
              ))))
      )))

  (func $binding-for
    (param $s (ref $Walk))
    (param $key (ref $tree))
    (param $body (ref $tree))
    (result i32)
    (@effect pure)
    (block
      (result i32)
      (@for-each $b
        (struct.get $macro-rule $bindings (struct.get $macro-match $rule (struct.get $Walk $match $s)))
        (if
          (&&
            (call $tree.eq (call $tree.at $b 1) $key)
            (call $tree.eq (call $tree.at $b 2) $body))
          (then (return 1))
          (else (nop))))
      0))

  (func $is-binder
    (param $s (ref $Walk))
    (param $key (ref $tree))
    (result i32)
    (@effect pure)
    (block
      (result i32)
      (@for-each $b
        (struct.get $macro-rule $bindings (struct.get $macro-match $rule (struct.get $Walk $match $s)))
        (if (call $tree.eq (call $tree.at $b 1) $key) (then (return 1)) (else (nop))))
      0))

  (func $new-binding
    (param $s (ref $Walk))
    (param $n (ref $tree))
    (param $env (ref null $Scope))
    (param $caller i32)
    (param $label i32)
    (result (ref $Scope))
    (@effect reads writes allocates)
    (@let
      (($hole (= (struct.get $tree $kind $n) 9))
       ($source (if (result (ref $tree)) $hole (then (call $tree.at $n 0)) (else $n)))
       ($key
         (if
           (result (ref $tree))
           $hole
           (then
             (call $tree.copy $n 0 (struct.get $tree $value $n) (@list.new (ref $tree))))
           (else $n)))
       ($new
         (struct.new $Scope
           $key
           $source
           (call $macro.fresh (struct.get $Walk $context $s) $source)
           (if (result i32) $label (then 2) (else $hole))
           $env)))
      (block
        (result (ref $Scope))
        (if
          (i32.eqz (call $tree.is-name $source))
          (then (call $fail $s $n 216))
          (else (nop)))
        (if
          (&& $hole (i32.eqz $caller))
          (then
            (block
              (if
                (|| $label (i32.eqz (call $is-binder $s $key)))
                (then (call $fail $s $n 216))
                (else (nop)))
              (@for-each $old
                (call $work.snapshot< (ref $Scope) > (struct.get $Walk $introduced $s))
                (if
                  (&&
                    (call $tree.eq $key (struct.get $Scope $key $old))
                    (call $tree.eq $source (struct.get $Scope $source $old)))
                  (then (call $fail $s $n 216))
                  (else (nop))))
              (call $list-builder.push< (ref $Scope) >
                (struct.get $Walk $introduced $s)
                $new)))
          (else (nop)))
        $new)))

  (func $lookup
    (param $n (ref $tree))
    (param $env (ref null $Scope))
    (param $caller i32)
    (param $label i32)
    (result (ref null $Scope))
    (@effect pure)
    (@loop $find
      (bind $p (ref null $Scope) $env)
      (result (ref null $Scope))
      (if
        (result (ref null $Scope))
        (ref.is_null $p)
        (then (ref.null $Scope))
        (else
          (@let $e (ref.as_non_null $p)
            (if
              (result (ref null $Scope))
              (&&
                (= (= (struct.get $Scope $kind $e) 2) $label)
                (call $tree.eq $n
                  (if
                    (result (ref $tree))
                    $caller
                    (then (struct.get $Scope $source $e))
                    (else (struct.get $Scope $key $e))))
              )
              (then $e)
              (else (@recur $find (struct.get $Scope $parent $e))))
          ))))
  )

  (func $select
    (param $s (ref $Walk))
    (param $body (ref $tree))
    (param $env (ref null $Scope))
    (result (ref null $Scope))
    (@effect allocates)
    (if
      (result (ref null $Scope))
      (ref.is_null $env)
      (then (ref.null $Scope))
      (else
        (@let
          (($e (ref.as_non_null $env))
           ($rest (call $select $s $body (struct.get $Scope $parent $e))))
          (if
            (result (ref null $Scope))
            (&&
              (= (struct.get $Scope $kind $e) 1)
              (call $binding-for $s (struct.get $Scope $key $e) $body))
            (then
              (struct.new $Scope
                (struct.get $Scope $source $e)
                (struct.get $Scope $source $e)
                (struct.get $Scope $target $e)
                0
                $rest))
            (else $rest))))
    ))

  (func $hole
    (param $s (ref $Walk))
    (param $n (ref $tree))
    (param $env (ref null $Scope))
    (param $mode i32)
    (result (ref $tree))
    (@effect reads writes allocates)
    (@let
      (($key
         (call $tree.copy $n 0 (struct.get $tree $value $n) (@list.new (ref $tree))))
       ($m (struct.get $Walk $match $s))
       ($c (ref.as_non_null (call $macro.capture $m $key)))
       ($v (struct.get $macro-capture $variable $c)))
      (block
        (result (ref $tree))
        (if
          (= (struct.get $macro-variable $category $v) 0)
          (then
            (block
              (@for-each $b
                (struct.get $macro-rule $bindings (struct.get $macro-match $rule $m))
                (if
                  (call $tree.eq (call $tree.at $b 2) $key)
                  (then
                    (@let
                      (($ids
                         (ref.as_non_null (call $macro.capture $m (call $tree.at $b 1))))
                      )
                      (@for-each $id
                        (call $work.snapshot< (ref $tree) > (struct.get $macro-capture $values $ids))
                        (if
                          (ref.is_null
                            (call $lookup $id (call $select $s $key $env) 1 0))
                          (then (call $fail $s $n 216))
                          (else (nop))))
                    ))
                  (else (nop))))
              (return
                (call $walk $s (call $tree.at $n 0) (call $select $s $key $env) $mode 1))))
          (else (nop)))
        (if
          (= (struct.get $macro-variable $category $v) 1)
          (then
            (@let
              (($scope (call $hole-scope $key (call $tree.at $n 0) $env)))
              (if
                (i32.eqz (ref.is_null $scope))
                (then (return (struct.get $Scope $target (ref.as_non_null $scope))))
                (else (nop))))
          )
          (else (nop)))
        (call $tree.at $n 0))))

  (func $let
    (param $s (ref $Walk))
    (param $n (ref $tree))
    (param $env (ref null $Scope))
    (param $caller i32)
    (result (ref $tree))
    (@effect reads writes allocates)
    (@let
      (($many (= (struct.get $tree $kind (call $tree.at $n 1)) 2))
       ($carry (struct.new $Carry $env))
       ($out (call $list-builder.new< (ref $tree) >))
       ($bindings
         (if
           (result $list< (ref $tree) >)
           $many
           (then (struct.get $tree $items (call $tree.at $n 1)))
           (else
             (@list.new
               (ref $tree)
               (call $tree.copy $n 2 (@bytes.new) (call $tree.slice $n 1))))
         )))
      (block
        (result (ref $tree))
        (@for-each $binding $bindings
          (@let
            (($binding $binding)
             ($typed
               (if
                 (result i32)
                 $many
                 (then (= (call $tree.len $binding) 3))
                 (else (= (call $tree.len $n) 5))))
             ($name (call $tree.at $binding 0))
             ($bound
               (call $new-binding $s $name (struct.get $Carry $env $carry) $caller 0))
             ($items (call $list-builder.new< (ref $tree) >)))
            (block
              (if
                (i32.eqz $many)
                (then
                  (if
                    (|| (< (call $tree.len $n) 4) (> (call $tree.len $n) 5))
                    (then (call $fail $s $n 214))
                    (else (nop))))
                (else (nop)))
              (if $many
                (then
                  (if
                    (|| (< (call $tree.len $binding) 2) (> (call $tree.len $binding) 3))
                    (then (call $fail $s $binding 214))
                    (else (nop))))
                (else (nop)))
              (call $list-builder.push< (ref $tree) > $items
                (struct.get $Scope $target $bound))
              (if $typed
                (then
                  (call $list-builder.push< (ref $tree) > $items
                    (call $walk $s
                      (call $tree.at $binding 1)
                      (struct.get $Carry $env $carry)
                      1
                      $caller)))
                (else (nop)))
              (call $list-builder.push< (ref $tree) > $items
                (call $walk $s
                  (call $tree.at $binding (+ 1 $typed))
                  (struct.get $Carry $env $carry)
                  0
                  $caller))
              (call $list-builder.push< (ref $tree) > $out
                (call $tree.copy $binding 2
                  (@bytes.new)
                  (call $list-builder.finish< (ref $tree) > $items)))
              (struct.set $Carry $env $carry $bound))))
        (@let
          (($body
             (call $walk $s
               (call $tree.at $n (- (call $tree.len $n) 1))
               (struct.get $Carry $env $carry)
               0
               $caller))
           ($items (call $list-builder.finish< (ref $tree) > $out)))
          (if
            (result (ref $tree))
            (= (@list.len (ref $tree) $items) 0)
            (then $body)
            (else
              (call $tree.form $n "@let"
                (@list.new
                  (ref $tree)
                  (call $tree.copy (call $tree.at $n 1) 2 (@bytes.new) $items)
                  $body))))
        ))))

  (func $loop
    (param $s (ref $Walk))
    (param $n (ref $tree))
    (param $env (ref null $Scope))
    (param $caller i32)
    (result (ref $tree))
    (@effect reads writes allocates)
    (@let
      (($carry (struct.new $Carry $env))
       ($b (call $list-builder.new< (ref $tree) >)))
      (block
        (result (ref $tree))
        (call $list-builder.push< (ref $tree) > $b (call $tree.at $n 0))
        (if
          (call $tree.is-name (call $tree.at $n 1))
          (then
            (@let
              (($label
                 (call $new-binding $s
                   (call $tree.at $n 1)
                   (struct.get $Carry $env $carry)
                   $caller
                   1)))
              (block
                (call $list-builder.push< (ref $tree) > $b
                  (struct.get $Scope $target $label))
                (struct.set $Carry $env $carry $label))))
          (else (call $list-builder.push< (ref $tree) > $b (call $tree.at $n 1))))
        (@for $i
          (bind $i i32 2)
          (while (< $i (call $tree.len $n)))
          (step (+ $i 1))
          (@let
            (($part (call $tree.at $n $i)))
            (if
              (call $tree.head $part "bind")
              (then
                (@let
                  (($bound
                     (call $new-binding $s
                       (call $tree.at $part 1)
                       (struct.get $Carry $env $carry)
                       $caller
                       0)))
                  (block
                    (call $list-builder.push< (ref $tree) > $b
                      (call $t3 $part "bind"
                        (struct.get $Scope $target $bound)
                        (call $walk $s (call $tree.at $part 2) $env 1 $caller)
                        (call $walk $s (call $tree.at $part 3) $env 0 $caller)))
                    (struct.set $Carry $env $carry $bound))))
              (else
                (call $list-builder.push< (ref $tree) > $b
                  (call $walk $s $part (struct.get $Carry $env $carry) 0 $caller))))
          ))
        (call $tree.copy $n 2
          (@bytes.new)
          (call $list-builder.finish< (ref $tree) > $b))))
  )

  (func $pattern
    (param $s (ref $Walk))
    (param $n (ref $tree))
    (param $carry (ref $Carry))
    (param $caller i32)
    (result (ref $tree))
    (@effect reads writes allocates)
    (@let
      (($xs
         (if
           (result $list< (ref $tree) >)
           (= (struct.get $tree $kind $n) 2)
           (then (struct.get $tree $items $n))
           (else (@list.new (ref $tree) $n))))
       ($b (call $list-builder.new< (ref $tree) >)))
      (block
        (result (ref $tree))
        (@for-each $id $xs
          (@let
            (($new (call $new-binding $s $id (struct.get $Carry $env $carry) $caller 0)))
            (block
              (struct.set $Carry $env $carry $new)
              (call $list-builder.push< (ref $tree) > $b
                (struct.get $Scope $target $new))))
        )
        (@let
          (($xs (call $list-builder.finish< (ref $tree) > $b)))
          (if
            (result (ref $tree))
            (= (struct.get $tree $kind $n) 2)
            (then (call $tree.copy $n 2 (@bytes.new) $xs))
            (else (@list.get (ref $tree) $xs 0))))
      )))

  (func $role
    (param $n (ref $tree))
    (param $i i32)
    (result i32)
    (@effect reads writes allocates)
    (block
      (result i32)
      (if
        (||
          (||
            (|| (call $tree.head $n "type") (call $tree.head $n "ref"))
            (||
              (call $tree.head $n "mut")
              (|| (call $tree.head $n "result") (call $tree.head $n "@inst"))))
          (||
            (&&
              (= $i 1)
              (||
                (||
                  (||
                    (||
                      (call $tree.head $n "struct.new")
                      (||
                        (call $tree.head $n "struct.new_default")
                        (call $tree.head $n "struct.get")))
                    (||
                      (call $tree.head $n "struct.get_s")
                      (||
                        (call $tree.head $n "struct.get_u")
                        (call $tree.head $n "struct.set"))))
                  (||
                    (||
                      (call $tree.head $n "array.new")
                      (||
                        (call $tree.head $n "array.new_default")
                        (call $tree.head $n "array.new_fixed")))
                    (||
                      (call $tree.head $n "array.get")
                      (||
                        (call $tree.head $n "array.get_s")
                        (call $tree.head $n "array.get_u"))))
                )
                (||
                  (||
                    (||
                      (call $tree.head $n "array.set")
                      (||
                        (call $tree.head $n "array.fill")
                        (call $tree.head $n "array.copy")))
                    (||
                      (call $tree.head $n "ref.null")
                      (||
                        (call $tree.head $n "ref.cast")
                        (call $tree.head $n "ref.test"))))
                  (||
                    (||
                      (call $tree.head $n "@list.new")
                      (||
                        (call $tree.head $n "@list.len")
                        (call $tree.head $n "@list.get")))
                    (||
                      (call $tree.head $n "@list.from-array")
                      (||
                        (call $tree.head $n "@bytes.from-array")
                        (call $tree.head $n "@bytes.copy-to-array"))))
                )))
            (&&
              (= $i 2)
              (||
                (call $tree.head $n "array.copy")
                (call $tree.head $n "@list.from-array"))))
        )
        (then (return 1))
        (else (nop)))
      (if (&& (= $i 1) (call $tree.head $n "call")) (then (return 3)) (else (nop)))
      (if
        (&&
          (= $i 1)
          (||
            (call $tree.head $n "br")
            (|| (call $tree.head $n "br_if") (call $tree.head $n "@recur"))))
        (then (return 4))
        (else (nop)))
      (if
        (&&
          (= $i 2)
          (||
            (|| (call $tree.head $n "struct.get") (call $tree.head $n "struct.get_s"))
            (|| (call $tree.head $n "struct.get_u") (call $tree.head $n "struct.set"))))
        (then (return 1))
        (else (nop)))
      0))

  (func $walk-body
    (param $s (ref $Walk))
    (param $n (ref $tree))
    (param $env (ref null $Scope))
    (param $mode i32)
    (param $caller i32)
    (result (ref $tree))
    (@effect reads writes allocates)
    (block
      (result (ref $tree))
      (if
        (= (struct.get $tree $kind $n) 10)
        (then (return (call $tree.at $n 0)))
        (else (nop)))
      (if
        (i32.eqz (ref.is_null (call $macro.error (struct.get $Walk $context $s))))
        (then (return $n))
        (else (nop)))
      (if
        (= (struct.get $tree $kind $n) 9)
        (then (return (call $hole $s $n $env $mode)))
        (else (nop)))
      (if
        (!= (struct.get $tree $kind $n) 2)
        (then
          (block
            (if
              (&& (call $tree.is-name $n) (|| (= $mode 0) (= $mode 4)))
              (then
                (@let
                  (($found (call $lookup $n $env $caller (= $mode 4))))
                  (block
                    (if
                      (i32.eqz (ref.is_null $found))
                      (then
                        (return (struct.get $Scope $target (ref.as_non_null $found))))
                      (else (nop)))
                    (if (i32.eqz $caller) (then (call $fail $s $n 215)) (else (nop))))
                ))
              (else (nop)))
            (if
              (&& (i32.eqz $caller) (= $mode 3))
