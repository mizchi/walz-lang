(module
  (@use "walz:core" (type $list) (type $result))
  (@use "./tree.walz"
    (type $source-file)
    (type $project-error)
    (type $tree)
    (type $rendered)
    (func $tree.render-profile))
  (@use "./modules.walz" (func $modules.link))
  (@use "./generics.walz" (func $generics.run-profile))
  (@use "./lower.walz" (func $lower.run))
  (@use "./syntax.walz"
    (func $syntax-tree.build)
    (func $syntax-tree.syntax)
    (func $syntax-tree.locate))
  (@use "../checker/checker.walz"
    (type $module-ir)
    (func $checker.check)
    (func $module-ir.functions))
  (@use "../checker/ir.walz" (type $function-ir))
  (@use "./profile.walz"
    (type $profile-state)
    (type $profile-stats)
    (func $profile.new)
    (func $profile.snapshot)
    (func $profile.limit)
    (func $profile.phase))
  (@export
    (func $frontend.project)
    (func $frontend.expand)
    (func $frontend.profile-project)
    (type $profile-report))
  (type $profile-report
    (struct
      (field $result $result<i32, (ref $project-error)>)
      (field $stats (ref $profile-stats))))
  (@abi.type $profile-report (record "result" "stats"))
  (func $frontend.expand
    (param $files $list<(ref $source-file)>)
    (result $result<(ref $rendered), (ref $project-error)>)
    (@effect reads writes allocates)
    (@match (call $lower-project $files (ref.null $profile-state))
      (@case err ($e) (@result.err $e))
      (@case ok ($tree) (call $tree.render-profile $tree (ref.null $profile-state))))
  )

  (func $lower-project
    (param $files $list<(ref $source-file)>)
    (param $profile (ref null $profile-state))
    (result $result<(ref $tree), (ref $project-error)>)
    (@effect reads writes allocates)
    (block
      (result $result<(ref $tree), (ref $project-error)>)
      (call $profile.phase $profile 1)
      (@match (call $modules.link $files)
        (@case err ($e) (@result.err $e))
        (@case ok ($linked)
          (block
            (result $result<(ref $tree), (ref $project-error)>)
            (call $profile.phase $profile 2)
            (@match (call $generics.run-profile $linked $profile)
              (@case err ($e) (@result.err $e))
              (@case ok ($expanded)
                (block
                  (result $result<(ref $tree), (ref $project-error)>)
                  (call $profile.phase $profile 4)
                  (@match (call $lower.run $expanded)
                    (@case err ($e)
                      (block
                        (result $result<(ref $tree), (ref $project-error)>)
                        (if
                          (= (struct.get $project-error $code $e) 150)
                          (then (call $profile.limit $profile 3))
                          (else (nop)))
                        (@result.err $e)))
                    (@case ok ($tree) (@result.ok $tree))))
              ))))
      )))

  (func $frontend.project
    (param $files $list<(ref $source-file)>)
    (result $result<(ref $module-ir), (ref $project-error)>)
    (@effect reads writes allocates)
    (call $project $files (ref.null $profile-state)))

  (func $project
    (param $files $list<(ref $source-file)>)
    (param $profile (ref null $profile-state))
    (result $result<(ref $module-ir), (ref $project-error)>)
    (@effect reads writes allocates)
    (@match (call $lower-project $files $profile)
      (@case err ($e) (@result.err $e))
      (@case ok ($tree)
        (block
          (result $result<(ref $module-ir), (ref $project-error)>)
          (call $profile.phase $profile 5)
          (@match (call $syntax-tree.build $tree $profile)
            (@case err ($e) (@result.err $e))
            (@case ok ($mapped)
              (block
                (result $result<(ref $module-ir), (ref $project-error)>)
                (call $profile.phase $profile 6)
                (@match (call $checker.check (call $syntax-tree.syntax $mapped))
                  (@case err ($e) (@result.err (call $syntax-tree.locate $mapped $e)))
                  (@case ok ($checked)
                    (block
                      (result $result<(ref $module-ir), (ref $project-error)>)
                      (call $profile.phase $profile 7)
                      (@result.ok $checked))))
              ))))
      )))

  (func $frontend.profile-project
    (param $files $list<(ref $source-file)>)
    (result (ref $profile-report))
    (@effect reads writes allocates)
    (@let
      (($profile (call $profile.new))
       ($result
         (type $result<i32, (ref $project-error)>)
         (@match (call $project $files $profile)
           (@case err ($e) (@result.err $e))
           (@case ok ($checked)
             (@result.ok
               (@list.len (ref $function-ir) (call $module-ir.functions $checked))))
         )))
      (struct.new $profile-report $result (call $profile.snapshot $profile))))
)
