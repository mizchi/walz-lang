(module
  (@use "walz:core" (type $list) (type $result))
  (@use "./tree.walz"
    (type $source-file)
    (type $project-error)
    (type $rendered)
    (func $tree.render)
    (func $tree.locate))
  (@use "./modules.walz" (func $modules.link))
  (@use "./generics.walz" (func $generics.run))
  (@use "./lower.walz" (func $lower.run))
  (@use "../parser/parser.walz" (func $parser.parse))
  (@use "../checker/checker.walz" (type $module-ir) (func $checker.check))
  (@export (func $frontend.project) (func $frontend.expand))
  (func $frontend.expand
    (param $files $list<(ref $source-file)>)
    (result $result<(ref $rendered), (ref $project-error)>)
    (@effect reads writes allocates)
    (@match (call $modules.link $files)
      (@case err ($e) (@result.err $e))
      (@case ok ($linked)
        (@match (call $generics.run $linked)
          (@case err ($e) (@result.err $e))
          (@case ok ($expanded)
            (@match (call $lower.run $expanded)
              (@case err ($e) (@result.err $e))
              (@case ok ($tree) (call $tree.render $tree))))
        ))))

  (func $frontend.project
    (param $files $list<(ref $source-file)>)
    (result $result<(ref $module-ir), (ref $project-error)>)
    (@effect reads writes allocates)
    (@match (call $frontend.expand $files)
      (@case err ($e) (@result.err $e))
      (@case ok ($rendered)
        (@match (call $parser.parse (struct.get $rendered $bytes $rendered))
          (@case err ($e) (@result.err (call $tree.locate $rendered $e)))
          (@case ok ($syntax)
            (@match (call $checker.check $syntax)
              (@case err ($e) (@result.err (call $tree.locate $rendered $e)))
              (@case ok ($checked) (@result.ok $checked))))
        ))))
)
