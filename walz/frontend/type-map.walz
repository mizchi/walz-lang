(module
  (@use "./tree.walz" (type $tree) (func $tree.len) (func $tree.at) (func $tree.eq))
  (@export
    (opaque $type-map)
    (func $type-map.new)
    (func $type-map.find)
    (func $type-map.insert))
  (type $Keys (array (mut (ref null $tree))))
  (type $Ints (array (mut i32)))
  (type $type-map (struct (field $keys (ref $Keys)) (field $values (ref $Ints))))
  ;; Structural keys deliberately exclude origin ranges. Declaration names and
  ;; explicit-rec keys include their normalized nominal/source identities.
  (func $same
    (param $a (ref $tree))
    (param $b (ref $tree))
    (result i32)
    (@effect reads writes allocates)
    (block
      (result i32)
      (if (ref.eq $a $b) (then (return 1)) (else (nop)))
      (if
        (||
          (||
            (!= (struct.get $tree $kind $a) (struct.get $tree $kind $b))
            (i32.eqz (call $tree.eq $a $b)))
          (!= (call $tree.len $a) (call $tree.len $b)))
        (then
          (if
            (&&
              (&&
                (|| (= (struct.get $tree $kind $a) 2) (= (struct.get $tree $kind $a) 8))
                (|| (= (struct.get $tree $kind $b) 2) (= (struct.get $tree $kind $b) 8)))
              (&& (call $tree.eq $a $b) (= (call $tree.len $a) (call $tree.len $b))))
            (then (nop))
            (else (return 0))))
        (else (nop)))
      (@for $i
        (bind $i i32 0)
        (while (< $i (call $tree.len $a)))
        (step (+ $i 1))
        (if
          (i32.eqz (call $same (call $tree.at $a $i) (call $tree.at $b $i)))
          (then (return 0))
          (else (nop))))
      1))

  (func $hash
    (param $n (ref $tree))
    (result i32)
    (@effect reads writes allocates)
    (@let
      (($bytes (struct.get $tree $value $n))
       ($base
         (if
           (result i32)
           (= (struct.get $tree $kind $n) 8)
           (then 2)
           (else (struct.get $tree $kind $n))))
       ($value
         (@loop $bytes
           (bind $i i32 0)
           (bind $hash i32 (+ 2166136261 $base))
           (result i32)
           (if
             (result i32)
             (< $i (@bytes.len $bytes))
             (then
               (@recur $bytes (+ $i 1) (* (^ $hash (@bytes.get $bytes $i)) 16777619)))
             (else $hash))))
      )
      (@loop $children
        (bind $i i32 0)
        (bind $hash i32 $value)
        (result i32)
        (if
          (result i32)
          (< $i (call $tree.len $n))
          (then
            (@recur $children
              (+ $i 1)
              (* (^ $hash (call $hash (call $tree.at $n $i))) 16777619)))
          (else $hash))))
  )

  (func $type-map.new
    (param $entries i32)
    (result (ref $type-map))
    (@effect allocates)
    (@let $size
      (@loop $size (bind $size i32 2) (result i32) (if (result i32) (<= $size (* $entries 2)) (then (@recur $size (* $size 2))) (else $size)))
      (struct.new $type-map
        (array.new $Keys (ref.null $tree) $size)
        (array.new $Ints -1 $size))))

  (func $type-map.find
    (param $m (ref $type-map))
    (param $key (ref $tree))
    (result i32)
    (@effect reads writes allocates)
    (@let
      (($keys (struct.get $type-map $keys $m))
       ($mask (- (array.len $keys) 1)))
      (@loop $probe
        (bind $i i32 (& (call $hash $key) $mask))
        (bind $steps i32 0)
        (result i32)
        (if
          (result i32)
          (= $steps (array.len $keys))
          (then -1)
          (else
            (@let $found (array.get $Keys $keys $i)
              (if
                (result i32)
                (ref.is_null $found)
                (then -1)
                (else
                  (if
                    (result i32)
                    (call $same $key (ref.as_non_null $found))
                    (then (array.get $Ints (struct.get $type-map $values $m) $i))
                    (else (@recur $probe (& (+ $i 1) $mask) (+ $steps 1))))
                ))))
        ))))

  (func $type-map.insert
    (param $m (ref $type-map))
    (param $key (ref $tree))
    (param $value i32)
    (result i32)
    (@effect reads writes allocates)
    (@let
      (($keys (struct.get $type-map $keys $m))
       ($mask (- (array.len $keys) 1)))
      (@loop $probe
        (bind $i i32 (& (call $hash $key) $mask))
        (bind $steps i32 0)
        (result i32)
        (if
          (result i32)
          (= $steps (array.len $keys))
          (then 0)
          (else
            (@let $found (array.get $Keys $keys $i)
              (if
                (result i32)
                (ref.is_null $found)
                (then
                  (block
                    (result i32)
                    (array.set $Keys $keys $i $key)
                    (array.set $Ints (struct.get $type-map $values $m) $i $value)
                    1))
                (else
                  (if
                    (result i32)
                    (call $same $key (ref.as_non_null $found))
                    (then 0)
                    (else (@recur $probe (& (+ $i 1) $mask) (+ $steps 1))))
                ))))
        ))))
)
