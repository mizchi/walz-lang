(module
  (@use "walz:core"
    (type $list)
    (type $result)
    (type $list-builder)
    (func $list-builder.new)
    (func $list-builder.push)
    (func $list-builder.finish))
  (@use "./tree.walz"
    (type $tree)
    (type $project-error)
    (func $tree.at)
    (func $tree.len)
    (func $tree.head)
    (func $tree.is)
    (func $tree.copy)
    (func $tree.form)
    (func $tree.error))
  (@use "../parser/number.walz" (func $number.i32))
  (@use "./graph.walz"
    (type $graph)
    (type $components)
    (func $graph.new)
    (func $graph.add)
    (func $graph.scc)
    (func $components.count)
    (func $components.get))
  (@use "./type-map.walz"
    (type $type-map)
    (func $type-map.new)
    (func $type-map.find)
    (func $type-map.insert))
  (@use "./limits.walz" (func $limits.types) (func $limits.edges))
  (@use "./profile.walz" (type $profile-state) (func $profile.limit))
  (@export (func $type-order.run) (func $type-order.run-profile))
  (type $Ints (array (mut i32)))
  (type $Order
    (struct
      (field $types $list<(ref $tree)>)
      (field $graph (ref $graph))
      (field $names (ref $type-map))
      (field $groups (ref $type-map))
      (field $owner (ref $Ints))
      (field $tail (ref $Ints))
      (field $rank (ref $Ints))
      (field $parent (ref $Ints))
      (field $done (ref $Ints))
      (field $scratch (ref $Ints))
      (field $out (ref $list-builder<(ref $tree)>))
      (field $profile (ref null $profile-state))
      (field $error (mut (ref null $project-error))))
  )
  (func $item
    (param $s (ref $Order))
    (param $i i32)
    (result (ref $tree))
    (@effect reads)
    (@list.get (ref $tree) (struct.get $Order $types $s) $i))

  (func $fail
    (param $s (ref $Order))
    (param $n (ref $tree))
    (param $code i32)
    (@effect reads writes allocates)
    (if
      (ref.is_null (struct.get $Order $error $s))
      (then (struct.set $Order $error $s (call $tree.error $n $code)))
      (else (nop))))

  (func $clean
    (param $n (ref $tree))
    (result (ref $tree))
    (@effect reads writes allocates)
    (@let $out (call $list-builder.new<(ref $tree)>)
      (block
        (result (ref $tree))
        (@for-each $child (struct.get $tree $items $n)
          (if
            (!= (struct.get $tree $kind $child) 7)
            (then (call $list-builder.push<(ref $tree)> $out $child))
            (else (nop))))
        (call $tree.copy $n 2
          (@bytes.new)
          (call $list-builder.finish<(ref $tree)> $out))))
  )

  (func $edge
    (param $s (ref $Order))
    (param $from i32)
    (param $to i32)
    (@effect reads writes allocates)
    (if
      (i32.eqz (call $graph.add (struct.get $Order $graph $s) $from $to))
      (then
        (block
          (call $profile.limit (struct.get $Order $profile $s) 6)
          (call $fail $s (call $item $s $from) 150)))
      (else (nop))))

  (func $reference
    (param $s (ref $Order))
    (param $from i32)
    (param $name (ref $tree))
    (result i32)
    (@effect reads writes allocates)
    (@let $to (call $type-map.find (struct.get $Order $names $s) $name)
      (block
        (result i32)
        (if (>= $to 0) (then (call $edge $s $from $to)) (else (nop)))
        $to)))
  ;; Only semantic type references form edges. Field binders, annotation values
  ;; and the declaration's own name are not dependencies.
  (func $walk
    (param $s (ref $Order))
    (param $from i32)
    (param $n (ref $tree))
    (param $depth i32)
    (@effect reads writes allocates)
    (block
      (if
        (i32.eqz (ref.is_null (struct.get $Order $error $s)))
        (then (return))
        (else (nop)))
      (if
        (>= $depth 128)
        (then
          (block
            (call $profile.limit (struct.get $Order $profile $s) 3)
            (call $fail $s $n 150)
            (return)))
        (else (nop)))
      (if (= (struct.get $tree $kind $n) 7) (then (return)) (else (nop)))
      (if
        (call $tree.head $n "ref")
        (then
          (drop (call $reference $s $from (call $tree.at $n (- (call $tree.len $n) 1))))
        )
        (else (nop)))
      (if
        (call $tree.head $n "sub")
        (then
          (@let $at
            (if (result i32) (call $tree.is (call $tree.at $n 1) "final") (then 2) (else 1))
            (block
              (@for $i
                (bind $i i32 $at)
                (while (< $i (- (call $tree.len $n) 1)))
                (step (+ $i 1))
                (@let $parent (call $reference $s $from (call $tree.at $n $i))
                  (if
                    (= $i $at)
                    (then
                      (array.set $Ints (struct.get $Order $parent $s) $from $parent))
                    (else (nop))))
              ))))
        (else (nop)))
      (@for-each $child (struct.get $tree $items $n)
        (call $walk $s $from $child (+ $depth 1))))
  )

  (func $register
    (param $s (ref $Order))
    (param $i i32)
    (@effect reads writes allocates)
    (@let
      (($n (call $item $s $i))
       ($mark (call $tree.at $n 2)))
      (block
        (if
          (i32.eqz
            (call $type-map.insert
              (struct.get $Order $names $s)
              (call $tree.at $n 1)
              $i))
          (then (call $fail $s $n 118))
          (else (nop)))
        (array.set $Ints (struct.get $Order $rank $s) $i $i)
        (if
          (= (struct.get $tree $kind $mark) 7)
          (then
            (block
              (@match
                (call $number.i32 (struct.get $tree $value (call $tree.at $mark 1)))
                (@case none () (call $fail $s $n 118))
                (@case some ($rank)
                  (if
                    (i32.ge_u $rank
                      (@list.len (ref $tree) (struct.get $Order $types $s)))
                    (then (call $fail $s $n 118))
                    (else (array.set $Ints (struct.get $Order $rank $s) $i $rank))))
              )
              (@let
                (($key (call $tree.at $mark 0))
                 ($found (call $type-map.find (struct.get $Order $groups $s) $key)))
                (if
                  (< $found 0)
                  (then
                    (block
                      (drop
                        (call $type-map.insert (struct.get $Order $groups $s) $key $i))
                      (array.set $Ints (struct.get $Order $owner $s) $i $i)
                      (array.set $Ints (struct.get $Order $tail $s) $i $i)))
                  (else
                    (block
                      (array.set $Ints (struct.get $Order $owner $s) $i $found)
                      (call $edge $s
                        (array.get $Ints (struct.get $Order $tail $s) $found)
                        $i)
                      (array.set $Ints (struct.get $Order $tail $s) $found $i))))
              )))
          (else (nop))))
    ))
  ;; Preserve the original rank order, with repeated parent-ready passes as in
  ;; the former implementation. Sorting and parent passes cost O(k^2) for an
  ;; SCC of k members; SCC discovery itself is O(V+E), with no V^3 closure.
  (func $emit-component
    (param $s (ref $Order))
    (param $c (ref $components))
    (param $group i32)
    (param $head i32)
    (param $next (ref $Ints))
    (@effect reads writes allocates)
    (@let
      (($scratch (struct.get $Order $scratch $s))
       ($owner (array.get $Ints (struct.get $Order $owner $s) $head))
       ($count
         (@loop $members
           (bind $i i32 $head)
           (bind $length i32 0)
           (result i32)
           (if
             (result i32)
             (< $i 0)
             (then $length)
             (else
               (block
                 (result i32)
                 (if
                   (!= $owner (array.get $Ints (struct.get $Order $owner $s) $i))
                   (then (call $fail $s (call $item $s $i) 118))
                   (else (nop)))
                 (@let $position
                   (@loop $insert (bind $at i32 $length) (result i32) (if (result i32) (> $at 0) (then (if (result i32) (> (array.get $Ints (struct.get $Order $rank $s) (array.get $Ints $scratch (- $at 1))) (array.get $Ints (struct.get $Order $rank $s) $i)) (then (block (result i32) (array.set $Ints $scratch $at (array.get $Ints $scratch (- $at 1))) (@recur $insert (- $at 1)))) (else $at))) (else $at)))
                   (block
                     (result i32)
                     (array.set $Ints $scratch $position $i)
                     (@recur $members (array.get $Ints $next $i) (+ $length 1))))
               ))))
       )
       ($out (call $list-builder.new<(ref $tree)>)))
      (block
        (if
          (i32.eqz (ref.is_null (struct.get $Order $error $s)))
          (then (return))
          (else (nop)))
        (@loop $passes
          (bind $remaining i32 $count)
          (if
            (> $remaining 0)
            (then
              (@let $pending
                (@loop $scan
                  (bind $i i32 0)
                  (bind $pending i32 $remaining)
                  (result i32)
                  (if
                    (result i32)
                    (= $i $count)
                    (then $pending)
                    (else
                      (@let
                        (($v (array.get $Ints $scratch $i))
                         ($parent (array.get $Ints (struct.get $Order $parent $s) $v)))
                        (if
                          (result i32)
                          (&&
                            (i32.eqz (array.get $Ints (struct.get $Order $done $s) $v))
                            (||
                              (< $parent 0)
                              (||
                                (!= (call $components.get $c $parent) $group)
                                (array.get $Ints (struct.get $Order $done $s) $parent))))
                          (then
                            (block
                              (result i32)
                              (call $list-builder.push<(ref $tree)> $out
                                (call $clean (call $item $s $v)))
                              (array.set $Ints (struct.get $Order $done $s) $v 1)
                              (@recur $scan (+ $i 1) (- $pending 1))))
                          (else (@recur $scan (+ $i 1) $pending))))
                    )))
                (if
                  (= $pending $remaining)
                  (then (call $fail $s (call $item $s $head) 118))
                  (else (@recur $passes $pending))))
            )
            (else (nop))))
        (if
          (i32.eqz (ref.is_null (struct.get $Order $error $s)))
          (then (return))
          (else (nop)))
        (@let $items (call $list-builder.finish<(ref $tree)> $out)
          (if
            (&& (= $count 1) (< $owner 0))
            (then
              (call $list-builder.push<(ref $tree)>
                (struct.get $Order $out $s)
                (@list.get (ref $tree) $items 0)))
            (else
              (call $list-builder.push<(ref $tree)>
                (struct.get $Order $out $s)
                (call $tree.form (call $item $s $head) "rec" $items))))
        ))))

  (func $type-order.run
    (param $types $list<(ref $tree)>)
    (result $result<$list<(ref $tree)>, (ref $project-error)>)
    (@effect reads writes allocates)
    (call $type-order.run-profile $types (ref.null $profile-state)))

  (func $type-order.run-profile
    (param $types $list<(ref $tree)>)
    (param $profile (ref null $profile-state))
    (result $result<$list<(ref $tree)>, (ref $project-error)>)
    (@effect reads writes allocates)
    (block
      (result $result<$list<(ref $tree)>, (ref $project-error)>)
      (if
        (> (@list.len (ref $tree) $types) (call $limits.types))
        (then
          (block
            (call $profile.limit $profile 4)
            (return (@result.err (struct.new $project-error 0 150 0 0))))
        )
        (else (nop)))
      (@let
        (($n (@list.len (ref $tree) $types))
         ($s
           (struct.new $Order
             $types
             (call $graph.new $n (call $limits.edges))
             (call $type-map.new $n)
             (call $type-map.new $n)
             (array.new $Ints -1 $n)
             (array.new $Ints -1 $n)
             (array.new $Ints 0 $n)
             (array.new $Ints -1 $n)
             (array.new $Ints 0 $n)
             (array.new $Ints 0 $n)
             (call $list-builder.new<(ref $tree)>)
             $profile
             (ref.null $project-error))))
        (block
          (result $result<$list<(ref $tree)>, (ref $project-error)>)
          (@for $i
            (bind $i i32 0)
            (while (< $i $n))
            (step (+ $i 1))
            (call $register $s $i))
          (@for $i
            (bind $i i32 0)
            (while (< $i $n))
            (step (+ $i 1))
            (block
              (if
                (= (array.get $Ints (struct.get $Order $owner $s) $i) $i)
                (then
                  (call $edge $s (array.get $Ints (struct.get $Order $tail $s) $i) $i))
                (else (nop)))
              (call $walk $s $i (call $item $s $i) 0)))
          (if
            (i32.eqz (ref.is_null (struct.get $Order $error $s)))
            (then
              (return (@result.err (ref.as_non_null (struct.get $Order $error $s))))
            )
            (else (nop)))
          (@let
            (($c (call $graph.scc (struct.get $Order $graph $s)))
             ($heads (array.new $Ints -1 (call $components.count $c)))
             ($next (array.new $Ints -1 $n)))
            (block
              (result $result<$list<(ref $tree)>, (ref $project-error)>)
              (@for $i
                (bind $i i32 (- $n 1))
                (while (>= $i 0))
                (step (- $i 1))
                (@let $label (call $components.get $c $i)
                  (block
                    (array.set $Ints $next $i (array.get $Ints $heads $label))
                    (array.set $Ints $heads $label $i))))
              (@for $group
                (bind $group i32 0)
                (while (< $group (call $components.count $c)))
                (step (+ $group 1))
                (call $emit-component $s $c $group
                  (array.get $Ints $heads $group)
                  $next))
              (if
                (result $result<$list<(ref $tree)>, (ref $project-error)>)
                (ref.is_null (struct.get $Order $error $s))
                (then
                  (@result.ok
                    (call $list-builder.finish<(ref $tree)> (struct.get $Order $out $s))))
                (else (@result.err (ref.as_non_null (struct.get $Order $error $s))))
              ))))
      ))))
