  (func $macro-operand-hint
    (param $s (ref $State))
    (param $n (ref $tree))
    (param $i i32)
    (param $expected (ref $tree))
    (result (ref $tree))
    (@effect reads writes allocates)
    (@let
      (($hint (call $gc-argument $s $n $i)))
      (if
        (result (ref $tree))
        (&&
          (call $tree.is $hint "?")
          (&&
            (|| (call $tree.is $expected "i32") (call $tree.is $expected "i64"))
            (||
              (||
                (|| (call $tree.head $n "+") (call $tree.head $n "-"))
                (||
                  (call $tree.head $n "*")
                  (|| (call $tree.head $n "/") (call $tree.head $n "&"))))
              (||
                (|| (call $tree.head $n "|") (call $tree.head $n "^"))
                (||
                  (call $tree.head $n "<<")
                  (|| (call $tree.head $n ">>") (call $tree.head $n ">>>"))))
            )))
        (then $expected)
        (else $hint))))

  (func $macro-expr
    (param $s (ref $State))
    (param $n (ref $tree))
    (param $expected (ref $tree))
    (param $env (ref null $Env))
    (result (ref $tree))
    (@effect reads writes allocates)
    (block
      (result (ref $tree))
      (call $macro.enter (struct.get $State $macros $s) $n)
      (if
        (i32.eqz (ref.is_null (call $macro.error (struct.get $State $macros $s))))
        (then
          (block
            (struct.set $State $error $s
              (call $macro.error (struct.get $State $macros $s)))
            (return $n)))
        (else (nop)))
      (@let
        (($rules
           (call $macro.rules (struct.get $State $macros $s) (call $tree.at $n 0)))
         ($args (call $tree.copy $n 2 (@bytes.new) (call $tree.slice $n 1))))
        (block
          (result (ref $tree))
          (if
            (= (@list.len (ref $macro-rule) $rules) 0)
            (then (call $fail $s $n 212))
            (else (nop)))
          (@for-each $rule $rules
            (@match (call $macro.match $rule $args)
              (@case none () (nop))
              (@case some ($match)
                (block
                  (call $macro-type-inputs $s $match)
                  (@for-each $q (struct.get $macro-rule $queries $rule)
                    (@let
                      (($ty (call $macro-query $s $match $q $expected $env))
                       ($capture
                         (ref.as_non_null
                           (call $macro.capture $match (call $tree.at $q 0))))
                      )
                      (call $list-builder.push< (ref $tree) >
                        (struct.get $macro-capture $values $capture)
                        $ty)))
                  (if
                    (call $macro-guards $s $match $env)
                    (then
                      (@match (call $macro.expand (struct.get $State $macros $s) $match)
                        (@case err ($e)
                          (block
                            (struct.set $State $error $s $e)
                            (call $macro.leave (struct.get $State $macros $s))
                            (return $n)))
                        (@case ok ($out)
                          (@let
                            (($result (call $expr $s $out $expected $env)))
                            (block
                              (call $macro.leave (struct.get $State $macros $s))
                              (return $result))))
                      ))
                    (else (nop)))
                  (if
                    (i32.eqz (ref.is_null (struct.get $State $error $s)))
                    (then
                      (block
                        (call $macro.leave (struct.get $State $macros $s))
                        (return $n)))
                    (else (nop))))
              )))
          (call $macro.leave (struct.get $State $macros $s))
          (call $fail $s $n 213)
          $n))))

  (func $macro-type-syntax
    (param $s (ref $State))
    (param $m (ref $macro-match))
    (param $n (ref $tree))
    (result (ref $tree))
    (@effect reads writes allocates)
    (block
      (result (ref $tree))
      (if
        (call $macro.variable $n)
        (then (return (call $macro.one $m $n)))
        (else (nop)))
      (if
        (!= (struct.get $tree $kind $n) 2)
        (then (return (call $linked.resolve (struct.get $State $linked $s) $n 0)))
        (else (nop)))
      (@let
        (($b (call $list-builder.new< (ref $tree) >)))
        (block
          (result (ref $tree))
          (@for-each $x (struct.get $tree $items $n)
            (call $list-builder.push< (ref $tree) > $b
              (call $macro-type-syntax $s $m $x)))
          (call $tree.copy $n 2
            (@bytes.new)
            (call $list-builder.finish< (ref $tree) > $b))))
    ))

  (func $macro-query
    (param $s (ref $State))
    (param $m (ref $macro-match))
    (param $q (ref $tree))
    (param $expected (ref $tree))
    (param $env (ref null $Env))
    (result (ref $tree))
    (@effect reads writes allocates)
    (@let
      (($target (call $tree.at $q 1))
       ($direct (= (struct.get $tree $kind $target) 0))
       ($key
         (if
           (result (ref $tree))
           $direct
           (then $target)
           (else (call $tree.at $target 1))))
       ($hint
         (if
           (result (ref $tree))
           (= (call $tree.len $q) 3)
           (then $expected)
           (else (call $tree.atom $q "?"))))
       ($ty
         (if
           (result (ref $tree))
           (call $tree.is $key "expected")
           (then $expected)
           (else (call $macro-infer $s (call $macro.one $m $key) $hint $env))))
      )
      (block
        (result (ref $tree))
        (if
          (&& (call $tree.is $key "expected") (i32.eqz $direct))
          (then (block (call $fail $s $q 218) (return $ty)))
          (else (nop)))
        (if
          (call $tree.is $ty "?")
          (then (block (call $fail $s $q 218) (return $ty)))
          (else (nop)))
        (if
          (result (ref $tree))
          $direct
          (then $ty)
          (else (call $macro-project $s $q (call $tree.at $target 0) $ty))))
    ))

  (func $macro-guards
    (param $s (ref $State))
    (param $m (ref $macro-match))
    (param $env (ref null $Env))
    (result i32)
    (@effect reads writes allocates)
    (block
      (result i32)
      (@for-each $g (struct.get $macro-rule $guards (struct.get $macro-match $rule $m))
        (@let
          (($ty
             (call $macro-infer $s
               (call $macro.one $m (call $tree.at $g 1))
               (call $tree.atom $g "?")
               $env)))
          (if
            (call $tree.head $g "type")
            (then
              (@let
                (($required
                   (call $type $s (call $macro-type-syntax $s $m (call $tree.at $g 2))))
                )
                (block
                  (if
                    (||
                      (i32.eqz (call $concrete $s $required))
                      (||
                        (call $tree.is $required "i8")
                        (call $tree.is $required "i16")))
                    (then (block (call $fail $s $g 218) (return 0)))
                    (else (nop)))
                  (if
                    (i32.eqz (call $same $ty $required))
                    (then (return 0))
                    (else (nop))))
              ))
            (else
              (if
                (i32.eqz (call $macro-supports (call $tree.at $g 0) $ty))
                (then (return 0))
                (else (nop))))
          )))
      1))

  (func $macro-supports
    (param $class (ref $tree))
    (param $ty (ref $tree))
    (result i32)
    (@effect reads writes allocates)
    (||
      (call $tree.is $ty "i32")
      (&& (call $tree.is $ty "i64") (i32.eqz (call $tree.is $class "Logical"))))
  )

  (func $macro-project
    (param $s (ref $State))
    (param $n (ref $tree))
    (param $selector (ref $tree))
    (param $ty (ref $tree))
    (result (ref $tree))
    (@effect reads writes allocates)
    (block
      (result (ref $tree))
      (if
        (call $tree.is $selector "ref.heap")
        (then
          (if
            (call $tree.head $ty "ref")
            (then (return (call $tree.at $ty (- (call $tree.len $ty) 1))))
            (else (nop))))
        (else (nop)))
      (if
        (call $tree.is $selector "array.element")
        (then
          (block
            (call $check-access $s $n $ty)
            (return
              (@let
                (($storage
                   (call $storage $s (call $tree.at $ty (- (call $tree.len $ty) 1))))
                )
                (if
                  (result (ref $tree))
                  (|| (call $tree.is $storage "i8") (call $tree.is $storage "i16"))
                  (then (call $tree.atom $n "i32"))
                  (else $storage))))
          ))
        (else (nop)))
      (@let
        (($instance (call $type-instance $s $ty)))
        (block
          (if
            (&&
              (call $tree.is $selector "option.element")
              (call $is-instance $s $instance "$Option"))
            (then
              (return
                (@list.get
                  (ref $tree)
                  (struct.get $Instance $args (ref.as_non_null $instance))
                  0)))
            (else (nop)))
          (if
            (&&
              (call $tree.is $selector "list.element")
              (call $is-instance $s $instance "$List"))
            (then
              (return
                (@list.get
                  (ref $tree)
                  (struct.get $Instance $args (ref.as_non_null $instance))
                  0)))
            (else (nop)))
          (if
            (&&
              (call $tree.is $selector "result.ok")
              (call $is-instance $s $instance "$Result"))
            (then
              (return
                (@list.get
                  (ref $tree)
                  (struct.get $Instance $args (ref.as_non_null $instance))
                  0)))
            (else (nop)))
          (if
            (&&
              (call $tree.is $selector "result.err")
              (call $is-instance $s $instance "$Result"))
            (then
              (return
                (@list.get
                  (ref $tree)
                  (struct.get $Instance $args (ref.as_non_null $instance))
                  1)))
            (else (nop)))
          (if
            (&&
              (call $tree.is $selector "tuple.first")
              (call $is-instance $s $instance "$Tuple"))
            (then
              (return
                (@list.get
                  (ref $tree)
                  (struct.get $Instance $args (ref.as_non_null $instance))
                  0)))
            (else (nop)))
          (if
            (&&
              (call $tree.is $selector "tuple.second")
              (call $is-instance $s $instance "$Tuple"))
            (then
              (return
                (@list.get
                  (ref $tree)
                  (struct.get $Instance $args (ref.as_non_null $instance))
                  1)))
            (else (nop))))
      )
      (call $fail $s $n 218)
      (call $tree.atom $n "?")))

  (func $macro-infer
    (param $s (ref $State))
    (param $n (ref $tree))
    (param $hint (ref $tree))
    (param $env (ref null $Env))
    (result (ref $tree))
    (@effect reads writes allocates)
    (@let
      (($expanded (call $expr $s $n $hint $env))
       ($inferred (call $infer $s $expanded $env))
       ($ty
         (if
           (result (ref $tree))
           (call $tree.is $hint "?")
           (then $inferred)
           (else $hint))))
      (block
        (result (ref $tree))
        (if
          (call $tree.is $inferred "@never")
          (then (block (call $fail $s $n 218) (return $ty)))
          (else (nop)))
        (if
          (call $tree.is $ty "?")
          (then (block (call $fail $s $n 116) (return $ty)))
          (else (nop)))
        (call $macro-probe $s $n $expanded $ty $env)
        $ty)))
  (type $ProbeName (struct (field $source (ref $tree)) (field $target (ref $tree))))
  (func $macro-probe
    (param $s (ref $State))
    (param $n (ref $tree))
    (param $body (ref $tree))
    (param $ty (ref $tree))
    (param $env (ref null $Env))
    (@effect reads writes allocates)
    (@let
      (($params (call $list-builder.new< (ref $tree) >))
       ($lets (call $list-builder.new< (ref $tree) >))
       ($names (call $list-builder.new< (ref $ProbeName) >))
       ($seen (call $list-builder.new< (ref $tree) >)))
      (block
        (@loop $env
          (bind $p (ref null $Env) $env)
          (if
            (i32.eqz (ref.is_null $p))
            (then
              (@let
                (($e (ref.as_non_null $p))
                 ($name (struct.get $Env $name $e)))
                (block
                  (if
                    (i32.eqz
                      (call $probe-seen
                        (call $work.snapshot< (ref $tree) > $seen)
                        $name))
                    (then
                      (@let
                        (($param
                           (if
                             (result (ref $tree))
                             (call $tree.is-name $name)
                             (then $name)
                             (else (call $fresh $s $n))))
                        )
                        (block
                          (call $list-builder.push< (ref $tree) > $seen $name)
                          (call $list-builder.push< (ref $tree) > $params
                            (call $t2 $n "param" $param (struct.get $Env $type $e)))
                          (if
                            (call $tree.is-name $name)
                            (then
                              (if
                                (i32.eqz (struct.get $Env $mutable $e))
                                (then
                                  (@let
                                    (($arg (call $fresh $s $n)))
                                    (block
                                      (call $list-builder.push< (ref $tree) > $lets
                                        (call $tree.copy $n 2
                                          (@bytes.new)
                                          (@list.new
                                            (ref $tree)
                                            $name
                                            (call $t1 $n "type"
                                              (struct.get $Env $type $e))
                                            $arg)))
                                      (call $list-builder.push< (ref $ProbeName) >
                                        $names
                                        (struct.new $ProbeName $name $arg))))
                                )
                                (else (nop))))
                            (else
                              (call $list-builder.push< (ref $ProbeName) > $names
                                (struct.new $ProbeName $name $param))))
                        )))
                    (else (nop)))
                  (@recur $env (struct.get $Env $parent $e))))
            )
            (else (nop))))
        (call $probe-finish $s $n $body $ty
          (call $list-builder.finish< (ref $tree) > $params)
          (call $list-builder.finish< (ref $tree) > $lets)
          (call $list-builder.finish< (ref $ProbeName) > $names))))
  )

  (func $probe-seen
    (param $xs $list< (ref $tree) >)
    (param $name (ref $tree))
    (result i32)
    (@effect reads writes allocates)
    (block
      (result i32)
      (@for-each $x $xs
        (if (call $tree.eq $x $name) (then (return 1)) (else (nop))))
      0))

  (func $probe-numeric
    (param $s (ref $State))
    (param $n (ref $tree))
    (param $names $list< (ref $ProbeName) >)
    (result (ref $tree))
    (@effect reads writes allocates)
    (@let
      (($b (call $list-builder.new< (ref $tree) >)))
      (block
        (result (ref $tree))
        (@for $i
          (bind $i i32 0)
          (while (< $i (call $tree.len $n)))
          (step (+ $i 1))
          (@let
            (($child (call $tree.at $n $i)))
            (call $list-builder.push< (ref $tree) > $b
              (if
                (result (ref $tree))
                (&&
                  (= $i 1)
                  (&&
                    (||
                      (call $tree.head $n "local.get")
                      (||
                        (call $tree.head $n "local.set")
                        (call $tree.head $n "local.tee")))
                    (i32.eqz (call $tree.is-name $child))))
                (then (call $probe-name $s $child $names))
                (else
                  (if
                    (result (ref $tree))
                    (||
                      (= (struct.get $tree $kind $child) 2)
                      (= (struct.get $tree $kind $child) 8))
                    (then (call $probe-numeric $s $child $names))
                    (else $child))))
            )))
        (call $tree.copy $n
          (struct.get $tree $kind $n)
          (struct.get $tree $value $n)
          (call $list-builder.finish< (ref $tree) > $b))))
  )

  (func $probe-name
    (param $s (ref $State))
    (param $n (ref $tree))
    (param $names $list< (ref $ProbeName) >)
    (result (ref $tree))
    (@effect reads writes allocates)
    (block
      (result (ref $tree))
      (@for-each $e $names
        (if
          (call $tree.eq $n (struct.get $ProbeName $source $e))
          (then (return (struct.get $ProbeName $target $e)))
          (else (nop))))
      (call $fresh $s $n)))

  (func $probe-finish
    (param $s (ref $State))
    (param $n (ref $tree))
    (param $body (ref $tree))
    (param $ty (ref $tree))
    (param $params $list< (ref $tree) >)
    (param $lets $list< (ref $tree) >)
    (param $names $list< (ref $ProbeName) >)
    (@effect reads writes allocates)
    (@let
      (($b (call $list-builder.new< (ref $tree) >))
       ($wrapped
         (@loop $lets
           (bind $i i32 (@list.len (ref $tree) $lets))
           (bind $out (ref $tree) (call $probe-numeric $s $body $names))
           (result (ref $tree))
           (if
             (result (ref $tree))
             (= $i 0)
             (then $out)
             (else
               (@let
                 (($binding (@list.get (ref $tree) $lets (- $i 1))))
                 (@recur $lets
                   (- $i 1)
                   (call $t4 $binding "@let"
                     (call $tree.at $binding 0)
                     (call $tree.at $binding 1)
                     (call $tree.at $binding 2)
                     $out))))
           ))))
      (block
        (call $list-builder.push< (ref $tree) > $b (call $fresh $s $n))
        (@for-each $p $params
          (call $list-builder.push< (ref $tree) > $b
            (call $t2 $p "param"
              (call $probe-param (call $tree.at $p 1) $names)
              (call $tree.at $p 2))))
        (call $list-builder.push< (ref $tree) > $b (call $result-form $n $ty))
        (call $list-builder.push< (ref $tree) > $b $wrapped)
        (call $list-builder.push< (ref $tree) >
          (struct.get $State $queries $s)
          (call $tree.form $n "func" (call $list-builder.finish< (ref $tree) > $b))))
    ))

  (func $probe-param
    (param $name (ref $tree))
    (param $names $list< (ref $ProbeName) >)
    (result (ref $tree))
    (@effect reads writes allocates)
    (block
      (result (ref $tree))
      (@for-each $e $names
        (if
          (call $tree.eq $name (struct.get $ProbeName $source $e))
          (then (return (struct.get $ProbeName $target $e)))
          (else (nop))))
      $name))

  (func $macro-type-inputs
    (param $s (ref $State))
    (param $m (ref $macro-match))
    (@effect reads writes allocates)
    (@for-each $c (struct.get $macro-match $captures $m)
      (if
        (=
          (struct.get $macro-variable $category
            (struct.get $macro-capture $variable $c))
          2)
        (then
          (@let
            (($values
               (call $list-builder.finish< (ref $tree) >
                 (struct.get $macro-capture $values $c))))
            (@for-each $value $values
              (call $list-builder.push< (ref $tree) >
                (struct.get $macro-capture $values $c)
                (call $macro-type-input $s $value))))
        )
        (else (nop))))
  )

  (func $macro-type-input
    (param $s (ref $State))
    (param $n (ref $tree))
    (result (ref $tree))
    (@effect reads writes allocates)
    (block
      (result (ref $tree))
      (if
        (= (struct.get $tree $kind $n) 0)
        (then (return (call $linked.resolve (struct.get $State $linked $s) $n 0)))
        (else (nop)))
      (@let
        (($b (call $list-builder.new< (ref $tree) >)))
        (block
          (result (ref $tree))
          (@for-each $x (struct.get $tree $items $n)
            (call $list-builder.push< (ref $tree) > $b (call $macro-type-input $s $x)))
          (call $tree.copy $n
            (struct.get $tree $kind $n)
            (struct.get $tree $value $n)
            (call $list-builder.finish< (ref $tree) > $b))))
    ))

  (func $macro-subst
    (param $s (ref $State))
    (param $n (ref $tree))
    (param $decl (ref $tree))
    (param $args $list< (ref $tree) >)
    (result (ref $tree))
    (@effect reads writes allocates)
    (@let
      (($refs (call $list-builder.new< (ref $tree) >))
       ($input (call $tree.copy $n 2 (@bytes.new) (call $tree.slice $n 1))))
      (block
        (result (ref $tree))
        (@for-each $rule
          (call $macro.rules (struct.get $State $macros $s) (call $tree.at $n 0))
          (@match (call $macro.match $rule $input)
            (@case none () (nop))
            (@case some ($m)
              (@for-each $c (struct.get $macro-match $captures $m)
                (if
                  (=
                    (struct.get $macro-variable $category
                      (struct.get $macro-capture $variable $c))
                    2)
                  (then
                    (call $list-builder.extend< (ref $tree) > $refs
                      (call $work.snapshot< (ref $tree) >
                        (struct.get $macro-capture $values $c))))
                  (else (nop))))
            )))
        (call $subst-at $s
          (call $macro-subst-nodes $s $n $decl $args
            (call $list-builder.finish< (ref $tree) > $refs))
          $decl
          $args
          3))))

  (func $macro-subst-nodes
    (param $s (ref $State))
    (param $n (ref $tree))
    (param $decl (ref $tree))
    (param $args $list< (ref $tree) >)
    (param $refs $list< (ref $tree) >)
    (result (ref $tree))
    (@effect reads writes allocates)
    (block
      (result (ref $tree))
      (@for-each $ref $refs
        (if
          (ref.eq $ref $n)
          (then (return (call $subst-at $s $n $decl $args 1)))
          (else (nop))))
      (if (!= (struct.get $tree $kind $n) 2) (then (return $n)) (else (nop)))
      (@let
        (($b (call $list-builder.new< (ref $tree) >)))
        (block
          (result (ref $tree))
          (@for-each $child (struct.get $tree $items $n)
            (call $list-builder.push< (ref $tree) > $b
              (call $macro-subst-nodes $s $child $decl $args $refs)))
          (call $tree.copy $n 2
            (@bytes.new)
            (call $list-builder.finish< (ref $tree) > $b))))
    ))

  (func $macro-call-target
    (param $s (ref $State))
    (param $n (ref $tree))
    (result (ref $tree))
    (@effect reads writes allocates)
    (if
      (result (ref $tree))
      (call $tree.head $n "@inst")
      (then
        (@let
          (($b (call $list-builder.new<(ref $tree)>)))
          (block
            (result (ref $tree))
            (call $list-builder.push<(ref $tree)> $b
              (call $linked.resolve
                (struct.get $State $linked $s)
                (call $tree.at $n 1)
                1))
            (@for $i
              (bind $i i32 2)
              (while (< $i (call $tree.len $n)))
              (step (+ $i 1))
              (call $list-builder.push<(ref $tree)> $b (call $tree.at $n $i)))
            (call $tree.form $n "@inst" (call $list-builder.finish<(ref $tree)> $b))))
      )
      (else (call $linked.resolve (struct.get $State $linked $s) $n 1))))
)
