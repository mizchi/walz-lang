(module
  (@use "./modules.walz" (func $linked.resolve))
  (@use "./macro-validation.walz" (func $macro.validate-queries))
  (@use "./macros.walz" (func $macro.expand))
  (@use "./macro-context.walz"
    (type $macro-context)
    (func $macro.context)
    (func $macro.rules)
    (func $macro.called)
    (func $macro.enter)
    (func $macro.leave)
    (func $macro.error))
  (@use "./macro-patterns.walz"
    (type $macro-rule)
    (type $macro-match)
    (type $macro-capture)
    (type $macro-variable)
    (func $macro.match)
    (func $macro.capture)
    (func $macro.one)
    (func $macro.variable))
  (@use "walz:core"
    (type $bytes)
    (type $string)
    (type $list)
    (type $result)
    (type $tuple)
    (type $list-builder)
    (func $list-builder.new)
    (func $list-builder.push)
    (func $list-builder.extend)
    (func $list-builder.finish)
    (func $list-builder.len))
  (@use "../core/bytes.walz" (func $bytes.equal))
  (@use "../core/text.walz" (func $string.concat) (func $string.u64))
  (@use "./tree.walz"
    (type $tree)
    (type $project-error)
    (type $source-file)
    (func $tree.at)
    (func $tree.len)
    (func $tree.is)
    (func $tree.head)
    (func $tree.atom)
    (func $tree.form)
    (func $tree.copy)
    (func $tree.name)
    (func $tree.error)
    (func $tree.read)
    (func $tree.slice)
    (func $tree.eq)
    (func $work.snapshot)
    (func $tree.is-name)
    (func $t0)
    (func $t1)
    (func $t2)
    (func $t3)
    (func $t4)
    (func $t5)
    (func $t6))
  (@use "./modules.walz"
    (type $linked)
    (func $linked.tree)
    (func $linked.core)
    (func $linked.access))
  (@use "./tree.walz" (func $tree.occurs))
  (@use "./type-order.walz" (func $type-order.run))
  (@use "../checker/operators.walz" (func $operator.code) (func $operator.result))
  (@export (func $generics.run))
  (type $Env
    (struct
      (field $name (ref $tree))
      (field $type (ref $tree))
      (field $parent (ref null $Env))
      (field $mutable i32)
      (field $index i32)))
  (type $Instance
    (struct
      (field $decl (ref $tree))
      (field $args $list< (ref $tree) >)
      (field $name (ref $tree))
      (field $kind i32)
      (field $state (mut i32))
      (field $value (mut (ref null $tree))))
  )
  (type $State
    (struct
      (field $linked (ref $linked))
      (field $decls (ref $list-builder< (ref $tree) >))
      (field $instances (ref $list-builder< (ref $Instance) >))
      (field $types (ref $list-builder< (ref $tree) >))
      (field $functions (ref $list-builder< (ref $tree) >))
      (field $groups (ref $list-builder< (ref $tree) >))
      (field $other (ref $list-builder< (ref $tree) >))
      (field $result (mut (ref $tree)))
      (field $next (mut i32))
      (field $work (mut i32))
      (field $error (mut (ref null $project-error)))
      (field $depth (mut i32))
      (field $macros (ref $macro-context))
      (field $queries (ref $list-builder< (ref $tree) >))))
  (func $fail
    (param $s (ref $State))
    (param $n (ref $tree))
    (param $code i32)
    (@effect reads writes allocates)
    (if
      (ref.is_null (struct.get $State $error $s))
      (then (struct.set $State $error $s (call $tree.error $n $code)))
      (else (nop))))

  (func $fresh
    (param $s (ref $State))
    (param $n (ref $tree))
    (result (ref $tree))
    (@effect reads writes allocates)
    (@loop $fresh
      (result (ref $tree))
      (@let
        (($x (call $tree.name $n "$__inst." (struct.get $State $next $s))))
        (block
          (result (ref $tree))
          (struct.set $State $next $s (+ (struct.get $State $next $s) 1))
          (if
            (result (ref $tree))
            (call $tree.occurs (call $linked.tree (struct.get $State $linked $s)) $x)
            (then (@recur $fresh))
            (else $x))))
    ))

  (func $same
    (param $a (ref $tree))
    (param $b (ref $tree))
    (result i32)
    (@effect pure)
    (block
      (result i32)
      (if
        (||
          (&&
            (!= (struct.get $tree $kind $a) (struct.get $tree $kind $b))
            (i32.eqz
              (&&
                (|| (= (struct.get $tree $kind $a) 2) (= (struct.get $tree $kind $a) 8))
                (|| (= (struct.get $tree $kind $b) 2) (= (struct.get $tree $kind $b) 8))))
          )
          (||
            (i32.eqz (call $tree.eq $a $b))
            (!= (call $tree.len $a) (call $tree.len $b))))
        (then (return 0))
        (else (nop)))
      (@for $i
        (bind $i i32 0)
        (while (< $i (call $tree.len $a)))
        (step (+ $i 1))
        (if
          (i32.eqz (call $same (call $tree.at $a $i) (call $tree.at $b $i)))
          (then (return 0))
          (else (nop))))
      1))

  (func $decl
    (param $s (ref $State))
    (param $name (ref $tree))
    (param $func i32)
    (result (ref null $tree))
    (@effect reads writes allocates)
    (block
      (result (ref null $tree))
      (if
        (!= (struct.get $tree $kind $name) 0)
        (then (return (ref.null $tree)))
        (else (nop)))
      (@for-each $d (call $work.snapshot< (ref $tree) > (struct.get $State $decls $s))
        (if
          (&&
            (call $tree.eq (call $tree.at $d 1) $name)
            (= (call $tree.head $d "func") $func))
          (then (return $d))
          (else (nop))))
      (ref.null $tree)))

  (func $params
    (param $n (ref $tree))
    (result $list< (ref $tree) >)
    (@effect reads writes allocates)
    (if
      (result $list< (ref $tree) >)
      (call $tree.head (call $tree.at $n 2) "@type.params")
      (then (call $tree.slice (call $tree.at $n 2) 1))
      (else (@list.new (ref $tree))))
  )

  (func $env-type
    (param $n (ref $tree))
    (param $env (ref null $Env))
    (result (ref $tree))
    (@effect reads writes allocates)
    (@loop $find
      (bind $p (ref null $Env) $env)
      (result (ref $tree))
      (if
        (result (ref $tree))
        (ref.is_null $p)
        (then (call $tree.atom $n "?"))
        (else
          (@let
            (($v (ref.as_non_null $p)))
            (if
              (result (ref $tree))
              (call $tree.eq $n (struct.get $Env $name $v))
              (then (struct.get $Env $type $v))
              (else (@recur $find (struct.get $Env $parent $v))))
          ))))
  )

  (func $subst-at
    (param $s (ref $State))
    (param $n (ref $tree))
    (param $decl (ref $tree))
    (param $args $list< (ref $tree) >)
    (param $mode i32)
    (result (ref $tree))
    (@effect reads writes allocates)
    (block
      (result (ref $tree))
      (if
        (&& (= $mode 0) (call $macro.called $n))
        (then (return (call $macro-subst $s $n $decl $args)))
        (else (nop)))
      (@let
        (($ps (call $params $decl)))
        (if
          (result (ref $tree))
          (= $mode 2)
          (then $n)
          (else
            (if
              (result (ref $tree))
              (= (struct.get $tree $kind $n) 0)
              (then
                (block
                  (result (ref $tree))
                  (if
                    (= $mode 1)
                    (then
                      (@for $i
                        (bind $i i32 0)
                        (while (< $i (@list.len (ref $tree) $ps)))
                        (step (+ $i 1))
                        (if
                          (call $tree.eq $n (@list.get (ref $tree) $ps $i))
                          (then
                            (block
                              (if
                                (>= $i (@list.len (ref $tree) $args))
                                (then (block (call $fail $s $n 206) (return $n)))
                                (else (nop)))
                              (return (@list.get (ref $tree) $args $i))))
                          (else (nop))))
                    )
                    (else (nop)))
                  $n))
              (else
                (@let
                  (($out (call $list-builder.new< (ref $tree) >)))
                  (block
                    (result (ref $tree))
                    (@for $i
                      (bind $i i32 0)
                      (while (< $i (call $tree.len $n)))
                      (step (+ $i 1))
                      (call $list-builder.push< (ref $tree) > $out
                        (call $subst-at $s
                          (call $tree.at $n $i)
                          $decl
                          $args
                          (if
                            (result i32)
                            (&& (= $i 0) (!= $mode 3))
                            (then 2)
                            (else
                              (if
                                (result i32)
                                (= $mode 3)
                                (then 4)
                                (else
                                  (if
                                    (result i32)
                                    (= $mode 4)
                                    (then (if (result i32) (= $i 0) (then 2) (else 0)))
                                    (else
                                      (if
                                        (result i32)
                                        (call $tree.is (call $tree.at $n 0) "@let")
                                        (then
                                          (if
                                            (result i32)
                                            (= $i 1)
                                            (then
                                              (if
                                                (result i32)
                                                (= (call $tree.len $n) 3)
                                                (then 3)
                                                (else 2)))
                                            (else 0)))
                                        (else
                                          (if
                                            (result i32)
                                            (&&
                                              (call $tree.is
                                                (call $tree.at $n 0)
                                                "@case")
                                              (< $i 3))
                                            (then 2)
                                            (else
                                              (if
                                                (result i32)
                                                (&&
                                                  (= $i 1)
                                                  (||
                                                    (call $tree.is
                                                      (call $tree.at $n 0)
                                                      "@for-each")
                                                    (||
                                                      (call $tree.is
                                                        (call $tree.at $n 0)
                                                        "@loop")
                                                      (call $tree.is
                                                        (call $tree.at $n 0)
                                                        "@for"))))
                                                (then 2)
                                                (else
                                                  (if
                                                    (result i32)
                                                    (&&
                                                      (= $i 1)
                                                      (call $tree.is
                                                        (call $tree.at $n 0)
                                                        "call"))
                                                    (then 0)
                                                    (else
                                                      (if
                                                        (result i32)
                                                        (&&
                                                          (= $i 1)
                                                          (||
                                                            (call $tree.is
                                                              (call $tree.at $n 0)
                                                              "call")
                                                            (||
                                                              (call $tree.is
                                                                (call $tree.at $n 0)
                                                                "local.get")
                                                              (||
                                                                (call $tree.is
                                                                  (call $tree.at $n 0)
                                                                  "local.set")
                                                                (||
                                                                  (call $tree.is
                                                                    (call $tree.at $n 0)
                                                                    "local.tee")
                                                                  (||
                                                                    (call $tree.is
                                                                      (call $tree.at $n
                                                                        0)
                                                                      "br")
                                                                    (||
                                                                      (call $tree.is
                                                                        (call $tree.at
                                                                          $n 0)
                                                                        "br_if")
                                                                      (call $tree.is
                                                                        (call $tree.at
                                                                          $n 0)
                                                                        "@recur"))))
                                                              ))))
                                                        (then 2)
                                                        (else
                                                          (if
                                                            (result i32)
                                                            (&&
                                                              (= $i 2)
                                                              (||
                                                                (call $tree.is
                                                                  (call $tree.at $n 0)
                                                                  "struct.get")
                                                                (||
                                                                  (call $tree.is
                                                                    (call $tree.at $n 0)
                                                                    "struct.get_s")
                                                                  (||
                                                                    (call $tree.is
                                                                      (call $tree.at $n
                                                                        0)
                                                                      "struct.get_u")
                                                                    (call $tree.is
                                                                      (call $tree.at $n
                                                                        0)
                                                                      "struct.set"))))
                                                            )
                                                            (then 2)
                                                            (else
                                                              (if
                                                                (result i32)
                                                                (call $tree.is
                                                                  (call $tree.at $n 0)
                                                                  "sub")
                                                                (then 1)
                                                                (else
                                                                  (if
                                                                    (result i32)
                                                                    (call $tree.is
                                                                      (call $tree.at $n
                                                                        0)
                                                                      "type")
                                                                    (then
                                                                      (if
                                                                        (result i32)
                                                                        (=
                                                                          (call
                                                                            $tree.len $n)
                                                                          2)
                                                                        (then 1)
                                                                        (else
                                                                          (if
                                                                            (result i32)
                                                                            (= $i 1)
                                                                            (then 2)
                                                                            (else 1))))
                                                                    )
                                                                    (else
                                                                      (if
                                                                        (result i32)
                                                                        (call $tree.is
                                                                          (call $tree.at
                                                                            $n 0)
                                                                          "bind")
                                                                        (then
                                                                          (if
                                                                            (result i32)
                                                                            (= $i 2)
                                                                            (then 1)
                                                                            (else
                                                                              (if
                                                                                (result
                                                                                  i32)
                                                                                (= $i 1)
                                                                                (then 2)
                                                                                (else 0))))
                                                                        )
                                                                        (else
                                                                          (if
                                                                            (result i32)
                                                                            (call
                                                                              $tree.is
                                                                              (call
                                                                                $tree.at
                                                                                $n 0)
                                                                              "field")
                                                                            (then
                                                                              (if
                                                                                (result
                                                                                  i32)
                                                                                (= $i
                                                                                  (-
                                                                                    (call
                                                                                      $tree.len
                                                                                      $n)
                                                                                    1))
                                                                                (then 1)
                                                                                (else 2)))
                                                                            (else
                                                                              (if
                                                                                (result
                                                                                  i32)
                                                                                (call
                                                                                  $tree.is
                                                                                  (call
                                                                                    $tree.at
                                                                                    $n 0)
                                                                                  "local")
                                                                                (then
                                                                                  (if
                                                                                    (result
                                                                                      i32)
                                                                                    (=
                                                                                      $i
                                                                                      (-
                                                                                        (call
                                                                                          $tree.len
                                                                                          $n)
                                                                                        1))
                                                                                    (then
                                                                                      1)
                                                                                    (else
                                                                                      2)))
                                                                                (else
                                                                                  (if
                                                                                    (result
                                                                                      i32)
                                                                                    (call
                                                                                      $tree.is
                                                                                      (call
                                                                                        $tree.at
                                                                                        $n
                                                                                        0)
                                                                                      "param")
                                                                                    (then
                                                                                      (if
                                                                                        (result
                                                                                          i32)
                                                                                        (=
                                                                                          $i
                                                                                          (-
                                                                                            (call
                                                                                              $tree.len
                                                                                              $n)
                                                                                            1))
                                                                                        (then
                                                                                          1)
                                                                                        (else
                                                                                          2)))
                                                                                    (else
                                                                                      (if
                                                                                        (result
                                                                                          i32)
                                                                                        (call
                                                                                          $tree.is
                                                                                          (call
                                                                                            $tree.at
                                                                                            $n
                                                                                            0)
                                                                                          "@inst")
                                                                                        (then
                                                                                          (if
                                                                                            (result
                                                                                              i32)
                                                                                            (>
                                                                                              $i
                                                                                              1)
                                                                                            (then
                                                                                              1)
                                                                                            (else
                                                                                              2)))
                                                                                        (else
                                                                                          (if
                                                                                            (result
                                                                                              i32)
                                                                                            (&&
                                                                                              (=
                                                                                                $i
                                                                                                2)
                                                                                              (||
                                                                                                (call
                                                                                                  $tree.is
                                                                                                  (call
                                                                                                    $tree.at
                                                                                                    $n
                                                                                                    0)
                                                                                                  "array.copy")
                                                                                                (call
                                                                                                  $tree.is
                                                                                                  (call
                                                                                                    $tree.at
                                                                                                    $n
                                                                                                    0)
                                                                                                  "@list.from-array")))
                                                                                            (then
                                                                                              1)
                                                                                            (else
                                                                                              (if
                                                                                                (result
                                                                                                  i32)
                                                                                                (&&
                                                                                                  (=
                                                                                                    $i
                                                                                                    1)
                                                                                                  (||
                                                                                                    (||
                                                                                                      (||
                                                                                                        (||
                                                                                                          (||
                                                                                                            (||
                                                                                                              (||
                                                                                                                (||
                                                                                                                  (||
                                                                                                                    (||
                                                                                                                      (||
                                                                                                                        (||
                                                                                                                          (||
                                                                                                                            (||
                                                                                                                              (||
                                                                                                                                (||
                                                                                                                                  (||
                                                                                                                                    (||
                                                                                                                                      (||
                                                                                                                                        (||
                                                                                                                                          (||
                                                                                                                                            (||
                                                                                                                                              (||
                                                                                                                                                (call
                                                                                                                                                  $tree.is
                                                                                                                                                  (call
                                                                                                                                                    $tree.at
                                                                                                                                                    $n
                                                                                                                                                    0)
                                                                                                                                                  "struct.new")
                                                                                                                                                (call
                                                                                                                                                  $tree.is
                                                                                                                                                  (call
                                                                                                                                                    $tree.at
                                                                                                                                                    $n
                                                                                                                                                    0)
                                                                                                                                                  "struct.new_default"))
                                                                                                                                              (call
                                                                                                                                                $tree.is
                                                                                                                                                (call
                                                                                                                                                  $tree.at
                                                                                                                                                  $n
                                                                                                                                                  0)
                                                                                                                                                "struct.get"))
                                                                                                                                            (call
                                                                                                                                              $tree.is
                                                                                                                                              (call
                                                                                                                                                $tree.at
                                                                                                                                                $n
                                                                                                                                                0)
                                                                                                                                              "struct.get_s"))
                                                                                                                                          (call
                                                                                                                                            $tree.is
                                                                                                                                            (call
                                                                                                                                              $tree.at
                                                                                                                                              $n
                                                                                                                                              0)
                                                                                                                                            "struct.get_u"))
                                                                                                                                        (call
                                                                                                                                          $tree.is
                                                                                                                                          (call
                                                                                                                                            $tree.at
                                                                                                                                            $n
                                                                                                                                            0)
                                                                                                                                          "struct.set"))
                                                                                                                                      (call
                                                                                                                                        $tree.is
                                                                                                                                        (call
                                                                                                                                          $tree.at
                                                                                                                                          $n
                                                                                                                                          0)
                                                                                                                                        "array.new"))
                                                                                                                                    (call
                                                                                                                                      $tree.is
                                                                                                                                      (call
                                                                                                                                        $tree.at
                                                                                                                                        $n
                                                                                                                                        0)
                                                                                                                                      "array.new_default"))
                                                                                                                                  (call
                                                                                                                                    $tree.is
                                                                                                                                    (call
                                                                                                                                      $tree.at
                                                                                                                                      $n
                                                                                                                                      0)
                                                                                                                                    "array.new_fixed"))
                                                                                                                                (call
                                                                                                                                  $tree.is
                                                                                                                                  (call
                                                                                                                                    $tree.at
                                                                                                                                    $n
                                                                                                                                    0)
                                                                                                                                  "array.get"))
                                                                                                                              (call
                                                                                                                                $tree.is
                                                                                                                                (call
                                                                                                                                  $tree.at
                                                                                                                                  $n
                                                                                                                                  0)
                                                                                                                                "array.get_s"))
                                                                                                                            (call
                                                                                                                              $tree.is
                                                                                                                              (call
                                                                                                                                $tree.at
                                                                                                                                $n
                                                                                                                                0)
                                                                                                                              "array.get_u"))
                                                                                                                          (call
                                                                                                                            $tree.is
                                                                                                                            (call
                                                                                                                              $tree.at
                                                                                                                              $n
                                                                                                                              0)
                                                                                                                            "array.set"))
                                                                                                                        (call
                                                                                                                          $tree.is
                                                                                                                          (call
                                                                                                                            $tree.at
                                                                                                                            $n
                                                                                                                            0)
                                                                                                                          "array.fill"))
                                                                                                                      (call
                                                                                                                        $tree.is
                                                                                                                        (call
                                                                                                                          $tree.at
                                                                                                                          $n
                                                                                                                          0)
                                                                                                                        "array.copy"))
                                                                                                                    (call
                                                                                                                      $tree.is
                                                                                                                      (call
                                                                                                                        $tree.at
                                                                                                                        $n
                                                                                                                        0)
                                                                                                                      "ref.null"))
                                                                                                                  (call
                                                                                                                    $tree.is
                                                                                                                    (call
                                                                                                                      $tree.at
                                                                                                                      $n
                                                                                                                      0)
                                                                                                                    "ref.cast"))
                                                                                                                (call
                                                                                                                  $tree.is
                                                                                                                  (call
                                                                                                                    $tree.at
                                                                                                                    $n
                                                                                                                    0)
                                                                                                                  "ref.test"))
                                                                                                              (call
                                                                                                                $tree.is
                                                                                                                (call
                                                                                                                  $tree.at
                                                                                                                  $n
                                                                                                                  0)
                                                                                                                "@list.new"))
                                                                                                            (call
                                                                                                              $tree.is
                                                                                                              (call
                                                                                                                $tree.at
                                                                                                                $n
                                                                                                                0)
                                                                                                              "@list.len"))
                                                                                                          (call
                                                                                                            $tree.is
                                                                                                            (call
                                                                                                              $tree.at
                                                                                                              $n
                                                                                                              0)
                                                                                                            "@list.get"))
                                                                                                        (call
                                                                                                          $tree.is
                                                                                                          (call
                                                                                                            $tree.at
                                                                                                            $n
                                                                                                            0)
                                                                                                          "@list.from-array"))
                                                                                                      (call
                                                                                                        $tree.is
                                                                                                        (call
                                                                                                          $tree.at
                                                                                                          $n
                                                                                                          0)
                                                                                                        "@bytes.from-array"))
                                                                                                    (||
                                                                                                      (call
                                                                                                        $tree.is
                                                                                                        (call
                                                                                                          $tree.at
                                                                                                          $n
                                                                                                          0)
                                                                                                        "@bytes.copy-to-array")
                                                                                                      (call
                                                                                                        $tree.is
                                                                                                        (call
                                                                                                          $tree.at
                                                                                                          $n
                                                                                                          0)
                                                                                                        "@storage.get"))))
                                                                                                (then
                                                                                                  1)
                                                                                                (else
                                                                                                  (if
                                                                                                    (result
                                                                                                      i32)
                                                                                                    (&&
                                                                                                      (>
                                                                                                        $i
                                                                                                        0)
                                                                                                      (||
                                                                                                        (||
                                                                                                          (||
                                                                                                            (call
                                                                                                              $tree.is
                                                                                                              (call
                                                                                                                $tree.at
                                                                                                                $n
