(memory (export "memory") 1 256)
(global $bump (mut i32) (i32.const 8))
(global $free (mut i32) (i32.const 0))
(global $live (mut i32) (i32.const 0))
(global $count (mut i32) (i32.const 0))
(global (export "cancel-requested") (mut i32) (i32.const 0))
(func (export "live") (result i32) (global.get $count))
(func $link (param $block i32) (result i32)
  (i32.store offset=8 (local.get $block) (i32.const 0))
  (i32.store offset=12 (local.get $block) (global.get $live))
  (if (global.get $live) (then (i32.store offset=8 (global.get $live) (local.get $block))))
  (global.set $live (local.get $block))
  (global.set $count (i32.add (global.get $count) (i32.const 1)))
  (i32.add (local.get $block) (i32.const 16)))
(func $alloc (export "alloc") (param $size i32) (result i32)
  (local $block i32) (local $previous i32) (local $end i32) (local $pages i32)
  (if (i32.gt_u (local.get $size) (i32.const 16777176)) (then unreachable))
  (local.set $size (i32.and (i32.add (local.get $size) (i32.const 23)) (i32.const -8)))
  (local.set $block (global.get $free))
  (block $miss (loop $search
    (br_if $miss (i32.eqz (local.get $block)))
    (if (i32.ge_u (i32.load offset=4 (local.get $block)) (local.get $size))
      (then
        ;; Split a large free block instead of losing its capacity to a tiny allocation.
        (if (i32.ge_u (i32.sub (i32.load offset=4 (local.get $block)) (local.get $size)) (i32.const 24))
          (then
            (local.set $end (i32.add (local.get $block) (local.get $size)))
            (i32.store (local.get $end) (i32.load (local.get $block)))
            (i32.store offset=4 (local.get $end) (i32.sub (i32.load offset=4 (local.get $block)) (local.get $size)))
            (i32.store offset=4 (local.get $block) (local.get $size))
            (if (local.get $previous)
              (then (i32.store (local.get $previous) (local.get $end)))
              (else (global.set $free (local.get $end)))))
          (else
            (if (local.get $previous)
              (then (i32.store (local.get $previous) (i32.load (local.get $block))))
              (else (global.set $free (i32.load (local.get $block)))))))
        (return (call $link (local.get $block)))))
    (local.set $previous (local.get $block)) (local.set $block (i32.load (local.get $block))) (br $search)))
  (local.set $block (global.get $bump))
  (local.set $end (i32.add (local.get $block) (local.get $size)))
  (if (i32.gt_u (local.get $end) (i32.const 16777216)) (then unreachable))
  (local.set $pages (i32.shr_u (i32.add (local.get $end) (i32.const 65535)) (i32.const 16)))
  (if (i32.gt_u (local.get $pages) (memory.size))
    (then (if (i32.eq (memory.grow (i32.sub (local.get $pages) (memory.size))) (i32.const -1)) (then unreachable))))
  (global.set $bump (local.get $end))
  (i32.store offset=4 (local.get $block) (local.get $size))
  (call $link (local.get $block)))
(func $reclaim (local $block i32) (local $previous i32) (local $next i32)
  ;; Free blocks are address-sorted. Merge neighbors, then reclaim the tail.
  (local.set $block (global.get $free))
  (block $done (loop $scan
    (br_if $done (i32.eqz (local.get $block)))
    (local.set $next (i32.load (local.get $block)))
    (if (local.get $next) (then
      (if (i32.eq (i32.add (local.get $block) (i32.load offset=4 (local.get $block))) (local.get $next))
        (then
          (i32.store offset=4 (local.get $block) (i32.add (i32.load offset=4 (local.get $block)) (i32.load offset=4 (local.get $next))))
          (i32.store (local.get $block) (i32.load (local.get $next))) (br $scan)))
      (local.set $previous (local.get $block)) (local.set $block (local.get $next)) (br $scan))))
  (if (local.get $block) (then
    (if (i32.eq (i32.add (local.get $block) (i32.load offset=4 (local.get $block))) (global.get $bump))
      (then
        (global.set $bump (local.get $block))
        (if (local.get $previous)
          (then (i32.store (local.get $previous) (i32.const 0)))
          (else (global.set $free (i32.const 0))))))))))
(func $free (export "free") (param $pointer i32)
  (local $previous i32) (local $next i32) (local $before i32) (local $after i32)
  (if (local.get $pointer) (then
    (local.set $pointer (i32.sub (local.get $pointer) (i32.const 16)))
    (local.set $previous (i32.load offset=8 (local.get $pointer)))
    (local.set $next (i32.load offset=12 (local.get $pointer)))
    (if (local.get $previous)
      (then (i32.store offset=12 (local.get $previous) (local.get $next)))
      (else (global.set $live (local.get $next))))
    (if (local.get $next) (then (i32.store offset=8 (local.get $next) (local.get $previous))))
    (global.set $count (i32.sub (global.get $count) (i32.const 1)))
    (local.set $after (global.get $free))
    (block $insert (loop $find
      (br_if $insert (i32.eqz (local.get $after)))
      (br_if $insert (i32.gt_u (local.get $after) (local.get $pointer)))
      (local.set $before (local.get $after)) (local.set $after (i32.load (local.get $after))) (br $find)))
    (i32.store (local.get $pointer) (local.get $after))
    (if (local.get $before)
      (then (i32.store (local.get $before) (local.get $pointer)))
      (else (global.set $free (local.get $pointer))))
    (call $reclaim))))
(func (export "free-all")
  (loop $again (if (global.get $live) (then
    (call $free (i32.add (global.get $live) (i32.const 16))) (br $again)))))
(func (export "realloc") (param $old i32) (param $old-size i32) (param $alignment i32) (param $size i32) (result i32)
  (local $new i32)
  (if (i32.or (i32.eqz (local.get $alignment)) (i32.gt_u (local.get $alignment) (i32.const 8))) (then unreachable))
  (if (i32.eqz (local.get $size)) (then (call $free (local.get $old)) (return (i32.const 0))))
  (local.set $new (call $alloc (local.get $size)))
  (if (local.get $old) (then
    (memory.copy (local.get $new) (local.get $old)
      (if (result i32) (i32.lt_u (local.get $old-size) (local.get $size)) (then (local.get $old-size)) (else (local.get $size))))
    (call $free (local.get $old))))
  (local.get $new))
